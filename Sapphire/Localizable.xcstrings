    "Dim this monitor in software even if it answers DDC, for monitors whose DDC is slow or unreliable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Display per Software abdunkeln, auch wenn es auf DDC reagiert, für Displays mit langsamem oder unzuverlässigem DDC."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dim this monitor in software even if it answers DDC, for monitors whose DDC is slow or unreliable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenúa este monitor por software aunque responda a DDC, para monitores cuyo DDC es lento o poco fiable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atténuer ce moniteur par logiciel même s’il répond au DDC, pour les moniteurs dont le DDC est lent ou peu fiable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenua questo monitor via software anche se risponde al DDC, per i monitor con DDC lento o inaffidabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DDCに応答する場合でも、このモニタをソフトウェアで暗くします。DDCの応答が遅い、または不安定なモニタ向けです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DDC가 느리거나 불안정한 모니터를 위해 DDC에 응답하더라도 이 모니터를 소프트웨어로 어둡게 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escurece este monitor por software mesmo que ele responda ao DDC, para monitores cujo DDC é lento ou não confiável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемнять этот монитор программно, даже если он отвечает по DDC, для мониторов с медленным или ненадёжным DDC."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使显示器响应 DDC，也使用软件调光，适用于 DDC 较慢或不稳定的显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使顯示器回應 DDC，也使用軟體調光，適用於 DDC 較慢或不穩定的顯示器。"
          }
        }
      }
    },
