    "No Focus modes found. Allow Focus Status access and set up Focus modes in System Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Fokus gefunden. Erlauben Sie den Zugriff auf den Fokus-Status und richten Sie Fokus in den Systemeinstellungen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Focus modes found. Allow Focus Status access and set up Focus modes in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron modos de concentración. Permite el acceso al estado de Foco y configura los modos de Foco en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mode de concentration trouvé. Autorisez l’accès à l’état de la concentration et configurez des modes de concentration dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna modalità Focus trovata. Consenti l’accesso allo stato Focus e configura le modalità Focus in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中モードが見つかりません。集中モードのステータスへのアクセスを許可し、「システム設定」で集中モードを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 모드를 찾을 수 없습니다. 집중 모드 상태 접근을 허용하고 \"시스템 설정\"에서 집중 모드를 설정하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum modo de Foco encontrado. Permita o acesso ao Status do Foco e configure modos de Foco em Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимы фокусирования не найдены. Разрешите доступ к статусу фокусирования и настройте режимы фокусирования в Системных настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到专注模式。请允许访问专注状态，并在系统设置中设置专注模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
