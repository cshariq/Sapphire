    "A live activity with the app's icon and a timer while you're in a meeting, on a call, recording, or connected to another Mac. Click it for controls.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A live activity with the app's icon and a timer while you're in a meeting, on a call, recording, or connected to another Mac. Click it for controls."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開會、通話、錄製或連接另一部 Mac 時，顯示包含 App 圖示與計時器的即時動態。按一下即可控制。"
          }
        }
      }
    },
    "A live activity with the app's icon and progress while something downloads, copies or arrives over AirDrop.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A live activity with the app's icon and progress while something downloads, copies or arrives over AirDrop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載、拷貝或透過 AirDrop 接收內容時，顯示包含 App 圖示與進度的即時動態。"
          }
        }
      }
    },
    "A live status item for the paired phone. Click it for a detailed connectivity view.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A live status item for the paired phone. Click it for a detailed connectivity view."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示已配對手機的即時狀態。按一下可查看詳細連線資訊。"
          }
        }
      }
    },
    "A new version is ready to download. Open Settings → About → Updates to install it.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version is ready to download. Open Settings → About → Updates to install it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有新版本可供下載。請打開「設定」→「關於」→「更新」進行安裝。"
          }
        }
      }
    },
    "A new way to experience your Mac's notch.\nLet's get you set up.": {
      "comment": "User-facing Sapphire interface text. Keep product names and interpolated user content unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new way to experience your Mac's notch.\nLet's get you set up."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以全新方式體驗 Mac 的瀏海區域。\n現在開始設定吧。"
          }
        }
      }
    },
    "A playful and energetic animation with noticeable bounce.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A playful and energetic animation with noticeable bounce."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "活潑有力的動畫，帶有明顯回彈。"
          }
        }
      }
    },
    "A quick and responsive feel with minimal bounce.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick and responsive feel with minimal bounce."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "反應快速，回彈幅度小。"
          }
        }
      }
    },
    "A real Notification Center banner, with reply and action buttons.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A real Notification Center banner, with reply and action buttons."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用通知中心橫幅顯示通知，並包含回覆與操作按鈕。"
          }
        }
      }
    },
    "A related item changed after it was scanned and was left in place: %@": {
      "comment": "Settings dynamic interpolated presentation; key and placeholder types verified against module-build-01 compiler output.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A related item changed after it was scanned and was left in place: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描後相關項目發生變更，已保留在原處：%@"
          }
        }
      }
    },
    "A second click on empty menu bar space also shows the always-hidden section. The first click still shows hidden items right away": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A second click on empty menu bar space also shows the always-hidden section. The first click still shows hidden items right away"
          }
        },
