          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo display torna all'aspetto usato da ogni display"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスプレイは、すべてのディスプレイが使う外観に戻ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디스플레이는 모든 디스플레이가 사용하는 외관으로 돌아갑니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este monitor volta à aparência usada por todos os monitores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот дисплей возвращается к оформлению, которое используют все дисплеи"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此显示器将恢复使用所有显示器共用的外观"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此顯示器將恢復使用所有顯示器共用的外觀"
          }
        }
      }
    },
