    "Use Night Shift on your Mac to reduce exposure to blue light, especially in dark environments or during late hours when it can interfere with sleep.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Night Shift auf Ihrem Mac, um die Blaulichtbelastung zu verringern, besonders in dunkler Umgebung oder zu später Stunde, wenn es den Schlaf beeinträchtigen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Night Shift on your Mac to reduce exposure to blue light, especially in dark environments or during late hours when it can interfere with sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Night Shift en tu Mac para reducir la exposición a la luz azul, sobre todo en entornos oscuros o a altas horas de la noche, cuando puede interferir con el sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Night Shift sur votre Mac pour réduire l’exposition à la lumière bleue, surtout dans un environnement sombre ou tard le soir, lorsqu’elle peut perturber le sommeil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Night Shift sul Mac per ridurre l’esposizione alla luce blu, soprattutto in ambienti bui o a tarda ora, quando può disturbare il sonno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacのNight Shiftを使用して、特に暗い場所や睡眠の妨げになる深夜に、ブルーライトへの露出を減らします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 Night Shift를 사용하여 특히 어두운 환경이나 수면을 방해할 수 있는 늦은 시간에 블루 라이트 노출을 줄이십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o Night Shift no Mac para reduzir a exposição à luz azul, especialmente em ambientes escuros ou tarde da noite, quando ela pode atrapalhar o sono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте Night Shift на Mac, чтобы уменьшить воздействие синего света, особенно в тёмной обстановке или поздно вечером, когда он может мешать сну."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Mac 的夜览功能减少蓝光，尤其是在光线较暗或夜间使用时，以免影响睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Mac 上的「夜覽」來減少藍光暴露，尤其是在昏暗環境中或深夜可能影響睡眠時。"
          }
        }
      }
    },
    "Use Night Shift on your mac to reduce exposure to blue light, especially in dark environments or during late hours when it can interfere with sleep.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Night Shift auf Ihrem Mac, um die Blaulichtbelastung zu verringern, besonders in dunklen Umgebungen oder zu später Stunde, wenn es den Schlaf stören kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Night Shift on your mac to reduce exposure to blue light, especially in dark environments or during late hours when it can interfere with sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Night Shift en tu Mac para reducir la exposición a la luz azul, especialmente en entornos oscuros o a altas horas, cuando puede interferir con el sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Night Shift sur votre Mac pour réduire l’exposition à la lumière bleue, surtout dans les environnements sombres ou tard le soir, où elle peut perturber le sommeil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Night Shift sul Mac per ridurre l'esposizione alla luce blu, soprattutto in ambienti bui o a tarda ora quando può interferire con il sonno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの“Night Shift”を使って、特に暗い環境や、睡眠を妨げる可能性のある遅い時間帯に、ブルーライトへの露出を減らします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 Night Shift를 사용하여 특히 어두운 환경이나 수면에 방해될 수 있는 늦은 시간에 블루라이트 노출을 줄이십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o Night Shift no Mac para reduzir a exposição à luz azul, especialmente em ambientes escuros ou à noite, quando ela pode atrapalhar o sono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте Night Shift на Mac, чтобы уменьшить воздействие синего света, особенно в тёмных помещениях или поздно вечером, когда он может мешать сну."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Mac 的夜览功能减少蓝光，尤其是在光线较暗或夜间使用时，以免影响睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Mac 上的「夜覽」來減少藍光暴露，尤其是在昏暗環境中或深夜可能影響睡眠時。"
          }
        }
      }
