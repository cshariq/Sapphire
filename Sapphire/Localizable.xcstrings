    "Bright border around the screen that lights your face while the lock screen stays visible.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heller Rahmen um den Bildschirm, der dein Gesicht beleuchtet, während der Sperrbildschirm sichtbar bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bright border around the screen that lights your face while the lock screen stays visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borde brillante alrededor de la pantalla que ilumina tu cara mientras la pantalla de bloqueo sigue visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bordure lumineuse autour de l’écran qui éclaire votre visage tout en laissant l’écran verrouillé visible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bordo luminoso intorno allo schermo che illumina il viso lasciando visibile la schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面を表示したまま、画面の周りの明るい枠で顔を照らします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면은 그대로 보이면서 화면 가장자리의 밝은 테두리가 얼굴을 비춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Borda brilhante ao redor da tela que ilumina seu rosto enquanto a tela de bloqueio continua visível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
