    "Find large folders and reclaim space with transparent, user-approved cleanup.": {
      "comment": "SettingsSection.shortDescription",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finden Sie große Ordner und gewinnen Sie Speicherplatz mit transparenter, von Ihnen genehmigter Bereinigung zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find large folders and reclaim space with transparent, user-approved cleanup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra carpetas grandes y recupera espacio con una limpieza transparente y aprobada por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repérez les gros dossiers et récupérez de l’espace grâce à un nettoyage transparent et approuvé par l’utilisateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova cartelle grandi e recupera spazio con una pulizia trasparente e approvata da te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きなフォルダを見つけ、透明性のあるユーザ承認制のクリーンアップで空き容量を回収します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 폴더를 찾아 투명하고 사용자가 승인한 정리로 공간을 확보합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre pastas grandes e recupere espaço com uma limpeza transparente e aprovada por você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находите крупные папки и освобождайте место с помощью прозрачной очистки с вашим одобрением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找大文件夹，在确认清理内容后释放空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找大型檔案夾，並以透明、經你確認的清理方式釋放空間。"
          }
        }
      }
    },
