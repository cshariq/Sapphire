    "Hold a mouse button to press modifier keys, like a keyboard modifier. While held, your side buttons perform their alternate action.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie eine Maustaste, um Modifikatortasten zu drücken, wie eine Tastatur-Modifikatortaste. Solange sie gehalten wird, führen Ihre Seitentasten ihre alternative Aktion aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a mouse button to press modifier keys, like a keyboard modifier. While held, your side buttons perform their alternate action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un botón del ratón para pulsar teclas modificadoras, como una tecla modificadora del teclado. Mientras se mantiene, los botones laterales realizan su acción alternativa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez un bouton de souris pour activer des touches de modification, comme un modificateur de clavier. Tant qu’il est maintenu, vos boutons latéraux effectuent leur action alternative."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un pulsante del mouse per premere i tasti modificatori, come un modificatore della tastiera. Mentre è premuto, i pulsanti laterali eseguono la loro azione alternativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスボタンを押し続けて、キーボードの修飾キーのように修飾キーを押します。押している間、サイドボタンは代替アクションを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 버튼을 길게 눌러 키보드 수정자처럼 수정자 키를 누릅니다. 누르고 있는 동안 사이드 버튼은 대체 동작을 수행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um botão do mouse pressionado para acionar teclas modificadoras, como um modificador do teclado. Enquanto pressionado, seus botões laterais executam a ação alternativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте кнопку мыши, чтобы нажимать клавиши-модификаторы, как на клавиатуре. Пока она удерживается, боковые кнопки выполняют альтернативное действие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住鼠标按键即可按下修饰键，就像键盘修饰键一样。按住期间，你的侧键会执行其替代操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住滑鼠按鍵即可按下修飾鍵，就像鍵盤修飾鍵一樣。按住期間，你的側邊按鍵會執行其替代動作。"
          }
        }
      }
    },
    "Hold a right-side modifier key and it acts as the modifier combination you choose; tap it on its own for a quick action.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie eine Modifikatortaste auf der rechten Seite, und sie wirkt als die von Ihnen gewählte Modifikatorkombination; tippen Sie sie allein an für eine Schnellaktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a right-side modifier key and it acts as the modifier combination you choose; tap it on its own for a quick action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una tecla modificadora del lado derecho y actúa como la combinación de modificadores que elijas; púlsala sola para una acción rápida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une touche de modification de droite pour qu’elle agisse comme la combinaison de modificateurs choisie ; appuyez dessus seule pour une action rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un tasto modificatore sul lato destro e agisce come la combinazione di modificatori che scegli; toccalo da solo per un'azione rapida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右側の修飾キーを押し続けると、選んだ修飾キーの組み合わせとして動作します。単独でタップするとクイックアクションを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 수정자 키를 길게 누르면 선택한 수정자 조합으로 작동하며, 단독으로 탭하면 빠른 동작을 수행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pressionada uma tecla modificadora do lado direito e ela atua como a combinação de modificadores que você escolher; toque nela sozinha para uma ação rápida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте правую клавишу-модификатор — она действует как выбранная вами комбинация модификаторов; коснитесь её отдельно для быстрого действия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住右侧修饰键时，它会作为你所选的修饰键组合；单独轻点则执行快捷操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住右側修飾鍵時，它會作為你所選的修飾鍵組合；單獨輕點則執行快速動作。"
          }
        }
      }
    },
