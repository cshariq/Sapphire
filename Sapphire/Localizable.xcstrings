    "Welcome, %@": {
      "comment": "Native local UI wording in MusicHubViews.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome, %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎，%@"
          }
        }
      }
    },
    "What This Includes:": {
      "comment": "Onboarding, app menus, helper, shared utilities, public build placeholders",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What This Includes:"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包括以下內容："
          }
        }
      }
    },
    "What can I change about the music player?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can I change about the music player?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂播放器有哪些設定可以調整？"
          }
        }
      }
    },
    "What is OpenBubbles?": {
      "comment": "Compiler-extracted static interface text",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is OpenBubbles?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "什麼是 OpenBubbles？"
          }
        }
      }
    },
    "Wheel notches glide instead of jumping. Scrolling with ⌘, ⌥, ⌃ or ⇧ held stays immediate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wheel notches glide instead of jumping. Scrolling with ⌘, ⌥, ⌃ or ⇧ held stays immediate."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾輪逐格平滑滑行，不再跳動。按住 ⌘、⌥、⌃ 或 ⇧ 時，捲動仍即時回應。"
          }
        }
      }
    },
    "When Sapphire opens a DMG, mount it, install contained apps, unmount, and clean up automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Sapphire opens a DMG, mount it, install contained apps, unmount, and clean up automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 開啟 DMG 時，會自動掛載、安裝其中的 App、卸載並清理。"
          }
        }
      }
    },
    "When Sapphire opens an archive, extract it automatically. Disable to hand archives back to macOS Archive Utility.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Sapphire opens an archive, extract it automatically. Disable to hand archives back to macOS Archive Utility."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 開啟封存檔時自動解壓縮。停用後，封存檔會交回 macOS 封存工具程式處理。"
          }
        }
      }
    },
    "When Spotify desktop on this Mac plays an ad, relaunch it in the background, then resume via Spotify Connect.": {
      "comment": "Settings interface",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Spotify desktop on this Mac plays an ad, relaunch it in the background, then resume via Spotify Connect."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當這台 Mac 上的 Spotify 桌面版播放廣告時，在背景重新啟動它，然後透過 Spotify Connect 繼續播放。"
          }
        }
      }
    },
    "When a Live Activity appears automatically.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a Live Activity appears automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時動態自動出現時。"
          }
        }
      }
    },
    "When a song only has line timing, listen to the music app's audio on this Mac to time each word, and share good results. Asks for audio access and downloads Apple's speech model once.": {
      "comment": "Settings interface",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a song only has line timing, listen to the music app's audio on this Mac to time each word, and share good results. Asks for audio access and downloads Apple's speech model once."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當歌曲只有逐行時間時，聆聽此 Mac 上音樂 App 的音訊來為每個字詞計時，並分享良好的結果。會要求音訊取用權限，並下載一次 Apple 的語音模型。"
          }
        }
      }
    },
    "When another app is playing, show a Spotify source tab so you can switch medias. Hidden while Spotify itself is the main media source.": {
      "comment": "Settings interface",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When another app is playing, show a Spotify source tab so you can switch medias. Hidden while Spotify itself is the main media source."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當其他 App 正在播放時，顯示 Spotify 來源標籤頁以便切換媒體。當 Spotify 本身為主要媒體來源時則隱藏。"
          }
        }
      }
    },
    "When enabled, 100% app volume is capped by current system output volume.": {
      "comment": "Settings interface",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, 100% app volume is capped by current system output volume."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，App 音量 100% 的上限為目前的系統輸出音量。"
          }
        }
      }
    },
    "When enabled, your Mac will stop using AC power and run from its battery until the battery limit is reached.": {
      "comment": "Settings interface",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, your Mac will stop using AC power and run from its battery until the battery limit is reached."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，你的 Mac 將停止使用交流電源，改以電池供電，直到達到電池上限。"
          }
        }
      }
    },
    "When more than one live activity is running, the ones after the first appear as small bubbles next to the notch, like the Dynamic Island. Click a bubble to open it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When more than one live activity is running, the ones after the first appear as small bubbles next to the notch, like the Dynamic Island. Click a bubble to open it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多個即時動態同時執行時，第一個之後的動態會像動態島一樣，以小泡泡顯示在瀏海旁。按一下泡泡即可開啟。"
          }
        }
      }
    },
    "When more than one phone is linked, pick a device each time you mirror or extend. Other features use the preferred (Active) phone, or sync to every linked phone where that makes sense (clipboard, Focus).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When more than one phone is linked, pick a device each time you mirror or extend. Other features use the preferred (Active) phone, or sync to every linked phone where that makes sense (clipboard, Focus)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接多部手機時，每次鏡像或延伸都會讓你選擇裝置。其他功能使用首選（目前啟用的）手機，或在適用時同步到所有已連接手機（如剪貼簿、專注模式）。"
          }
        }
      }
    },
    "When on (and Music ▸ Live Activity lyrics is on), Continuity / phone tracks can show lyrics in the notch Live Activity.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on (and Music ▸ Live Activity lyrics is on), Continuity / phone tracks can show lyrics in the notch Live Activity."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後（且已開啟「音樂」▸「即時動態歌詞」），Continuity 與手機曲目可在瀏海即時動態中顯示歌詞。"
          }
        }
      }
    },
    "When re-opening the notch, it will return to the last menu you had open.": {
      "comment": "Settings interface",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When re-opening the notch, it will return to the last menu you had open."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打開瀏海區域時，會回到你上次打開的選單。"
          }
        }
      }
    },
    "When shown items would run into the app's menus or the notch, temporarily swap the menus out until the items hide again": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When shown items would run into the app's menus or the notch, temporarily swap the menus out until the items hide again"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示的項目將與 App 選單或瀏海重疊時，暫時隱藏 App 選單，直到這些項目再次隱藏"
          }
        }
      }
    },
    "When the DMG contains an older or equal version of an installed app, keep the installed copy without asking.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the DMG contains an older or equal version of an installed app, keep the installed copy without asking."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG 中的版本比已安裝版本更舊或相同時，無須詢問，直接保留已安裝的副本。"
          }
        }
      }
    },
    "When the notch is collapsed, swipe up over it to hide it completely. Swipe down near the notch area to bring it back.": {
      "comment": "Settings interface",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the notch is collapsed, swipe up over it to hide it completely. Swipe down near the notch area to bring it back."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海區域收合時，在其上方向上滑動即可完全隱藏；在瀏海區域附近向下滑動即可讓它重新出現。"
          }
        }
      }
    },
    "When the phone is playing and this Mac is not, show it in the regular music Live Activity (album art on the left). Right-side track info, waveform mode, and waveform style are under Music settings ▸ Live Activity.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the phone is playing and this Mac is not, show it in the regular music Live Activity (album art on the left). Right-side track info, waveform mode, and waveform style are under Music settings ▸ Live Activity."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機正在播放而這部 Mac 未播放時，在一般音樂即時動態中顯示手機內容，左側顯示專輯封面。右側曲目資訊、波形模式與波形樣式位於「音樂設定」▸「即時動態」中。"
          }
        }
      }
    },
    "When this Mac or the phone starts playing, it reconnects the shared earbuds and the other device pauses. Seamless Connection is always free.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this Mac or the phone starts playing, it reconnects the shared earbuds and the other device pauses. Seamless Connection is always free."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 或手機開始播放時，會重新連接共用的耳塞，另一部裝置則暫停。無縫連線一律免費。"
          }
        }
      }
    },
    "When this profile starts or ends here, do the same on Android.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this profile starts or ends here, do the same on Android."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此開始或結束此設定檔時，在 Android 上執行相同操作。"
          }
        }
      }
    },
    "When you copy a large image or screenshot, replace it on the clipboard with a smaller version automatically": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you copy a large image or screenshot, replace it on the clipboard with a smaller version automatically"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝大型影像或螢幕截圖時，自動將剪貼簿內容替換為較小版本"
          }
        }
      }
    },
    "When you drag a file out of the shelf, remove it from the shelf automatically.": {
      "comment": "Settings interface",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you drag a file out of the shelf, remove it from the shelf automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將檔案拖出暫存架時，自動將其從暫存架移除。"
          }
        }
      }
    },
    "When you open a disk image yourself, ask whether to install the app inside and eject it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you open a disk image yourself, ask whether to install the app inside and eject it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你自行開啟磁碟映像檔時，詢問是否安裝其中的 App 並退出映像檔。"
          }
        }
      }
    },
    "Which live activities still show while an app is full screen, on every display.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which live activities still show while an app is full screen, on every display."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 全螢幕時，哪些即時動態仍會在所有顯示器上顯示。"
          }
        }
      }
    },
    "Whichever device starts playing most recently takes the earbuds. Turn this off to only hand off when the buds themselves connect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whichever device starts playing most recently takes the earbuds. Turn this off to only hand off when the buds themselves connect."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近開始播放的裝置會接管耳塞。關閉後，僅在耳塞自身連接時接力。"
          }
        }
      }
    },
    "While QuickTime is recording the screen, a movie or audio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While QuickTime is recording the screen, a movie or audio."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "QuickTime 正在錄製螢幕、影片或音訊時顯示。"
          }
        }
      }
    },
    "While Selected Apps Are Running": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Selected Apps Are Running"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選 App 執行期間"
          }
        }
      }
    },
