    },
    "Drag Coordinates": {
      "comment": "The name of a tool test.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehkoordinaten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
