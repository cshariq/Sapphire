    "%@. Your windows are safe; Fractal Windows picks up again when this clears.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Ihre Fenster sind sicher; Fractal Windows setzt fort, sobald dies behoben ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Your windows are safe; Fractal Windows picks up again when this clears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Tus ventanas están a salvo; Fractal Windows continuará cuando esto se resuelva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Vos fenêtres sont en sécurité ; Fractal Windows reprend lorsque cela disparaît."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Le tue finestre sono al sicuro; Fractal Windows riprende quando questo si risolve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。ウインドウは安全です。これが解消されると、Fractal Windowsが再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 윈도우는 안전하며 이 문제가 해결되면 프랙탈 윈도우가 다시 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Suas janelas estão seguras; o Fractal Windows retoma quando isso for resolvido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Ваши окна в безопасности; Fractal Windows продолжит работу, когда это пройдёт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。你的窗口是安全的；待此问题解除后，Fractal Windows 会继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。你的視窗是安全的；待此問題解除後，Fractal Windows 會繼續運作。"
          }
        }
      }
    },
