    "Dim and blur the display as the lid closes past the activation angle, following the hinge.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelt das Display ab und macht es unscharf, wenn sich der Deckel über den Aktivierungswinkel hinaus schließt, passend zum Scharnier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dim and blur the display as the lid closes past the activation angle, following the hinge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenúa y desenfoca la pantalla a medida que la tapa se cierra más allá del ángulo de activación, siguiendo la bisagra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atténue et floute l’écran lorsque le capot se ferme au-delà de l’angle d’activation, en suivant la charnière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenua e sfoca il display mentre il coperchio si chiude oltre l'angolo di attivazione, seguendo la cerniera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋が起動角度を超えて閉じるとき、ヒンジに合わせてディスプレイを暗くしてぼかします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개가 활성화 각도를 넘어 닫힐 때 경첩을 따라 디스플레이를 어둡게 하고 흐리게 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escurece e desfoca o monitor conforme a tampa fecha além do ângulo de ativação, acompanhando a dobradiça."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемнять и размывать дисплей по мере закрытия крышки за углом активации, следуя за шарниром."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上屏幕超过触发角度后，随着转轴运动逐渐调暗并模糊显示画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "闔上螢幕超過觸發角度後，隨著轉軸移動逐漸調暗並模糊顯示畫面。"
          }
        }
      }
    },
