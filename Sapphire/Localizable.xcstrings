    "Boosting Clear Bass or the low EQ bands can cause clipping and distortion.": {
      "comment": "Native local UI wording in DeviceEQView.swift",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verstärken von „Clear Bass“ oder der tiefen EQ-Bänder kann zu Übersteuerung und Verzerrung führen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boosting Clear Bass or the low EQ bands can cause clipping and distortion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumentar Clear Bass o las bandas graves del ecualizador puede provocar saturación y distorsión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforcer Clear Bass ou les bandes graves de l’égaliseur peut provoquer de l’écrêtage et de la distorsion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumentare Bassi nitidi o le bande EQ basse può causare clipping e distorsione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリアベースや低域のEQバンドを上げると、クリッピングや歪みが発生することがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클리어 베이스 또는 저음역 EQ 대역을 높이면 클리핑과 왜곡이 발생할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumentar Graves Nítidos ou as bandas baixas do EQ pode causar clipping e distorção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Усиление «Чистых басов» или низких полос эквалайзера может вызвать клиппинг и искажения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提高清晰低音或低频均衡器频段可能导致削波和失真。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調高「清晰低音」或低頻 EQ 頻段可能造成削波和失真。"
          }
        }
      }
    },
