    "Mirror blocks and social filters. Off = customize each device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockierungen und Social-Filter spiegeln. Aus = jedes Gerät einzeln anpassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror blocks and social filters. Off = customize each device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplica los bloqueos y los filtros sociales. Desactivado = personalizar cada dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduire les blocs et les filtres de réseaux sociaux. Désactivé = personnaliser chaque appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispecchia blocchi e filtri social. Disattivato = personalizza ogni dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックとソーシャルフィルタをミラーリングします。オフにすると、各デバイスを個別にカスタマイズできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 항목과 소셜 필터를 미러링합니다. 끄면 기기마다 사용자화합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espelha bloqueios e filtros de redes sociais. Desativado = personalizar cada dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отражать блокировки и социальные фильтры. Выкл. = настраивать каждое устройство отдельно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步屏蔽项和社交筛选条件。关闭后可单独自定义各设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步封鎖項目與社群篩選條件。關閉後可個別自訂各裝置。"
          }
        }
      }
    },
    "Mirror focus sessions to the system Clock app via Shortcuts.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus-Sitzungen über Kurzbefehle in die System-App „Uhr“ spiegeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror focus sessions to the system Clock app via Shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplica las sesiones de foco en la app Reloj del sistema mediante Atajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduire les sessions de concentration dans l’app Horloge du système via Raccourcis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispecchia le sessioni di focus nell'app Orologio di sistema tramite Comandi rapidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット経由で、集中セッションをシステムの時計Appにミラーリングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어를 통해 집중 세션을 시스템 시계 앱에 미러링합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espelhar sessões de foco no app Relógio do sistema por meio dos Atalhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отражать сеансы фокусирования в приложении «Часы» через Быстрые команды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过快捷指令将专注时段同步到系统时钟应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑將專注時段同步到系統「時鐘」App。"
          }
        }
      }
    },
    "Mirror macOS Focus and Android Do Not Disturb.": {
      "localizations": {
