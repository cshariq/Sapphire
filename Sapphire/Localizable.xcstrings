    "Opened Terminal to upgrade %@ — Homebrew needs your administrator password.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal zum Aktualisieren von %@ geöffnet – Homebrew benötigt Ihr Administratorpasswort."
          }
        },
        "en": {
          "stringUnit": {
