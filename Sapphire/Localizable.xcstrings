    "Save a portable copy of your Sapphire preferences or restore one you exported earlier.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern Sie eine portable Kopie Ihrer Sapphire-Einstellungen oder stellen Sie eine zuvor exportierte wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a portable copy of your Sapphire preferences or restore one you exported earlier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una copia portátil de tus preferencias de Sapphire o restaura una que exportaste antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une copie portable de vos préférences Sapphire ou restaurez-en une exportée précédemment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una copia portatile delle preferenze di Sapphire o ripristinane una esportata in precedenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireの環境設定のポータブルなコピーを保存するか、以前に書き出したものを復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 환경설정의 이동 가능한 사본을 저장하거나 이전에 내보낸 사본을 복원합니다."
          }
        },
        "pt-BR": {
