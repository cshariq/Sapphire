    "Hide the notch while nothing is happening. It appears for any live activity.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Notch aus, solange nichts passiert. Sie erscheint bei jeder Live-Aktivität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the notch while nothing is happening. It appears for any live activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta la muesca mientras no ocurre nada. Aparece con cualquier actividad en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer l’encoche tant que rien ne se passe. Elle apparaît pour toute activité en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi il notch mentre non succede nulla. Compare per qualsiasi Live Activity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も起きていない間、ノッチを非表示にします。ライブアクティビティがあれば表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 일도 없을 때 노치를 숨깁니다. 라이브 활동이 있으면 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta o entalhe enquanto nada está acontecendo. Ele aparece para qualquer atividade ao vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать вырез, пока ничего не происходит. Он появляется для любой live-активности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有活动时隐藏刘海。有实时活动时会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有動態時隱藏瀏海。有即時動態時會顯示。"
          }
        }
      }
    },
    "Hide the notch while nothing is happening. It still appears for activities that aren't hidden, like the volume HUD.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Notch aus, solange nichts passiert. Sie erscheint weiterhin bei Aktivitäten, die nicht ausgeblendet sind, wie dem Lautstärke-HUD."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the notch while nothing is happening. It still appears for activities that aren't hidden, like the volume HUD."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta la muesca mientras no ocurre nada. Sigue apareciendo para las actividades que no están ocultas, como el HUD de volumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer l’encoche tant que rien ne se passe. Elle apparaît quand même pour les activités non masquées, comme l’affichage du volume."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi il notch mentre non succede nulla. Compare comunque per le attività non nascoste, come l'HUD del volume."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も起きていない間、ノッチを非表示にします。音量HUDなど、非表示にしていないアクティビティでは引き続き表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 일도 없을 때 노치를 숨깁니다. 볼륨 HUD처럼 숨겨지지 않은 활동에는 계속 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta o entalhe enquanto nada está acontecendo. Ele ainda aparece para atividades que não estão ocultas, como o HUD de volume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать вырез, пока ничего не происходит. Он по-прежнему появляется для нескрытых активностей, например HUD громкости."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有活动时隐藏刘海。音量提示浮层等未隐藏的活动仍会让刘海显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有動態時隱藏瀏海。音量浮動提示等未隱藏的動態仍會讓瀏海顯示。"
          }
        }
      }
    },
    "Hide the sports activity when no favorite team has a live game.": {
      "comment": "Settings interface",
      "localizations": {
