    "Bluetooth only unlocks this Mac while your phone is unlocked and its screen is on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth entsperrt diesen Mac nur, während dein Telefon entsperrt und sein Bildschirm an ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth only unlocks this Mac while your phone is unlocked and its screen is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth solo desbloquea este Mac mientras tu teléfono está desbloqueado y con la pantalla encendida."
          }
        },
        "fr": {
          "stringUnit": {
