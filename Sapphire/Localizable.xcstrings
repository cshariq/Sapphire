    "Sign in to Spotify below. Old sessions are cleared first so a revoked login cannot auto-complete.": {
      "comment": "Compiler-extracted static interface text",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich unten bei Spotify an. Alte Sitzungen werden zuvor gelöscht, damit sich eine widerrufene Anmeldung nicht automatisch abschließen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to Spotify below. Old sessions are cleared first so a revoked login cannot auto-complete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en Spotify abajo. Las sesiones antiguas se borran primero para que un inicio de sesión revocado no se complete automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à Spotify ci-dessous. Les anciennes sessions sont d’abord effacées afin qu’une connexion révoquée ne puisse pas se terminer automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a Spotify qui sotto. Le vecchie sessioni vengono prima cancellate, così un accesso revocato non può completarsi automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下でSpotifyにサインインしてください。取り消されたログインが自動的に完了しないよう、古いセッションは先に消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에서 Spotify에 로그인하십시오. 취소된 로그인이 자동으로 완료되지 않도록 이전 세션이 먼저 지워집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login no Spotify abaixo. As sessões antigas são limpas primeiro para que um login revogado não seja concluído automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в Spotify ниже. Старые сеансы сначала очищаются, чтобы отозванный вход не завершился автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在下方登录 Spotify。系统会先清除旧会话，防止已撤销的登录自动完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在下方登入 Spotify。會先清除舊的工作階段，以免已撤銷的登入自動完成。"
          }
        }
      }
    },
    "Sign in to Spotify to see your library": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich bei Spotify an, um Ihre Mediathek zu sehen"
