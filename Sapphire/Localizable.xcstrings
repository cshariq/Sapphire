      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous data is processed by google for analytics. This data is always aggregated and cannot be used to identify you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名数据由 Google 处理并用于分析。这些数据始终以汇总形式呈现，无法用于识别你的身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名資料由 Google 處理並用於分析。這些資料一律以彙總形式呈現，無法用來識別你的身分。"
          }
        }
      }
    },
