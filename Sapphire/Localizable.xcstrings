          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas ejecutan Blip automáticamente cuando corresponde, incluso con el panel de la muesca cerrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
