    "You're on a beta build. Switching to Stable lets you install the latest stable release.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie verwenden einen Beta-Build. Durch den Wechsel zu „Stabil“ können Sie das neueste stabile Release installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're on a beta build. Switching to Stable lets you install the latest stable release."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás en una compilación beta. Al cambiar a Estable podrás instalar la última versión estable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes sur une version bêta. Passer à Stable vous permet d’installer la dernière version stable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai usando una build beta. Passando a Stabile puoi installare l'ultima versione stabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベータビルドをお使いです。“安定版”に切り替えると、最新の安定版リリースをインストールできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "베타 빌드를 사용 중입니다. 안정 버전으로 전환하면 최신 안정 릴리스를 설치할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está em um build beta. Mudar para Estável permite instalar a versão estável mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас бета-сборка. Переключение на «Стабильный» позволит установить последний стабильный выпуск."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在使用测试版。切换到稳定版通道后，可以安装最新稳定版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前使用的是 Beta 版本。切換至「穩定版」即可安裝最新的穩定版本。"
          }
        }
      }
    },
