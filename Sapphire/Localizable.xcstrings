    "Height of the notch in points on every display. 0 matches the built-in notch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhe der Notch in Punkten auf jedem Display. 0 entspricht der integrierten Notch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Height of the notch in points on every display. 0 matches the built-in notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura de la muesca en puntos en todas las pantallas. Con 0 coincide con la muesca integrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauteur de l’encoche en points sur chaque écran. 0 correspond à l’encoche intégrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza del notch in punti su ogni display. 0 corrisponde al notch integrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのディスプレイでのノッチの高さ(ポイント単位)。0にすると内蔵ノッチに合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 디스플레이에서 노치의 높이(포인트)입니다. 0은 내장 노치와 일치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura do entalhe em pontos em todos os monitores. 0 corresponde ao entalhe integrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высота выреза в пунктах на каждом дисплее. 0 соответствует встроенному вырезу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有显示器上刘海区域的高度，单位为点。设为 0 时与内置刘海匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有顯示器上瀏海區域的高度，單位為點。設為 0 時與內建瀏海相符。"
          }
        }
      }
    },
