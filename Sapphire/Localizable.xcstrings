    "Camera access is required for Face ID. Enable it in System Settings → Privacy & Security → Camera.": {
      "comment": "Runtime user-facing string",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Face ID ist Zugriff auf die Kamera erforderlich. Aktivieren Sie ihn unter „Systemeinstellungen“ → „Datenschutz & Sicherheit“ → „Kamera“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is required for Face ID. Enable it in System Settings → Privacy & Security → Camera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso a la cámara para Face ID. Actívalo en Ajustes del Sistema → Privacidad y seguridad → Cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la caméra est requis pour Face ID. Activez-le dans Réglages Système → Confidentialité et sécurité → Caméra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla fotocamera è necessario per Face ID. Attivalo in Impostazioni di Sistema → Privacy e sicurezza → Fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face IDにはカメラへのアクセスが必要です。“システム設定”→“プライバシーとセキュリティ”→“カメラ”で有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID에는 카메라 접근이 필요합니다. 시스템 설정 → 개인정보 보호 및 보안 → 카메라에서 활성화하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera é necessário para o Face ID. Ative-o em Ajustes do Sistema → Privacidade e Segurança → Câmera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Face ID нужен доступ к камере. Включите его в разделе «Системные настройки» → «Конфиденциальность и безопасность» → «Камера»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID需要摄像头权限。请前往“系统设置 → 隐私与安全性 → 摄像头”开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID 需要相機權限。請前往「系統設定」→「隱私權與安全性」→「相機」啟用。"
          }
        }
      }
    },
