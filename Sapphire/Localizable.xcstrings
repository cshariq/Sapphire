    },
    "Mirror sessions to the Clock app using Apple's Clock shortcuts, such as Start Timer, when they're on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzungen mit den Kurzbefehlen von Apple für die App „Uhr“, z. B. „Timer starten“, in die Uhr-App spiegeln, wenn sie auf diesem Mac vorhanden sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror sessions to the Clock app using Apple's Clock shortcuts, such as Start Timer, when they're on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Refleja las sesiones en la app Reloj mediante los atajos de Reloj de Apple, como Iniciar temporizador, cuando estén en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reflétez les sessions dans l’app Horloge à l’aide des raccourcis Horloge d’Apple, comme Démarrer le minuteur, lorsqu’ils sont présents sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispecchia le sessioni nell’app Orologio usando i comandi rapidi di Orologio di Apple, come Avvia timer, quando sono su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでAppleの時計のショートカット（「タイマーを開始」など）が使える場合、セッションを時計Appに反映します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 타이머 시작과 같은 Apple 시계 단축어를 사용할 수 있을 때 세션을 시계 앱에 미러링합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espelhe as sessões no app Relógio usando os atalhos do Relógio da Apple, como Iniciar Timer, quando estiverem neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дублируйте сеансы в приложении «Часы» с помощью быстрых команд «Часов» от Apple, например «Запустить таймер», если они есть на этом Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当这台 Mac 上有 Apple 的时钟快捷指令（如“开始计时器”）时，将专注时段同步到时钟 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當這台 Mac 上有 Apple 的時鐘捷徑（如「開始計時器」）時，將專注時段同步到時鐘 App。"
          }
        }
      }
    },
    "Mirror the camera feed horizontally for a natural selfie view.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kamerabild für eine natürliche Selfie-Ansicht horizontal spiegeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror the camera feed horizontally for a natural selfie view."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltea horizontalmente la imagen de la cámara para obtener una vista de selfie natural."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverser horizontalement le flux de la caméra pour un rendu selfie naturel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispecchia orizzontalmente il feed della fotocamera per una naturale vista selfie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自然なセルフィー表示になるよう、カメラ映像を左右反転します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자연스러운 셀카 보기를 위해 카메라 화면을 좌우 반전합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espelha a imagem da câmera na horizontal para uma visualização de selfie natural."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зеркально отражать изображение камеры по горизонтали для естественного вида селфи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水平镜像摄像头画面，获得自然的自拍视角。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "水平鏡像相機畫面，呈現自然的自拍視角。"
          }
        }
      }
    },
    "Mirror widget showing live camera feed, with expandable fullscreen view.": {
      "comment": "SettingsSection.shortDescription",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiegel-Widget mit Live-Kamerabild und erweiterbarer Vollbildansicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror widget showing live camera feed, with expandable fullscreen view."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget de espejo que muestra la imagen en directo de la cámara, con vista a pantalla completa expandible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget miroir affichant le flux de la caméra en direct, avec une vue plein écran extensible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget Specchio che mostra il feed della fotocamera in tempo reale, con vista a schermo intero espandibile."
          }
        },
        "ja": {
