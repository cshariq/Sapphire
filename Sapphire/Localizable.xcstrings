    "Clean as soon as a link is copied. Turn off to only clean from the picker.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigt, sobald ein Link kopiert wird. Deaktivieren Sie dies, um nur über die Auswahl zu bereinigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean as soon as a link is copied. Turn off to only clean from the picker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia en cuanto se copia un enlace. Desactívalo para limpiar solo desde el selector."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer dès qu’un lien est copié. Désactivez pour ne nettoyer qu’à partir du sélecteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulisci appena viene copiato un link. Disattiva per pulire solo dal selettore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクをコピーするとすぐにクリーンアップします。オフにすると、ピッカーからのみクリーンアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 복사하는 즉시 정리합니다. 끄면 선택기에서만 정리합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa assim que um link é copiado. Desative para limpar apenas pelo seletor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищать сразу при копировании ссылки. Выключите, чтобы очищать только из выбора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制链接后立即清理。关闭后，仅通过选取面板手动清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝連結後立即清理。關閉後，僅能從選取面板手動清理。"
          }
        }
      }
    },
