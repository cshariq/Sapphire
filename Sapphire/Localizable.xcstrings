          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recouvre le fond d’écran et les icônes du bureau de noir pendant une session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copri lo sfondo scrivania e le icone della scrivania con il nero durante una sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
