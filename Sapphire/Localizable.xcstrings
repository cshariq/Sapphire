    "Reading %@… If nothing appears, allow Sapphire to control %@ in System Settings › Privacy & Security › Automation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird gelesen … Wenn nichts erscheint, erlauben Sie Sapphire unter „Systemeinstellungen“ › „Datenschutz & Sicherheit“ › „Automation“, %@ zu steuern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading %@… If nothing appears, allow Sapphire to control %@ in System Settings › Privacy & Security › Automation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyendo %@… Si no aparece nada, permite que Sapphire controle %@ en Ajustes del Sistema › Privacidad y seguridad › Automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture de %@… Si rien n’apparaît, autorisez Sapphire à contrôler %@ dans Réglages Système › Confidentialité et sécurité › Automatisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettura di %@… Se non compare nulla, consenti a Sapphire di controllare %@ in Impostazioni di Sistema › Privacy e sicurezza › Automazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を読み込み中… 何も表示されない場合は、“システム設定”›“プライバシーとセキュリティ”›“オートメーション”で、Sapphireに%2$@の制御を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 읽는 중… 아무것도 나타나지 않으면 시스템 설정 › 개인정보 보호 및 보안 › 자동화에서 Sapphire가 %@을(를) 제어하도록 허용하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lendo %@… Se nada aparecer, permita que o Sapphire controle %@ em Ajustes do Sistema › Privacidade e Segurança › Automação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтение %@… Если ничего не появляется, разрешите Sapphire управлять %@ в «Системные настройки» › «Конфиденциальность и безопасность» › «Автоматизация»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取 %@… 如果没有显示内容，请在“系统设置”›“隐私与安全性”›“自动化”中允许 Sapphire 控制 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在讀取 %@… 如果沒有顯示內容，請在「系統設定」›「隱私權與安全性」›「自動化」中允許 Sapphire 控制 %@。"
          }
        }
      }
    },
