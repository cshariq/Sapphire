    "GitHub rate-limited update checks. Retrying %@.": {
      "comment": "Settings dynamic interpolated presentation; key and placeholder types verified against module-build-01 compiler output.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat die Update-Suche begrenzt. Neuer Versuch %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub rate-limited update checks. Retrying %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ha limitado las comprobaciones de actualizaciones. Reintentando %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a limité le débit des recherches de mises à jour. Nouvel essai %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ha limitato i controlli degli aggiornamenti. Nuovo tentativo %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubがアップデートの確認を制限しました。%@後に再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 업데이트 확인 속도를 제한했습니다. %@에 다시 시도합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub limitou as verificações de atualização. Tentando novamente %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ограничил частоту проверок обновлений. Повтор: %@."
