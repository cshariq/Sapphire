    "Shove the pointer against a screen edge; push harder and it hands the keyboard and cursor to the phone. Shove back to return.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schieben Sie den Zeiger gegen einen Bildschirmrand; schieben Sie stärker, und er übergibt Tastatur und Cursor an das Smartphone. Schieben Sie zurück, um zurückzukehren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shove the pointer against a screen edge; push harder and it hands the keyboard and cursor to the phone. Shove back to return."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja el puntero contra el borde de la pantalla; si empujas más fuerte, entrega el teclado y el cursor al teléfono. Empuja hacia atrás para volver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poussez le pointeur contre le bord de l’écran ; poussez plus fort et il transmet le clavier et le curseur au téléphone. Repoussez pour revenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spingi il puntatore contro il bordo dello schermo; spingi più forte e passa tastiera e cursore al telefono. Spingi indietro per tornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタを画面の端に押し当て、さらに強く押すと、キーボードとカーソルがスマートフォンに引き渡されます。押し戻すと戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터를 화면 가장자리에 밀어붙이십시오. 더 세게 밀면 키보드와 커서가 휴대전화로 넘어갑니다. 다시 밀면 돌아옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurre o ponteiro contra a borda da tela; empurre com mais força e ele passa o teclado e o cursor ao celular. Empurre de volta para retornar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прижмите указатель к краю экрана; нажмите сильнее — и клавиатура с курсором перейдут на телефон. Прижмите в обратную сторону, чтобы вернуться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针推向屏幕边缘，再继续推即可将键盘和光标输入切换到手机。反向推回即可返回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將游標推向螢幕邊緣，再繼續推即可將鍵盤與游標輸入切換到手機。反向推回即可返回。"
          }
        }
      }
    },
