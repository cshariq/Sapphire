    "Always visible. Keeps the last song after playback stops, or shows a button to open your music app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer sichtbar. Behält den letzten Song, nachdem die Wiedergabe stoppt, oder zeigt eine Taste zum Öffnen Ihrer Musik-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always visible. Keeps the last song after playback stops, or shows a button to open your music app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre visible. Conserva la última canción cuando se detiene la reproducción o muestra un botón para abrir tu app de música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours visible. Conserve le dernier morceau après l’arrêt de la lecture, ou affiche un bouton pour ouvrir votre app de musique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre visibile. Mantiene l'ultimo brano dopo l'arresto della riproduzione o mostra un pulsante per aprire l'app musicale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に表示されます。再生が停止したあとは最後の曲を保持するか、ミュージックAppを開くボタンを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 표시됩니다. 재생이 중지된 후에도 마지막 노래를 유지하거나 음악 앱을 여는 버튼을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre visível. Mantém a última música depois que a reprodução para ou mostra um botão para abrir seu app de música."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда видно. Сохраняет последнюю песню после остановки воспроизведения или показывает кнопку открытия музыкального приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终可见。播放停止后保留上一首歌曲，或显示用于打开音乐 App 的按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一律可見。播放停止後保留上一首歌曲，或顯示用於開啟音樂 App 的按鈕。"
          }
        }
      }
    },
