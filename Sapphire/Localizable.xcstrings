    "Never include Sapphire in screen sharing, screenshots, or screen recordings.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire niemals in Bildschirmfreigabe, Bildschirmfotos oder Bildschirmaufnahmen einbeziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never include Sapphire in screen sharing, screenshots, or screen recordings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No incluir nunca Sapphire al compartir pantalla, en capturas de pantalla ni en grabaciones de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais inclure Sapphire dans le partage d’écran, les captures d’écran ou les enregistrements d’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non includere mai Sapphire nella condivisione dello schermo, negli screenshot o nelle registrazioni dello schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面共有、スクリーンショット、画面収録にSapphireを含めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire를 화면 공유, 스크린샷 또는 화면 기록에 포함하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
