    "NSLocationWhenInUseUsageDescription": {
      "comment": "System permission purpose. Preserve the permission meaning and Sapphire/Blip product names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip verwendet Ihren Standort für das lokale Wetter, Orte in der Nähe und standortbezogene Aufgaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip uses your location for local weather, nearby places, and location-aware tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip usa tu ubicación para el tiempo local, lugares cercanos y tareas que dependen de la ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip utilise votre position pour la météo locale, les lieux à proximité et les tâches liées à la localisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip usa la tua posizione per il meteo locale, i luoghi vicini e le attività basate sulla posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Blipは、現地の天気、近くの場所、位置情報に基づくタスクのために位置情報を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip은 현지 날씨, 근처 장소 및 위치 기반 작업에 사용자의 위치를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blip usa sua localização para o clima local, lugares próximos e tarefas baseadas em localização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip использует вашу геопозицию для местной погоды, ближайших мест и задач с учётом местоположения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
