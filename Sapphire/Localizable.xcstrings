        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何位置按下此快捷键，即可开始或暂停专注时段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何地方按下此快速鍵即可開始或暫停專注時段。"
          }
        }
      }
    },
