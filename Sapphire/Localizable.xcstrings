    "Copy a file on either device and paste it on the other. Files over 32 MB use file transfer instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren Sie eine Datei auf einem der Geräte und fügen Sie sie auf dem anderen ein. Dateien über 32 MB verwenden stattdessen die Dateiübertragung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy a file on either device and paste it on the other. Files over 32 MB use file transfer instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia un archivo en cualquiera de los dos dispositivos y pégalo en el otro. Los archivos de más de 32 MB usan la transferencia de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez un fichier sur l’un des appareils et collez-le sur l’autre. Les fichiers de plus de 32 Mo utilisent le transfert de fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia un file su uno dei due dispositivi e incollalo sull'altro. I file oltre 32 MB usano invece il trasferimento file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらかのデバイスでファイルをコピーして、もう一方でペーストします。32 MBを超えるファイルには、代わりにファイル転送が使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 기기에서 파일을 복사하여 다른 기기에 붙여넣으십시오. 32MB를 초과하는 파일은 대신 파일 전송을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie um arquivo em um dos dispositivos e cole no outro. Arquivos acima de 32 MB usam a transferência de arquivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте файл на одном устройстве и вставьте на другом. Файлы больше 32 МБ передаются через передачу файлов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任一设备上复制文件，即可在另一台设备上粘贴。超过 32 MB 的文件会改用文件传输。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任一裝置上拷貝檔案，即可在另一部裝置上貼上。超過 32 MB 的檔案會改用檔案傳輸。"
          }
        }
      }
    },
