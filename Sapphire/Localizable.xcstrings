    "No paired devices. Install Sapphire Continuity on your Android phone (currently testers only; iOS is coming soon) and tap Pair.": {
      "comment": "A description of the user's devices if they have none.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine gekoppelten Geräte. Installieren Sie Sapphire Continuity auf Ihrem Android-Smartphone (derzeit nur für Tester; iOS folgt in Kürze) und tippen Sie auf „Koppeln“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No paired devices. Install Sapphire Continuity on your Android phone (currently testers only; iOS is coming soon) and tap Pair."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay dispositivos emparejados. Instala Sapphire Continuity en tu teléfono Android (por ahora solo para probadores; iOS llegará pronto) y toca Emparejar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appareil associé. Installez Sapphire Continuity sur votre téléphone Android (actuellement réservé aux testeurs ; iOS arrive bientôt) et touchez Associer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dispositivo associato. Installa Sapphire Continuity sul tuo telefono Android (al momento solo per tester; iOS arriverà presto) e tocca Associa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのデバイスはありません。AndroidスマートフォンにSapphire Continuityをインストールして(現在はテスターのみ。iOSは近日公開)、“ペアリング”をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 기기가 없습니다. Android 휴대전화에 Sapphire Continuity를 설치하고(현재 테스터 전용이며 iOS는 출시 예정) 페어링을 탭하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum dispositivo pareado. Instale o Sapphire Continuity no seu celular Android (atualmente só para testadores; o iOS chegará em breve) e toque em Parear."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет парных устройств. Установите Sapphire Continuity на телефон Android (пока только для тестировщиков; iOS скоро появится) и нажмите «Связать»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已配对的设备。请在你的 Android 手机上安装 Sapphire 连续互通（目前仅限测试人员；iOS 版即将推出），然后点按“配对”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已配對的裝置。請在你的 Android 手機上安裝 Sapphire 接續互通（目前僅限測試人員；iOS 版即將推出），然後點按「配對」。"
          }
        }
      }
    },
    "No password set yet. Set one in Authentication settings to enable password fallback.": {
      "comment": "A warning displayed below the Touch ID toggle in the App Lock settings.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Passwort festgelegt. Legen Sie in den Authentifizierungseinstellungen eines fest, um den Passwort-Fallback zu aktivieren."
          }
        },
        "en": {
