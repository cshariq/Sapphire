    "Cover the desktop wallpaper and icons with black for the duration of the session.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibtischhintergrundbild und Symbole für die Dauer der Sitzung schwarz abdecken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover the desktop wallpaper and icons with black for the duration of the session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubre de negro el fondo de pantalla y los iconos del escritorio mientras dure la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recouvrir de noir le fond d’écran et les icônes du bureau pendant la durée de la session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copri lo sfondo scrivania e le icone con il nero per tutta la durata della sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの間、デスクトップの壁紙とアイコンを黒で覆います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 진행되는 동안 데스크탑 배경화면과 아이콘을 검은색으로 덮습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobre o papel de parede e os ícones da mesa com preto durante a sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрывать обои и значки рабочего стола чёрным на время сеанса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注时段内以黑色覆盖桌面壁纸和图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在專注時段期間以黑色覆蓋桌面背景圖片和圖像。"
          }
        }
      }
    },
    "Cover the wallpaper and desktop icons with black during a session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedeckt Hintergrundbild und Schreibtischsymbole während einer Sitzung mit Schwarz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
