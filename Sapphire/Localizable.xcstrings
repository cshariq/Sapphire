    "Sapphire is running through an application symlink. Move the real app into Applications before updating.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire läuft über einen Programm-Symlink. Bewegen Sie die echte App vor dem Aktualisieren in den Ordner „Programme“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire is running through an application symlink. Move the real app into Applications before updating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire se está ejecutando a través de un enlace simbólico de la aplicación. Mueve la app real a Aplicaciones antes de actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire s’exécute via un lien symbolique d’application. Déplacez la vraie app dans Applications avant de mettre à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire è in esecuzione tramite un link simbolico dell'applicazione. Sposta l'app reale in Applicazioni prima di aggiornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireはアプリケーションのシンボリックリンク経由で実行されています。アップデートする前に、実際のAppをアプリケーションフォルダに移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire가 응용 프로그램 심볼릭 링크를 통해 실행되고 있습니다. 업데이트하기 전에 실제 앱을 응용 프로그램 폴더로 이동하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire está sendo executado por um link simbólico de aplicativo. Mova o app real para Aplicativos antes de atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire запущен через символическую ссылку на приложение. Перед обновлением переместите настоящее приложение в «Программы»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 正通过应用符号链接运行。请先将实际应用移到“应用程序”文件夹再更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
