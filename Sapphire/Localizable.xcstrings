    "⌃⌥Space shows everything, ⌃⌥↑↓ step out and in, ⌃⌥←→ move between spaces, ⌃⌥[ ] go back and forward.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥Leertaste zeigt alles, ⌃⌥↑↓ gehen heraus und hinein, ⌃⌥←→ wechseln zwischen Spaces, ⌃⌥[ ] gehen zurück und vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥Space shows everything, ⌃⌥↑↓ step out and in, ⌃⌥←→ move between spaces, ⌃⌥[ ] go back and forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥Espacio muestra todo, ⌃⌥↑↓ sale y entra de nivel, ⌃⌥←→ se mueve entre espacios, ⌃⌥[ ] van atrás y adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥Espace affiche tout, ⌃⌥↑↓ montent et descendent d’un niveau, ⌃⌥←→ passent d’un espace à l’autre, ⌃⌥[ ] reculent et avancent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥Spazio mostra tutto, ⌃⌥↑↓ escono ed entrano, ⌃⌥←→ si spostano tra gli spazi, ⌃⌥[ ] vanno indietro e avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥Spaceですべてを表示、⌃⌥↑↓で1段階外へ/中へ、⌃⌥←→でスペース間を移動、⌃⌥[ ]で戻る/進む。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥Space는 모두 표시, ⌃⌥↑↓는 나가기/들어가기, ⌃⌥←→는 스페이스 간 이동, ⌃⌥[ ]는 뒤로/앞으로입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥Espaço mostra tudo, ⌃⌥↑↓ sobem e descem de nível, ⌃⌥←→ movem entre espaços, ⌃⌥[ ] voltam e avançam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥Пробел показывает всё, ⌃⌥↑↓ — выход и вход по уровням, ⌃⌥←→ — переход между пространствами, ⌃⌥[ ] — назад и вперёд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥空格键显示全部内容，⌃⌥↑↓ 退出和进入一级，⌃⌥←→ 在空间之间移动，⌃⌥[ ] 后退和前进。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥空白鍵顯示全部內容，⌃⌥↑↓ 退出和進入一層，⌃⌥←→ 在空間之間移動，⌃⌥[ ] 上一頁和下一頁。"
          }
        }
      }
    },
