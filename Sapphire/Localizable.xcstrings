          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué apps pueden mostrar notificaciones y cuáles pueden ejecutar actividades en directo en la muesca. Las apps nuevas siguen los valores predeterminados anteriores."
          }
        },
        "fr": {
          "stringUnit": {
