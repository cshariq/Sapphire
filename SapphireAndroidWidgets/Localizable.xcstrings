    "Adding from your phone — allow it there if asked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding from your phone — allow it there if asked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在从手机添加；如有提示，请在手机上允许"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在從手機加入；如有提示，請在手機上允許"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird von Ihrem Smartphone hinzugefügt – erlauben Sie es dort, falls Sie gefragt werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadiendo desde tu teléfono: permítelo allí si se te pide"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajout depuis votre téléphone — autorisez-le là-bas si on vous le demande"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunta dal telefono: consentila lì se richiesto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンから追加中 — 求められたら、スマートフォンで許可してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화에서 추가하는 중입니다. 요청되면 휴대전화에서 허용하십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionando do seu celular — permita lá, se solicitado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавление с телефона — разрешите это на телефоне, если потребуется"
          }
        }
      }
    },
    "All the widgets from your Android phone that are on your Mac, together.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All the widgets from your Android phone that are on your Mac, together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "集中显示已添加到 Mac 上的 Android 手机小组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "集中顯示已加入 Mac 的 Android 手機小工具。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Widgets Ihres Android-Smartphones, die sich auf Ihrem Mac befinden, zusammen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los widgets de tu teléfono Android que están en tu Mac, juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les widgets de votre téléphone Android présents sur votre Mac, réunis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti insieme, i widget del telefono Android presenti sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacにあるAndroidスマートフォンのウィジェットをすべてまとめて表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 있는 Android 휴대전화의 모든 위젯을 한곳에 모았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os widgets do seu celular Android que estão no seu Mac, juntos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все виджеты вашего телефона Android, которые есть на вашем Mac, вместе."
          }
        }
      }
    },
