      }
    },
    "Posts a notification as each stage happens — app detected, content read, offer sent, offer received, pill shown — so you can see where handoff stops. For troubleshooting; leave off in normal use.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts a notification as each stage happens — app detected, content read, offer sent, offer received, pill shown — so you can see where handoff stops. For troubleshooting; leave off in normal use."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個階段都會傳送通知，包括偵測到 App、讀取內容、傳送接力建議、收到建議及顯示膠囊提示，協助你判斷接力在哪一步停止。僅供疑難排解，正常使用時請關閉。"
          }
        }
      }
