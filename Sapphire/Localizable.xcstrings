    "Allow switching Dock presets and keep preset hotkeys registered": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wechseln von Dock-Presets erlauben und Preset-Tastenkurzbefehle registriert lassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow switching Dock presets and keep preset hotkeys registered"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite cambiar entre presets del Dock y mantiene registrados los atajos de los presets"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le changement de préréglages du Dock et conserver les raccourcis clavier des préréglages enregistrés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti il cambio dei preset del Dock e mantieni registrate le scorciatoie dei preset"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockプリセットの切り替えを許可し、プリセットのホットキーを登録したままにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 프리셋 전환을 허용하고 프리셋 단축키를 계속 등록합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir a troca de predefinições do Dock e manter os atalhos de predefinição registrados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить переключение пресетов Dock и сохранять регистрацию горячих клавиш пресетов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许切换程序坞预设，并保持预设热键可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許切換 Dock 預設組合，並保持預設組合快速鍵可用"
          }
        }
      }
    },
    "Allow the global shortcut to open the clipboard panel anywhere.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt dem globalen Tastenkurzbefehl, das Zwischenablage-Fenster überall zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the global shortcut to open the clipboard panel anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el atajo global abra el panel del portapapeles desde cualquier lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
