    "Turn on Universal Control to choose how it drives the phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Universal Control, um zu wählen, wie es das Smartphone steuert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Universal Control to choose how it drives the phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Control universal para elegir cómo controla el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le Contrôle universel pour choisir comment il pilote le téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Universal Control per scegliere come controlla il telefono."
          }
        },
        "ja": {
