    "Skipped a mounted volume. Scan that volume directly to include it.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gemountetes Volume wurde übersprungen. Scannen Sie dieses Volume direkt, um es einzubeziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped a mounted volume. Scan that volume directly to include it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha omitido un volumen montado. Analiza ese volumen directamente para incluirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un volume monté a été ignoré. Analysez ce volume directement pour l’inclure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un volume montato è stato saltato. Scansiona direttamente quel volume per includerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウントされたボリュームをスキップしました。含めるには、そのボリュームを直接スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마운트된 볼륨을 건너뛰었습니다. 포함하려면 해당 볼륨을 직접 스캔하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um volume montado foi ignorado. Analise esse volume diretamente para incluí-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смонтированный том пропущен. Просканируйте этот том напрямую, чтобы включить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过一个已挂载宗卷。若要包含它，请直接扫描该宗卷。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已略過一個已裝載的卷宗。若要包含該卷宗，請直接掃描它。"
          }
        }
      }
    },
