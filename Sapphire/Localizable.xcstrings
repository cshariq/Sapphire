    "Automatic: the spacer grows with the bar but is never narrower than the notch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch: Der Platzhalter wächst mit der Leiste, ist aber nie schmaler als die Notch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic: the spacer grows with the bar but is never narrower than the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático: el espaciador crece con la barra, pero nunca es más estrecho que la muesca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique : l’espaceur s’agrandit avec la barre, mais n’est jamais plus étroit que l’encoche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatico: lo spaziatore cresce con la barra ma non è mai più stretto del notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動: スペーサーはバーとともに広がりますが、ノッチより狭くなることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동: 스페이서가 막대와 함께 늘어나지만 노치보다 좁아지지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático: o espaçador cresce com a barra, mas nunca fica mais estreito que o entalhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически: разделитель растёт вместе с панелью, но никогда не уже выреза."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动：间隔会随栏宽增长，但不会窄于刘海。"
          }
        },
        "zh-Hant": {
