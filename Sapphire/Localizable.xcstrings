            "value": "Solange Sie in einem Meeting sind. Stummschaltung, Video und Freigabe folgen dem eigenen Zustand von Zoom."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you're in a meeting. Mute, video and sharing follow Zoom's own state."
