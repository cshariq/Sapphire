    "Drops the speakers to a safe level when headphones go away, and puts their volume back when the headphones return.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkt die Lautsprecher auf eine sichere Lautstärke, wenn Kopfhörer entfernt werden, und stellt die Lautstärke wieder her, wenn die Kopfhörer zurückkehren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drops the speakers to a safe level when headphones go away, and puts their volume back when the headphones return."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja los altavoces a un nivel seguro cuando se desconectan los auriculares y restablece su volumen cuando vuelven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramène les haut-parleurs à un niveau sûr lorsque le casque est retiré, et rétablit leur volume lorsqu’il revient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa gli altoparlanti a un livello sicuro quando le cuffie vengono scollegate e ripristina il loro volume quando tornano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッドフォンが外れたらスピーカーの音量を安全なレベルに下げ、ヘッドフォンが戻ったら元の音量に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤드폰을 분리하면 스피커를 안전한 레벨로 낮추고, 헤드폰을 다시 연결하면 볼륨을 되돌립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz os alto-falantes a um nível seguro quando os fones de ouvido são removidos e restaura o volume quando eles voltam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снижает громкость колонок до безопасного уровня, когда наушники отключаются, и возвращает прежнюю громкость, когда наушники возвращаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耳机断开时，将扬声器音量降到安全水平；耳机重新连接时恢复扬声器原有音量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "耳機中斷連線時，將揚聲器音量降至安全程度；耳機重新連接時恢復揚聲器原有音量。"
          }
        }
      }
    },
