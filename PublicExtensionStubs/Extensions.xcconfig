// Extensions.xcconfig
// Sapphire
//
// The camera extension, microphone driver and Continuity share extension targets build these
// placeholders in a public checkout. A full checkout also has the private
// SapphireCameraExtension/, SapphireAudioDriver/ and SapphireShare/ folders, and each one
// carries a Private.xcconfig that points its target at the real sources instead.

SAPPHIRE_CAMERA_INFOPLIST_FILE = PublicExtensionStubs/Camera/Info.plist
SAPPHIRE_CAMERA_ENTITLEMENTS =
SAPPHIRE_CAMERA_EXCLUDED_SOURCES = */SapphireCameraExtension/* */Sapphire/Services/Continuity/*

SAPPHIRE_AUDIO_INFOPLIST_FILE = PublicExtensionStubs/AudioDriver/Info.plist
SAPPHIRE_AUDIO_EXCLUDED_SOURCES = */SapphireAudioDriver/*

SAPPHIRE_SHARE_INFOPLIST_FILE = PublicExtensionStubs/Share/Info.plist
SAPPHIRE_SHARE_ENTITLEMENTS =
SAPPHIRE_SHARE_EXCLUDED_SOURCES = */SapphireShare/*

#include? "../SapphireCameraExtension/Private.xcconfig"
#include? "../SapphireAudioDriver/Private.xcconfig"
#include? "../SapphireShare/Private.xcconfig"
