            "state": "translated",
            "value": "Não Fazer Nada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не делать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不执行任何操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不執行任何動作"
          }
        }
      }
    },
    "Do not expand the notch from hover while a transient live activity is showing. Persistent activities, Music, Weather, Stats, and Developer Activity are exempt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notch wird bei Hover nicht erweitert, solange eine vorübergehende Live-Aktivität angezeigt wird. Dauerhafte Aktivitäten, Musik, Wetter, Statistiken und Entwickleraktivität sind ausgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not expand the notch from hover while a transient live activity is showing. Persistent activities, Music, Weather, Stats, and Developer Activity are exempt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No expande la muesca al pasar el cursor mientras se muestra una actividad en directo transitoria. Las actividades persistentes, Música, Tiempo, Estadísticas y Actividad de desarrollo están exentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas étendre l’encoche au survol tant qu’une activité en direct temporaire est affichée. Les activités persistantes, Musique, Météo, Statistiques et l’activité de développement sont exemptées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non espandere il notch al passaggio del puntatore mentre è visibile una Live Activity temporanea. Le attività persistenti, Musica, Meteo, Statistiche e Attività di sviluppo sono escluse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的なライブアクティビティの表示中は、ホバーでノッチを展開しません。常駐アクティビティ、ミュージック、天気、統計、開発アクティビティは対象外です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시적인 라이브 활동이 표시되는 동안에는 마우스를 가져가도 노치를 확장하지 않습니다. 지속 활동, 음악, 날씨, 통계 및 개발자 활동은 예외입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não expande o entalhe ao passar o ponteiro enquanto uma atividade ao vivo temporária está visível. Atividades persistentes, Música, Clima, Estatísticas e Atividade de Desenvolvimento são exceções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не раскрывать вырез при наведении, пока показывается временная live-активность. Постоянные активности, Музыка, Погода, Статистика и Активность разработки исключены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示临时实时活动时，不因悬停而展开刘海区域。常驻活动、音乐、天气、状态统计和开发者活动不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示暫時性即時動態時，不因游標停留而展開瀏海區域。常駐動態、音樂、天氣、狀態統計與開發者動態不受影響。"
          }
        }
      }
    },
    "Do not share this code publicly. It is permanently tied to your Mac's hardware identity.": {
      "comment": "Compiler-extracted static interface text",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie diesen Code nicht öffentlich weiter. Er ist dauerhaft an die Hardwareidentität Ihres Mac gebunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not share this code publicly. It is permanently tied to your Mac's hardware identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No compartas este código públicamente. Está vinculado de forma permanente a la identidad de hardware de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne partagez pas ce code publiquement. Il est lié de façon permanente à l’identité matérielle de votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non condividere pubblicamente questo codice. È legato in modo permanente all'identità hardware del tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードを公開しないでください。Macのハードウェア識別情報に恒久的に紐づいています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드를 공개적으로 공유하지 마십시오. Mac의 하드웨어 ID에 영구적으로 연결되어 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não compartilhe este código publicamente. Ele está permanentemente vinculado à identidade de hardware do seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не делитесь этим кодом публично. Он навсегда привязан к аппаратному идентификатору вашего Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿公开分享此代码。它与 Mac 的硬件身份永久绑定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請勿公開分享此代碼。它與你 Mac 的硬體身分永久綁定。"
          }
        }
      }
    },
