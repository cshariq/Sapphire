            "state": "translated",
            "value": "Déverrouillez votre téléphone pour déverrouiller ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca il telefono per sbloccare questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのロックを解除するには、電話のロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 잠금을 해제하려면 휴대폰 잠금을 해제하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
