    "Locks Face ID and requires your password after this much sustained clear spoof detection (not borderline frames).": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperrt Face ID und verlangt Ihr Passwort nach dieser Dauer anhaltender, eindeutiger Täuschungserkennung (nicht bei Grenzfällen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locks Face ID and requires your password after this much sustained clear spoof detection (not borderline frames)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea Face ID y requiere tu contraseña tras esta duración de detección clara y sostenida de suplantación (no fotogramas dudosos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille Face ID et exige votre mot de passe après cette durée de détection continue et nette d’usurpation (pas d’images ambiguës)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca Face ID e richiede la password dopo questa durata di rilevamento chiaro e continuo di spoofing (non di fotogrammi dubbi)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明確ななりすましの検出(境界線上のフレームではなく)が一定時間続くと、Face IDをロックしてパスワードを要求します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경계선상의 프레임이 아닌 명확한 스푸핑 감지가 이만큼 지속되면 Face ID를 잠그고 암호를 요구합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia o Face ID e exige sua senha após esta quantidade de detecção contínua e clara de falsificação (não de quadros duvidosos)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокирует Face ID и требует пароль после такого длительного устойчивого обнаружения явной подделки (не пограничных кадров)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续明确检测到伪装达到此时长后，锁定 Face ID 并要求输入密码，不计入难以判断的画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持續偵測到明確的偽造攻擊達到此時間長度後（不含邊緣畫格），會鎖定 Face ID 並要求輸入密碼。"
          }
        }
      }
    },
    "Locks Face ID and requires your password when a spoof is clearly detected for this long.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperrt Face ID und verlangt Ihr Passwort, wenn eine Täuschung so lange eindeutig erkannt wird."
          }
        },
        "en": {
          "stringUnit": {
