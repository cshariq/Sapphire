    "Blocks every app except the ones you allow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockiert alle Apps außer den von Ihnen erlaubten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocks every app except the ones you allow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea todas las apps excepto las que permitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque toutes les apps sauf celles que vous autorisez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca tutte le app tranne quelle che consenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可したApp以外のすべてのAppをブロックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용한 앱을 제외한 모든 앱을 차단합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia todos os apps, exceto os que você permitir."
          }
        },
