    },
    "Send anonymous usage events to Google to help improve Sapphire. Disable this to opt out of analytics collection.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Nutzungsereignisse an Google senden, um Sapphire zu verbessern. Deaktivieren Sie dies, um die Analyseerfassung abzulehnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
