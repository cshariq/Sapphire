    "Reveal hidden menu bar items based on battery level, Focus, Wi-Fi network, or a script's exit code, and bind profiles to displays, Spaces, or Focus filters.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blenden Sie ausgeblendete Menüleistenobjekte abhängig von Ladestand, Fokus, WLAN-Netzwerk oder dem Exit-Code eines Skripts ein und binden Sie Profile an Displays, Spaces oder Fokusfilter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveal hidden menu bar items based on battery level, Focus, Wi-Fi network, or a script's exit code, and bind profiles to displays, Spaces, or Focus filters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revela los elementos ocultos de la barra de menús según el nivel de batería, el Foco, la red Wi-Fi o el código de salida de un script, y vincula perfiles a pantallas, Spaces o filtros de Foco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révélez les éléments masqués de la barre des menus selon le niveau de batterie, la concentration, le réseau Wi-Fi ou le code de sortie d’un script, et associez des profils à des écrans, des Spaces ou des filtres de concentration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra gli elementi nascosti della barra dei menu in base al livello della batteria, al Focus, alla rete Wi-Fi o al codice di uscita di uno script, e associa i profili a display, Spaces o filtri Focus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー残量、集中モード、Wi-Fiネットワーク、またはスクリプトの終了コードに応じて、隠れたメニューバー項目を表示します。プロファイルをディスプレイ、Spaces、または集中モードのフィルタに関連付けることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 잔량, 집중 모드, Wi-Fi 네트워크 또는 스크립트의 종료 코드에 따라 숨겨진 메뉴 막대 항목을 표시하고, 프로필을 디스플레이, Spaces 또는 집중 모드 필터에 연결합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revele itens ocultos da barra de menus com base no nível da bateria, no Foco, na rede Wi-Fi ou no código de saída de um script, e vincule perfis a telas, Spaces ou filtros de Foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывайте скрытые элементы строки меню в зависимости от уровня заряда, фокусирования, сети Wi-Fi или кода выхода скрипта, а также привязывайте профили к дисплеям, рабочим столам Spaces или фильтрам фокусирования."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据电量、专注模式、Wi-Fi 网络或脚本退出码显示隐藏的菜单栏项目，并可将方案绑定到显示器、桌面空间或专注模式过滤条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據電池電量、專注模式、Wi-Fi 網路或腳本的結束代碼顯示隱藏的選單列項目，並可將設定組綁定至顯示器、空間或專注模式過濾條件。"
          }
        }
      }
    },
    "Reveal hidden menu bar items when a condition is met — battery level, active Focus, Wi-Fi network, or a script's exit code — and bind profiles to displays, Spaces, or Focus filters.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blenden Sie ausgeblendete Menüleistenobjekte ein, wenn eine Bedingung erfüllt ist – Batteriestand, aktiver Fokus, WLAN-Netzwerk oder Exit-Code eines Skripts – und binden Sie Profile an Displays, Spaces oder Fokus-Filter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveal hidden menu bar items when a condition is met — battery level, active Focus, Wi-Fi network, or a script's exit code — and bind profiles to displays, Spaces, or Focus filters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los elementos ocultos de la barra de menús cuando se cumple una condición (nivel de batería, Foco activo, red Wi-Fi o código de salida de un script) y vincula perfiles a pantallas, Spaces o filtros de Foco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révélez les éléments masqués de la barre des menus lorsqu’une condition est remplie — niveau de batterie, concentration active, réseau Wi-Fi ou code de sortie d’un script — et associez des profils à des écrans, des Spaces ou des filtres de concentration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra gli elementi nascosti della barra dei menu quando si verifica una condizione (livello batteria, Focus attivo, rete Wi-Fi o codice di uscita di uno script) e associa i profili a display, Spaces o filtri Focus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー残量、アクティブな集中モード、Wi-Fiネットワーク、スクリプトの終了コードなどの条件を満たしたときに、非表示のメニューバー項目を表示します。また、プロファイルをディスプレイ、Space、集中モードフィルタに関連付けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 레벨, 활성 집중 모드, Wi-Fi 네트워크 또는 스크립트 종료 코드 같은 조건이 충족되면 숨겨진 메뉴 막대 항목을 표시하고, 프로파일을 디스플레이, Spaces 또는 집중 모드 필터에 연결합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revele itens ocultos da barra de menus quando uma condição for atendida — nível da bateria, Foco ativo, rede Wi-Fi ou código de saída de um script — e vincule perfis a monitores, Spaces ou filtros de Foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывайте скрытые элементы строки меню при выполнении условия — уровень заряда, активное фокусирование, сеть Wi-Fi или код завершения скрипта — и привязывайте профили к дисплеям, рабочим столам или фильтрам фокусирования."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "满足电量、当前专注模式、Wi-Fi 网络或脚本退出码等条件时，显示隐藏的菜单栏项目；还可将方案绑定到显示器、桌面空间或专注模式过滤条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在符合條件時顯示隱藏的選單列項目（電池電量、目前專注模式、Wi-Fi 網路或腳本的結束代碼），並將設定組綁定至顯示器、空間或專注模式過濾條件。"
          }
        }
      }
    },
