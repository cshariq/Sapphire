          "stringUnit": {
            "state": "translated",
            "value": "仅对 Sapphire 的实时电平表应用增益，便于检查削波。其他应用仍接收原始麦克风信号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
