    "Memory pressure is critical — consider closing some apps.": {
      "comment": "Runtime user-facing string",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicherdruck ist kritisch – schließen Sie einige Apps."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory pressure is critical — consider closing some apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La presión de memoria es crítica: considera cerrar algunas apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pression mémoire est critique — envisagez de fermer certaines apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pressione della memoria è critica: valuta di chiudere alcune app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ負荷が危険な状態です。一部のAppを閉じることを検討してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 압력이 심각합니다. 일부 앱을 닫아 보십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pressão da memória está crítica — considere fechar alguns apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагрузка на память критическая — закройте некоторые приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存压力严重，建议关闭部分应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶體壓力嚴重，建議關閉部分 App。"
          }
        }
      }
    },
