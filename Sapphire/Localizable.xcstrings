            "state": "translated",
            "value": "Il server degli aggiornamenti ha reindirizzato a un indirizzo non attendibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートサーバが、信頼できないアドレスにリダイレクトしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 서버가 신뢰할 수 없는 주소로 리디렉션했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de atualização redirecionou para um endereço não confiável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер обновлений перенаправил на ненадёжный адрес."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新服务器重定向到了不受信任的地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新伺服器重新導向至不受信任的位址。"
          }
        }
      }
    },
