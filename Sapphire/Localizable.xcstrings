    "Adaptive tint follows the colors of your wallpaper behind the menu bar. Turn this on to blend its left and right sides instead of using one average color.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die adaptive Tönung folgt den Farben Ihres Hintergrundbilds hinter der Menüleiste. Aktivieren Sie diese Option, um die linke und rechte Seite zu verblenden, statt eine einzelne Durchschnittsfarbe zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptive tint follows the colors of your wallpaper behind the menu bar. Turn this on to blend its left and right sides instead of using one average color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tinte adaptativo sigue los colores de tu fondo de pantalla detrás de la barra de menús. Actívalo para mezclar los lados izquierdo y derecho en lugar de usar un único color promedio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La teinte adaptative suit les couleurs de votre fond d’écran derrière la barre des menus. Activez cette option pour fondre les côtés gauche et droit au lieu d’utiliser une seule couleur moyenne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tinta adattiva segue i colori dello sfondo scrivania dietro la barra dei menu. Attivala per sfumare tra loro il lato sinistro e quello destro invece di usare un solo colore medio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アダプティブティントは、メニューバーの背後にある壁紙の色に合わせます。オンにすると、1つの平均色ではなく左右の色をブレンドします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적응형 색조는 메뉴 막대 뒤에 있는 배경화면의 색상을 따릅니다. 이 옵션을 켜면 하나의 평균 색상 대신 좌우 색상을 혼합합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tom adaptável segue as cores do seu papel de parede atrás da barra de menus. Ative para mesclar os lados esquerdo e direito em vez de usar uma única cor média."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаптивный оттенок следует цветам обоев за строкой меню. Включите, чтобы смешивать цвета левой и правой сторон вместо одного среднего цвета."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自适应色调会跟随菜单栏背后的墙纸颜色。启用后会混合左右两侧的颜色，而非使用单一平均色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自適應色調會跟隨選單列後方的背景圖片顏色。啟用後會混合左右兩側的顏色，而非使用單一平均色。"
          }
        }
      }
    },
    "Adaptive tint follows the colours of your wallpaper behind the menu bar. Turn this on to blend its left and right sides instead of using one average colour.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die adaptive Tönung folgt den Farben Ihres Hintergrundbilds hinter der Menüleiste. Aktivieren Sie dies, um die linke und rechte Seite zu verblenden, anstatt eine Durchschnittsfarbe zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptive tint follows the colours of your wallpaper behind the menu bar. Turn this on to blend its left and right sides instead of using one average colour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tinte adaptable sigue los colores de tu fondo de pantalla detrás de la barra de menús. Actívalo para combinar sus lados izquierdo y derecho en lugar de usar un único color promedio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La teinte adaptative suit les couleurs de votre fond d’écran derrière la barre des menus. Activez cette option pour fondre ses côtés gauche et droit au lieu d’utiliser une seule couleur moyenne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tinta adattiva segue i colori dello sfondo scrivania dietro la barra dei menu. Attivala per fondere i lati sinistro e destro invece di usare un unico colore medio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アダプティブティントは、メニューバーの背後にある壁紙の色に追従します。オンにすると、1つの平均色ではなく左右の色をなじませます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적응형 색조는 메뉴 막대 뒤 배경화면의 색상을 따릅니다. 평균 색상 하나를 사용하는 대신 왼쪽과 오른쪽을 섞으려면 이 옵션을 켜십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tonalidade adaptável segue as cores do seu papel de parede atrás da barra de menus. Ative para mesclar os lados esquerdo e direito em vez de usar uma única cor média."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаптивный оттенок следует цветам обоев за строкой меню. Включите, чтобы смешивать его левую и правую стороны вместо одного среднего цвета."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自适应色调会跟随菜单栏背后的墙纸颜色。启用后会混合左右两侧的颜色，而非使用单一平均色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自適應色調會跟隨選單列後方的背景圖片顏色。啟用後會混合左右兩側的顏色，而非使用單一平均色。"
          }
        }
      }
    },
