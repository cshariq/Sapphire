    "Detection is off. Turn on the notch activity or auto-caffeinate above to start watching.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erkennung ist ausgeschaltet. Aktivieren Sie oben die Notch-Aktivität oder Auto-Caffeinate, um die Überwachung zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detection is off. Turn on the notch activity or auto-caffeinate above to start watching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección está desactivada. Activa la actividad de la muesca o caffeinate automático arriba para empezar a vigilar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection est désactivée. Activez l’activité de l’encoche ou caffeinate automatique ci-dessus pour commencer la surveillance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rilevamento è disattivato. Attiva l'attività nel notch o l'auto-caffeinate qui sopra per iniziare il monitoraggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出がオフです。監視を開始するには、上のノッチアクティビティまたは自動caffeinateをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지가 꺼져 있습니다. 위의 노치 활동 또는 자동 caffeinate를 켜서 감시를 시작하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A detecção está desativada. Ative a atividade do entalhe ou o caffeinate automático acima para começar a monitorar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружение выключено. Включите активность в вырезе или автоматический caffeinate выше, чтобы начать наблюдение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测已关闭。开启上方的刘海活动或自动保持唤醒功能，即可开始检测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測已關閉。開啟上方的瀏海區域即時動態或自動保持喚醒，即可開始偵測。"
          }
        }
      }
    },
