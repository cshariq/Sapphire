    "Queue and discover come from Spotify or Apple Music. Output devices still work from Audio.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warteschlange und Entdecken stammen von Spotify oder Apple Music. Ausgabegeräte funktionieren weiterhin über „Audio“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue and discover come from Spotify or Apple Music. Output devices still work from Audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cola y Descubrir proceden de Spotify o Apple Music. Los dispositivos de salida siguen funcionando desde Audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La file d’attente et la découverte proviennent de Spotify ou d’Apple Music. Les appareils de sortie fonctionnent toujours depuis Audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coda e Scopri provengono da Spotify o Apple Music. I dispositivi di uscita funzionano ancora da Audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューと発見はSpotifyまたはApple Musicから取得します。出力デバイスは引き続きオーディオから操作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열과 탐색은 Spotify 또는 Apple Music에서 가져옵니다. 출력 기기는 오디오에서 계속 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fila e a descoberta vêm do Spotify ou do Apple Music. Os dispositivos de saída continuam funcionando em Áudio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очередь и рекомендации берутся из Spotify или Apple Music. Устройства вывода по-прежнему работают из раздела «Аудио»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队列和发现内容来自 Spotify 或 Apple Music。输出设备仍可在“音频”中使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "佇列和探索內容來自 Spotify 或 Apple Music。輸出裝置仍可在「音訊」中使用。"
          }
        }
      }
    },
