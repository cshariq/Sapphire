          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куда помещать извлечённые файлы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解压后的文件应存放的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解壓縮後的檔案應存放的位置。"
          }
        }
      }
    },
    "Where the Gradient style switches from its first color to its second, in percent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo der Verlaufsstil von seiner ersten zu seiner zweiten Farbe wechselt, in Prozent."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the Gradient style switches from its first color to its second, in percent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde el estilo Degradado pasa de su primer color al segundo, en porcentaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Point où le style Dégradé passe de sa première à sa deuxième couleur, en pourcentage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove lo stile Gradiente passa dal primo al secondo colore, in percentuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラデーションスタイルが1色目から2色目に切り替わる位置(パーセント)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그라디언트 스타일이 첫 번째 색상에서 두 번째 색상으로 전환되는 지점(퍼센트)입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde o estilo Degradê passa da primeira cor para a segunda, em porcentagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где стиль «Градиент» переходит от первого цвета ко второму, в процентах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“渐变”样式从第一种颜色切换到第二种颜色的位置（百分比）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「漸層」樣式從第一種顏色切換到第二種顏色的位置（百分比）。"
          }
        }
      }
    },
    "Where the Gradient style switches from its second color to its third, in percent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo der Verlaufsstil von seiner zweiten zu seiner dritten Farbe wechselt, in Prozent."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the Gradient style switches from its second color to its third, in percent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde el estilo Degradado pasa de su segundo color al tercero, en porcentaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Point où le style Dégradé passe de sa deuxième à sa troisième couleur, en pourcentage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove lo stile Gradiente passa dal secondo al terzo colore, in percentuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラデーションスタイルが2色目から3色目に切り替わる位置(パーセント)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그라디언트 스타일이 두 번째 색상에서 세 번째 색상으로 전환되는 지점(퍼센트)입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde o estilo Degradê passa da segunda cor para a terceira, em porcentagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где стиль «Градиент» переходит от второго цвета к третьему, в процентах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“渐变”样式从第二种颜色切换到第三种颜色的位置（百分比）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「漸層」樣式從第二種顏色切換到第三種顏色的位置（百分比）。"
          }
        }
      }
    },
    "Which live activities still show while an app is full screen, on every display.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Live-Aktivitäten weiterhin angezeigt werden, solange eine App im Vollbildmodus ist, auf jedem Display."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which live activities still show while an app is full screen, on every display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué actividades en directo se siguen mostrando mientras una app está a pantalla completa, en todas las pantallas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelles activités en direct restent affichées lorsqu’une app est en plein écran, sur tous les écrans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quali Live Activity continuano a essere mostrate mentre un'app è a schermo intero, su ogni display."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appがフルスクリーンの間も、すべてのディスプレイで表示されるライブアクティビティ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 디스플레이에서 앱이 전체 화면일 때도 계속 표시되는 라이브 활동입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quais atividades ao vivo continuam sendo exibidas enquanto um app está em tela inteira, em todos os monitores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какие live-активности по-прежнему показываются, пока приложение в полноэкранном режиме, на каждом дисплее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
