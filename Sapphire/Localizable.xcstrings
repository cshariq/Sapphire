      }
    },
    "Add your own Model Context Protocol servers. Blip can list and call their tools.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Ihre eigenen Model-Context-Protocol-Server hinzu. Blip kann deren Tools auflisten und aufrufen."
          }
        },
        "en": {
          "stringUnit": {
