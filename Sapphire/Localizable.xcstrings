    "Only listens for the device's broadcasts. Uses the least energy but reacts slowest.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört nur auf die Signale des Geräts. Verbraucht am wenigsten Energie, reagiert aber am langsamsten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only listens for the device's broadcasts. Uses the least energy but reacts slowest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo escucha las emisiones del dispositivo. Consume menos energía, pero reacciona más despacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute seulement les annonces de l’appareil. Consomme le moins d’énergie, mais réagit le plus lentement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta solo le trasmissioni del dispositivo. Consuma meno energia ma reagisce più lentamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのアドバタイズのみを受信します。消費電力は最小ですが、反応は最も遅くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 브로드캐스트만 수신합니다. 에너지를 가장 적게 사용하지만 반응이 가장 느립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas escuta as transmissões do dispositivo. Usa menos energia, mas reage mais devagar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только принимает сигналы устройства. Расходует меньше всего энергии, но реагирует медленнее всего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅监听设备的广播。耗电最少，但反应最慢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅監聽裝置的廣播。耗電最少，但反應最慢。"
          }
        }
      }
    },
    "Only play video wallpapers while your Mac is plugged in.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videohintergrundbilder nur abspielen, solange Ihr Mac am Strom angeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only play video wallpapers while your Mac is plugged in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce los fondos de vídeo solo cuando tu Mac esté conectado a la corriente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne lire les fonds d’écran vidéo que lorsque votre Mac est branché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduci gli sfondi video solo quando il Mac è collegato all'alimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macが電源に接続されているときのみ、ビデオ壁紙を再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 전원에 연결되어 있을 때만 비디오 배경화면을 재생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz papéis de parede em vídeo somente enquanto o Mac está conectado à energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводить видеообои только при подключённом питании Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 Mac 接通电源时播放视频墙纸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在 Mac 接上電源時播放影片背景圖片。"
          }
        }
      }
    },
    "Only show device icons for external audio devices like AirPods or HomePods.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerätesymbole nur für externe Audiogeräte wie AirPods oder HomePods anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only show device icons for external audio devices like AirPods or HomePods."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra iconos de dispositivo solo para dispositivos de audio externos como AirPods o HomePod."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’afficher les icônes d’appareil que pour les appareils audio externes comme les AirPods ou les HomePod."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le icone dei dispositivi solo per i dispositivi audio esterni come AirPods o HomePod."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPodsやHomePodなどの外部オーディオデバイスにのみ、デバイスアイコンを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods 또는 HomePod 같은 외부 오디오 기기에만 기기 아이콘을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra ícones de dispositivo apenas para dispositivos de áudio externos, como AirPods ou HomePods."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать значки устройств только для внешних аудиоустройств, таких как AirPods или HomePod."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为 AirPods、HomePod 等外接音频设备显示设备图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅針對 AirPods 或 HomePod 等外接音訊裝置顯示裝置圖像。"
          }
        }
      }
    },
    "Only show media from your selected source, ignoring browsers and other apps.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Medien aus der ausgewählten Quelle anzeigen und Browser und andere Apps ignorieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
