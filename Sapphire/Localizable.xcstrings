          }
        }
      }
    },
    "Turns the EQ'd audio down by its biggest boost. Quieter, but the level never moves.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkt das per EQ bearbeitete Audio um seine größte Verstärkung ab. Leiser, aber der Pegel schwankt nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns the EQ'd audio down by its biggest boost. Quieter, but the level never moves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el audio ecualizado según su mayor refuerzo. Más silencioso, pero el nivel nunca varía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisse l’audio égalisé de sa plus grande amplification. Plus faible, mais le niveau ne varie jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa l'audio equalizzato del suo potenziamento maggiore. Più silenzioso, ma il livello non cambia mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EQをかけたオーディオを、最大のブースト分だけ下げます。音は小さくなりますが、レベルは変動しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "EQ가 적용된 오디오를 가장 큰 부스트만큼 낮춥니다. 더 조용하지만 레벨이 변하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz o áudio equalizado pelo maior reforço. Mais baixo, mas o nível nunca varia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снижает громкость звука с эквалайзером на величину наибольшего усиления. Тише, но уровень никогда не меняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将经过均衡的音频降低其最大增强量。更安静，但音量不会变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將經過等化的音訊降低其最大增強量。更安靜，但音量不會變化。"
          }
        }
      }
    },
    "Turns the audio down by the biggest boost and raises the device volume by the same amount, so it stays as loud. The system volume will read higher.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkt das Audio um die größte Verstärkung ab und erhöht die Gerätelautstärke um denselben Betrag, sodass es gleich laut bleibt. Die Systemlautstärke wird höher angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns the audio down by the biggest boost and raises the device volume by the same amount, so it stays as loud. The system volume will read higher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el audio según el mayor refuerzo y sube el volumen del dispositivo en la misma cantidad, para que siga igual de alto. El volumen del sistema aparecerá más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisse l’audio de la plus grande amplification et augmente le volume de l’appareil d’autant, pour qu’il reste aussi fort. Le volume du système s’affichera plus haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa l'audio del potenziamento maggiore e alza il volume del dispositivo della stessa quantità, così resta forte uguale. Il volume di sistema risulterà più alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大のブースト分だけオーディオを下げ、デバイスの音量を同じ分だけ上げるため、音の大きさは保たれます。システムの音量は高く表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 가장 큰 부스트만큼 낮추고 기기 볼륨을 같은 양만큼 높여 같은 크기를 유지합니다. 시스템 볼륨이 더 높게 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz o áudio pelo maior reforço e aumenta o volume do dispositivo na mesma quantidade, para que continue tão alto. O volume do sistema aparecerá mais alto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снижает громкость звука на величину наибольшего усиления и повышает громкость устройства на столько же, так что звук остаётся таким же громким. Системная громкость будет показываться выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将音频降低最大增强量，并将设备音量提高相同的量，因此响度保持不变。系统音量读数会更高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將音訊降低最大增強量，並將裝置音量提高相同的量，因此響度保持不變。系統音量讀數會更高。"
          }
        }
      }
    },
    "Turns the screen to full brightness.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt den Bildschirm auf volle Helligkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns the screen to full brightness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone la pantalla al máximo brillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle l’écran sur la luminosité maximale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta lo schermo alla massima luminosità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を最大の明るさにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 최대 밝기로 설정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa a tela no brilho máximo."
          }
        },
