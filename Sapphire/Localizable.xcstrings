    "Keep your Mac awake while Sapphire's caffeinate mode is active, even with the lid closed.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält Ihren Mac wach, solange der Caffeinate-Modus von Sapphire aktiv ist, auch bei geschlossenem Deckel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your Mac awake while Sapphire's caffeinate mode is active, even with the lid closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu Mac activo mientras el modo caffeinate de Sapphire esté activado, incluso con la tapa cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient votre Mac éveillé tant que le mode caffeinate de Sapphire est actif, même avec le capot fermé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni il Mac attivo mentre la modalità caffeinate di Sapphire è attiva, anche con il coperchio chiuso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireのcaffeinateモードが有効な間は、蓋を閉じていても、Macをスリープさせません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire의 caffeinate 모드가 활성화된 동안에는 덮개를 닫아도 Mac을 깨어 있게 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o Mac ativo enquanto o modo caffeinate do Sapphire está ativo, mesmo com a tampa fechada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не давать Mac засыпать, пока включён режим caffeinate Sapphire, даже при закрытой крышке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 的保持唤醒模式启用时，即使合上屏幕，也让 Mac 保持唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 的保持喚醒模式啟用時，即使闔上螢幕也讓 Mac 保持喚醒。"
          }
        }
      }
    },
    "Keep your Mac awake, clamshell sleep behavior, and lid-angle display controls.": {
      "comment": "SettingsSection.shortDescription",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac wach halten, Clamshell-Ruhezustandsverhalten und Steuerung der Display-Deckelwinkel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your Mac awake, clamshell sleep behavior, and lid-angle display controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu Mac activo, comportamiento de suspensión con pantalla cerrada y controles de pantalla según el ángulo de la tapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez votre Mac éveillé, réglez le comportement de veille en mode clamshell et les commandes d’affichage selon l’angle du capot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni il Mac attivo, comportamento di stop in clamshell e controlli del display in base all'angolo del coperchio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macをスリープさせない設定、クラムシェルスリープの動作、蓋の角度によるディスプレイ制御。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 깨어 있기 유지, 클램셸 잠자기 동작 및 덮개 각도 디스플레이 제어입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter o Mac ativo, comportamento de repouso em clamshell e controles de monitor pelo ângulo da tampa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не давать Mac засыпать, поведение сна при закрытой крышке и управление дисплеем по углу крышки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 Mac 保持唤醒、合盖休眠行为，以及按屏幕开合角度控制显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 Mac 保持喚醒、闔上螢幕的睡眠行為，以及依上蓋角度控制顯示器。"
          }
        }
      }
    },
