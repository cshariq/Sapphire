          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не засыпать, пока Mac подключён к питанию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 接通电源时保持唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 接上電源時保持喚醒。"
          }
        }
      }
    },
    "Stay awake while a monitor is attached. AirPlay and Sidecar displays don't count.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach bleiben, solange ein Monitor angeschlossen ist. AirPlay- und Sidecar-Displays zählen nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay awake while a monitor is attached. AirPlay and Sidecar displays don't count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el Mac activo mientras haya un monitor conectado. Las pantallas AirPlay y Sidecar no cuentan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester éveillé tant qu’un moniteur est connecté. Les écrans AirPlay et Sidecar ne comptent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni attivo finché è collegato un monitor. I display AirPlay e Sidecar non contano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モニタが接続されている間、スリープさせません。AirPlayとSidecarのディスプレイは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모니터가 연결되어 있는 동안 깨어 있도록 유지합니다. AirPlay 및 Sidecar 디스플레이는 포함되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém ativo enquanto um monitor estiver conectado. Monitores AirPlay e Sidecar não contam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не засыпать, пока подключён монитор. Дисплеи AirPlay и Sidecar не учитываются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接显示器时保持唤醒，不包括隔空播放和随航显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接顯示器時保持喚醒，不包括 AirPlay 與並行顯示器。"
