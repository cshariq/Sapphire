    "Another app is playing. Open TIDAL or one of your playlists to switch.": {
      "comment": "A description of the state when another app is playing.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere App spielt gerade. Öffnen Sie TIDAL oder eine Ihrer Playlists, um zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app está reproduciendo. Abre TIDAL o una de tus playlists para cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app est en cours de lecture. Ouvrez TIDAL ou l’une de vos playlists pour basculer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra app è in riproduzione. Apri TIDAL o una delle tue playlist per passare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリが再生中です。切り替えるには TIDAL またはプレイリストを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 재생 중입니다. 전환하려면 TIDAL 또는 플레이리스트를 여십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
