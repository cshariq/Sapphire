    "Re-lock a protected app the moment you switch away from it, so returning requires authentication again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine geschützte App sofort wieder sperren, wenn Sie sie verlassen, sodass für die Rückkehr erneut eine Authentifizierung erforderlich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-lock a protected app the moment you switch away from it, so returning requires authentication again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a bloquear una app protegida en cuanto cambias a otra, de modo que volver requiere autenticarse de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverrouiller une app protégée dès que vous la quittez, afin que son retour exige à nouveau une authentification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca di nuovo un'app protetta non appena passi a un'altra, così per tornare serve di nuovo l'autenticazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護されたAppから切り替えた瞬間に再ロックするため、戻るときにはもう一度認証が必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호된 앱에서 다른 앱으로 전환하면 즉시 다시 잠가 돌아올 때 다시 인증하도록 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia novamente um app protegido assim que você sai dele, para que voltar exija autenticação outra vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировать защищённое приложение снова, как только вы от него переключились, чтобы для возврата снова требовалась аутентификация."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换离开受保护应用时立即重新锁定，返回时需再次认证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換離開受保護的 App 時立即重新鎖定，返回時需再次認證。"
          }
        }
      }
    },
    "Re-lock protected apps after the Mac sleeps and wakes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschützte Apps wieder sperren, nachdem der Mac in den Ruhezustand gewechselt und aufgewacht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-lock protected apps after the Mac sleeps and wakes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a bloquear las apps protegidas después de que el Mac entre en reposo y se reactive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverrouiller les apps protégées après la mise en veille et la reprise du Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca di nuovo le app protette dopo che il Mac va in stop e si riattiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのスリープとスリープ解除のあとに、保護されたAppを再ロックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 잠자기 상태가 되었다가 깨어난 후 보호된 앱을 다시 잠급니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia novamente apps protegidos depois que o Mac entra em repouso e desperta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировать защищённые приложения снова после сна и пробуждения Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 睡眠并唤醒后，重新锁定受保护应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 睡眠並喚醒後，重新鎖定受保護的 App。"
          }
        }
      }
    },
    "Re-lock the protected app after a period of inactivity.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geschützte App nach einer Zeit der Inaktivität wieder sperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-lock the protected app after a period of inactivity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a bloquear la app protegida tras un periodo de inactividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverrouiller l’app protégée après une période d’inactivité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca di nuovo l'app protetta dopo un periodo di inattività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
