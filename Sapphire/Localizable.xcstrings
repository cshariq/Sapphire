    "Publish the phone's mic as a macOS input device, so any app can select it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon des Smartphones als macOS-Eingabegerät bereitstellen, damit jede App es auswählen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publish the phone's mic as a macOS input device, so any app can select it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publica el micrófono del teléfono como dispositivo de entrada de macOS para que cualquier app pueda seleccionarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publier le micro du téléphone comme appareil d’entrée macOS, afin que n’importe quelle app puisse le sélectionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubblica il microfono del telefono come dispositivo di ingresso macOS, così qualsiasi app può selezionarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンのマイクをmacOSの入力デバイスとして公開し、任意のAppで選択できるようにします。"
