    "Off by default — not every long command is worth holding the display on for.": {
      "comment": "Settings interface",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus – nicht jeder lange Befehl ist es wert, das Display eingeschaltet zu halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default — not every long command is worth holding the display on for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto: no todos los comandos largos merecen mantener la pantalla encendida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut — toutes les commandes longues ne justifient pas de garder l’écran allumé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato per impostazione predefinita: non ogni comando lungo vale la pena di tenere acceso il display."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオフです。長いコマンドのすべてでディスプレイをオンにしておく価値があるわけではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 꺼져 있습니다. 긴 명령마다 디스플레이를 켜 둘 가치가 있는 것은 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão — nem todo comando longo vale a pena manter o monitor ligado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено — не каждая долгая команда стоит того, чтобы не давать дисплею погаснуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭，并非所有长时间运行的命令都需要让显示器保持唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設為關閉——並非每個長時間執行的指令都值得讓顯示器保持開啟。"
          }
        }
      }
    },
    "Off expands the moment the trigger completes.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus erweitert sich, sobald der Auslöser abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off expands the moment the trigger completes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado se expande en cuanto se completa el activador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : s’étend dès que le déclencheur se termine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato espande non appena l'attivatore si completa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、トリガが完了した瞬間に展開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 트리거가 완료되는 즉시 확장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado expande assim que o gatilho é concluído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкл.: раскрывается сразу после срабатывания триггера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，触发词输入完成时立即展开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時，觸發字詞輸入完成後會立即展開。"
          }
        }
      }
    },
