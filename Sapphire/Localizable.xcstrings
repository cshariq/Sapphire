        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 커서"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cursor do Sapphire"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсор Sapphire"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 光标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 游標"
          }
        }
      }
    },
    "Sapphire does not permanently delete items that are already in Trash. Review or empty Trash in Finder.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire löscht Objekte, die sich bereits im Papierkorb befinden, nicht endgültig. Prüfen oder leeren Sie den Papierkorb im Finder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire does not permanently delete items that are already in Trash. Review or empty Trash in Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire no elimina de forma permanente los elementos que ya están en la Papelera. Revisa o vacía la Papelera en el Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire ne supprime pas définitivement les éléments déjà dans la corbeille. Examinez ou videz la corbeille dans le Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire non elimina definitivamente gli elementi già nel Cestino. Controlla o svuota il Cestino nel Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireは、すでにゴミ箱にある項目を完全に削除しません。Finderでゴミ箱を確認するか、空にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire는 이미 휴지통에 있는 항목을 영구적으로 삭제하지 않습니다. Finder에서 휴지통을 검토하거나 비우십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire não exclui permanentemente itens que já estão na Lixeira. Revise ou esvazie a Lixeira no Finder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire не удаляет навсегда объекты, уже находящиеся в Корзине. Просмотрите или очистите Корзину в Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 不会永久删除废纸篓中的项目。请在访达中检查或清空废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 不會永久刪除已在垃圾桶中的項目。請在 Finder 中檢查或清空垃圾桶。"
          }
        }
      }
    },
    "Sapphire follows your Mac's preferred languages unless you choose one here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire folgt den bevorzugten Sprachen Ihres Mac, sofern Sie hier keine auswählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire follows your Mac's preferred languages unless you choose one here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire sigue los idiomas preferidos de tu Mac, salvo que elijas uno aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire suit les langues préférées de votre Mac, sauf si vous en choisissez une ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire segue le lingue preferite del Mac, a meno che tu non ne scelga una qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで選択しない限り、SapphireはMacの優先する言語に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 언어를 선택하지 않으면 Sapphire는 Mac의 선호 언어를 따릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire segue os idiomas preferidos do seu Mac, a menos que você escolha um aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire следует предпочитаемым языкам вашего Mac, если вы не выберете язык здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你在此选择一种语言，否则 Sapphire 会遵循你 Mac 的首选语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你在此選擇一種語言，否則 Sapphire 會遵循你 Mac 的偏好語言。"
          }
        }
      }
    },
    "Sapphire hides items with macOS's own menu bar controls only when it is installed in the Applications folder. This copy runs from elsewhere, so it falls back to stretching the divider up to the app menus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire blendet Objekte nur dann mit den eigenen Menüleistensteuerelementen von macOS aus, wenn es im Ordner „Programme“ installiert ist. Diese Kopie läuft von einem anderen Ort und greift daher darauf zurück, den Trenner bis zu den App-Menüs zu strecken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire hides items with macOS's own menu bar controls only when it is installed in the Applications folder. This copy runs from elsewhere, so it falls back to stretching the divider up to the app menus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire oculta elementos con los controles propios de la barra de menús de macOS solo cuando está instalado en la carpeta Aplicaciones. Esta copia se ejecuta desde otro lugar, así que recurre a estirar el divisor hasta los menús de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire ne masque les éléments avec les commandes natives de la barre des menus de macOS que lorsqu’il est installé dans le dossier Applications. Cette copie s’exécute depuis un autre emplacement ; elle se rabat donc sur l’étirement du séparateur jusqu’aux menus de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire nasconde gli elementi con i controlli della barra dei menu di macOS solo quando è installato nella cartella Applicazioni. Questa copia viene eseguita da un'altra posizione, quindi ripiega allungando il divisore fino ai menu delle app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireは、アプリケーションフォルダにインストールされている場合にのみ、macOS標準のメニューバーコントロールで項目を非表示にします。このコピーは別の場所から実行されているため、Appメニューまで区切りを伸ばす方法に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire는 응용 프로그램 폴더에 설치된 경우에만 macOS 자체 메뉴 막대 제어 항목으로 항목을 숨깁니다. 이 사본은 다른 위치에서 실행되므로 구분선을 앱 메뉴까지 늘리는 방식으로 대체합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire oculta itens com os próprios controles da barra de menus do macOS somente quando está instalado na pasta Aplicativos. Esta cópia é executada de outro lugar, então recorre a esticar o divisor até os menus do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire скрывает элементы с помощью собственных элементов управления строкой меню macOS, только если установлен в папку «Программы». Эта копия запущена из другого места, поэтому разделитель растягивается до меню приложений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 只有安装在“应用程序”文件夹中，才能使用 macOS 自带的菜单栏控制来隐藏项目。当前副本从其他位置运行，因此会改为将分隔线延伸到应用菜单处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 只有安裝在「應用程式」檔案夾中，才能使用 macOS 內建的選單列控制來隱藏項目。目前的副本從其他位置執行，因此會改為將分隔線延伸至 App 選單處。"
          }
        }
      }
    },
    "Sapphire is a Connect controller only, audio always plays on the Spotify desktop app or another speaker.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire ist nur ein Connect-Controller; Audio wird immer in der Spotify-Desktop-App oder auf einem anderen Lautsprecher abgespielt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire is a Connect controller only, audio always plays on the Spotify desktop app or another speaker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire es solo un controlador de Connect; el audio siempre se reproduce en la app de escritorio de Spotify o en otro altavoz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire n’est qu’un contrôleur Connect ; l’audio est toujours lu sur l’app de bureau Spotify ou une autre enceinte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire è solo un controller Connect: l'audio viene sempre riprodotto sull'app Spotify per desktop o su un altro altoparlante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SapphireはConnectコントローラのみです。オーディオは常にSpotifyデスクトップアプリまたは別のスピーカーで再生されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire는 Connect 컨트롤러일 뿐이며 오디오는 항상 Spotify 데스크탑 앱 또는 다른 스피커에서 재생됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire é apenas um controlador Connect; o áudio sempre toca no app do Spotify para computador ou em outro alto-falante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire — только контроллер Connect, звук всегда воспроизводится в приложении Spotify для компьютера или на другой колонке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 仅作为 Connect 控制器，音频始终由 Spotify 桌面应用或其他扬声器播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 僅作為 Connect 控制器，音訊一律由 Spotify 桌面 App 或其他揚聲器播放。"
          }
        }
      }
    },
    "Sapphire is not a Spotify speaker. Choose the desktop app or another device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire ist kein Spotify-Lautsprecher. Wählen Sie die Desktop-App oder ein anderes Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire is not a Spotify speaker. Choose the desktop app or another device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire no es un altavoz de Spotify. Elige la app de escritorio u otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire n’est pas une enceinte Spotify. Choisissez l’app de bureau ou un autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire non è un altoparlante Spotify. Scegli l'app desktop o un altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SapphireはSpotifyスピーカーではありません。デスクトップAppまたは別のデバイスを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire는 Spotify 스피커가 아닙니다. 데스크탑 앱 또는 다른 기기를 선택하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire não é um alto-falante do Spotify. Escolha o app para computador ou outro dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire не является колонкой Spotify. Выберите приложение для компьютера или другое устройство."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 不是 Spotify 播放设备。请选择 Spotify 桌面应用或其他设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 不是 Spotify 揚聲器。請選擇桌面 App 或其他裝置。"
          }
        }
      }
    },
