            "state": "translated",
            "value": "Facendo clic sul widget degli appunti si espande la cronologia completa degli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードウィジェットをクリックすると、クリップボード履歴全体に展開されます。"
          }
        },
        "ko": {
          "stringUnit": {
