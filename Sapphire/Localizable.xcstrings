            "value": "Log in to like tracks and skip ads from the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para dar me gusta a canciones y saltar anuncios desde la muesca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour aimer des titres et passer les publicités depuis l’encoche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi per mettere Mi piace ai brani e saltare le pubblicità dal notch."
