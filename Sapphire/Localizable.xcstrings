    "Fan control is in beta. Idle fans at 0 RPM are normal": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lüftersteuerung befindet sich in der Beta-Phase. Stillstehende Lüfter mit 0 U/min sind normal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan control is in beta. Idle fans at 0 RPM are normal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El control de ventiladores está en beta. Es normal que los ventiladores en reposo estén a 0 RPM"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle des ventilateurs est en bêta. Des ventilateurs à 0 tr/min au repos sont normaux"
          }
