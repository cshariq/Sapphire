    "Drop files onto any of your %@ paired Continuity devices from the File Shelf. Offline devices stay visible.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie Dateien aus der Dateiablage auf eines Ihrer %@ gekoppelten Continuity-Geräte ab. Offline-Geräte bleiben sichtbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop files onto any of your %@ paired Continuity devices from the File Shelf. Offline devices stay visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta archivos en cualquiera de tus %@ dispositivos de Continuidad emparejados desde la bandeja de archivos. Los dispositivos sin conexión siguen visibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez des fichiers sur l’un de vos %@ appareils de continuité associés depuis l’étagère de fichiers. Les appareils hors ligne restent visibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia i file su uno dei tuoi %@ dispositivi Continuity associati dal File Shelf. I dispositivi offline restano visibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルシェルフから、ペアリング済みの%@台のContinuityデバイスにファイルをドロップできます。オフラインのデバイスも表示されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 선반에서 페어링된 연속성 기기 %@대에 파일을 드롭하십시오. 오프라인 기기도 계속 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte arquivos em qualquer um dos seus %@ dispositivos Continuity pareados pela Prateleira de Arquivos. Dispositivos offline continuam visíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте файлы с Полки файлов на любое из ваших парных устройств Continuity (%@). Устройства не в сети остаются видимыми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从文件暂存架将文件拖放到已配对的 %@ 台连续互通设备中的任意一台。离线设备仍会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從檔案暫存架將檔案拖放到已配對的 %@ 部接續互通裝置中的任一部。離線裝置仍會顯示。"
          }
        }
      }
    },
