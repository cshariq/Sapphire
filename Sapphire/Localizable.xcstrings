        }
      }
    },
    "Ask about any setting, get suggestions, and change the most-used settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen Sie nach einer beliebigen Einstellung, erhalten Sie Vorschläge und ändern Sie die am häufigsten verwendeten Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about any setting, get suggestions, and change the most-used settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta sobre cualquier ajuste, obtén sugerencias y cambia los ajustes más usados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question sur n’importe quel réglage, obtenez des suggestions et modifiez les réglages les plus utilisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi di qualsiasi impostazione, ricevi suggerimenti e modifica le impostazioni più usate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定について質問したり、提案を受けたり、よく使う設定を変更したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에 대해 질문하고, 제안을 받고, 가장 많이 쓰는 설정을 변경할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte sobre qualquer ajuste, receba sugestões e altere os ajustes mais usados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивайте о любой настройке, получайте советы и меняйте самые используемые настройки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "询问任何设置、获取建议，并调整常用设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詢問任何設定、取得建議，並調整常用設定。"
          }
        }
      }
    },
    "Ask about any setting, get suggestions, or have Sapphire change things for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen Sie nach einer beliebigen Einstellung, erhalten Sie Vorschläge oder lassen Sie Sapphire Dinge für Sie ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about any setting, get suggestions, or have Sapphire change things for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta sobre cualquier ajuste, obtén sugerencias o pide a Sapphire que cambie cosas por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question sur n’importe quel réglage, obtenez des suggestions ou demandez à Sapphire de modifier les choses pour vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi di qualsiasi impostazione, ricevi suggerimenti o fai cambiare le cose a Sapphire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定について質問したり、提案を受けたり、Sapphireに設定を変更してもらったりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에 대해 질문하고, 제안을 받거나, Sapphire가 대신 변경하도록 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte sobre qualquer ajuste, receba sugestões ou peça ao Sapphire para alterar as coisas por você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивайте о любой настройке, получайте советы или поручите Sapphire всё изменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
