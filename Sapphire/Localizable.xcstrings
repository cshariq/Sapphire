    "Stops Face ID scanning when your face isn't recognized for this long.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt das Face ID-Scannen, wenn Ihr Gesicht so lange nicht erkannt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops Face ID scanning when your face isn't recognized for this long."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene el escaneo de Face ID cuando tu rostro no se reconoce durante este tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête l’analyse de Face ID lorsque votre visage n’est pas reconnu pendant cette durée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe la scansione di Face ID quando il tuo volto non viene riconosciuto per questo tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔が一定時間認識されないと、Face IDのスキャンを停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간 동안 얼굴이 인식되지 않으면 Face ID 스캔을 중지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe a leitura do Face ID quando seu rosto não é reconhecido por este tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останавливает сканирование Face ID, если ваше лицо не распознаётся в течение этого времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在指定时间内未识别到你的面容时，停止 Face ID 扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若在這段時間內未辨識出你的臉孔，便停止 Face ID 掃描。"
          }
        }
      }
    },
