        }
      }
    },
    "The lid angle sensor stopped responding. Reconnecting…": {
      "comment": "Runtime user-facing string",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Deckelwinkelsensor antwortet nicht mehr. Verbindung wird wiederhergestellt …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lid angle sensor stopped responding. Reconnecting…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sensor de ángulo de la tapa ha dejado de responder. Reconectando…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le capteur d’angle du capot ne répond plus. Reconnexion…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sensore dell'angolo del coperchio ha smesso di rispondere. Riconnessione…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋の角度センサーが応答しなくなりました。再接続しています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개 각도 센서가 응답을 멈췄습니다. 다시 연결하는 중…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sensor de ângulo da tampa parou de responder. Reconectando…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Датчик угла крышки перестал отвечать. Повторное подключение…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开合角度传感器停止响应，正在重新连接…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開合角度感測器停止回應。正在重新連接…"
          }
        }
      }
    },
    "The lock screen hides key presses from apps without Input Monitoring. Until it's allowed, Face ID won't unlock; type your password instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sperrbildschirm verbirgt Tastenanschläge vor Apps ohne Eingabeüberwachung. Solange sie nicht erlaubt ist, entsperrt Face ID nicht; geben Sie stattdessen Ihr Passwort ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock screen hides key presses from apps without Input Monitoring. Until it's allowed, Face ID won't unlock; type your password instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla bloqueada oculta las pulsaciones de teclas a las apps sin Supervisión de entrada. Hasta que se permita, Face ID no desbloqueará; escribe tu contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran de verrouillage masque les frappes de touches aux apps sans surveillance de l’entrée. Tant qu’elle n’est pas autorisée, Face ID ne déverrouille pas ; saisissez plutôt votre mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La schermata di blocco nasconde la pressione dei tasti alle app senza Monitoraggio input. Finché non viene consentito, Face ID non sblocca; digita invece la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面では、入力監視のないAppからキー入力が隠されます。許可されるまで、Face IDではロックを解除できません。代わりにパスワードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면은 입력 모니터링이 없는 앱에 키 입력을 숨깁니다. 허용하기 전에는 Face ID로 잠금 해제되지 않으므로 암호를 입력하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela bloqueada oculta os pressionamentos de tecla de apps sem Monitoramento de Entrada. Até ser permitido, o Face ID não desbloqueará; digite sua senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран блокировки скрывает нажатия клавиш от приложений без мониторинга ввода. Пока он не разрешён, Face ID не разблокирует; введите пароль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定屏幕会向没有输入监控权限的 App 隐藏按键。在允许之前，面容 ID 无法解锁；请改为键入密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定畫面會向沒有輸入監控權限的 App 隱藏按鍵。在允許之前，Face ID 無法解鎖；請改為輸入密碼。"
          }
        }
      }
    },
    "The most bubbles that show at once. The first two sit on either side of the notch; more line up further out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die maximale Anzahl gleichzeitig angezeigter Blasen. Die ersten beiden sitzen zu beiden Seiten der Notch; weitere reihen sich weiter außen auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most bubbles that show at once. The first two sit on either side of the notch; more line up further out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El máximo de burbujas que se muestran a la vez. Las dos primeras se sitúan a cada lado de la muesca; las demás se alinean más lejos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre maximal de bulles affichées en même temps. Les deux premières se placent de chaque côté de l’encoche ; les suivantes s’alignent plus loin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero massimo di bolle mostrate contemporaneamente. Le prime due stanno ai lati del notch; le altre si dispongono più all'esterno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に表示されるバブルの最大数。最初の2つはノッチの両側に配置され、それ以降はさらに外側に並びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 표시되는 최대 버블 수입니다. 처음 두 개는 노치 양쪽에 위치하고 나머지는 더 바깥쪽에 정렬됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O máximo de bolhas exibidas ao mesmo tempo. As duas primeiras ficam em cada lado do entalhe; as demais se alinham mais longe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наибольшее число одновременно показываемых пузырей. Первые два располагаются по обе стороны выреза; остальные выстраиваются дальше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时显示的气泡数量上限。前两个位于刘海两侧，更多气泡向外排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時顯示的泡泡數量上限。前兩個位於瀏海兩側，更多泡泡向外排列。"
          }
        }
      }
    },
    "The notch is off on this display.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notch ist auf diesem Display ausgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notch is off on this display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La muesca está desactivada en esta pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’encoche est désactivée sur cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il notch è disattivato su questo display."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスプレイではノッチがオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디스플레이에서는 노치가 꺼져 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O entalhe está desativado neste monitor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вырез выключен на этом дисплее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此显示器上的刘海已关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此顯示器上的瀏海已關閉。"
          }
        }
      }
    },
    "The panic key is hidden by default. Authenticate again to hide it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Panikschlüssel ist standardmäßig ausgeblendet. Authentifizieren Sie sich erneut, um ihn auszublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The panic key is hidden by default. Authenticate again to hide it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de pánico está oculta por defecto. Vuelve a autenticarte para ocultarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de panique est masquée par défaut. Authentifiez-vous à nouveau pour la masquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasto di panico è nascosto per impostazione predefinita. Autenticati di nuovo per nasconderlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パニックキーはデフォルトで非表示です。非表示にするには、もう一度認証してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패닉 키는 기본적으로 숨겨져 있습니다. 숨기려면 다시 인증하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de pânico fica oculta por padrão. Autentique-se novamente para ocultá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аварийный ключ по умолчанию скрыт. Пройдите аутентификацию снова, чтобы скрыть его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
