    "Full Galaxy Buds Client controls — ANC, EQ, Seamless, gaming, spatial, touch, fit test, and more — plus Sony headphones.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständige Galaxy-Buds-Client-Steuerung – ANC, EQ, Seamless, Gaming, Spatial, Touch, Sitztest und mehr – plus Sony-Kopfhörer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Galaxy Buds Client controls — ANC, EQ, Seamless, gaming, spatial, touch, fit test, and more — plus Sony headphones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controles completos de Galaxy Buds Client (ANC, ecualizador, Seamless, juegos, espacial, táctil, prueba de ajuste y más), además de auriculares Sony."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commandes complètes de Galaxy Buds Client — ANC, égaliseur, Seamless, jeu, spatial, tactile, test d’ajustement et plus — ainsi que les casques Sony."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlli completi di Galaxy Buds Client — ANC, EQ, Seamless, gaming, spaziale, tocco, test di aderenza e altro — più cuffie Sony."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Galaxy Budsクライアントのフルコントロール — ANC、EQ、Seamless、ゲーム、空間、タッチ、フィットテストなど — に加え、Sonyヘッドフォンにも対応。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 Galaxy Buds 클라이언트 제어(ANC, EQ, Seamless, 게이밍, 공간, 터치, 착용 테스트 등)와 Sony 헤드폰 지원."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controles completos do Galaxy Buds Client — ANC, EQ, Seamless, jogos, espacial, toque, teste de ajuste e mais — além de fones Sony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полное управление Galaxy Buds Client — ANC, эквалайзер, Seamless, игровой режим, пространственный звук, касания, проверка посадки и другое — а также наушники Sony."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整的 Galaxy Buds 客户端控制——ANC、EQ、无缝、游戏、空间音频、触控、佩戴测试等——另支持 Sony 耳机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整的 Galaxy Buds 用戶端控制項——ANC、EQ、無縫、遊戲、空間音訊、觸控、佩戴測試等——另支援 Sony 耳機。"
          }
        }
      }
    },
