          }
        }
      }
    },
    "Customize what happens when you swipe a clipboard row left or right in the full clipboard view.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie fest, was passiert, wenn Sie in der vollständigen Zwischenablageansicht eine Zeile nach links oder rechts streichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize what happens when you swipe a clipboard row left or right in the full clipboard view."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Personaliza lo que ocurre al deslizar una fila del portapapeles hacia la izquierda o la derecha en la vista completa del portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personnalisez ce qui se passe lorsque vous faites glisser une ligne du presse-papiers vers la gauche ou la droite dans la vue complète du presse-papiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizza cosa succede quando scorri a sinistra o a destra una riga degli appunti nella vista completa degli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード全体ビューで、クリップボードの行を左または右にスワイプしたときの動作をカスタマイズします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 클립보드 보기에서 클립보드 행을 왼쪽 또는 오른쪽으로 쓸어 넘길 때의 동작을 사용자화합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalize o que acontece quando você desliza uma linha da área de transferência para a esquerda ou a direita na visualização completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте, что происходит при смахивании строки буфера обмена влево или вправо в полном виде буфера обмена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义在完整剪贴板视图中向左或向右轻扫项目行时的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂在完整剪貼簿檢視中向左或向右滑動剪貼簿列時的動作。"
          }
        }
      }
    },
    "Customize what happens when you swipe a file drop row left or right. Share only applies to File Shelf items.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie fest, was passiert, wenn Sie eine Zeile für abgelegte Dateien nach links oder rechts streichen. „Teilen“ gilt nur für Objekte der Dateiablage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize what happens when you swipe a file drop row left or right. Share only applies to File Shelf items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Personaliza lo que ocurre al deslizar una fila de archivos soltados hacia la izquierda o la derecha. Compartir solo se aplica a los elementos de la bandeja de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personnalisez ce qui se passe lorsque vous faites glisser une ligne de fichier déposé vers la gauche ou la droite. Partager ne s’applique qu’aux éléments de l’étagère de fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizza cosa succede quando scorri a sinistra o a destra una riga di file rilasciati. Condividi si applica solo agli elementi del File Shelf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルドロップの行を左または右にスワイプしたときの動作をカスタマイズします。共有はファイルシェルフの項目にのみ適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 드롭 행을 왼쪽 또는 오른쪽으로 쓸어 넘길 때의 동작을 사용자화합니다. 공유는 파일 선반 항목에만 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalize o que acontece quando você desliza uma linha de arquivo solto para a esquerda ou a direita. Compartilhar se aplica apenas a itens da Prateleira de Arquivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте, что происходит при смахивании строки файла влево или вправо. «Поделиться» относится только к объектам Полки файлов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义在文件投递条目上左右滑动的操作。“共享”仅适用于文件暂存架项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂向左或向右滑動檔案拖放列時的動作。「分享」僅適用於檔案暫存架項目。"
          }
        }
      }
    },
