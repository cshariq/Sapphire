    "The Android app is only available to testers right now. Join the Sapphire Discord to request access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Android-App ist derzeit nur für Tester verfügbar. Treten Sie dem Sapphire-Discord bei, um Zugriff anzufordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Android app is only available to testers right now. Join the Sapphire Discord to request access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app de Android solo está disponible para probadores por ahora. Únete al Discord de Sapphire para solicitar acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app Android n’est disponible que pour les testeurs pour le moment. Rejoignez le Discord de Sapphire pour demander l’accès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app Android è disponibile solo per i tester al momento. Unisciti al Discord di Sapphire per richiedere l'accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android版Appは、現在テスターのみが利用できます。アクセスをリクエストするには、Sapphire Discordに参加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 앱은 현재 테스터에게만 제공됩니다. 접근을 요청하려면 Sapphire Discord에 참여하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app Android está disponível apenas para testadores no momento. Entre no Discord do Sapphire para solicitar acesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение для Android пока доступно только тестировщикам. Присоединитесь к Discord Sapphire, чтобы запросить доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android App 目前仅向测试人员开放。加入 Sapphire Discord 即可申请访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android App 目前僅向測試人員開放。加入 Sapphire Discord 即可申請存取權限。"
          }
        }
      }
    },
    "The CPU has been running at about %@°C for 30 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die CPU läuft seit 30 Sekunden bei etwa %@ °C."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CPU has been running at about %@°C for 30 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La CPU lleva unos %@ °C durante 30 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processeur tourne à environ %@ °C depuis 30 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La CPU è a circa %@°C da 30 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPUが30秒間、約%@°Cで動作しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU가 30초 동안 약 %@°C에서 실행되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A CPU está funcionando a cerca de %@°C há 30 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЦП работает при температуре около %@ °C уже 30 секунд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 已在约 %@°C 的温度下运行了 30 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 已在約 %@°C 的溫度下運作了 30 秒。"
          }
        }
      }
    },
