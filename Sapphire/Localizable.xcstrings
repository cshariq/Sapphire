    "Override default appearance and animation values. This may lead to unexpected behavior.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschreibt Standardwerte für Erscheinungsbild und Animation. Dies kann zu unerwartetem Verhalten führen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Override default appearance and animation values. This may lead to unexpected behavior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye los valores predeterminados de apariencia y animación. Esto puede provocar un comportamiento inesperado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer l’apparence et les valeurs d’animation par défaut. Cela peut provoquer un comportement inattendu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci i valori predefiniti di aspetto e animazione. Questo può portare a comportamenti imprevisti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトの外観とアニメーションの値を上書きします。予期しない動作につながる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 외관과 애니메이션 값을 재정의합니다. 예기치 않은 동작이 발생할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui os valores padrão de aparência e animação. Isso pode causar comportamento inesperado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переопределяет оформление и значения анимации по умолчанию. Это может привести к непредвиденному поведению."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖默认外观和动画参数，可能产生非预期行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覆寫預設的外觀和動畫數值。這可能會導致非預期的行為。"
          }
        }
      }
    },
