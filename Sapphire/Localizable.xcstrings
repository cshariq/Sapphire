    "Mute all system output as the lid closes, then unmute when it opens past the threshold.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die gesamte Systemausgabe stumm, wenn sich der Deckel schließt, und hebt die Stummschaltung auf, wenn er den Schwellenwert überschreitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute all system output as the lid closes, then unmute when it opens past the threshold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencia toda la salida del sistema al cerrar la tapa y deja de silenciarla cuando se abre más allá del umbral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couper tout le son du système à la fermeture du capot, puis le rétablir à l’ouverture au-delà du seuil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenzia tutto l'output di sistema quando il coperchio si chiude, poi riattiva l'audio quando si apre oltre la soglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋を閉じるとシステム出力をすべてミュートし、しきい値を超えて開くとミュートを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫을 때 모든 시스템 출력을 음소거하고 임계값을 넘어 열리면 음소거를 해제합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencia toda a saída do sistema ao fechar a tampa e reativa o som quando ela abre além do limite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключать звук всей системы при закрытии крышки и включать, когда она открывается за порог."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖时将所有系统音频输出静音，屏幕打开超过阈值后取消静音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上蓋闔上時將所有系統輸出靜音，打開超過臨界值後取消靜音。"
          }
        }
      }
    },
