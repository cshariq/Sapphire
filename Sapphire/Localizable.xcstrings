    "Register your app at developer.spotify.com and copy these values here. The redirect URI is: sapphire://callback": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrieren Sie Ihre App unter developer.spotify.com und kopieren Sie diese Werte hierher. Der Redirect-URI lautet: sapphire://callback"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register your app at developer.spotify.com and copy these values here. The redirect URI is: sapphire://callback"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu app en developer.spotify.com y copia aquí estos valores. El URI de redirección es: sapphire://callback"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre app sur developer.spotify.com et copiez ces valeurs ici. L’URI de redirection est : sapphire://callback"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la tua app su developer.spotify.com e copia qui questi valori. L'URI di reindirizzamento è: sapphire://callback"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "developer.spotify.comでAppを登録し、これらの値をここにコピーしてください。リダイレクトURIは次のとおりです: sapphire://callback"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "developer.spotify.com에서 앱을 등록하고 이 값을 여기에 복사하십시오. 리디렉션 URI: sapphire://callback"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre seu app em developer.spotify.com e copie estes valores aqui. O URI de redirecionamento é: sapphire://callback"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарегистрируйте приложение на developer.spotify.com и скопируйте эти значения сюда. URI перенаправления: sapphire://callback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 developer.spotify.com 注册应用，并将这些值复制到此处。重定向 URI 为：sapphire://callback"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 developer.spotify.com 註冊你的 App，並將這些值拷貝到這裡。重新導向 URI 為：sapphire://callback"
          }
        }
      }
    },
