    "Tighter spacing and smaller chrome.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Engere Abstände und kleinere Bedienelemente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tighter spacing and smaller chrome."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaciado más ajustado y marco más pequeño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacement plus serré et éléments d’interface plus petits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaziatura più stretta e interfaccia più piccola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より狭い間隔と、小さなクローム。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 좁은 간격과 더 작은 크롬입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaçamento mais justo e elementos menores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более плотные интервалы и меньший хром."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更紧凑的间距和更小的界面元素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更緊湊的間距和更小的介面元素。"
          }
