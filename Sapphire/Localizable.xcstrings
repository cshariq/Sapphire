          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 全螢幕時，哪些即時動態仍會在所有顯示器上顯示。"
          }
        }
      }
    },
    "Which mouse button acts as the modifier.": {
      "localizations": {
        "de": {
