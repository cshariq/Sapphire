    "Session-style Focus Profiles with timers, app/website blocking, social filters, triggers, and cross-device sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus-Profile im Sitzungsstil mit Timern, App-/Website-Blockierung, Social-Filtern, Auslösern und geräteübergreifender Synchronisierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session-style Focus Profiles with timers, app/website blocking, social filters, triggers, and cross-device sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfiles de foco por sesiones con temporizadores, bloqueo de apps y sitios web, filtros sociales, activadores y sincronización entre dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profils de concentration par sessions avec minuteurs, blocage d’apps et de sites web, filtres de réseaux sociaux, déclencheurs et synchronisation entre appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profili Focus a sessioni con timer, blocco di app/siti web, filtri social, attivatori e sincronizzazione tra dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマー、App/Webサイトのブロック、ソーシャルフィルタ、トリガ、デバイス間同期を備えた、セッション形式の集中プロファイル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이머, 앱/웹사이트 차단, 소셜 필터, 트리거 및 기기 간 동기화가 있는 세션 방식의 집중 프로파일입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfis de Foco em sessões com timers, bloqueio de apps/sites, filtros de redes sociais, gatilhos e sincronização entre dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеансовые профили фокусирования с таймерами, блокировкой приложений и сайтов, социальными фильтрами, триггерами и синхронизацией между устройствами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按时段运行的专注配置方案，支持计时器、App 和网站屏蔽、社交内容过滤、触发条件及跨设备同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依時段執行的專注設定組合，支援計時器、App 和網站封鎖、社群內容過濾、觸發條件及跨裝置同步。"
          }
        }
      }
    },
    "Session-style focus mode with timers, app/website blocking, and session history.": {
      "comment": "SettingsSection.shortDescription",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus-Modus im Sitzungsstil mit Timern, App-/Website-Blockierung und Sitzungsverlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session-style focus mode with timers, app/website blocking, and session history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de foco por sesiones con temporizadores, bloqueo de apps y sitios web, e historial de sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode de concentration par sessions avec minuteurs, blocage d’apps et de sites web et historique des sessions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità focus a sessioni con timer, blocco di app/siti web e cronologia delle sessioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマー、App/Webサイトのブロック、セッション履歴を備えた、セッション形式の集中モード。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이머, 앱/웹사이트 차단 및 세션 기록이 있는 세션 방식의 집중 모드입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de foco em sessões com timers, bloqueio de apps/sites e histórico de sessões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеансовый режим фокусирования с таймерами, блокировкой приложений и сайтов и историей сеансов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用按时段进行的专注模式，支持计时、屏蔽应用与网站，以及历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以時段為單位的專注模式，提供計時器、App／網站封鎖和專注時段記錄。"
          }
        }
      }
    },
