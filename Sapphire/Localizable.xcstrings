    "Pair an Android phone for clipboard, notifications, media, battery, and Instant Hotspot.": {
      "comment": "SettingsSection.shortDescription",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln Sie ein Android-Smartphone für Zwischenablage, Mitteilungen, Medien, Batterie und Instant Hotspot."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair an Android phone for clipboard, notifications, media, battery, and Instant Hotspot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja un teléfono Android para portapapeles, notificaciones, contenido multimedia, batería y Acceso instantáneo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez un téléphone Android pour le presse-papiers, les notifications, les médias, la batterie et le point d’accès instantané."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Associa un telefono Android per appunti, notifiche, contenuti multimediali, batteria e Instant Hotspot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Androidスマートフォンをペアリングして、クリップボード、通知、メディア、バッテリー、Instant Hotspotを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드, 알림, 미디어, 배터리 및 인스턴트 핫스팟을 위해 Android 휴대전화를 페어링합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareie um celular Android para área de transferência, notificações, mídia, bateria e Hotspot Instantâneo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свяжите телефон Android для буфера обмена, уведомлений, медиа, батареи и Instant Hotspot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对安卓手机，同步剪贴板、通知、媒体和电量，并使用即时热点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
