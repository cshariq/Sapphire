    "NSAppleEventsUsageDescription": {
      "comment": "System permission purpose. Preserve the permission meaning and Sapphire/Blip product names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire benötigt Zugriff, um die Wiedergabe zu steuern und Titelinformationen aus Musik und Spotify zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire needs access to control playback and read track information from Music and Spotify."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire necesita acceso para controlar la reproducción y leer la información de las pistas de Música y Spotify."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire a besoin d’un accès pour contrôler la lecture et lire les informations des morceaux de Musique et Spotify."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire richiede l'accesso per controllare la riproduzione e leggere le informazioni sui brani da Musica e Spotify."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireが、ミュージックとSpotifyの再生を制御し、トラック情報を読み取るために、アクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire가 Music과 Spotify에서 재생을 제어하고 트랙 정보를 읽으려면 접근 권한이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire precisa de acesso para controlar a reprodução e ler as informações das faixas do Música e do Spotify."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire нужен доступ для управления воспроизведением и чтения сведений о треках из Музыки и Spotify."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 需要控制 Music 和 Spotify 的播放，并读取歌曲信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 需要取用權限，才能控制「音樂」和 Spotify 的播放並讀取曲目資訊。"
          }
        }
      }
    },
    "NSAppleMusicUsageDescription": {
      "comment": "System permission purpose. Preserve the permission meaning and Sapphire/Blip product names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, um kommende Songs und Playlists in Apple Music anzuzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to show upcming songs and playlists within apple music"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para mostrar las próximas canciones y listas de reproducción en Apple Music"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour afficher les morceaux et listes de lecture à venir dans Apple Music"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato per mostrare i prossimi brani e le playlist in Apple Music"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music内で次の曲とプレイリストを表示するために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music에서 다음 노래와 플레이리스트를 표시하는 데 사용됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para mostrar as próximas músicas e playlists no Apple Music"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для показа предстоящих песен и плейлистов в Apple Music"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在 Apple Music 中显示待播放歌曲和播放列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於在 Apple Music 中顯示即將播放的歌曲和播放列表。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "comment": "System permission purpose. Preserve the permission meaning and Sapphire/Blip product names.",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire hört auf dem Mac auf das Audio Ihrer Musik-App, um Songtexte wortgenau zu timen. Das Audio verlässt Ihren Mac nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire listens to your music app's audio on this Mac to time lyrics word by word. The audio never leaves your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire escucha el audio de tu app de música en este Mac para sincronizar las letras palabra por palabra. El audio nunca sale de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire écoute l’audio de votre app de musique sur ce Mac pour minuter les paroles mot par mot. L’audio ne quitte jamais votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire ascolta l'audio dell'app musicale su questo Mac per temporizzare i testi parola per parola. L'audio non lascia mai il Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireは、このMac上のミュージックAppのオーディオを聴いて、歌詞を単語ごとにタイミング合わせします。オーディオがMacの外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire는 가사를 단어별로 맞추기 위해 이 Mac에서 음악 앱의 오디오를 듣습니다. 오디오는 Mac을 벗어나지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire ouve o áudio do seu app de música neste Mac para sincronizar as letras palavra por palavra. O áudio nunca sai do seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire слушает звук вашего музыкального приложения на этом Mac, чтобы расставить тексты песен по словам. Звук никогда не покидает ваш Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 会在此 Mac 上读取音乐应用的音频，以逐字同步歌词。音频不会离开你的 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 會在這台 Mac 上聆聽你的音樂 App 音訊，以逐字同步歌詞。音訊絕不會離開你的 Mac。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "comment": "System permission purpose. Preserve the permission meaning and Sapphire/Blip product names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire benötigt Bluetooth, um neue Verbindungen und Hinweise bei schwacher Batterie anzuzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire needs bluetooth to show new connections and battery low notifications"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire necesita Bluetooth para mostrar nuevas conexiones y notificaciones de batería baja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire a besoin du Bluetooth pour afficher les nouvelles connexions et les notifications de batterie faible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire richiede il Bluetooth per mostrare le nuove connessioni e le notifiche di batteria scarica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireは、新しい接続とバッテリー残量低下の通知を表示するためにBluetoothを必要とします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire가 새로운 연결과 배터리 부족 알림을 표시하려면 Bluetooth가 필요합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire precisa do Bluetooth para mostrar novas conexões e notificações de bateria fraca"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire нужен Bluetooth, чтобы показывать новые подключения и уведомления о низком заряде батареи"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 需要使用蓝牙来显示新连接和设备低电量通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 使用藍牙顯示裝置連線通知和電池狀態，並提供近距離解鎖。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "System permission purpose. Preserve the permission meaning and Sapphire/Blip product names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire benötigt die Kalenderberechtigung, um anstehende Ereignisse anzuzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire needs calendar permission to show upcoming events"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire necesita el permiso de Calendario para mostrar los próximos eventos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire a besoin de l’autorisation d’accès au calendrier pour afficher les événements à venir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire richiede l'autorizzazione al calendario per mostrare i prossimi eventi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireは、今後のイベントを表示するためにカレンダーの権限を必要とします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire가 예정된 일정을 표시하려면 캘린더 권한이 필요합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire precisa de permissão para o calendário para mostrar os próximos eventos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire нужно разрешение на доступ к календарю, чтобы показывать предстоящие события"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 需要访问日历来显示即将开始的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 需要行事曆權限來顯示即將到來的行程。"
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "comment": "System permission purpose. Preserve the permission meaning and Sapphire/Blip product names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip kann aus Ihren Kalendermustern lernen, um Ihren Zeitplan und Ihre Vorlieben besser zu verstehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip can learn from your calendar patterns to better understand your schedule and preferences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip puede aprender de tus patrones de calendario para entender mejor tu agenda y tus preferencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip peut apprendre de vos habitudes de calendrier pour mieux comprendre votre emploi du temps et vos préférences."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip può apprendere dai modelli del tuo calendario per capire meglio i tuoi impegni e le tue preferenze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Blipは、カレンダーのパターンを学習して、スケジュールや好みをよりよく理解できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip은 캘린더 패턴을 학습하여 일정과 선호도를 더 잘 이해할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blip pode aprender com os padrões do seu calendário para entender melhor sua agenda e suas preferências."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip может изучать ваши календарные привычки, чтобы лучше понимать ваше расписание и предпочтения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Blip 可以根据你的日历安排，更好地理解你的日程和偏好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 使用行事曆取用權限顯示即將到來的行程。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "System permission purpose. Preserve the permission meaning and Sapphire/Blip product names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire verwendet die Kamera für das Spiegel-Widget, damit Sie sich selbst in der Notch sehen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire uses the camera for the Mirror widget so you can see yourself in the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire usa la cámara para el widget Espejo, para que puedas verte en la muesca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire utilise la caméra pour le widget Miroir afin que vous puissiez vous voir dans l’encoche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire usa la fotocamera per il widget Specchio così puoi vederti nel notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireは、ノッチに自分の姿を表示するミラーウィジェットのためにカメラを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire는 노치에서 자신을 볼 수 있도록 미러 위젯에 카메라를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire usa a câmera para o widget Espelho, para que você possa se ver no entalhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire использует камеру для виджета «Зеркало», чтобы вы могли видеть себя в вырезе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 使用摄像头提供镜子小组件，让你能在刘海区域看到自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 使用相機提供「鏡子」小工具，讓你可以在瀏海區域中看到自己。"
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "comment": "System permission purpose. Preserve the permission meaning and Sapphire/Blip product names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire benötigt Zugriff auf Ihre Kontakte, um beim Senden einer Antwort aus einer Mitteilung die richtige Telefonnummer oder E-Mail-Adresse zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire needs access to your contacts to find the correct phone number or email when sending a reply from a notification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire necesita acceso a tus contactos para encontrar el número de teléfono o el correo correctos al enviar una respuesta desde una notificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire a besoin d’accéder à vos contacts pour trouver le bon numéro de téléphone ou la bonne adresse e-mail lors de l’envoi d’une réponse depuis une notification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire richiede l'accesso ai contatti per trovare il numero di telefono o l'email corretti quando invii una risposta da una notifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireは、通知から返信を送信するときに正しい電話番号やメールアドレスを見つけるために、連絡先へのアクセスを必要とします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire가 알림에서 답장을 보낼 때 올바른 전화번호나 이메일을 찾으려면 연락처 접근이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire precisa de acesso aos seus contatos para encontrar o número de telefone ou e-mail correto ao enviar uma resposta de uma notificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire нужен доступ к контактам, чтобы находить нужный номер телефона или адрес электронной почты при отправке ответа из уведомления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 需要访问通讯录，以便在回复通知时找到正确的电话号码或电子邮件地址。"
          }
        },
