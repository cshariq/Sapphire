    "⌘V in Finder turns a copied image into a PNG file in the front folder.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘V im Finder wandelt ein kopiertes Bild in eine PNG-Datei im vordersten Ordner um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘V in Finder turns a copied image into a PNG file in the front folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘V en el Finder convierte una imagen copiada en un archivo PNG en la carpeta frontal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘V dans le Finder transforme une image copiée en fichier PNG dans le dossier au premier plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘V nel Finder trasforma un'immagine copiata in un file PNG nella cartella in primo piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderで⌘Vを押すと、コピーした画像が前面のフォルダにPNGファイルとして保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 ⌘V를 누르면 복사한 이미지가 가장 앞에 있는 폴더에 PNG 파일로 만들어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘V no Finder transforma uma imagem copiada em um arquivo PNG na pasta da frente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘V в Finder превращает скопированное изображение в файл PNG в верхней папке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中按 ⌘V，将已复制的图像保存为当前文件夹中的 PNG 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中按 ⌘V，會將拷貝的影像轉為最前方檔案夾中的 PNG 檔案。"
          }
        }
      }
    },
    "⌘X then ⌘V moves copied files instead of copying them, ⌘V pastes copied images as PNG files into the front Finder folder, and F2 renames the selected item.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X und danach ⌘V bewegt kopierte Dateien, anstatt sie zu kopieren, ⌘V fügt kopierte Bilder als PNG-Dateien in den vordersten Finder-Ordner ein, und F2 benennt das ausgewählte Objekt um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X then ⌘V moves copied files instead of copying them, ⌘V pastes copied images as PNG files into the front Finder folder, and F2 renames the selected item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X y después ⌘V mueve los archivos copiados en lugar de copiarlos, ⌘V pega las imágenes copiadas como archivos PNG en la carpeta frontal del Finder y F2 cambia el nombre del elemento seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X puis ⌘V déplace les fichiers copiés au lieu de les copier, ⌘V colle les images copiées sous forme de fichiers PNG dans le dossier du Finder au premier plan, et F2 renomme l’élément sélectionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X poi ⌘V sposta i file copiati invece di copiarli, ⌘V incolla le immagini copiate come file PNG nella cartella del Finder in primo piano e F2 rinomina l'elemento selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Xのあと⌘Vでコピーせずにファイルを移動し、⌘Vでコピーした画像を前面のFinderフォルダにPNGファイルとしてペーストし、F2で選択した項目の名前を変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X 후 ⌘V를 누르면 복사한 파일이 복사되는 대신 이동되고, ⌘V는 복사한 이미지를 가장 앞에 있는 Finder 폴더에 PNG 파일로 붙여넣으며, F2는 선택한 항목의 이름을 변경합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X e depois ⌘V move os arquivos copiados em vez de copiá-los, ⌘V cola imagens copiadas como arquivos PNG na pasta do Finder da frente, e F2 renomeia o item selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X, затем ⌘V перемещает скопированные файлы вместо копирования, ⌘V вставляет скопированные изображения как файлы PNG в верхнюю папку Finder, а F2 переименовывает выбранный объект."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先按 ⌘X 再按 ⌘V，可移动已复制的文件；按 ⌘V 可将已复制的图像作为 PNG 文件粘贴到当前访达文件夹；按 F2 可重命名所选项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X 再按 ⌘V 會搬移拷貝的檔案而非複製，⌘V 會將拷貝的影像以 PNG 檔案貼至最前方的 Finder 檔案夾，F2 會為所選項目重新命名。"
          }
        }
      }
    },
    "⌘⌥S — instantly dismisses all lock overlays.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⌥S – blendet alle Sperrüberlagerungen sofort aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⌥S — instantly dismisses all lock overlays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⌥S — descarta al instante todas las superposiciones de bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⌥S — ferme instantanément toutes les incrustations de verrouillage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⌥S — chiude subito tutti gli overlay di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⌥S — すべてのロックオーバーレイを即座に閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⌥S — 모든 잠금 오버레이를 즉시 닫습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⌥S — descarta instantaneamente todas as sobreposições de bloqueio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⌥S — мгновенно закрывает все экраны блокировки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⌥S — 立即关闭所有锁定遮罩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⌥S — 立即關閉所有鎖定遮罩。"
          }
        }
      }
    },
