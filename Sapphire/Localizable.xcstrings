    "Runs on-device with Apple Intelligence. Changes apply right away and can be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft auf dem Gerät mit Apple Intelligence. Änderungen werden sofort angewendet und können rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs on-device with Apple Intelligence. Changes apply right away and can be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta en el dispositivo con Apple Intelligence. Los cambios se aplican de inmediato y se pueden deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’exécute sur l’appareil avec Apple Intelligence. Les modifications s’appliquent immédiatement et peuvent être annulées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene eseguito sul dispositivo con Apple Intelligence. Le modifiche si applicano subito e possono essere annullate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceを使って、デバイス上で実行します。変更はすぐに適用され、取り消すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence로 기기 내에서 실행됩니다. 변경 사항은 즉시 적용되며 실행 취소할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa no dispositivo com o Apple Intelligence. As alterações se aplicam imediatamente e podem ser desfeitas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняется на устройстве с помощью Apple Intelligence. Изменения применяются сразу и могут быть отменены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "借助 Apple Intelligence 在设备上运行。更改立即生效，并可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Apple Intelligence 在裝置上執行。更改立即生效，並可還原。"
          }
        }
      }
    },
