    "Tune the notch look, materials, colors, and layout styling.": {
      "comment": "SettingsSection.shortDescription",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie Notch-Look, Materialien, Farben und Layoutgestaltung an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tune the notch look, materials, colors, and layout styling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el aspecto de la muesca, los materiales, los colores y el estilo de la disposición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez l’aspect de l’encoche, les matériaux, les couleurs et le style de la disposition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola aspetto, materiali, colori e stile del layout del notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチの見た目、素材、色、レイアウトのスタイルを調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치의 모양, 재질, 색상 및 레이아웃 스타일을 조정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste a aparência, os materiais, as cores e o estilo do layout do entalhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте внешний вид выреза, материалы, цвета и оформление раскладки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整刘海区域的外观、材质、颜色和布局样式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整瀏海區域的外觀、材質、顏色和佈局樣式。"
          }
        }
      }
    },
