    "Press %@ and draw around anything on your screen.": {
      "comment": "A description of how to use the Circle to Search feature. The argument is the string “%1$arg%2$arg”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie %@ und umkreisen Sie beliebige Inhalte auf Ihrem Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press %@ and draw around anything on your screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa %@ y dibuja alrededor de lo que quieras en la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur %@ et dessinez autour de n’importe quel élément de votre écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi %@ e disegna attorno a qualsiasi cosa sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押して、画面上の任意のものを囲んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 누르고 화면의 아무 곳이나 둘러 그리십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione %@ e desenhe ao redor de qualquer coisa na tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@ и обведите что угодно на экране."
          }
        },
        "zh-Hans": {
