        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 不会永久删除废纸篓中的项目。请在访达中检查或清空废纸篓。"
          }
        }
      }
    },
    "Sapphire is a Connect controller only, audio always plays on the Spotify desktop app or another speaker.": {
      "comment": "Settings interface",
      "localizations": {
        "en": {
          "stringUnit": {
