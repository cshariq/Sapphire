          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a protected location and can only be inspected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una ubicación protegida y solo se puede inspeccionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit d’un emplacement protégé qui ne peut être qu’inspecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è una posizione protetta e può essere solo ispezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは保護された場所で、確認のみ可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호된 위치이며 검사만 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
