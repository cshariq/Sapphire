            "value": "Funktioniert mit oder ohne aktivierten Zwischenablageverlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work with or without clipboard history enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con o sin el historial del portapapeles activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne avec ou sans historique du presse-papiers activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona con o senza la cronologia degli appunti attivata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴が有効でも無効でも動作します。"
