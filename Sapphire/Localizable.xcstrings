    "Scroll play-by-play updates under the score, similar to synced lyrics.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielverlaufs-Updates unter dem Spielstand scrollen lassen, ähnlich wie synchronisierte Songtexte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll play-by-play updates under the score, similar to synced lyrics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplaza las actualizaciones jugada a jugada bajo el marcador, de forma similar a las letras sincronizadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire défiler les mises à jour du match sous le score, comme des paroles synchronisées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri gli aggiornamenti della cronaca sotto il punteggio, in modo simile ai testi sincronizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試合の実況アップデートを、同期された歌詞のようにスコアの下でスクロール表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화된 가사처럼 점수 아래에서 중계 업데이트를 스크롤합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rola as atualizações lance a lance abaixo do placar, de forma semelhante às letras sincronizadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокручивать комментарии к игре под счётом, как синхронизированные тексты песен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在比分下方滚动显示比赛进程，类似同步歌词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在比分下方捲動顯示比賽進程，類似同步歌詞。"
          }
        }
      }
    },
    "Scroll up or swipe in an empty part of the menu bar to show hidden items; scroll down to hide them": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrollen Sie nach oben oder wischen Sie in einem leeren Bereich der Menüleiste, um ausgeblendete Objekte anzuzeigen; scrollen Sie nach unten, um sie auszublenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll up or swipe in an empty part of the menu bar to show hidden items; scroll down to hide them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplázate hacia arriba o desliza en una parte vacía de la barra de menús para mostrar los elementos ocultos; desplázate hacia abajo para ocultarlos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites défiler vers le haut ou balayez dans une zone vide de la barre des menus pour afficher les éléments masqués ; faites défiler vers le bas pour les masquer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri su o fai swipe in una parte vuota della barra dei menu per mostrare gli elementi nascosti; scorri giù per nasconderli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの空いている部分でスクロールアップまたはスワイプすると非表示の項目を表示し、スクロールダウンすると非表示にします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 빈 부분에서 위로 스크롤하거나 스와이프하면 숨겨진 항목이 표시되고, 아래로 스크롤하면 숨겨집니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role para cima ou deslize em uma parte vazia da barra de menus para mostrar os itens ocultos; role para baixo para ocultá-los"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите вверх или смахните вверх на пустом месте строки меню, чтобы показать скрытые элементы; прокрутите вниз, чтобы скрыть их"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏空白处向上滚动或轻扫以显示隐藏项目；向下滚动则隐藏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列空白處向上捲動或滑動以顯示隱藏項目；向下捲動則隱藏"
          }
        }
      }
    },
