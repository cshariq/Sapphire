          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Классический» — это столбчатая волна. «Continuity» — значок из прежней медиа-активности телефона."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“经典”采用条形波形。“Continuity”采用旧版手机媒体活动的图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「經典」採用條形波形。「Continuity」採用舊版手機媒體動態的圖像。"
          }
        }
      }
    },
