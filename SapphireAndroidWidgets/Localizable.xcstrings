{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "comment": "User-supplied Android widget label; preserve verbatim.",
      "shouldTranslate": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "+%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld"
          }
        }
      }
    },
    "Add an Android widget in Sapphire": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an Android widget in Sapphire"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Sapphire 中加入 Android 小工具"
          }
        }
      }
    },
    "Add from your phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add from your phone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從手機加入"
          }
        }
      }
    },
    "Add widgets from your phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add widgets from your phone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從手機加入小工具"
          }
        }
      }
    },
    "Adding from your phone — allow it there if asked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding from your phone — allow it there if asked"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在從手機加入；如有提示，請在手機上允許"
          }
        }
      }
    },
    "All the widgets from your Android phone that are on your Mac, together.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All the widgets from your Android phone that are on your Mac, together."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "集中顯示已加入 Mac 的 Android 手機小工具。"
          }
        }
      }
    },
    "Android Widget": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Widget"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 小工具"
          }
        }
      }
    },
    "Android Widget (choose)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Widget (choose)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 小工具（選擇）"
          }
        }
      }
    },
    "Android Widgets": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Widgets"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 小工具"
          }
        }
      }
    },
    "Android widget": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android widget"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 小工具"
          }
        }
      }
    },
    "Choose a widget mirrored from your paired Android phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a widget mirrored from your paired Android phone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個從已配對 Android 手機鏡像的小工具。"
          }
        }
      }
    },
    "Edit this widget to choose one from your phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit this widget to choose one from your phone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯此小工具，從手機選擇一個"
          }
        }
      }
    },
    "Live widget from your Android phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live widget from your Android phone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 Android 手機的即時小工具。"
          }
        }
      }
    },
    "On your Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your Mac"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上的小工具"
          }
        }
      }
    },
    "Pick any widget from your paired Android phone — choosing one that isn't on your Mac yet adds it from the phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick any widget from your paired Android phone — choosing one that isn't on your Mac yet adds it from the phone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從已配對的 Android 手機選擇任意小工具；若 Mac 上還沒有這個小工具，會從手機加入。"
          }
        }
      }
    },
    "Place a live widget from your paired Android phone on the Mac desktop or in Notification Center.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a live widget from your paired Android phone on the Mac desktop or in Notification Center."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將已配對 Android 手機上的即時小工具放到 Mac 桌面或通知中心。"
          }
        }
      }
    },
    "This widget was removed from your phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This widget was removed from your phone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此小工具已從手機移除"
          }
        }
      }
    },
    "Use “Android Widget (choose)” here, or Widgets on your Mac in the Sapphire phone app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Android Widget (choose)” here, or Widgets on your Mac in the Sapphire phone app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此處的「Android 小工具（選擇）」，或手機 Sapphire App 中的「Mac 上的小工具」。"
          }
        }
      }
    },
    "Waiting for your phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for your phone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待手機連線"
          }
        }
      }
    },
    "Widget": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小工具"
          }
        }
      }
    }
  },
  "version": "1.0"
}
