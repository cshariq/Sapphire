    "Allow Sapphire to adjust scrolling, pointer acceleration, and mouse buttons system-wide.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Sapphire, Scrollen, Zeigerbeschleunigung und Maustasten systemweit anzupassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Sapphire to adjust scrolling, pointer acceleration, and mouse buttons system-wide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Sapphire ajuste el desplazamiento, la aceleración del puntero y los botones del ratón en todo el sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Sapphire à ajuster le défilement, l’accélération du pointeur et les boutons de la souris à l’échelle du système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Sapphire di regolare scorrimento, accelerazione del puntatore e pulsanti del mouse a livello di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireがスクロール、ポインタの加速、マウスボタンをシステム全体で調整することを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire가 시스템 전체에서 스크롤, 포인터 가속 및 마우스 버튼을 조정하도록 허용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o Sapphire ajuste a rolagem, a aceleração do ponteiro e os botões do mouse em todo o sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Sapphire настраивать прокрутку, ускорение указателя и кнопки мыши во всей системе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Sapphire 在整个系统中调整滚动、指针加速和鼠标按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Sapphire 在整個系統中調整捲動、游標加速與滑鼠按鈕。"
          }
        }
      }
    },
    "Allow Sapphire to control the terminal in Privacy & Security › Automation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie Sapphire unter „Datenschutz & Sicherheit“ › „Automation“, das Terminal zu steuern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Sapphire to control the terminal in Privacy & Security › Automation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Sapphire controle la terminal en Privacidad y seguridad › Automatización"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Sapphire à contrôler le terminal dans Confidentialité et sécurité › Automatisation"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Sapphire di controllare il terminale in Privacy e sicurezza › Automazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“プライバシーとセキュリティ”›“オートメーション”でSapphireにターミナルの操作を許可してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호 및 보안 › 자동화에서 Sapphire가 터미널을 제어하도록 허용하십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o Sapphire controle o terminal em Privacidade e Segurança › Automação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Sapphire управлять терминалом в разделе «Конфиденциальность и безопасность» › «Автоматизация»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“隐私与安全性 › 自动化”中允许 Sapphire 控制终端"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「隱私權與安全性 › 自動化」中允許 Sapphire 控制終端機"
          }
        }
      }
    },
    "Allow Sapphire to detect :shortcode: patterns and show emoji suggestions as you type.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Sapphire, :Kurzbefehl:-Muster zu erkennen und beim Tippen Emoji-Vorschläge anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Sapphire to detect :shortcode: patterns and show emoji suggestions as you type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Sapphire detecte patrones :código: y muestre sugerencias de emojis mientras escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Sapphire à détecter les motifs :shortcode: et à afficher des suggestions d’émojis pendant la saisie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Sapphire di rilevare i pattern :shortcode: e mostrare suggerimenti emoji mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中に:ショートコード:のパターンを検出して絵文字の候補を表示することをSapphireに許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire가 :shortcode: 패턴을 감지하고 입력하는 동안 이모지 제안을 표시하도록 허용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o Sapphire detecte padrões :atalho: e mostre sugestões de emoji enquanto você digita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить Sapphire распознавать шаблоны :shortcode: и показывать подсказки эмодзи при вводе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Sapphire 在输入时检测 :shortcode: 格式并显示表情符号建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Sapphire 在輸入時偵測 :shortcode: 格式並顯示表情符號建議。"
          }
        }
      }
    },
    "Allow Sapphire under System Settings → Privacy & Security → Media & Apple Music.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie Sapphire unter „Systemeinstellungen“ → „Datenschutz & Sicherheit“ → „Medien & Apple Music“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Sapphire under System Settings → Privacy & Security → Media & Apple Music."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Sapphire en Ajustes del Sistema → Privacidad y seguridad → Contenido multimedia y Apple Music."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Sapphire dans Réglages Système → Confidentialité et sécurité → Contenu multimédia et Apple Music."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Sapphire in Impostazioni di Sistema → Privacy e sicurezza → Contenuti multimediali e Apple Music."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“システム設定”→“プライバシーとセキュリティ”→“メディアとApple Music”でSapphireを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 미디어 및 Apple Music에서 Sapphire를 허용하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o Sapphire em Ajustes do Sistema → Privacidade e Segurança → Mídia e Apple Music."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Sapphire в разделе «Системные настройки» → «Конфиденциальность и безопасность» → «Медиа и Apple Music»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置 → 隐私与安全性 → 媒体与 Apple Music 中允许 Sapphire 访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定 → 隱私權與安全性 → 媒體與 Apple Music 中允許 Sapphire 存取。"
          }
        }
      }
    },
    "Allow Screen Recording (optional) to see their contents while they move and when they're small. Pictures are taken only when something moves; nothing is recorded or kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie die Bildschirmaufnahme (optional), um deren Inhalt zu sehen, während sie sich bewegen und wenn sie klein sind. Bilder werden nur aufgenommen, wenn sich etwas bewegt; es wird nichts aufgezeichnet oder gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Screen Recording (optional) to see their contents while they move and when they're small. Pictures are taken only when something moves; nothing is recorded or kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite la Grabación de pantalla (opcional) para ver su contenido mientras se mueven y cuando son pequeñas. Las imágenes se toman solo cuando algo se mueve; no se graba ni se conserva nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’enregistrement de l’écran (facultatif) pour voir leur contenu pendant leur déplacement et lorsqu’elles sont petites. Les images ne sont prises que lorsqu’un élément bouge ; rien n’est enregistré ni conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Registrazione schermo (facoltativo) per vedere il contenuto delle finestre mentre si spostano e quando sono piccole. Le immagini vengono acquisite solo quando qualcosa si muove; non viene registrato né conservato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウが移動中や小さいときに内容を表示するために、画面収録を許可してください(オプション)。何かが動いたときにのみ画像を取得し、録画や保持は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 움직이는 동안과 작을 때 내용을 보려면 화면 기록(선택 사항)을 허용하십시오. 사진은 무언가 움직일 때만 촬영되며 아무것도 기록되거나 보관되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a Gravação de Tela (opcional) para ver o conteúdo das janelas enquanto se movem e quando estão pequenas. As imagens são capturadas somente quando algo se move; nada é gravado nem mantido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите запись экрана (необязательно), чтобы видеть содержимое окон, пока они движутся и когда они маленькие. Снимки делаются, только когда что-то движется; ничего не записывается и не хранится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许屏幕录制（可选），即可在窗口移动时以及窗口缩小时查看其内容。仅在有东西移动时才会截取图像；不会录制或保留任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許螢幕錄製（選用），即可在視窗移動時以及視窗縮小時檢視其內容。僅在有東西移動時才會擷取影像；不會錄製或保留任何內容。"
          }
        }
      }
    },
    "Allow access to show artwork, artist profiles and Up Next for Apple Music.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie den Zugriff, um Artwork, Künstlerprofile und „Als Nächstes“ für Apple Music anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to show artwork, artist profiles and Up Next for Apple Music."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso para mostrar carátulas, perfiles de artistas y Siguiente de Apple Music."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès pour afficher les pochettes, les profils d’artistes et la suite pour Apple Music."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso per mostrare copertine, profili degli artisti e Prossimi brani per Apple Music."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Musicのアートワーク、アーティストプロフィール、次の曲を表示するためのアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music의 아트워크, 아티스트 프로필, 다음 순서를 표시하도록 접근을 허용하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso para mostrar capas, perfis de artistas e A Seguir do Apple Music."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ, чтобы показывать обложки, профили исполнителей и очередь воспроизведения Apple Music."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问以显示 Apple Music 的封面、艺人资料和待播清单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許取用以顯示 Apple Music 的封面、藝人資料和待播清單。"
          }
        }
      }
    },
    "Allow any widget to be enabled even when Sapphire estimates there is not enough notch space.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt das Aktivieren jedes Widgets, auch wenn Sapphire schätzt, dass nicht genug Platz in der Notch vorhanden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow any widget to be enabled even when Sapphire estimates there is not enough notch space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite activar cualquier widget aunque Sapphire estime que no hay suficiente espacio en la muesca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’activation de n’importe quel widget, même lorsque Sapphire estime qu’il n’y a pas assez de place dans l’encoche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'attivazione di qualsiasi widget anche quando Sapphire stima che non ci sia abbastanza spazio nel notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireがノッチのスペースが足りないと推定した場合でも、すべてのウィジェットを有効にできるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire에서 노치 공간이 부족하다고 추정하더라도 모든 위젯을 활성화할 수 있도록 허용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite ativar qualquer widget mesmo quando o Sapphire estimar que não há espaço suficiente no entalhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить включать любой виджет, даже если Sapphire считает, что в вырезе недостаточно места."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使 Sapphire 估计刘海区域空间不足，也允许启用任意小组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使 Sapphire 估計瀏海區域空間不足，也允許啟用任何小工具。"
          }
        }
      }
    },
