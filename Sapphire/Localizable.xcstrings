    "Beta builds require Basic or higher. Free accounts only receive public releases.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Beta-Builds ist Basic oder höher erforderlich. Kostenlose Accounts erhalten nur öffentliche Releases."
          }
        },
