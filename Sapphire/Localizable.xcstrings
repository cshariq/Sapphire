    "The item identity changed after the scan and it was not removed.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Objektidentität hat sich nach dem Scan geändert und das Objekt wurde nicht entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item identity changed after the scan and it was not removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identidad del elemento cambió después del análisis y no se eliminó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identité de l’élément a changé après l’analyse et il n’a pas été supprimé."
          }
        },
        "it": {
