    "The privileged helper is not reachable. Install or reset it (Settings → Battery → Helper) before calibrating.": {
      "comment": "Runtime user-facing string",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der privilegierte Helfer ist nicht erreichbar. Installieren oder setzen Sie ihn zurück (Einstellungen → Batterie → Helfer), bevor Sie kalibrieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The privileged helper is not reachable. Install or reset it (Settings → Battery → Helper) before calibrating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder al asistente con privilegios. Instálalo o restablécelo (Ajustes → Batería → Asistente) antes de calibrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant privilégié est injoignable. Installez-le ou réinitialisez-le (Réglages → Batterie → Assistant) avant l’étalonnage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'helper con privilegi non è raggiungibile. Installalo o reimpostalo (Impostazioni → Batteria → Helper) prima di calibrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特権ヘルパーに接続できません。キャリブレーションの前に、インストールまたはリセットしてください(設定→バッテリー→ヘルパー)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 있는 도우미에 연결할 수 없습니다. 보정하기 전에 설치하거나 재설정하십시오(설정 → 배터리 → 도우미)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O helper privilegiado não está acessível. Instale ou redefina-o (Ajustes → Bateria → Helper) antes de calibrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привилегированный помощник недоступен. Установите или сбросьте его («Настройки» → «Батарея» → «Помощник») перед калибровкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接特权辅助程序。校准前，请在“设置 → 电池 → 辅助程序”中安装或重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連接特權輔助服務。校正前，請先安裝或重置（設定 → 電池 → 輔助服務）。"
          }
        }
      }
    },
    "The privileged update helper could not be contacted. Reinstall or repair Sapphire's helper, then try again.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der privilegierte Update-Helfer konnte nicht kontaktiert werden. Installieren oder reparieren Sie den Sapphire-Helfer erneut und versuchen Sie es dann noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The privileged update helper could not be contacted. Reinstall or repair Sapphire's helper, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido contactar con el asistente de actualizaciones con privilegios. Reinstala o repara el asistente de Sapphire e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant privilégié de mise à jour n’a pas pu être contacté. Réinstallez ou réparez l’assistant de Sapphire, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile contattare l'helper di aggiornamento con privilegi. Reinstalla o ripara l'helper di Sapphire, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特権アップデートヘルパーに接続できませんでした。Sapphireのヘルパーを再インストールまたは修復してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 있는 업데이트 도우미에 연결할 수 없습니다. Sapphire의 도우미를 다시 설치하거나 복구한 다음 다시 시도하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível contatar o helper de atualização privilegiado. Reinstale ou repare o helper do Sapphire e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с привилегированным помощником обновлений. Переустановите или восстановите помощник Sapphire и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法联系特权更新辅助工具。请重新安装或修复 Sapphire 辅助工具后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法聯繫特權更新輔助工具。請重新安裝或修復 Sapphire 的輔助工具，然後再試一次。"
          }
        }
      }
    },
    "The privileged update helper could not install the update.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
