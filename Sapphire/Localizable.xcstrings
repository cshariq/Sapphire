    "Missed %@ — a pass would revive it.": {
      "comment": "Native local UI wording in FocusStreakPanelView.swift",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verpasst – ein Pass würde sie wiederbeleben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missed %@ — a pass would revive it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdido %@: un pase la recuperaría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ manqué — un pass la relancerait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perso %@: un pass la ripristinerebbe."
          }
        },
        "ja": {
