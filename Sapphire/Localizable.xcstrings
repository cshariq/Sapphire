    "Your ticket skips general triage and goes straight to core maintainers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Ticket überspringt die allgemeine Triage und geht direkt an die Core-Maintainer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ticket skips general triage and goes straight to core maintainers."
          }
        },
        "es": {
