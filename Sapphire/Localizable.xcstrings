    "Exact progress from Safari's download bundle and the system progress Safari publishes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genauer Fortschritt aus dem Download-Bundle von Safari und dem Systemfortschritt, den Safari veröffentlicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact progress from Safari's download bundle and the system progress Safari publishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Progreso exacto del paquete de descargas de Safari y del progreso del sistema que publica Safari."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Progression exacte d’après le paquet de téléchargement de Safari et la progression système publiée par Safari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanzamento esatto dal bundle di download di Safari e dall'avanzamento di sistema pubblicato da Safari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariのダウンロードバンドルと、Safariが公開するシステムの進捗から取得した正確な進捗。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari의 다운로드 번들과 Safari가 게시하는 시스템 진행률에서 가져온 정확한 진행률입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresso exato do pacote de download do Safari e do progresso do sistema que o Safari publica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точный прогресс из пакета загрузок Safari и системного прогресса, публикуемого Safari."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据 Safari 下载包和 Safari 发布的系统进度显示准确进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據 Safari 下載套件和 Safari 發布的系統進度顯示精確進度。"
          }
        }
      }
    },
    "Exact progress from the system progress Chromium publishes for .crdownload files, in the folder set in its settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
