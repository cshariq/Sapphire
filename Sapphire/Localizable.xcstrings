    "Turn off macOS cursor acceleration for 1:1, precise pointer movement — great for gaming and design work.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie die macOS-Cursorbeschleunigung für präzise 1:1-Zeigerbewegung aus – ideal für Spiele und Designarbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off macOS cursor acceleration for 1:1, precise pointer movement — great for gaming and design work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la aceleración del cursor de macOS para un movimiento del puntero preciso 1:1, ideal para juegos y trabajo de diseño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez l’accélération du curseur de macOS pour un mouvement du pointeur précis en 1:1 — idéal pour le jeu et le travail de conception."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva l'accelerazione del cursore di macOS per un movimento del puntatore preciso 1:1, ideale per giochi e lavoro di design."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSのカーソル加速をオフにして、1:1の正確なポインタ移動にします。ゲームやデザイン作業に最適です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1:1의 정밀한 포인터 움직임을 위해 macOS 커서 가속을 끕니다. 게임과 디자인 작업에 좋습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative a aceleração do cursor do macOS para um movimento do ponteiro 1:1 e preciso — ótimo para jogos e trabalho de design."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите ускорение курсора macOS для точного движения указателя 1:1 — отлично для игр и дизайна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 macOS 光标加速，实现 1:1 精准指针移动，适合游戏和设计工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉 macOS 游標加速，實現 1:1 精準游標移動，適合遊戲與設計工作。"
          }
        }
      }
    },
    "Turn on Apple Intelligence in System Settings to ask about settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie Apple Intelligence in den Systemeinstellungen ein, um nach Einstellungen zu fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Apple Intelligence in System Settings to ask about settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Apple Intelligence en Ajustes del Sistema para preguntar sobre los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Apple Intelligence dans Réglages Système pour poser des questions sur les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Apple Intelligence in Impostazioni di Sistema per fare domande sulle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定について質問するには、“システム設定”でApple Intelligenceをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에 대해 질문하려면 시스템 설정에서 Apple Intelligence를 켜십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Apple Intelligence em Ajustes do Sistema para perguntar sobre os ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Apple Intelligence в Системных настройках, чтобы спрашивать о настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中开启 Apple 智能，以询问设置相关问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中開啟 Apple Intelligence，以詢問設定相關問題。"
          }
        }
      }
    },
    "Turn on Dev Activity in Settings to see AI agents, builds and terminal commands here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie die Dev-Aktivität in den Einstellungen, um hier KI-Agenten, Builds und Terminalbefehle zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Dev Activity in Settings to see AI agents, builds and terminal commands here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Actividad de desarrollo en Ajustes para ver aquí agentes de IA, compilaciones y comandos de terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’activité de développement dans les Réglages pour voir ici les agents IA, les builds et les commandes de terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Attività di sviluppo nelle Impostazioni per vedere qui agenti IA, build e comandi del terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIエージェント、ビルド、ターミナルコマンドをここに表示するには、設定で開発アクティビティをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 AI 에이전트, 빌드 및 터미널 명령을 보려면 설정에서 개발 활동을 켜십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a Atividade de Desenvolvimento nos Ajustes para ver agentes de IA, builds e comandos de terminal aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Активность разработки» в Настройках, чтобы видеть здесь ИИ-агентов, сборки и команды терминала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中开启开发活动，即可在此查看 AI 智能体、构建和终端命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中開啟開發活動，即可在此查看 AI 代理程式、建置和終端機指令。"
          }
        }
      }
    },
    "Turn on Fractal Windows above. Your windows stay where they are: nothing moves until you dock one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie oben Fractal Windows ein. Ihre Fenster bleiben, wo sie sind: Nichts bewegt sich, bis Sie eines andocken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Fractal Windows above. Your windows stay where they are: nothing moves until you dock one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Fractal Windows arriba. Tus ventanas se quedan donde están: nada se mueve hasta que acoples una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Fractal Windows ci-dessus. Vos fenêtres restent où elles sont : rien ne bouge tant que vous n’en ancrez pas une."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Fractal Windows qui sopra. Le finestre restano dove sono: nulla si sposta finché non ne agganci una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上でFractal Windowsをオンにしてください。ウインドウはそのままの位置に留まります。ドックするまで何も動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에서 프랙탈 윈도우를 켜십시오. 윈도우는 제자리에 유지되며 하나를 도킹하기 전까지는 아무것도 이동하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Fractal Windows acima. Suas janelas permanecem onde estão: nada se move até você encaixar uma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Fractal Windows выше. Ваши окна остаются на местах: ничего не перемещается, пока вы не закрепите одно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在上方打开 Fractal Windows。你的窗口会保持原位：在你停靠窗口之前不会有任何移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在上方開啟 Fractal Windows。你的視窗會保持原位：在你停靠視窗之前不會有任何移動。"
          }
        }
      }
    },
    "Turn on Sapphire and Sapphire Helper in Login Items.": {
