    "Skip passwords and other concealed clipboard content (e.g., from 1Password, Bitwarden).": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwörter und andere verborgene Zwischenablageinhalte überspringen (z. B. von 1Password, Bitwarden)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip passwords and other concealed clipboard content (e.g., from 1Password, Bitwarden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omite las contraseñas y otro contenido oculto del portapapeles (p. ej., de 1Password, Bitwarden)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorer les mots de passe et autres contenus masqués du presse-papiers (par ex. de 1Password, Bitwarden)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta le password e altri contenuti nascosti degli appunti (ad es. da 1Password, Bitwarden)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードや、その他の隠されたクリップボードの内容(1PasswordやBitwardenなど)をスキップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호 및 기타 숨겨진 클립보드 콘텐츠(예: 1Password, Bitwarden)를 건너뜁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora senhas e outros conteúdos ocultos da área de transferência (por exemplo, do 1Password, Bitwarden)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропускать пароли и другое скрытое содержимое буфера обмена (например, из 1Password, Bitwarden)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过密码及其他隐藏的剪贴板内容，例如来自 1Password、Bitwarden 的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "略過密碼和其他隱藏的剪貼簿內容（例如來自 1Password、Bitwarden）。"
          }
        }
      }
    },
    "Skip passwords and other concealed content from apps like 1Password and Bitwarden.": {
      "comment": "Settings interface",
