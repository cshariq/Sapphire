    "Continue preventing sleep after leaving clamshell mode instead of turning caffeinate off automatically.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Ruhezustand weiterhin verhindern, nachdem der Clamshell-Modus verlassen wurde, anstatt Caffeinate automatisch auszuschalten."
          }
        },
        "en": {
          "stringUnit": {
