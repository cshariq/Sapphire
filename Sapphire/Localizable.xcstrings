    "Break reminders, timing, and focus nudges for healthier screen habits.": {
      "comment": "SettingsSection.shortDescription",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausenerinnerungen, Zeitplanung und Fokus-Hinweise für gesündere Bildschirmgewohnheiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Break reminders, timing, and focus nudges for healthier screen habits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios de descanso, tiempos y avisos de foco para hábitos de pantalla más saludables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels de pause, minutage et incitations à la concentration pour des habitudes d’écran plus saines."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria delle pause, tempi e inviti al focus per abitudini più sane davanti allo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "健康的な画面習慣のための、休憩のリマインダー、タイミング、集中のうながし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강한 화면 습관을 위한 휴식 알림, 타이밍 및 집중 알림입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes de pausa, tempo e incentivos de foco para hábitos de tela mais saudáveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания о перерывах, время и подсказки фокусирования для более здоровых привычек работы с экраном."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置休息提醒、间隔和专注提示，养成更健康的用屏习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "休息提醒、時間安排和專注提示，養成更健康的螢幕使用習慣。"
          }
        }
      }
    },
