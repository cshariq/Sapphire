    "Enables File Shelf, Intelligence file access, and deeper system integrations.": {
      "comment": "Onboarding, app menus, helper, shared utilities, public build placeholders",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert die Dateiablage, den Dateizugriff der Intelligenz und tiefere Systemintegrationen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enables File Shelf, Intelligence file access, and deeper system integrations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la bandeja de archivos, el acceso a archivos de Intelligence e integraciones más profundas con el sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active l’étagère de fichiers, l’accès aux fichiers d’Intelligence et des intégrations système plus poussées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva File Shelf, accesso ai file per Intelligence e integrazioni di sistema più profonde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルシェルフ、Intelligenceのファイルアクセス、より深いシステム連携を有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 선반, Intelligence 파일 접근 및 더 깊은 시스템 통합을 활성화합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa a Prateleira de Arquivos, o acesso a arquivos da Inteligência e integrações mais profundas com o sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает Полку файлов, доступ к файлам для Intelligence и более глубокую интеграцию с системой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于文件暂存架、智能功能的文件访问，以及更深入的系统集成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於檔案暫存架、智慧功能的檔案存取，以及更深入的系統整合。"
          }
        }
      }
    },
