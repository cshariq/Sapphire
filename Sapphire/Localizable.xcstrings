        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虽然已实现睡眠期间的电池管理，但并不保证始终生效。如需确保设备睡眠时的行为，请使用以下设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
