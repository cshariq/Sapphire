            "value": "Fragen Sie nach einer Einstellung oder sagen Sie, was geändert werden soll …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about a setting, or say what to change…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta sobre un ajuste o di qué quieres cambiar…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question sur un réglage ou dites ce qu’il faut changer…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi di un'impostazione o dì cosa cambiare…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定について質問するか、変更したい内容を伝えてください…"
