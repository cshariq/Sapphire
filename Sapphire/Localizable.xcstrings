          "stringUnit": {
            "state": "translated",
            "value": "Touchez 5 fois rapidement pour activer le mode débogage"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca 5 volte rapidamente per attivare la modalità debug"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すばやく5回タップするとデバッグモードを有効にします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디버그 모드를 활성화하려면 5번 빠르게 탭하십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque 5× rapidamente para ativar o modo de depuração"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро коснитесь 5 раз, чтобы включить режим отладки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速轻点 5 次以启用调试模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速點一下 5 次以啟用除錯模式"
          }
        }
      }
    },
