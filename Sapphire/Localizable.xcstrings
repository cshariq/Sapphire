          "stringUnit": {
            "state": "translated",
            "value": "이 cask의 제거를 완료하려면 Homebrew에 관리자 암호가 필요합니다. 터미널에서 “%@”을(를) 실행하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew precisa da sua senha de administrador para terminar de remover este cask. Execute “%@” no Terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для завершения удаления этого cask Homebrew нужен пароль администратора. Выполните «%@» в Терминале."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 需要管理员密码才能完成此 cask 的移除。请在终端中运行“%@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 需要管理者密碼才能完成此 cask 的移除。請在終端機中執行「%@」。"
          }
        }
      }
    },
