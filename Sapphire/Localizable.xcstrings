          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en Spotify desde la sección Música de los ajustes de Sapphire para usar esta función."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
