          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce automáticamente las imágenes copiadas, comprime imágenes/PDF/vídeo/audio, extrae texto con OCR y pega como texto sin formato o Markdown."
