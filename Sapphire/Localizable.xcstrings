    "⌥-pinch anywhere, or pinch on bare wallpaper, to zoom your desktop. ⌥-scroll pans.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit ⌥-Pinch irgendwo oder per Pinch auf leerem Hintergrundbild zoomen Sie Ihren Schreibtisch. ⌥-Scrollen verschiebt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥-pinch anywhere, or pinch on bare wallpaper, to zoom your desktop. ⌥-scroll pans."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥-pellizca en cualquier lugar, o pellizca sobre el fondo de pantalla vacío, para hacer zoom en tu escritorio. ⌥-desplazar mueve la vista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥-pincez n’importe où, ou pincez sur le fond d’écran nu, pour zoomer sur votre bureau. ⌥-défilement déplace la vue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizzica con ⌥ ovunque, o pizzica sullo sfondo libero, per zoomare la scrivania. Lo scorrimento con ⌥ la sposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ピンチをどこでも行うか、何もない壁紙上でピンチすると、デスクトップをズームします。⌥スクロールでパンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥-핀치를 아무 곳에서나 하거나 빈 배경화면에서 핀치하여 데스크탑을 확대/축소합니다. ⌥-스크롤은 이동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥-pinça em qualquer lugar, ou pinça no papel de parede vazio, para dar zoom na mesa. ⌥-rolagem desloca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥-щипок где угодно или щипок по пустым обоям масштабирует рабочий стол. ⌥-прокрутка сдвигает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 在任意位置捏合，或在空白墙纸上捏合，即可缩放桌面。按住 ⌥ 滚动可平移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 在任何位置縮放手勢，或在空白桌面圖片上縮放手勢，即可縮放桌面。按住 ⌥ 捲動可平移。"
          }
        }
      }
    },
