    "Dark, satiny glass like the Dock.": {
      "comment": "Onboarding, app menus, helper, shared utilities, public build placeholders",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkles, seidiges Glas wie das Dock."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark, satiny glass like the Dock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cristal oscuro y satinado como el del Dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verre satiné sombre, comme le Dock."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetro scuro e satinato come il Dock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockのような、暗く滑らかなガラス。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock처럼 어둡고 부드러운 유리입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidro escuro acetinado, como o Dock."
          }
        },
