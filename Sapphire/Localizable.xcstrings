    "Save your own prompts, like “Grade my essay against the rubric on screen” or “Answer as a senior iOS engineer”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern Sie eigene Prompts, etwa „Bewerte meinen Aufsatz anhand des Bewertungsrasters auf dem Bildschirm“ oder „Antworte als Senior-iOS-Entwickler“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your own prompts, like “Grade my essay against the rubric on screen” or “Answer as a senior iOS engineer”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus propias instrucciones, como “Califica mi redacción según la rúbrica en pantalla” o “Responde como un ingeniero de iOS sénior”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez vos propres invites, comme « Note ma dissertation d’après la grille affichée à l’écran » ou « Réponds en tant qu’ingénieur iOS senior »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva i tuoi prompt, come “Valuta il mio saggio in base alla rubrica sullo schermo” o “Rispondi come un ingegnere iOS senior”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“画面上のルーブリックに照らして私のエッセイを採点して”や“シニアiOSエンジニアとして答えて”など、独自のプロンプトを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"화면의 평가 기준에 맞춰 내 에세이 채점\" 또는 \"시니어 iOS 엔지니어로서 답변\" 같은 자신만의 프롬프트를 저장하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve seus próprios prompts, como “Avalie minha redação com base na rubrica na tela” ou “Responda como um engenheiro iOS sênior”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте собственные запросы, например «Оцени моё эссе по рубрике на экране» или «Отвечай как старший iOS-инженер»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储你自己的提示词，例如“对照屏幕上的评分标准给我的文章打分”或“以资深 iOS 工程师的身份回答”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存你自己的提示詞，例如「對照螢幕上的評分標準給我的文章打分數」或「以資深 iOS 工程師的身分回答」。"
          }
        }
      }
    },
