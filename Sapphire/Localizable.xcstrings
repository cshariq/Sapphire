    "Show suggestions after typing : plus a letter. A bare colon never opens the popup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge anzeigen, nachdem : und ein Buchstabe getippt wurden. Ein einzelner Doppelpunkt öffnet nie das Popup."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show suggestions after typing : plus a letter. A bare colon never opens the popup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra sugerencias después de escribir : más una letra. Unos dos puntos solos nunca abren la ventana emergente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher des suggestions après avoir saisi : suivi d’une lettre. Un deux-points seul n’ouvre jamais la fenêtre."
