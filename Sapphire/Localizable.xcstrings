          }
        }
      }
    },
    "Choose which apps may show notifications and which may run live activities in the notch. New apps follow the defaults above.": {
      "comment": "A description of the Continuity app preferences section.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, welche Apps Mitteilungen anzeigen und Live-Aktivitäten in der Notch ausführen dürfen. Neue Apps folgen den obigen Standardeinstellungen."
          }
        },
        "en": {
