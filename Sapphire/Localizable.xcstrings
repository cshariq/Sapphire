    "Log in to TIDAL in the Music section of Sapphire's settings to see your playlists here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich im Bereich „Musik“ der Sapphire-Einstellungen bei TIDAL an, um Ihre Playlists hier zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in to TIDAL in the Music section of Sapphire's settings to see your playlists here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en TIDAL en la sección Música de los ajustes de Sapphire para ver aquí tus listas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à TIDAL dans la section Musique des réglages de Sapphire pour voir vos listes de lecture ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a TIDAL nella sezione Musica delle impostazioni di Sapphire per vedere qui le tue playlist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイリストをここに表示するには、Sapphireの設定の“ミュージック”セクションでTIDALにログインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 플레이리스트를 보려면 Sapphire 설정의 음악 섹션에서 TIDAL에 로그인하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login no TIDAL na seção Música dos ajustes do Sapphire para ver suas playlists aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в TIDAL в разделе «Музыка» настроек Sapphire, чтобы видеть здесь свои плейлисты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Sapphire 设置的“音乐”部分登录 TIDAL，即可在此处查看你的播放列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Sapphire 設定的「音樂」部分登入 TIDAL，即可在此處檢視你的播放列表。"
          }
        }
      }
    },
    "Log in to enable enhanced features like liking tracks and skipping ads directly from the notch.": {
      "comment": "Onboarding, app menus, helper, shared utilities, public build placeholders",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich an, um erweiterte Funktionen wie das Markieren von Titeln mit „Gefällt mir“ und das Überspringen von Werbung direkt aus der Notch zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in to enable enhanced features like liking tracks and skipping ads directly from the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para habilitar funciones mejoradas, como marcar canciones con Me gusta y saltar anuncios directamente desde la muesca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour activer des fonctionnalités avancées comme aimer des titres et passer les publicités directement depuis l’encoche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi per attivare funzionalità avanzate come mettere Mi piace ai brani e saltare le pubblicità direttamente dal notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインすると、ノッチから直接トラックに高評価を付けたり広告をスキップしたりする拡張機能が有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하면 노치에서 바로 트랙에 좋아요를 누르고 광고를 건너뛰는 등의 향상된 기능을 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login para ativar recursos avançados, como curtir faixas e pular anúncios diretamente do entalhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы включить расширенные функции, такие как лайки треков и пропуск рекламы прямо из выреза."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后即可直接在刘海区域使用收藏歌曲、跳过广告等增强功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入以啟用增強功能，例如直接從瀏海喜愛曲目和略過廣告。"
          }
        }
      }
    },
    "Log in to like tracks and skip ads from the notch.": {
      "comment": "Onboarding, app menus, helper, shared utilities, public build placeholders",
      "localizations": {
        "de": {
          "stringUnit": {
