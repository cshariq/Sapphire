    "Show the track's popularity score. Apple Music scores come from stats.fm and need no login.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Beliebtheitswert des Titels anzeigen. Apple Music-Werte stammen von stats.fm und erfordern keine Anmeldung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the track's popularity score. Apple Music scores come from stats.fm and need no login."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la puntuación de popularidad de la pista. Las puntuaciones de Apple Music proceden de stats.fm y no requieren iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le score de popularité du morceau. Les scores d’Apple Music proviennent de stats.fm et ne nécessitent aucune connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il punteggio di popolarità del brano. I punteggi di Apple Music provengono da stats.fm e non richiedono accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックの人気度スコアを表示します。Apple Musicのスコアはstats.fmから取得され、ログインは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙의 인기도 점수를 표시합니다. Apple Music 점수는 stats.fm에서 가져오며 로그인이 필요하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a pontuação de popularidade da faixa. As pontuações do Apple Music vêm do stats.fm e não exigem login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать индекс популярности трека. Индексы Apple Music берутся из stats.fm и не требуют входа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示曲目的热度评分。Apple Music 的评分来自 stats.fm，无需登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示曲目的熱門程度評分。Apple Music 的評分來自 stats.fm，無須登入。"
          }
        }
      }
    },
    "Show the upcoming track from the queue under the now-playing title during the last 10 seconds of the song.": {
      "comment": "Settings interface",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nächsten Titel aus der Warteschlange in den letzten 10 Sekunden des Songs unter dem aktuellen Titel anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the upcoming track from the queue under the now-playing title during the last 10 seconds of the song."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la siguiente pista de la cola bajo el título de lo que suena durante los últimos 10 segundos de la canción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le morceau suivant de la file d’attente sous le titre en cours de lecture pendant les 10 dernières secondes du morceau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il brano successivo della coda sotto il titolo in riproduzione negli ultimi 10 secondi del brano."
          }
        },
        "ja": {
