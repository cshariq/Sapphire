        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在桌面上使用你自己的图像或视频。视频在桌面图标后方播放，桌面被遮挡时暂停。锁定屏幕也会使用它，除非已单独设置墙纸。"
          }
        }
      }
