    "Run an individual tool after a 5-second countdown. Focus the target window first.": {
      "comment": "A description of the Direct Tools Testing feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie ein einzelnes Tool nach einem 5-Sekunden-Countdown aus. Fokussieren Sie zuerst das Zielfenster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run an individual tool after a 5-second countdown. Focus the target window first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta una herramienta individual tras una cuenta atrás de 5 segundos. Enfoca primero la ventana de destino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez un outil individuel après un compte à rebours de 5 secondes. Activez d’abord la fenêtre cible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui un singolo strumento dopo un conto alla rovescia di 5 secondi. Metti prima a fuoco la finestra di destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5秒のカウントダウン後に、個別のツールを実行します。先に対象のウインドウにフォーカスしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5초 카운트다운 후 개별 도구를 실행합니다. 먼저 대상 윈도우에 포커스를 맞추십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute uma ferramenta individual após uma contagem regressiva de 5 segundos. Foque primeiro a janela de destino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите отдельный инструмент после 5-секундного отсчёта. Сначала сфокусируйтесь на целевом окне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倒计时 5 秒后运行单个工具。请先让目标窗口成为焦点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "倒數 5 秒後執行單一工具。請先讓目標視窗成為焦點。"
          }
        }
      }
    },
    "Run any of these from Shortcuts, Raycast, Alfred, a Stream Deck or Terminal (open sapphire://fractal/everything). Add %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
