    "Quit running apps that aren't in this preset after switching (always keeps the frontmost app and Sapphire open)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufende Apps beenden, die nicht in diesem Preset sind, nachdem gewechselt wurde (die vorderste App und Sapphire bleiben immer geöffnet)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
