    "Pick any widget from your paired Android phone — choosing one that isn't on your Mac yet adds it from the phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick any widget from your paired Android phone — choosing one that isn't on your Mac yet adds it from the phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从已配对的 Android 手机中选择任意小组件；如果 Mac 上还没有这个小组件，会从手机添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從已配對的 Android 手機選擇任意小工具；若 Mac 上還沒有這個小工具，會從手機加入。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein beliebiges Widget Ihres gekoppelten Android-Smartphones – wenn Sie eines wählen, das noch nicht auf Ihrem Mac ist, wird es vom Smartphone hinzugefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cualquier widget de tu teléfono Android emparejado; si eliges uno que aún no está en tu Mac, se añade desde el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez n’importe quel widget de votre téléphone Android associé — en choisir un qui n’est pas encore sur votre Mac l’ajoute depuis le téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli qualsiasi widget dal telefono Android associato: se ne scegli uno che non è ancora sul Mac, viene aggiunto dal telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのAndroidスマートフォンから任意のウィジェットを選択します。まだMacにないウィジェットを選ぶと、スマートフォンから追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 Android 휴대전화의 위젯을 선택하십시오. 아직 Mac에 없는 위젯을 선택하면 휴대전화에서 추가됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha qualquer widget do seu celular Android pareado — escolher um que ainda não está no seu Mac o adiciona a partir do celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите любой виджет с вашего парного телефона Android — выбор того, которого ещё нет на Mac, добавит его с телефона."
          }
        }
      }
    },
    "Place a live widget from your paired Android phone on the Mac desktop or in Notification Center.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a live widget from your paired Android phone on the Mac desktop or in Notification Center."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将已配对 Android 手机上的实时小组件放到 Mac 桌面或通知中心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將已配對 Android 手機上的即時小工具放到 Mac 桌面或通知中心。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platzieren Sie ein Live-Widget von Ihrem gekoppelten Android-Smartphone auf dem Mac-Schreibtisch oder im Mitteilungszentrum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca un widget en directo de tu teléfono Android emparejado en el escritorio del Mac o en el Centro de notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez un widget en direct de votre téléphone Android associé sur le bureau du Mac ou dans le Centre de notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un widget live del telefono Android associato sulla scrivania del Mac o nel Centro Notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのAndroidスマートフォンのライブウィジェットを、Macのデスクトップまたは通知センターに配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 Android 휴대전화의 라이브 위젯을 Mac 데스크탑 또는 알림 센터에 배치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque um widget ao vivo do seu celular Android pareado na mesa do Mac ou na Central de Notificações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разместите живой виджет с вашего парного телефона Android на рабочем столе Mac или в Центре уведомлений."
          }
        }
      }
    },
