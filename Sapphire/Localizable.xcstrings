    "Report days you can’t focus — at least 3 days in advance — and they won’t break your streak. Unlimited.": {
      "comment": "Native local UI wording in FocusStreakPanelView.swift",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie Tage, an denen Sie sich nicht konzentrieren können – mindestens 3 Tage im Voraus –, und sie unterbrechen Ihre Serie nicht. Unbegrenzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report days you can’t focus — at least 3 days in advance — and they won’t break your streak. Unlimited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica los días en los que no puedes concentrarte (con al menos 3 días de antelación) y no romperán tu racha. Sin límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalez les jours où vous ne pouvez pas vous concentrer — au moins 3 jours à l’avance — et ils n’interrompront pas votre série. Illimité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnala i giorni in cui non puoi concentrarti, con almeno 3 giorni di anticipo, e non interromperanno la tua serie. Illimitati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中できない日を、3日以上前までに報告すると、連続記録は途切れません。回数は無制限です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중할 수 없는 날을 3일 이상 전에 미리 보고하면 연속 기록이 끊어지지 않습니다. 무제한입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe os dias em que você não consegue focar — com pelo menos 3 dias de antecedência — e eles não quebrarão sua sequência. Ilimitado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщайте о днях, когда не можете сосредоточиться — минимум за 3 дня — и они не прервут вашу серию. Без ограничений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少提前 3 天安排无法专注的日期，它们不会中断连续专注记录，次数不限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回報無法專注的日子（至少提前 3 天），就不會中斷你的連續紀錄。無次數限制。"
          }
        }
      }
    },
