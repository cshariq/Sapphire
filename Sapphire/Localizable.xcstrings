    "Click the live activity for every transfer, with pause, cancel, open and Show in Finder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf die Live-Aktivität, um jede Übertragung mit Pause, Abbrechen, Öffnen und „Im Finder anzeigen“ zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the live activity for every transfer, with pause, cancel, open and Show in Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la actividad en directo para ver todas las transferencias, con pausar, cancelar, abrir y Mostrar en el Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’activité en direct pour voir chaque transfert, avec pause, annulation, ouverture et Afficher dans le Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sulla Live Activity per ogni trasferimento, con pausa, annulla, apri e Mostra nel Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティをクリックすると、すべての転送を表示し、一時停止、キャンセル、開く、Finderで表示ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 활동을 클릭하면 모든 전송을 일시 정지, 취소, 열기 및 Finder에서 보기와 함께 볼 수 있습니다."
          }
        },
        "pt-BR": {
