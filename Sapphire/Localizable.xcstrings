    "Starts the screensaver instead of showing the lock screen.": {
      "comment": "Settings interface",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet den Bildschirmschoner, anstatt den Sperrbildschirm anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts the screensaver instead of showing the lock screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia el salvapantallas en lugar de mostrar la pantalla bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance l’économiseur d’écran au lieu d’afficher l’écran de verrouillage."
          }
        },
        "it": {
