    "Display a special HUD with the active device name when changing volume while Spotify is active.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt ein spezielles HUD mit dem Namen des aktiven Geräts an, wenn die Lautstärke geändert wird, während Spotify aktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display a special HUD with the active device name when changing volume while Spotify is active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un HUD especial con el nombre del dispositivo activo al cambiar el volumen mientras Spotify está activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher un affichage spécial avec le nom de l’appareil actif lors d’un changement de volume pendant que Spotify est actif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un HUD speciale con il nome del dispositivo attivo quando cambi il volume mentre Spotify è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotifyがアクティブなときに音量を変更すると、アクティブなデバイス名を含む専用のHUDを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify가 활성 상태일 때 볼륨을 변경하면 활성 기기 이름이 있는 특별한 HUD를 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe um HUD especial com o nome do dispositivo ativo ao alterar o volume enquanto o Spotify está ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать особый HUD с именем активного устройства при изменении громкости, пока активен Spotify."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 活跃时，调整音量会显示包含当前设备名称的专用提示浮层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 使用中時調整音量，會顯示含有目前裝置名稱的特殊浮動提示。"
          }
        }
      }
    },
