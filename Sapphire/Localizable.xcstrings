    "That conversation got too long. Ask again and I'll start fresh.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Unterhaltung wurde zu lang. Fragen Sie erneut, dann beginne ich neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That conversation got too long. Ask again and I'll start fresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa conversación se hizo demasiado larga. Pregunta de nuevo y empezaré desde cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversation est devenue trop longue. Reposez votre question et je repartirai de zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversazione è diventata troppo lunga. Chiedi di nuovo e ricomincerò da capo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その会話は長くなりすぎました。もう一度質問していただければ、最初からやり直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화가 너무 길어졌습니다. 다시 질문하면 새로 시작하겠습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa conversa ficou longa demais. Pergunte novamente e eu começo do zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта беседа стала слишком длинной. Спросите снова, и я начну заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段对话太长了。请再问一次，我会重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這段對話太長了。請再問一次，我會重新開始。"
          }
        }
      }
    },
