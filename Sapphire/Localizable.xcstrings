    "Run a Shortcut when a session starts / ends — e.g. turn on Do Not Disturb.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Start/Ende einer Sitzung einen Kurzbefehl ausführen – z. B. „Nicht stören“ aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a Shortcut when a session starts / ends — e.g. turn on Do Not Disturb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta un atajo cuando una sesión empieza o termina, p. ej., para activar No molestar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécuter un raccourci au début / à la fin d’une session — par ex. activer Ne pas déranger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui un comando rapido quando una sessione inizia / finisce, ad es. attivare Non disturbare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの開始時/終了時にショートカットを実行します。たとえば、おやすみモードをオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 시작/종료될 때 단축어를 실행합니다. 예: 방해 금지 모드 켜기."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar um Atalho quando uma sessão começar / terminar — por exemplo, ativar o Não Perturbe."
          }
        },
        "ru": {
          "stringUnit": {
