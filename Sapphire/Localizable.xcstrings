        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisa quando finisce un blocco di focus, una pausa o la sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中ブロック、休憩、またはセッションが終了したときにお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 블록, 휴식 또는 세션이 끝나면 알려줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa você quando um bloco de foco, uma pausa ou a sessão termina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомляет вас, когда заканчивается блок фокусирования, перерыв или сеанс."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一个专注阶段、休息或整个时段结束时通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在一個專注階段、休息或整個時段結束時通知你。"
          }
        }
      }
    },
