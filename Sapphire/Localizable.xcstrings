    "Circle to Search is included with Sapphire Pro and Ultra. Draw around text, images, or UI to search or ask Blip.": {
      "comment": "Text describing the Circle to Search feature, including the product it's included with.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Circle to Search ist in Sapphire Pro und Ultra enthalten. Umkreisen Sie Text, Bilder oder Oberflächenelemente, um zu suchen oder Blip zu fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Circle to Search is included with Sapphire Pro and Ultra. Draw around text, images, or UI to search or ask Blip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Circle to Search está incluido en Sapphire Pro y Ultra. Dibuja alrededor de texto, imágenes o elementos de la interfaz para buscar o preguntar a Blip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entourer pour rechercher est inclus dans Sapphire Pro et Ultra. Dessinez autour d’un texte, d’images ou d’éléments d’interface pour rechercher ou interroger Blip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circle to Search è incluso in Sapphire Pro e Ultra. Disegna un cerchio attorno a testo, immagini o interfaccia per cercare o chiedere a Blip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Circle to SearchはSapphire ProおよびUltraに含まれています。テキスト、画像、UIを囲んで、検索したりBlipに質問したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Circle to Search는 Sapphire Pro 및 Ultra에 포함되어 있습니다. 텍스트, 이미지 또는 UI 주위에 원을 그려 검색하거나 Blip에게 물어보십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Circle to Search está incluído no Sapphire Pro e Ultra. Desenhe em volta de texto, imagens ou da interface para pesquisar ou perguntar ao Blip."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Circle to Search входит в Sapphire Pro и Ultra. Обведите текст, изображение или элемент интерфейса, чтобы найти информацию или спросить Blip."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圈选搜索包含在 Sapphire Pro 和 Ultra 中。圈出文本、图像或界面元素即可搜索或询问 Blip。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
