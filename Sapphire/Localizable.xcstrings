    "Follows the growing .part file in the folder set in Firefox's settings; the total size isn't known until it finishes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgt die wachsende .part-Datei im in den Firefox-Einstellungen festgelegten Ordner; die Gesamtgröße ist erst bekannt, wenn der Vorgang abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows the growing .part file in the folder set in Firefox's settings; the total size isn't known until it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue el archivo .part en crecimiento de la carpeta definida en los ajustes de Firefox; el tamaño total no se conoce hasta que termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit le fichier .part en cours de croissance dans le dossier défini dans les réglages de Firefox ; la taille totale n’est connue qu’à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue il file .part in crescita nella cartella impostata nelle impostazioni di Firefox; la dimensione totale non è nota finché non termina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Firefoxの設定で指定したフォルダ内で増えていく.partファイルを追跡します。合計サイズは完了するまで不明です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Firefox 설정에 지정된 폴더에서 커지는 .part 파일을 따라갑니다. 총 크기는 완료될 때까지 알 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanha o arquivo .part em crescimento na pasta definida nos ajustes do Firefox; o tamanho total só é conhecido quando termina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следит за растущим файлом .part в папке, заданной в настройках Firefox; общий размер неизвестен до завершения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟踪 Firefox 设置的下载文件夹中不断增长的 .part 文件；下载完成前无法获知总大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤 Firefox 設定的下載檔案夾中持續增長的 .part 檔案；下載完成前無法得知總大小。"
          }
        }
      }
    },
