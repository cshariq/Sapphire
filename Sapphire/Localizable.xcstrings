          "stringUnit": {
            "state": "translated",
            "value": "Eine gleich große Karte für Ihre gekoppelten Continuity-Geräte anzeigen. Koppeln Sie ein Gerät in den Continuity-Einstellungen, um sie verfügbar zu machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a same-size card for your paired Continuity devices. Pair a device in Continuity settings to make it available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una tarjeta del mismo tamaño para tus dispositivos de Continuidad emparejados. Empareja un dispositivo en los ajustes de Continuidad para que esté disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
