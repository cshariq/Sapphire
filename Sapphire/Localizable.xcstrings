    "Commands run in your login shell in the folder on the left. Use the window button for interactive programs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle werden in Ihrer Login-Shell im Ordner links ausgeführt. Verwenden Sie die Fenstertaste für interaktive Programme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commands run in your login shell in the folder on the left. Use the window button for interactive programs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comandos se ejecutan en tu shell de inicio de sesión, en la carpeta de la izquierda. Usa el botón de ventana para programas interactivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes s’exécutent dans votre shell de connexion, dans le dossier à gauche. Utilisez le bouton de fenêtre pour les programmes interactifs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I comandi vengono eseguiti nella shell di login nella cartella a sinistra. Usa il pulsante finestra per i programmi interattivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドは左のフォルダ内で、ログインシェルで実行されます。対話型プログラムにはウインドウボタンを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령은 왼쪽 폴더에서 로그인 셸로 실행됩니다. 대화형 프로그램에는 윈도우 버튼을 사용하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os comandos são executados no seu shell de login na pasta à esquerda. Use o botão de janela para programas interativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды выполняются в вашей login-оболочке в папке слева. Для интерактивных программ используйте кнопку окна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令会在左侧文件夹中使用你的登录 shell 运行。交互式程序请使用窗口按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指令會在左側檔案夾中使用你的登入 shell 執行。互動式程式請使用視窗按鈕。"
          }
        }
      }
    },
