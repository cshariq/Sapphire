    "Open the camera app on your phone and point it at this QR code to go to the download page.": {
      "comment": "Compiler-extracted static interface text",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die Kamera-App auf Ihrem Smartphone und richten Sie sie auf diesen QR-Code, um zur Download-Seite zu gelangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the camera app on your phone and point it at this QR code to go to the download page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app de la cámara de tu teléfono y apúntala a este código QR para ir a la página de descarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app Appareil photo de votre téléphone et pointez-la vers ce QR code pour accéder à la page de téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l'app Fotocamera del telefono e inquadra questo codice QR per andare alla pagina di download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンのカメラAppを開き、このQRコードに向けると、ダウンロードページに移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화의 카메라 앱을 열고 이 QR 코드에 비추면 다운로드 페이지로 이동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o app da câmera do seu celular e aponte para este QR code para ir à página de download."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте камеру на телефоне и наведите её на этот QR-код, чтобы перейти на страницу загрузки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开手机相机并对准此二维码，即可前往下载页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開手機上的相機 App 並對準此 QR 碼，即可前往下載頁面。"
          }
        }
      }
    },
    "Open the full session view when you click the activity.": {
      "localizations": {
