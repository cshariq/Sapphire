          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 이미 설치되어 있고 DMG에 더 새로운 버전이 있으면 묻지 않고 교체합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o app já estiver instalado e o DMG contiver uma versão mais nova, substitui sem perguntar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если приложение уже установлено, а DMG содержит более новую версию, заменять его без запроса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果已安装应用，且 DMG 中包含较新版本，则无需询问直接替换。"
