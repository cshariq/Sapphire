    "Screen Recording is allowed; macOS applies it when Sapphire reopens. Every window comes back into view first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildschirmaufnahme ist erlaubt; macOS wendet sie an, wenn Sapphire erneut geöffnet wird. Zuvor kommt jedes Fenster wieder in die Ansicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording is allowed; macOS applies it when Sapphire reopens. Every window comes back into view first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Grabación de pantalla está permitida; macOS la aplica cuando Sapphire se vuelve a abrir. Antes, todas las ventanas vuelven a la vista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement de l’écran est autorisé ; macOS l’applique à la réouverture de Sapphire. Chaque fenêtre revient d’abord à l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione schermo è consentita; macOS la applica quando Sapphire si riapre. Prima ogni finestra torna visibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録は許可されています。macOSはSapphireを開き直したときにこれを適用します。先に、すべてのウインドウが表示に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 기록이 허용되었으며 Sapphire를 다시 열면 macOS에서 적용합니다. 먼저 모든 윈도우가 다시 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gravação de Tela está permitida; o macOS a aplica quando o Sapphire é reaberto. Toda janela volta à vista primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись экрана разрешена; macOS применит её при повторном открытии Sapphire. Сначала каждое окно вернётся в поле зрения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许屏幕录制；macOS 会在 Sapphire 重新打开时应用该设置。每个窗口会先回到视野中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許螢幕錄製；macOS 會在 Sapphire 重新開啟時套用該設定。每個視窗會先回到視野中。"
          }
        }
      }
    },
