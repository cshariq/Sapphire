    "Share anonymous usage data with Google Analytics to help improve Sapphire. You can change this anytime in Settings > General.": {
      "comment": "Onboarding, app menus, helper, shared utilities, public build placeholders",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen Sie anonyme Nutzungsdaten mit Google Analytics, um Sapphire zu verbessern. Sie können dies jederzeit unter „Einstellungen“ > „Allgemein“ ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share anonymous usage data with Google Analytics to help improve Sapphire. You can change this anytime in Settings > General."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte datos de uso anónimos con Google Analytics para ayudar a mejorar Sapphire. Puedes cambiarlo en cualquier momento en Ajustes > General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez des données d’utilisation anonymes avec Google Analytics pour aider à améliorer Sapphire. Vous pouvez modifier ce réglage à tout moment dans Réglages > Général."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi dati di utilizzo anonimi con Google Analytics per contribuire a migliorare Sapphire. Puoi cambiare questa impostazione in qualsiasi momento in Impostazioni > Generali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireの改善に役立てるため、匿名の利用データをGoogle Analyticsと共有します。“設定”>“一般”でいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 개선에 도움이 되도록 익명 사용 데이터를 Google Analytics와 공유합니다. 설정 > 일반에서 언제든지 변경할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe dados de uso anônimos com o Google Analytics para ajudar a melhorar o Sapphire. Você pode alterar isto a qualquer momento em Ajustes > Geral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делитесь анонимными данными использования с Google Analytics, чтобы помочь улучшить Sapphire. Это можно изменить в любой момент в «Настройки» > «Основные»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 Google Analytics 分享匿名使用数据，帮助改进 Sapphire。你可以随时在“设置”→“通用”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與 Google Analytics 分享匿名使用資料，協助改善 Sapphire。你可以隨時在「設定」→「一般」中更改。"
          }
        }
      }
    },
    "Share duration, intensity, apps, websites, and social filters for profiles that opt into settings sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauer, Intensität, Apps, Websites und Social-Filter für Profile teilen, die an der Einstellungssynchronisierung teilnehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share duration, intensity, apps, websites, and social filters for profiles that opt into settings sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte la duración, la intensidad, las apps, los sitios web y los filtros sociales de los perfiles que activan la sincronización de ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager la durée, l’intensité, les apps, les sites web et les filtres de réseaux sociaux pour les profils qui activent la synchronisation des réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi durata, intensità, app, siti web e filtri social per i profili che aderiscono alla sincronizzazione delle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の同期を有効にしたプロファイルについて、時間、強度、App、Webサイト、ソーシャルフィルタを共有します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 동기화를 선택한 프로파일의 기간, 강도, 앱, 웹사이트 및 소셜 필터를 공유합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilha duração, intensidade, apps, sites e filtros de redes sociais dos perfis que aderem à sincronização de ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делиться длительностью, интенсивностью, приложениями, сайтами и социальными фильтрами для профилей, включивших синхронизацию настроек."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为已启用设置同步的配置共享时长、强度、应用、网站和社交筛选条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為已啟用設定同步的設定檔共享時間長度、強度、App、網站及社群篩選條件。"
          }
        }
      }
    },
