    "Extract ZIP, RAR, 7-Zip, TAR, and other archives — or auto-mount and install disk images (DMGs) — from anywhere.": {
      "comment": "SettingsSection.shortDescription",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrahieren Sie ZIP-, RAR-, 7-Zip-, TAR- und andere Archive – oder mounten und installieren Sie Disk-Images (DMGs) automatisch – von überall."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extract ZIP, RAR, 7-Zip, TAR, and other archives — or auto-mount and install disk images (DMGs) — from anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrae ZIP, RAR, 7-Zip, TAR y otros archivos comprimidos, o monta e instala automáticamente imágenes de disco (DMG), desde cualquier lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrayez des archives ZIP, RAR, 7-Zip, TAR et autres — ou montez et installez automatiquement des images disque (DMG) — depuis n’importe où."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrai ZIP, RAR, 7-Zip, TAR e altri archivi, oppure monta e installa automaticamente le immagini disco (DMG), da qualsiasi posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP、RAR、7-Zip、TARなどのアーカイブの展開や、ディスクイメージ(DMG)の自動マウントとインストールを、どこからでも実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서든 ZIP, RAR, 7-Zip, TAR 및 기타 보관 파일의 압축을 풀거나 디스크 이미지(DMG)를 자동으로 마운트하고 설치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Extraia ZIP, RAR, 7-Zip, TAR e outros arquivos compactados — ou monte e instale imagens de disco (DMGs) automaticamente — de qualquer lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Извлекайте ZIP, RAR, 7-Zip, TAR и другие архивы — или автоматически монтируйте и устанавливайте образы дисков (DMG) — откуда угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从任意位置解压 ZIP、RAR、7-Zip、TAR 等归档，或自动装载磁盘映像（DMG）并安装其中的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從任何位置解壓縮 ZIP、RAR、7-Zip、TAR 及其他封存檔，或自動裝載並安裝磁碟映像檔（DMG）。"
          }
        }
      }
    },
