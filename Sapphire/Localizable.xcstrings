    "\"%@\" will be removed from your File Shelf. The actual file stays in place.": {
      "comment": "Native local UI wording in FileActionView.swift",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird aus Ihrer Dateiablage entfernt. Die eigentliche Datei bleibt an ihrem Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" will be removed from your File Shelf. The actual file stays in place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" se eliminará de tu bandeja de archivos. El archivo original permanece donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » sera retiré de votre étagère de fichiers. Le fichier d’origine reste en place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" verrà rimosso dal File Shelf. Il file effettivo resta dov'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”はファイルシェルフから削除されます。実際のファイルはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"이(가) 파일 선반에서 제거됩니다. 실제 파일은 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" será removido da Prateleira de Arquivos. O arquivo original permanece onde está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» будет удалён с вашей Полки файлов. Сам файл останется на месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将从文件暂存架移除，原文件仍保留在原位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」將從檔案暫存架移除，實際檔案仍會保留在原處。"
          }
        }
      }
    },
    "\"\\(manager.searchQuery)\" doesn't match any shortcode or keyword.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„\\(manager.searchQuery)“ stimmt mit keinem Kurzbefehl oder Stichwort überein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"\\(manager.searchQuery)\" doesn't match any shortcode or keyword."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"\\(manager.searchQuery)\" no coincide con ningún código abreviado ni palabra clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« \\(manager.searchQuery) » ne correspond à aucun raccourci ni mot-clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"\\(manager.searchQuery)\" non corrisponde ad alcuno shortcode o parola chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"\\(manager.searchQuery)\"に一致するショートコードまたはキーワードはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"\\(manager.searchQuery)\"와(과) 일치하는 단축 코드나 키워드가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"\\(manager.searchQuery)\" não corresponde a nenhum atalho de texto ou palavra-chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«\\(manager.searchQuery)» не совпадает ни с одним шорткодом или ключевым словом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“\\(manager.searchQuery)”与任何短代码或关键词都不匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「\\(manager.searchQuery)」與任何簡短代碼或關鍵字都不相符。"
          }
        }
      }
    },
