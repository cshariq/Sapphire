    "Soft, strong blur with bright diffusion.": {
      "comment": "Onboarding, app menus, helper, shared utilities, public build placeholders",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiche, starke Unschärfe mit heller Streuung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft, strong blur with bright diffusion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenfoque suave e intenso con difusión brillante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flou doux et prononcé avec une diffusion lumineuse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfocatura morbida e intensa con diffusione luminosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るい拡散を伴う、柔らかく強いぼかし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝은 확산이 있는 부드럽고 강한 블러입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfoque suave e forte com difusão brilhante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкое сильное размытие с яркой диффузией."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔和、强烈模糊且明亮扩散的效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
