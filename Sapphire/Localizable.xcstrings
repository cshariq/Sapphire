          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este método funciona para usuários Gratuitos e Premium. Use por sua conta e risco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот способ работает как для пользователей Free, так и Premium. Используйте на свой страх и риск."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此方式适用于 Free 和 Premium 用户。使用风险由你自行承担。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此方式適用於 Free 和 Premium 使用者。使用風險自負。"
          }
        }
      }
    },
    "This permanently deletes collected personalization data on this Mac.": {
      "comment": "The body of a confirmation alert that warns the user that clearing their data will delete all their personalization data.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden auf diesem Mac erfasste Personalisierungsdaten dauerhaft gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes collected personalization data on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina de forma permanente los datos de personalización recopilados en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement les données de personnalisation collectées sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina definitivamente i dati di personalizzazione raccolti su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacに収集されたパーソナライズデータを完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 수집된 개인 맞춤 데이터가 영구적으로 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto exclui permanentemente os dados de personalização coletados neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит собранные данные персонализации на этом Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除这台 Mac 上已收集的个性化数据。"
          }
