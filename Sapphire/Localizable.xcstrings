          }
        }
      }
    },
    "Blocks every app except the ones you allow. Ideal for deep-work sessions where only a few tools should exist.": {
      "comment": "FocusBlockingMode.blurb",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockiert jede App außer den von Ihnen erlaubten. Ideal für konzentrierte Arbeitssitzungen, in denen nur wenige Tools vorhanden sein sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocks every app except the ones you allow. Ideal for deep-work sessions where only a few tools should exist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea todas las apps excepto las que permitas. Ideal para sesiones de trabajo profundo en las que solo deben existir unas pocas herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque toutes les apps sauf celles que vous autorisez. Idéal pour les sessions de travail intense où seuls quelques outils doivent exister."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca tutte le app tranne quelle che consenti. Ideale per le sessioni di lavoro intenso in cui devono esistere solo pochi strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可したApp以外のすべてのAppをブロックします。ごく少数のツールだけを使いたい集中作業のセッションに最適です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용한 앱을 제외한 모든 앱을 차단합니다. 몇 가지 도구만 있어야 하는 집중 작업 세션에 적합합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia todos os apps, exceto os que você permitir. Ideal para sessões de trabalho profundo em que apenas algumas ferramentas devem existir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокирует все приложения, кроме разрешённых вами. Идеально для сеансов глубокой работы, когда нужны лишь несколько инструментов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽允许列表之外的所有应用，适合只使用少量工具的深度专注时段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封鎖你允許之外的所有 App。適合只需使用少數工具的深度工作時段。"
          }
        }
      }
    },
    "Blocks only the apps (and websites) you add to the list. Everything else stays accessible.": {
      "comment": "FocusBlockingMode.blurb",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockiert nur die Apps (und Websites), die Sie zur Liste hinzufügen. Alles andere bleibt zugänglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocks only the apps (and websites) you add to the list. Everything else stays accessible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea solo las apps (y sitios web) que añadas a la lista. Todo lo demás sigue accesible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque uniquement les apps (et sites web) que vous ajoutez à la liste. Tout le reste reste accessible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca solo le app (e i siti web) che aggiungi all'elenco. Tutto il resto resta accessibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストに追加したApp(とWebサイト)のみをブロックします。それ以外は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에 추가한 앱(및 웹사이트)만 차단합니다. 나머지는 모두 계속 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia apenas os apps (e sites) que você adicionar à lista. Todo o resto continua acessível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокирует только добавленные в список приложения (и сайты). Всё остальное остаётся доступным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅屏蔽加入列表的应用和网站，其他内容仍可访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅封鎖你加入列表的 App（和網站），其他內容仍可取用。"
          }
        }
      }
    },
