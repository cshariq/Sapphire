          "stringUnit": {
            "state": "translated",
            "value": "使用玻璃凸起、高亮的状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用玻璃浮起並醒目顯示的狀態。"
          }
        }
      }
    },
    "Use the liquid glass material for the custom notch background.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Liquid-Glass-Material für den benutzerdefinierten Notch-Hintergrund verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the liquid glass material for the custom notch background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el material Liquid Glass para el fondo de la muesca personalizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser le matériau Liquid Glass pour l’arrière-plan de l’encoche personnalisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il materiale Liquid Glass per lo sfondo del notch personalizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムノッチの背景にリキッドグラス素材を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자화 노치 배경에 리퀴드 글래스 재질을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o material liquid glass no fundo personalizado do entalhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать материал liquid glass для своего фона выреза."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为自定义刘海背景使用液态玻璃材质。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂瀏海背景使用液態玻璃材質。"
          }
        }
      }
    },
    "Use the phone as a second display — mirrored, or a true extended desktop — with stylus input.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie das Smartphone als zweites Display – gespiegelt oder als echter erweiterter Schreibtisch – mit Stifteingabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the phone as a second display — mirrored, or a true extended desktop — with stylus input."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el teléfono como segunda pantalla, duplicada o como escritorio extendido real, con entrada de lápiz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le téléphone comme second écran — recopié ou en vrai bureau étendu — avec saisie au stylet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il telefono come secondo display (in mirroring o come vera scrivania estesa) con input da stilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンを、スタイラス入力に対応した2台目のディスプレイ(ミラーリングまたは本物の拡張デスクトップ)として使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스타일러스 입력으로 휴대전화를 미러링 또는 실제 확장 데스크탑 형태의 보조 디스플레이로 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o celular como segundo monitor — espelhado ou como uma mesa estendida de verdade — com entrada por caneta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте телефон как второй дисплей — зеркальный или настоящий расширенный рабочий стол — с вводом стилусом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手机用作第二显示器，支持镜像或真正扩展桌面，并支持触控笔输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將手機用作第二顯示器，支援鏡像或真正延伸桌面，並支援觸控筆輸入。"
          }
        }
      }
    },
    "Use the phone camera and mic as a webcam, with Portrait and Desk View.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Kamera und Mikrofon des Smartphones als Webcam, mit Porträt und Schreibtischansicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the phone camera and mic as a webcam, with Portrait and Desk View."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la cámara y el micrófono del teléfono como webcam, con Retrato y Vista cenital."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la caméra et le micro du téléphone comme webcam, avec Portrait et Vue du bureau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la fotocamera e il microfono del telefono come webcam, con Ritratto e Vista scrivania."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンのカメラとマイクを、ポートレートとデスクビュー対応のWebカメラとして使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화 카메라와 마이크를 웹캠으로 사용하며 인물 사진 및 데스크 뷰를 지원합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a câmera e o microfone do celular como webcam, com Retrato e Visão da Mesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте камеру и микрофон телефона как веб-камеру с режимами «Портрет» и «Вид сверху стола»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手机摄像头和麦克风用作网络摄像头，支持人像和桌上视角。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將手機相機與麥克風用作網路攝影機，支援人像與桌上視角。"
          }
        }
      }
    },
    "Use this display's notch size, hiding and full-screen settings on every display, including ones you connect later": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notch-Größe, Ausblend- und Vollbild-Einstellungen dieses Displays auf jedem Display verwenden, auch auf später angeschlossenen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this display's notch size, hiding and full-screen settings on every display, including ones you connect later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el tamaño de la muesca, la ocultación y los ajustes de pantalla completa de esta pantalla en todas las pantallas, incluidas las que conectes más adelante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser la taille de l’encoche, le masquage et les réglages plein écran de cet écran sur tous les écrans, y compris ceux que vous connectez plus tard"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa su ogni display, compresi quelli che collegherai in seguito, le impostazioni di dimensione del notch, nascondimento e schermo intero di questo display"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスプレイのノッチのサイズ、非表示、フルスクリーンの設定を、あとから接続するものを含むすべてのディスプレイで使用します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 연결하는 디스플레이를 포함한 모든 디스플레이에서 이 디스플레이의 노치 크기, 숨기기 및 전체 화면 설정을 사용합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar o tamanho do entalhe, a ocultação e os ajustes de tela inteira deste monitor em todos os monitores, inclusive os que você conectar depois"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать размер выреза, скрытие и настройки полноэкранного режима этого дисплея на всех дисплеях, включая подключённые позже"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此显示器的刘海大小、隐藏方式和全屏设置应用到所有显示器，包括之后连接的显示器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此顯示器的瀏海大小、隱藏方式和全螢幕設定套用至所有顯示器，包括之後連接的顯示器"
          }
        }
      }
    },
    "Use this profile's blocking and social filters on your phone too. Turn off to set them separately on each device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockierung und Social-Filter dieses Profils auch auf Ihrem Telefon verwenden. Deaktivieren Sie dies, um sie auf jedem Gerät separat festzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this profile's blocking and social filters on your phone too. Turn off to set them separately on each device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa también el bloqueo y los filtros sociales de este perfil en tu teléfono. Desactívalo para ajustarlos por separado en cada dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez aussi le blocage et les filtres sociaux de ce profil sur votre téléphone. Désactivez cette option pour les définir séparément sur chaque appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa i filtri di blocco e social di questo profilo anche sul telefono. Disattiva per impostarli separatamente su ogni dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルのブロックとソーシャルフィルタをスマートフォンでも使用します。オフにすると、デバイスごとに個別に設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필의 차단 및 소셜 필터를 휴대전화에서도 사용합니다. 끄면 각 기기에서 따로 설정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os bloqueios e filtros sociais deste perfil também no celular. Desative para configurá-los separadamente em cada dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте блокировку и социальные фильтры этого профиля и на телефоне. Выключите, чтобы настраивать их отдельно на каждом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上也使用此配置方案的屏蔽和社交内容过滤设置。关闭后可在每台设备上分别设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在手機上也使用此設定組的封鎖和社群內容過濾設定。關閉後可在每部裝置上分別設定。"
          }
        }
      }
    },
    "Use trusted Wi-Fi networks as locations. Face ID will not start on other networks or when the network name is unavailable.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrauenswürdige WLAN-Netzwerke als Orte verwenden. Face ID startet in anderen Netzwerken oder wenn der Netzwerkname nicht verfügbar ist nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use trusted Wi-Fi networks as locations. Face ID will not start on other networks or when the network name is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa redes Wi-Fi de confianza como ubicaciones. Face ID no se iniciará en otras redes ni cuando el nombre de la red no esté disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser les réseaux Wi-Fi de confiance comme lieux. Face ID ne démarrera pas sur d’autres réseaux ni lorsque le nom du réseau est indisponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa le reti Wi-Fi attendibili come luoghi. Face ID non si avvia su altre reti o quando il nome della rete non è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できるWi-Fiネットワークを場所として使用します。ほかのネットワークや、ネットワーク名が利用できない場合、Face IDは開始されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰할 수 있는 Wi-Fi 네트워크를 위치로 사용합니다. 다른 네트워크이거나 네트워크 이름을 사용할 수 없을 때는 Face ID가 시작되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use redes Wi-Fi confiáveis como locais. O Face ID não iniciará em outras redes nem quando o nome da rede estiver indisponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать доверенные сети Wi-Fi как места. Face ID не запустится в других сетях или когда имя сети недоступно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将受信任的 Wi-Fi 网络用作位置条件。在其他网络上，或无法获取网络名称时，Face ID 不会启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將信任的 Wi-Fi 網路作為位置。在其他網路上或無法取得網路名稱時，Face ID 不會啟動。"
          }
        }
      }
    },
    "Use your own image or video on the desktop. A video plays behind your desktop icons and pauses whenever the desktop is covered. The lock screen shows it too unless it has its own wallpaper.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Ihr eigenes Bild oder Video auf dem Schreibtisch. Ein Video läuft hinter Ihren Schreibtischsymbolen und pausiert, sobald der Schreibtisch verdeckt ist. Der Sperrbildschirm zeigt es ebenfalls, sofern er kein eigenes Hintergrundbild hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your own image or video on the desktop. A video plays behind your desktop icons and pauses whenever the desktop is covered. The lock screen shows it too unless it has its own wallpaper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu propia imagen o vídeo en el escritorio. El vídeo se reproduce detrás de los iconos del escritorio y se pausa cuando el escritorio está tapado. La pantalla bloqueada también lo muestra, salvo que tenga su propio fondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez votre propre image ou vidéo sur le bureau. Une vidéo se lit derrière les icônes du bureau et se met en pause dès que le bureau est recouvert. L’écran de verrouillage l’affiche aussi, sauf s’il a son propre fond d’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una tua immagine o un tuo video sulla scrivania. Un video viene riprodotto dietro le icone della scrivania e va in pausa ogni volta che la scrivania è coperta. Lo mostra anche la schermata di blocco, a meno che non abbia un proprio sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップに独自の画像またはビデオを使用します。ビデオはデスクトップアイコンの背後で再生され、デスクトップが覆われると一時停止します。独自の壁紙がない限り、ロック画面にも表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크탑에 내 이미지나 비디오를 사용합니다. 비디오는 데스크탑 아이콘 뒤에서 재생되며 데스크탑이 가려지면 일시 정지됩니다. 별도의 배경화면이 없으면 잠금 화면에도 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use sua própria imagem ou vídeo na mesa. Um vídeo toca atrás dos ícones da mesa e pausa sempre que a mesa estiver coberta. A tela bloqueada também o mostra, a menos que tenha seu próprio papel de parede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте собственное изображение или видео на рабочем столе. Видео воспроизводится за значками рабочего стола и приостанавливается, когда рабочий стол закрыт. Экран блокировки тоже показывает его, если у него нет собственных обоев."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在桌面上使用你自己的图像或视频。视频在桌面图标后方播放，桌面被遮挡时暂停。锁定屏幕也会使用它，除非已单独设置墙纸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在桌面上使用你自己的影像或影片。影片會在桌面圖像後方播放，並在桌面被遮住時暫停。鎖定畫面也會顯示它，除非鎖定畫面有自己的背景圖片。"
          }
        }
      }
    },
    "Use “Android Widget (choose)” here, or Widgets on your Mac in the Sapphire phone app.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie hier „Android-Widget (auswählen)“ oder „Widgets auf Ihrem Mac“ in der Sapphire-Smartphone-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Android Widget (choose)” here, or Widgets on your Mac in the Sapphire phone app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa aquí “Widget de Android (elegir)” o Widgets en tu Mac en la app de teléfono de Sapphire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez « Widget Android (choisir) » ici, ou Widgets sur votre Mac dans l’app Sapphire du téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa qui “Widget Android (scegli)” oppure Widget sul tuo Mac nell'app Sapphire per telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで“Androidウィジェット(選択)”を使用するか、SapphireのスマートフォンAppの“Macのウィジェット”を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 “Android 위젯(선택)”을 사용하거나 Sapphire 휴대전화 앱의 내 Mac의 위젯을 사용하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Widget Android (escolher)” aqui, ou Widgets no seu Mac no app do celular do Sapphire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте здесь «Виджет Android (выбрать)» или «Виджеты» на вашем Mac в приложении Sapphire для телефона."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在此处使用“Android 小组件（选择）”，或使用 Sapphire 手机 App 中的“Mac 上的小组件”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在此處使用「Android 小工具（選擇）」，或使用 Sapphire 手機 App 中的「Mac 上的小工具」。"
          }
        }
      }
    },
    "Use ⌃, ⌥ or ⌘ with the key.": {
      "comment": "A warning for a shortcut that's not ⌃, ⌥ or ⌘.",
      "isCommentAutoGenerated": true,
      "localizations": {
