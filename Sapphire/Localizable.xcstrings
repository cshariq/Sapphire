    "Hide long-running activities like music, timers and persistent stats. Short events like HUDs, notifications and Caps Lock still show.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet lang laufende Aktivitäten wie Musik, Timer und dauerhafte Statistiken aus. Kurze Ereignisse wie HUDs, Mitteilungen und Feststelltaste werden weiterhin angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide long-running activities like music, timers and persistent stats. Short events like HUDs, notifications and Caps Lock still show."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta las actividades de larga duración, como música, temporizadores y estadísticas persistentes. Los eventos breves, como los HUD, las notificaciones y Bloq Mayús, siguen mostrándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les activités de longue durée comme la musique, les minuteurs et les statistiques persistantes. Les événements courts comme les affichages, les notifications et Verr. maj. restent visibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi le attività di lunga durata come musica, timer e statistiche persistenti. Gli eventi brevi come HUD, notifiche e Bloc Maiusc vengono comunque mostrati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージック、タイマー、永続的な統計など、長時間続くアクティビティを非表示にします。HUD、通知、Caps Lockなどの短いイベントは引き続き表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악, 타이머, 지속 통계 같은 오래 지속되는 활동을 숨깁니다. HUD, 알림, Caps Lock 같은 짧은 이벤트는 계속 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta atividades de longa duração, como música, cronômetros e estatísticas persistentes. Eventos curtos, como HUDs, notificações e Caps Lock, ainda aparecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать длительные активности, такие как музыка, таймеры и постоянная статистика. Короткие события — HUD, уведомления и Caps Lock — по-прежнему показываются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏音乐、计时器和常驻统计等持续活动。提示浮层、通知和 Caps Lock 等短暂事件仍会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏音樂、計時器和常駐統計等持續動態。浮動提示、通知和 Caps Lock 等短暫事件仍會顯示。"
          }
        }
      }
    },
