            "state": "translated",
            "value": "Las compilaciones beta requieren Basic o superior. Las cuentas gratuitas solo reciben versiones públicas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les versions bêta nécessitent Basic ou supérieur. Les comptes gratuits ne reçoivent que les versions publiques."
          }
        },
        "it": {
          "stringUnit": {
