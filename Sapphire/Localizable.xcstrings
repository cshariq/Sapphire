    "Prevent hover, click, and swipe from expanding the notch while the Mac is locked.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindern, dass Hover, Klick und Wischen die Notch erweitern, solange der Mac gesperrt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent hover, click, and swipe from expanding the notch while the Mac is locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impide que pasar el cursor, hacer clic o deslizar expanda la muesca mientras el Mac está bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêcher le survol, le clic et le balayage d’étendre l’encoche tant que le Mac est verrouillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisci che passaggio del puntatore, clic e swipe espandano il notch mentre il Mac è bloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがロックされている間、ホバー、クリック、スワイプでノッチが展開されないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 잠겨 있는 동안 마우스 오버, 클릭 및 스와이프로 노치가 확장되지 않도록 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que passar o ponteiro, clicar e deslizar expandam o entalhe enquanto o Mac está bloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не позволять наведению, щелчку и смахиванию раскрывать вырез, пока Mac заблокирован."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 锁定时，禁止通过悬停、点击或轻扫展开刘海区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 鎖定時，防止懸停、按一下和滑動展開瀏海區域。"
          }
        }
      }
    },
    "Prevent locked apps from opening until authenticated": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindern, dass gesperrte Apps sich vor der Authentifizierung öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent locked apps from opening until authenticated"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impide que se abran las apps bloqueadas hasta autenticarse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêcher l’ouverture des apps verrouillées avant authentification"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisci l'apertura delle app bloccate finché non ti autentichi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証されるまで、ロックされたAppが開かないようにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증할 때까지 잠긴 앱이 열리지 않도록 합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedir que apps bloqueados abram até a autenticação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не давать заблокированным приложениям открываться до аутентификации"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证前阻止锁定应用打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "認證前阻止鎖定的 App 開啟"
          }
        }
      }
    },
    "Prevent sleep during calibration": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhezustand während der Kalibrierung verhindern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent sleep during calibration"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedir la suspensión durante la calibración"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêcher la veille pendant l’étalonnage"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisci lo stop durante la calibrazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャリブレーション中はスリープを防止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보정 중 잠자기 방지"
          }
        },
        "pt-BR": {
          "stringUnit": {
