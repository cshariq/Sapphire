          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードがまだ設定されていません。パスワードによる代替手段を有効にするには、認証設定で設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 설정된 암호가 없습니다. 암호 대체 사용을 활성화하려면 인증 설정에서 암호를 설정하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma senha definida ainda. Defina uma nos ajustes de Autenticação para ativar a senha alternativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль ещё не задан. Задайте его в настройках аутентификации, чтобы включить вход по паролю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
