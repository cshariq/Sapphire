    "Focus Profiles work independently on either device. Sync activation and/or settings per profile — free for everyone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus-Profile funktionieren auf jedem Gerät unabhängig. Synchronisieren Sie Aktivierung und/oder Einstellungen pro Profil – kostenlos für alle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Profiles work independently on either device. Sync activation and/or settings per profile — free for everyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles de foco funcionan de forma independiente en cada dispositivo. Sincroniza la activación y/o los ajustes por perfil, gratis para todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils de concentration fonctionnent indépendamment sur chaque appareil. Synchronisez l’activation et/ou les réglages par profil — gratuit pour tout le monde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili Focus funzionano in modo indipendente su ciascun dispositivo. Sincronizza attivazione e/o impostazioni per profilo: gratis per tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中プロファイルは、どちらのデバイスでも独立して動作します。アクティベーションや設定を、プロファイルごとに同期できます。誰でも無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 프로파일은 각 기기에서 독립적으로 작동합니다. 프로파일마다 활성화 및/또는 설정을 동기화하십시오. 모든 사용자에게 무료입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Perfis de Foco funcionam de forma independente em cada dispositivo. Sincronize a ativação e/ou os ajustes por perfil — gratuito para todos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили фокусирования работают независимо на каждом устройстве. Синхронизируйте активацию и/или настройки для каждого профиля — бесплатно для всех."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注模式配置在两台设备上各自独立运行。可按配置同步启用状态和／或设置——所有人均可免费使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專注模式設定檔在兩部裝置上各自獨立運作。可依設定檔同步啟用狀態和／或設定——所有人均可免費使用。"
          }
        }
      }
    },
