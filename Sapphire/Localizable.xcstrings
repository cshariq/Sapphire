          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a Spotify dalla sezione Musica delle impostazioni di Sapphire per usare questa funzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能を使うには、Sapphireの設定の“ミュージック”セクションでSpotifyにログインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능을 사용하려면 Sapphire 설정의 음악 섹션에서 Spotify에 로그인하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login no Spotify pela seção Música dos ajustes do Sapphire para usar este recurso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
