    "Play generated white/pink/brown noise or rain to mask noisy surroundings. Starts automatically with each session.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzeugtes weißes/rosa/braunes Rauschen oder Regen abspielen, um laute Umgebungen zu überdecken. Startet automatisch mit jeder Sitzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play generated white/pink/brown noise or rain to mask noisy surroundings. Starts automatically with each session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce ruido blanco, rosa o marrón generado, o lluvia, para enmascarar entornos ruidosos. Se inicia automáticamente con cada sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez du bruit blanc/rose/brun généré ou de la pluie pour masquer l’environnement bruyant. Démarre automatiquement à chaque session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduci rumore bianco/rosa/marrone o pioggia generati per coprire l'ambiente rumoroso. Parte automaticamente a ogni sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホワイト/ピンク/ブラウンノイズや雨音を再生して、周囲の騒音をマスクします。各セッションとともに自動的に開始されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시끄러운 주변 환경을 가리기 위해 생성된 화이트/핑크/브라운 노이즈 또는 빗소리를 재생합니다. 각 세션과 함께 자동으로 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz ruído branco/rosa/marrom ou chuva gerados para mascarar ambientes barulhentos. Começa automaticamente a cada sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводите сгенерированный белый/розовый/коричневый шум или дождь, чтобы заглушить шум вокруг. Запускается автоматически с каждым сеансом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放生成的白噪声、粉红噪声、棕噪声或雨声，遮盖周围噪音。每个专注时段自动开始播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放產生的白噪音／粉紅噪音／棕噪音或雨聲，以掩蓋周遭的噪音。每個時段都會自動開始播放。"
          }
        }
      }
    },
