    },
    "No personalization screenshots stored yet. Enable the Screenshot monitor to collect (default: every 2 hours on Moderate preset).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Personalisierungs-Bildschirmfotos gespeichert. Aktivieren Sie den Bildschirmfoto-Monitor, um welche zu erfassen (Standard: alle 2 Stunden im Preset „Mäßig“)."
          }
        },
