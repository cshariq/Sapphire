    "Use “Android Widget (choose)” here, or Widgets on your Mac in the Sapphire phone app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Android Widget (choose)” here, or Widgets on your Mac in the Sapphire phone app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此处的“Android 小组件（选择）”，或手机 Sapphire 应用中的“Mac 上的小组件”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此處的「Android 小工具（選擇）」，或手機 Sapphire App 中的「Mac 上的小工具」。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie hier „Android-Widget (auswählen)“ oder „Widgets auf Ihrem Mac“ in der Sapphire-Smartphone-App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa aquí “Widget de Android (elegir)” o Widgets en tu Mac en la app de teléfono de Sapphire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez « Widget Android (choisir) » ici, ou Widgets sur votre Mac dans l’app Sapphire du téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa qui “Widget Android (scegli)” oppure Widget sul tuo Mac nell'app Sapphire per telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで“Androidウィジェット(選択)”を使用するか、SapphireのスマートフォンAppの“Macのウィジェット”を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 “Android 위젯(선택)”을 사용하거나 Sapphire 휴대전화 앱의 내 Mac의 위젯을 사용하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Widget Android (escolher)” aqui, ou Widgets no seu Mac no app do celular do Sapphire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте здесь «Виджет Android (выбрать)» или «Виджеты» на вашем Mac в приложении Sapphire для телефона."
          }
        }
      }
    },
