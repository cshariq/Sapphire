    "Free %@ users get %lld every month. Use one to revive a broken streak.": {
      "comment": "Native local UI wording in FocusStreakPanelView.swift",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzer von %@ (kostenlos) erhalten jeden Monat %lld. Verwenden Sie eines, um eine unterbrochene Serie wiederzubeleben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free %@ users get %lld every month. Use one to revive a broken streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los usuarios de %@ gratis reciben %lld cada mes. Usa uno para recuperar una racha rota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les utilisateurs %@ gratuits en reçoivent %lld chaque mois. Utilisez-en un pour relancer une série interrompue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli utenti %@ gratuiti ricevono %lld ogni mese. Usane uno per recuperare una serie interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料の%1$@ユーザは、毎月%2$lld回分を利用できます。途切れた連続記録を復活させるために1回分を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 %@ 사용자는 매월 %lld회를 받습니다. 하나를 사용하여 끊어진 연속 기록을 되살리십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuários %@ gratuitos recebem %lld por mês. Use um para recuperar uma sequência quebrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользователи %@ без подписки получают %lld каждый месяц. Используйте один, чтобы восстановить прерванную серию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费 %@ 用户每月可获得 %lld 张恢复券，用于恢复中断的连续专注记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
