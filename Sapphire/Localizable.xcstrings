        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca app e siti web che distraggono durante le sessioni di focus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中セッション中、気が散るAppやWebサイトをブロックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 세션 중에 주의를 분산시키는 앱과 웹사이트를 차단합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueie apps e sites que distraem durante as sessões de foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокируйте отвлекающие приложения и сайты во время сеансов фокусирования."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注时段内屏蔽干扰应用和网站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專注時段內封鎖會令人分心的 App 和網站。"
          }
        }
      }
    },
    "Block macOS's own iPhone Mirroring the moment it opens and start Android screen mirroring instead — useful if you have no iPhone and it's just a Dock entry that goes nowhere. Only blocks it while a phone is actually connected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockiert die iPhone-Synchronisierung von macOS, sobald sie sich öffnet, und startet stattdessen die Android-Bildschirmsynchronisierung – nützlich, wenn Sie kein iPhone haben und im Dock nur ein Eintrag ins Leere führt. Blockiert sie nur, solange ein Smartphone tatsächlich verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block macOS's own iPhone Mirroring the moment it opens and start Android screen mirroring instead — useful if you have no iPhone and it's just a Dock entry that goes nowhere. Only blocks it while a phone is actually connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea la función Duplicación de iPhone de macOS en el momento en que se abre e inicia en su lugar la duplicación de pantalla de Android; útil si no tienes iPhone y solo es una entrada del Dock que no lleva a ninguna parte. Solo la bloquea mientras hay un teléfono conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque la recopie de l’iPhone de macOS dès son ouverture et lance à la place la recopie d’écran Android — utile si vous n’avez pas d’iPhone et que ce n’est qu’une entrée du Dock qui ne mène nulle part. Ne la bloque que lorsqu’un téléphone est réellement connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca iPhone Mirroring di macOS non appena si apre e avvia invece il mirroring dello schermo Android: utile se non hai un iPhone e nel Dock è solo una voce che non porta da nessuna parte. Lo blocca solo mentre un telefono è effettivamente collegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS標準のiPhoneミラーリングが開いた瞬間にブロックし、代わりにAndroid画面ミラーリングを開始します。iPhoneを持っておらず、Dockの項目がどこにもつながっていない場合に便利です。スマートフォンが実際に接続されている間のみブロックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 자체의 iPhone 미러링이 열리는 즉시 차단하고 대신 Android 화면 미러링을 시작합니다. iPhone이 없어서 아무 곳으로도 연결되지 않는 Dock 항목일 뿐이라면 유용합니다. 휴대전화가 실제로 연결된 동안에만 차단합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia o próprio Espelhamento do iPhone do macOS assim que ele abre e inicia o espelhamento de tela do Android — útil se você não tem iPhone e ele é apenas um item do Dock que não leva a lugar nenhum. Só bloqueia enquanto um celular estiver realmente conectado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировать «Повтор экрана iPhone» от macOS при открытии и вместо него запускать повтор экрана Android — полезно, если у вас нет iPhone и это просто бесполезный значок в Dock. Блокирует только пока телефон действительно подключён."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 自带的 iPhone 镜像一打开，就将其阻止并改为启动 Android 屏幕镜像。适合没有 iPhone、程序坞中的该入口无法派上用场的情况。仅在实际连接手机时阻止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 內建的 iPhone 鏡像輸出一開啟，就將其阻擋並改為啟動 Android 螢幕鏡像。適合沒有 iPhone、Dock 中該入口無法派上用場的情況。僅在實際連接手機時阻擋。"
          }
        }
      }
    },
    "Block photos, videos, or screen captures from unlocking Face ID.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindern, dass Fotos, Videos oder Bildschirmaufnahmen Face ID entsperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block photos, videos, or screen captures from unlocking Face ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impide que fotos, vídeos o capturas de pantalla desbloqueen Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêcher les photos, vidéos ou captures d’écran de déverrouiller Face ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisci a foto, video o acquisizioni dello schermo di sbloccare Face ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真、ビデオ、画面キャプチャによるFace IDのロック解除をブロックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진, 비디오 또는 화면 캡처로 Face ID가 잠금 해제되지 않도록 차단합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedir que fotos, vídeos ou capturas de tela desbloqueiem o Face ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не давать фото, видео или снимкам экрана разблокировать Face ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止照片、视频或屏幕截图通过 Face ID 解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻擋照片、影片或螢幕截圖解鎖 Face ID。"
          }
        }
      }
    },
