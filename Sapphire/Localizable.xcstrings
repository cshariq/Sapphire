    "Save Dock layouts as presets and switch between them with a click or hotkey.": {
      "comment": "SettingsSection.shortDescription",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern Sie Dock-Layouts als Presets und wechseln Sie per Klick oder Hotkey zwischen ihnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Dock layouts as presets and switch between them with a click or hotkey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda disposiciones del Dock como presets y cambia entre ellos con un clic o un atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez des dispositions du Dock sous forme de préréglages et passez de l’une à l’autre en un clic ou avec un raccourci clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva i layout del Dock come preset e passa dall'uno all'altro con un clic o una scorciatoia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockのレイアウトをプリセットとして保存し、クリックまたはホットキーで切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 레이아웃을 프리셋으로 저장하고 클릭 또는 핫키로 전환합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve layouts do Dock como predefinições e alterne entre elas com um clique ou atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте раскладки Dock как пресеты и переключайтесь между ними щелчком или горячей клавишей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将程序坞布局保存为预设，通过点按或热键切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Dock 佈局儲存為預設組合，並按一下或使用快速鍵切換。"
          }
        }
      }
    },
    "Save Dock layouts — apps, folders, files, links, and spacers — as named presets, then switch between them instantly from settings or with a hotkey.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern Sie Dock-Layouts – Apps, Ordner, Dateien, Links und Abstandshalter – als benannte Presets und wechseln Sie sofort in den Einstellungen oder per Hotkey zwischen ihnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Dock layouts — apps, folders, files, links, and spacers — as named presets, then switch between them instantly from settings or with a hotkey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda disposiciones del Dock (apps, carpetas, archivos, enlaces y espaciadores) como presets con nombre y cambia entre ellos al instante desde los ajustes o con un atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez des dispositions du Dock — apps, dossiers, fichiers, liens et espaceurs — sous forme de préréglages nommés, puis passez de l’une à l’autre instantanément depuis les réglages ou avec un raccourci clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva i layout del Dock (app, cartelle, file, link e spaziatori) come preset con nome, poi passa dall'uno all'altro all'istante dalle impostazioni o con una scorciatoia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockのレイアウト(App、フォルダ、ファイル、リンク、スペーサ)を名前付きプリセットとして保存し、設定またはホットキーからすぐに切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱, 폴더, 파일, 링크 및 스페이서가 포함된 Dock 레이아웃을 이름이 있는 프리셋으로 저장한 다음 설정 또는 핫키로 즉시 전환하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve layouts do Dock — apps, pastas, arquivos, links e espaçadores — como predefinições com nome e alterne entre elas instantaneamente pelos ajustes ou com um atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте раскладки Dock — приложения, папки, файлы, ссылки и разделители — как именованные пресеты и мгновенно переключайтесь между ними в настройках или горячей клавишей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Dock 布局（App、文件夹、文件、链接和间隔符）存储为命名预设，然后即可通过设置或快捷键即时切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Dock 版面配置（App、檔案夾、檔案、連結和間隔符）儲存為命名預設集，然後即可透過設定或快速鍵即時切換。"
          }
        }
      }
    },
