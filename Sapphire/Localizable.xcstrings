    "Universal Back and Forward: side buttons press the app's own Back and Forward menu items, falling back to ⌘[ and ⌘] typed correctly for your keyboard layout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Universelles Zurück und Vor: Die Seitentasten drücken die eigenen Menüobjekte „Zurück“ und „Vor“ der App und greifen andernfalls auf ⌘[ und ⌘] zurück, korrekt für Ihr Tastaturlayout getippt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Universal Back and Forward: side buttons press the app's own Back and Forward menu items, falling back to ⌘[ and ⌘] typed correctly for your keyboard layout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrás y Adelante universales: los botones laterales pulsan los elementos de menú Atrás y Adelante de la propia app, recurriendo a ⌘[ y ⌘] escritos correctamente para la distribución de tu teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour et Avancer universels : les boutons latéraux activent les éléments de menu Retour et Avancer propres à l’app, avec repli sur ⌘[ et ⌘] saisis correctement selon la disposition de votre clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indietro e Avanti universali: i pulsanti laterali premono le voci di menu Indietro e Avanti dell'app, ripiegando su ⌘[ e ⌘] digitati correttamente per il layout della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユニバーサルな戻る/進む: サイドボタンで、Appの“戻る”と“進む”のメニュー項目を押します。ない場合は、キーボードレイアウトに合わせて正しく入力された⌘[と⌘]にフォールバックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범용 뒤로 및 앞으로: 사이드 버튼이 앱 자체의 뒤로 및 앞으로 메뉴 항목을 누르며, 없으면 키보드 레이아웃에 맞게 올바르게 입력된 ⌘[ 및 ⌘]로 대체합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar e Avançar universais: os botões laterais acionam os itens de menu Voltar e Avançar do próprio app, recorrendo a ⌘[ e ⌘] digitados corretamente para o layout do seu teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Универсальные «Назад» и «Вперёд»: боковые кнопки нажимают собственные пункты «Назад» и «Вперёд» приложения, а при их отсутствии — ⌘[ и ⌘], правильно вводимые для вашей раскладки клавиатуры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用后退和前进：侧键会按下 App 自身的“后退”和“前进”菜单项；若无，则回退为按你的键盘布局正确键入的 ⌘[ 和 ⌘]。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通用上一頁和下一頁：側鍵會按下 App 自身的「上一頁」和「下一頁」選單項目；若無，則改為輸入符合你鍵盤配置的 ⌘[ 和 ⌘]。"
          }
        }
      }
    },
