    "Raising the Clear Bass slider or the low EQ bands adds level below ~150 Hz and can clip into audible distortion. Ease off if it sounds crunchy.": {
      "comment": "Native local UI wording in DeviceEQView.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raising the Clear Bass slider or the low EQ bands adds level below ~150 Hz and can clip into audible distortion. Ease off if it sounds crunchy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提高清晰低音滑块或低频段，会增强约 150 Hz 以下的音量，可能产生削波失真。若出现破音，请降低增益。"
          }
        }
      }
    },
    "Rank running work alongside notifications instead of with the ambient readouts, so it shows even while music is playing.": {
      "comment": "Settings interface",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rank running work alongside notifications instead of with the ambient readouts, so it shows even while music is playing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将运行中的任务与通知放在同一优先级，而非普通状态信息，即使播放音乐时也能显示。"
          }
        }
      }
    },
    "Re-Register": {
