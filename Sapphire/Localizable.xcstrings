    "Automatically shrink copied images, compress images/PDFs/video/audio, extract text with OCR, and paste as plain text or Markdown.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkleinert kopierte Bilder automatisch, komprimiert Bilder/PDFs/Video/Audio, extrahiert Text per OCR und fügt als reinen Text oder Markdown ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
