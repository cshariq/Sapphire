            "state": "translated",
            "value": "No password set yet. Set one in Authentication settings to enable password fallback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha establecido ninguna contraseña. Establece una en los ajustes de Autenticación para habilitar la contraseña como alternativa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
