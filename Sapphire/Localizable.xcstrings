    "Checks the signal four times a second and reacts to fewer readings. Uses more energy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft das Signal viermal pro Sekunde und reagiert auf weniger Messwerte. Verbraucht mehr Energie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks the signal four times a second and reacts to fewer readings. Uses more energy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la señal cuatro veces por segundo y reacciona con menos lecturas. Consume más energía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie le signal quatre fois par seconde et réagit avec moins de mesures. Consomme plus d’énergie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il segnale quattro volte al secondo e reagisce con meno letture. Consuma più energia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1秒に4回信号を確認し、少ない測定値で反応します。消費電力が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초당 네 번 신호를 확인하고 더 적은 측정값으로 반응합니다. 에너지를 더 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica o sinal quatro vezes por segundo e reage com menos leituras. Usa mais energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяет сигнал четыре раза в секунду и реагирует по меньшему числу замеров. Расходует больше энергии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每秒检查四次信号，用更少的读数做出反应。耗电更多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每秒檢查四次訊號，用更少的讀數做出反應。耗電更多。"
          }
        }
      }
    },
