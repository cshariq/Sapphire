        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia automáticamente una sesión de foco a una hora determinada: a diario, en días concretos de la semana, semanalmente, mensualmente o una sola vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer automatiquement une session de concentration à une heure donnée — chaque jour, certains jours de la semaine, chaque semaine, chaque mois ou une seule fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia automaticamente una sessione di focus a un'ora stabilita: ogni giorno, in giorni specifici della settimana, ogni settimana, ogni mese o una sola volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日のうち設定した時刻に、集中セッションを自動開始します。毎日、特定の曜日、毎週、毎月、または1回のみを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 중 정해진 시간에 집중 세션을 자동으로 시작합니다. 매일, 특정 요일, 매주, 매월 또는 한 번만 시작할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia automaticamente uma sessão de foco em um horário definido — diariamente, em dias específicos da semana, semanalmente, mensalmente ou uma única vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически запускать сеанс фокусирования в заданное время — ежедневно, по определённым дням недели, еженедельно, ежемесячно или один раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在指定时间自动开始专注时段，可设为每天、每周指定日期、每周、每月或仅一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在指定時間自動開始專注時段，可設為每天、每週特定日子、每週、每月或僅一次。"
          }
        }
      }
    },
