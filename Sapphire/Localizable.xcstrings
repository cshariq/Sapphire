    "Show the artist avatar, verified check, and monthly listeners instead of plain artist text.": {
      "comment": "Settings interface",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Künstler-Avatar, das Bestätigungshäkchen und die monatlichen Hörer statt einfachem Künstlertext anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the artist avatar, verified check, and monthly listeners instead of plain artist text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el avatar del artista, la marca de verificado y los oyentes mensuales en lugar del texto simple del artista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher l’avatar de l’artiste, la coche de vérification et les auditeurs mensuels au lieu d’un simple texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l'avatar dell'artista, il segno di verifica e gli ascoltatori mensili invece del semplice testo dell'artista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常のアーティストのテキストの代わりに、アーティストのアバター、認証済みチェック、月間リスナーを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 아티스트 텍스트 대신 아티스트 아바타, 인증 체크 표시 및 월간 청취자를 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o avatar do artista, a marca de verificado e os ouvintes mensais em vez de apenas o texto do artista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать аватар исполнителя, значок подтверждения и слушателей в месяц вместо простого текста с именем исполнителя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示艺人头像、认证标记和月听众数，替代纯文字艺人名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示藝人頭像、認證標記和每月聽眾數，而非純文字的藝人名稱。"
          }
        }
      }
    },
    "Show the artist's picture next to their name. Spotify adds the verified check and monthly listeners; Apple Music adds genre, release year and your play count.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild des Künstlers neben seinem Namen anzeigen. Spotify ergänzt das Bestätigungshäkchen und die monatlichen Hörer; Apple Music ergänzt Genre, Erscheinungsjahr und Ihre Wiedergabeanzahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the artist's picture next to their name. Spotify adds the verified check and monthly listeners; Apple Music adds genre, release year and your play count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la foto del artista junto a su nombre. Spotify añade la marca de verificado y los oyentes mensuales; Apple Music añade el género, el año de lanzamiento y tu número de reproducciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la photo de l’artiste à côté de son nom. Spotify ajoute la coche de vérification et les auditeurs mensuels ; Apple Music ajoute le genre, l’année de sortie et votre nombre de lectures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l'immagine dell'artista accanto al suo nome. Spotify aggiunge il segno di verifica e gli ascoltatori mensili; Apple Music aggiunge genere, anno di uscita e il tuo numero di riproduzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前の横にアーティストの写真を表示します。Spotifyでは認証済みチェックと月間リスナーが、Apple Musicではジャンル、リリース年、再生回数が追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아티스트 이름 옆에 아티스트 사진을 표시합니다. Spotify는 인증 체크 표시와 월간 청취자를, Apple Music은 장르, 발매 연도 및 내 재생 횟수를 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a foto do artista ao lado do nome. O Spotify adiciona a marca de verificado e os ouvintes mensais; o Apple Music adiciona gênero, ano de lançamento e sua contagem de reproduções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать фото исполнителя рядом с именем. Spotify добавляет значок подтверждения и слушателей в месяц; Apple Music — жанр, год выпуска и число ваших прослушиваний."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在艺人姓名旁显示照片。Spotify 会补充认证标记和月度听众数；Apple Music 会补充流派、发行年份和你的播放次数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在藝人姓名旁顯示照片。Spotify 會補充認證標記與每月聽眾數；Apple Music 會補充曲風、發行年份及你的播放次數。"
          }
        }
      }
    },
