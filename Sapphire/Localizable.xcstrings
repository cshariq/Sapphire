    "For devices like HomePods, show a device-specific icon in the volume HUD.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt bei Geräten wie dem HomePod ein gerätespezifisches Symbol im Lautstärke-HUD an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For devices like HomePods, show a device-specific icon in the volume HUD."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para dispositivos como HomePod, muestra un icono específico del dispositivo en el HUD de volumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les appareils comme les HomePod, afficher une icône propre à l’appareil dans l’affichage du volume."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per dispositivi come HomePod, mostra nell'HUD del volume un'icona specifica del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePodなどのデバイスでは、音量HUDにデバイス専用のアイコンを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePod 같은 기기의 볼륨 HUD에 기기별 아이콘을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para dispositivos como HomePods, mostra um ícone específico do dispositivo no HUD de volume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для устройств вроде HomePod показывать в HUD громкости значок конкретного устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于 HomePod 等设备，在音量提示浮层中显示对应的设备图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "針對 HomePod 等裝置，在音量浮動提示中顯示裝置專屬圖像。"
          }
        }
      }
    },
    "For displays you haven't switched on or off below, including ones you connect later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Displays, die Sie unten nicht ein- oder ausgeschaltet haben, einschließlich später angeschlossener."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For displays you haven't switched on or off below, including ones you connect later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para las pantallas que no hayas activado ni desactivado abajo, incluidas las que conectes más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les écrans que vous n’avez pas activés ou désactivés ci-dessous, y compris ceux que vous connectez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per i display che non hai attivato o disattivato qui sotto, inclusi quelli che collegherai in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下でオンまたはオフにしていないディスプレイ(あとから接続するものを含む)に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에서 켜거나 끄지 않은 디스플레이(나중에 연결하는 디스플레이 포함)에 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para monitores que você não ativou nem desativou abaixo, incluindo os que conectar depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для дисплеев, которые вы не включали и не выключали ниже, включая подключённые позже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于下方尚未单独开启或关闭的显示器，包括以后连接的显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於下方尚未個別開啟或關閉的顯示器，包括之後連接的顯示器。"
          }
        }
      }
    },
    "For logged-in Spotify accounts, hide the music widget when Spotify is not running on this Mac and Spotify is the only media source.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet bei angemeldeten Spotify-Accounts das Musik-Widget aus, wenn Spotify auf diesem Mac nicht läuft und Spotify die einzige Medienquelle ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For logged-in Spotify accounts, hide the music widget when Spotify is not running on this Mac and Spotify is the only media source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cuentas de Spotify con sesión iniciada, oculta el widget de música cuando Spotify no se está ejecutando en este Mac y es la única fuente multimedia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les comptes Spotify connectés, masquer le widget musique lorsque Spotify n’est pas ouvert sur ce Mac et que Spotify est la seule source multimédia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per gli account Spotify con accesso effettuato, nascondi il widget musica quando Spotify non è in esecuzione su questo Mac e Spotify è l'unica fonte multimediale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン済みのSpotifyアカウントで、このMacでSpotifyが実行されておらず、Spotifyが唯一のメディアソースの場合、ミュージックウィジェットを非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 계정에 로그인한 경우, 이 Mac에서 Spotify가 실행 중이 아니고 Spotify가 유일한 미디어 소스이면 음악 위젯을 숨깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em contas do Spotify com login, oculta o widget de música quando o Spotify não está em execução neste Mac e é a única fonte de mídia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вошедших в Spotify учётных записей скрывать музыкальный виджет, когда Spotify не запущен на этом Mac и является единственным источником медиа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于已登录的 Spotify 账户，如果 Spotify 未在这台 Mac 上运行，且它是唯一的媒体来源，则隐藏音乐小组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對於已登入的 Spotify 帳號，如果 Spotify 未在這部 Mac 上執行，且它是唯一的媒體來源，則隱藏音樂小工具。"
          }
        }
      }
    },
    "Force Low Power Mode while the lid is partially closed and restore the previous state when reopened.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzwingt den Energiesparmodus, solange der Deckel teilweise geschlossen ist, und stellt beim erneuten Öffnen den vorherigen Zustand wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force Low Power Mode while the lid is partially closed and restore the previous state when reopened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuerza el modo de bajo consumo mientras la tapa está parcialmente cerrada y restaura el estado anterior al abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcer le mode économie d’énergie tant que le capot est partiellement fermé et rétablir l’état précédent à sa réouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forza Risparmio energia mentre il coperchio è parzialmente chiuso e ripristina lo stato precedente alla riapertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋が半分閉じている間は低電力モードを強制し、再び開いたら以前の状態に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개가 일부 닫혀 있는 동안 저전력 모드를 강제하고 다시 열리면 이전 상태를 복원합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Força o Modo de Pouca Energia enquanto a tampa está parcialmente fechada e restaura o estado anterior quando reaberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принудительно включать режим энергосбережения, пока крышка частично закрыта, и восстанавливать прежнее состояние при открытии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕部分合上时强制启用低电量模式，重新打开时恢复原状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上蓋部分闔上時強制啟用低耗電模式，重新打開時回復先前狀態。"
          }
        }
      }
    },
    "Force a specific layout mode (Single or Multi) when dragging a particular app.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ziehen einer bestimmten App einen bestimmten Layoutmodus (Einzeln oder Multi) erzwingen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force a specific layout mode (Single or Multi) when dragging a particular app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuerza un modo de disposición concreto (Simple o Múltiple) al arrastrar una app determinada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcer un mode de disposition précis (Simple ou Multi) lors du glissement d’une app particulière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forza una modalità di layout specifica (Singolo o Multiplo) quando trascini una determinata app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特定のAppをドラッグするときに、特定のレイアウトモード(シングルまたはマルチ)を強制します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특정 앱을 드래그할 때 특정 레이아웃 모드(단일 또는 다중)를 강제합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Força um modo de layout específico (Único ou Múltiplo) ao arrastar um app em particular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принудительно задавать режим раскладки (одиночный или мульти) при перетаскивании определённого приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动特定应用时，强制使用指定的布局模式（单视图或多视图）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移特定 App 時，強制使用指定的佈局模式（單一或多重）。"
          }
        }
      }
    },
    "Force light or dark glass, or follow the system.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helles oder dunkles Glas erzwingen oder dem System folgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force light or dark glass, or follow the system."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuerza el cristal claro u oscuro, o sigue el del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcer un verre clair ou sombre, ou suivre le système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forza il vetro chiaro o scuro, oppure segui il sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトまたはダークのガラスを強制するか、システムに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이트 또는 다크 유리를 강제하거나 시스템을 따릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Força vidro claro ou escuro, ou segue o sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принудительно светлое или тёмное стекло, либо следовать системе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制使用浅色或深色玻璃，也可跟随系统。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強制使用淺色或深色玻璃，也可跟隨系統。"
          }
        }
      }
    },
    "Force-close a locked or covered app after three consecutive failed authentication attempts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gesperrte oder verdeckte App nach drei aufeinanderfolgenden fehlgeschlagenen Authentifizierungsversuchen zwangsweise beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force-close a locked or covered app after three consecutive failed authentication attempts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuerza el cierre de una app bloqueada o tapada tras tres intentos de autenticación fallidos consecutivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer de force une app verrouillée ou masquée après trois échecs d’authentification consécutifs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi forzatamente un'app bloccata o coperta dopo tre tentativi di autenticazione consecutivi non riusciti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証に3回連続で失敗すると、ロックされた、または覆われたAppを強制終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증에 3회 연속 실패하면 잠겨 있거나 가려진 앱을 강제 종료합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fecha à força um app bloqueado ou coberto após três tentativas de autenticação malsucedidas consecutivas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принудительно закрывать заблокированное или закрытое приложение после трёх подряд неудачных попыток аутентификации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续三次认证失败后，强制关闭已锁定或被遮罩覆盖的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續三次認證失敗後，強制關閉已鎖定或被遮罩覆蓋的 App。"
          }
        }
      }
    },
