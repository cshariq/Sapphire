    "The green traffic-light button fills the screen without creating a new Space; clicking it again restores the window.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die grüne Ampeltaste füllt den Bildschirm, ohne einen neuen Space zu erstellen; ein erneuter Klick stellt das Fenster wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The green traffic-light button fills the screen without creating a new Space; clicking it again restores the window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón verde del semáforo llena la pantalla sin crear un nuevo Space; al volver a hacer clic se restaura la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton vert des feux tricolores remplit l’écran sans créer de nouveau Space ; cliquer de nouveau dessus restaure la fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante verde dei semafori riempie lo schermo senza creare un nuovo Space; facendo di nuovo clic si ripristina la finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑の信号ボタンは、新しいSpaceを作成せずに画面全体に広げます。もう一度クリックすると、ウインドウが元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹색 신호등 버튼은 새 Space를 만들지 않고 화면을 채우며, 다시 클릭하면 윈도우가 복원됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão verde do semáforo preenche a tela sem criar um novo Space; clicar nele novamente restaura a janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зелёная кнопка окна разворачивает его на весь экран без создания нового Space; повторное нажатие восстанавливает окно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击绿色窗口按钮时填满屏幕，不创建新空间；再次点击可恢复窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綠色紅綠燈按鈕會填滿螢幕而不建立新的空間；再按一下即可回復視窗。"
          }
        }
      }
    },
