    "Display an authentication status activity in the notch on the lock screen.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt auf dem Sperrbildschirm eine Authentifizierungsstatus-Aktivität in der Notch an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display an authentication status activity in the notch on the lock screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra en la muesca de la pantalla bloqueada una actividad con el estado de autenticación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une activité d’état d’authentification dans l’encoche sur l’écran de verrouillage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra nel notch, sulla schermata di blocco, un'attività sullo stato di autenticazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面のノッチに、認証ステータスのアクティビティを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면의 노치에 인증 상태 활동을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe uma atividade de status de autenticação no entalhe na tela bloqueada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать в вырезе на экране блокировки активность состояния аутентификации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁定屏幕的刘海区域中显示身份验证状态活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鎖定畫面的瀏海區域中顯示驗證狀態活動。"
          }
        }
      }
    },
    "Display app volume in the normal volume HUD (like Spotify). When disabled, only shows with Option + Volume keys.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die App-Lautstärke im normalen Lautstärke-HUD an (wie bei Spotify). Wenn deaktiviert, erscheint sie nur mit Wahltaste + Lautstärketasten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display app volume in the normal volume HUD (like Spotify). When disabled, only shows with Option + Volume keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el volumen de la app en el HUD de volumen normal (como Spotify). Si se desactiva, solo aparece con Opción + teclas de volumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le volume de l’app dans l’affichage de volume normal (comme Spotify). Désactivé, il ne s’affiche qu’avec Option + touches de volume."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il volume delle app nell'HUD del volume normale (come Spotify). Se disattivato, compare solo con Opzione + tasti volume."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の音量HUDにApp別の音量を表示します(Spotifyなど)。オフの場合、Optionキーと音量キーを押したときのみ表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 볼륨 HUD에 앱 볼륨을 표시합니다(Spotify처럼). 비활성화하면 Option + 볼륨 키를 누를 때만 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe o volume do app no HUD de volume normal (como no Spotify). Quando desativado, só aparece com Option + teclas de volume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать громкость приложения в обычном HUD громкости (как у Spotify). Если выключено, показывается только с Option + клавиши громкости."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像 Spotify 一样，在常规音量提示浮层中显示应用音量。关闭后，仅在按住 Option 并按音量键时显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在一般音量浮動提示中顯示 App 音量（例如 Spotify）。停用時，僅在按住 Option 並按音量鍵時顯示。"
          }
        }
      }
    },
    "Display brightness as a row of dots instead of a bar.": {
