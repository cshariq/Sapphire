    "No Spotify devices online. Open Spotify on this Mac or another device to play audio. Sapphire only controls playback.": {
      "comment": "Native local UI wording in MusicHubViews.swift",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Spotify-Geräte online. Öffnen Sie Spotify auf diesem Mac oder einem anderen Gerät, um Audio wiederzugeben. Sapphire steuert nur die Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Spotify devices online. Open Spotify on this Mac or another device to play audio. Sapphire only controls playback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay dispositivos de Spotify en línea. Abre Spotify en este Mac o en otro dispositivo para reproducir audio. Sapphire solo controla la reproducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appareil Spotify en ligne. Ouvrez Spotify sur ce Mac ou sur un autre appareil pour lire de l’audio. Sapphire ne contrôle que la lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dispositivo Spotify online. Apri Spotify su questo Mac o su un altro dispositivo per riprodurre l’audio. Sapphire controlla solo la riproduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインのSpotifyデバイスがありません。音声を再生するには、このMacまたは別のデバイスでSpotifyを開いてください。Sapphireは再生の操作のみを行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 상태인 Spotify 기기가 없습니다. 오디오를 재생하려면 이 Mac 또는 다른 기기에서 Spotify를 여십시오. Sapphire는 재생만 제어합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum dispositivo Spotify on-line. Abra o Spotify neste Mac ou em outro dispositivo para reproduzir áudio. O Sapphire só controla a reprodução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет устройств Spotify в сети. Откройте Spotify на этом Mac или другом устройстве, чтобы воспроизводить звук. Sapphire только управляет воспроизведением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有在线的 Spotify 设备。请在这台 Mac 或其他设备上打开 Spotify 播放音频。Sapphire 仅控制播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有在線上的 Spotify 裝置。請在這台 Mac 或其他裝置上打開 Spotify 來播放音訊。Sapphire 僅控制播放。"
          }
        }
      }
    },
    "No Spotify speakers online. Open the Spotify desktop app (or another Connect device) to play audio — Sapphire only controls playback.": {
      "comment": "Native local UI wording in MusicHubViews.swift",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Spotify-Lautsprecher online. Öffnen Sie die Spotify-Desktop-App (oder ein anderes Connect-Gerät), um Audio abzuspielen – Sapphire steuert nur die Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Spotify speakers online. Open the Spotify desktop app (or another Connect device) to play audio — Sapphire only controls playback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay altavoces de Spotify en línea. Abre la app de escritorio de Spotify (u otro dispositivo Connect) para reproducir audio; Sapphire solo controla la reproducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune enceinte Spotify en ligne. Ouvrez l’app de bureau Spotify (ou un autre appareil Connect) pour lire de l’audio — Sapphire ne fait que contrôler la lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun altoparlante Spotify online. Apri l'app Spotify per desktop (o un altro dispositivo Connect) per riprodurre l'audio: Sapphire controlla solo la riproduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインのSpotifyスピーカーがありません。オーディオを再生するには、Spotifyデスクトップアプリ(または別のConnectデバイス)を開いてください。Sapphireは再生を制御するのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 상태인 Spotify 스피커가 없습니다. Spotify 데스크탑 앱(또는 다른 Connect 기기)을 열어 오디오를 재생하십시오. Sapphire는 재생만 제어합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum alto-falante do Spotify online. Abra o app do Spotify para computador (ou outro dispositivo Connect) para reproduzir áudio — o Sapphire apenas controla a reprodução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Колонки Spotify не в сети. Откройте приложение Spotify для компьютера (или другое устройство Connect), чтобы воспроизвести звук — Sapphire лишь управляет воспроизведением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有在线的 Spotify 播放设备。请打开 Spotify 桌面应用或其他 Connect 设备播放音频；Sapphire 仅控制播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有在線上的 Spotify 揚聲器。請打開 Spotify 桌面 App（或其他 Connect 裝置）來播放音訊，Sapphire 僅控制播放。"
          }
        }
      }
    },
