    "%@ doesn't keep a transcript Sapphire can read. Processes are listed on the right tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ speichert kein Protokoll, das Sapphire lesen kann. Prozesse werden im rechten Tab aufgelistet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doesn't keep a transcript Sapphire can read. Processes are listed on the right tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no guarda una transcripción que Sapphire pueda leer. Los procesos aparecen en la pestaña de la derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne conserve pas de transcription que Sapphire peut lire. Les processus sont listés dans l’onglet de droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non conserva una trascrizione leggibile da Sapphire. I processi sono elencati nella scheda a destra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはSapphireが読み取れる記録がありません。プロセスは右のタブに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) Sapphire에서 읽을 수 있는 대화 기록을 보관하지 않습니다. 프로세스는 오른쪽 탭에 나열됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não mantém uma transcrição que o Sapphire possa ler. Os processos estão listados na aba à direita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не хранит расшифровку, доступную Sapphire. Процессы показаны на правой вкладке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不会保留 Sapphire 可读取的对话记录。进程列在右侧标签页中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不會保留 Sapphire 可讀取的對話記錄。程序列在右側標籤頁中。"
          }
        }
      }
    },
    "%@ doesn't let other apps read its tabs. Send input below or open it to see the output.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erlaubt anderen Apps nicht, seine Tabs zu lesen. Senden Sie unten eine Eingabe oder öffnen Sie die App, um die Ausgabe zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doesn't let other apps read its tabs. Send input below or open it to see the output."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no permite que otras apps lean sus pestañas. Envía texto abajo o ábrela para ver la salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’autorise pas les autres apps à lire ses onglets. Envoyez une saisie ci-dessous ou ouvrez-le pour voir la sortie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non consente ad altre app di leggere le sue schede. Invia l'input qui sotto o aprilo per vedere l'output."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は他のAppからタブを読み取れないようにしています。下で入力を送信するか、開いて出力を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 다른 앱이 해당 탭을 읽도록 허용하지 않습니다. 아래에 입력을 보내거나 앱을 열어 출력을 확인하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não permite que outros apps leiam suas abas. Envie a entrada abaixo ou abra-o para ver a saída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не позволяет другим приложениям читать свои вкладки. Отправьте ввод ниже или откройте приложение, чтобы увидеть вывод."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不允许其他应用读取其标签页。请在下方发送输入，或打开它查看输出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不允許其他 App 讀取其分頁。請在下方傳送輸入，或開啟它查看輸出。"
