    },
    "The default. A quick and responsive feel with minimal bounce.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standardeinstellung. Ein schnelles, reaktionsfreudiges Gefühl mit minimalem Nachfedern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default. A quick and responsive feel with minimal bounce."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor predeterminado. Una sensación rápida y reactiva con un rebote mínimo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglage par défaut. Une sensation rapide et réactive avec un rebond minimal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito. Un effetto rapido e reattivo con un rimbalzo minimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルト。弾みが少なく、素早く反応する感触。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값입니다. 튕김이 거의 없는 빠르고 반응성 좋은 느낌입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O padrão. Uma sensação rápida e responsiva com ricochete mínimo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию. Быстрая и отзывчивая анимация с минимальным отскоком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认效果。响应轻快，回弹幅度很小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設效果。輕快靈敏，回彈幅度極小。"
          }
        }
      }
    },
    "The default. Content grows out of the notch with the shape, blurring into focus as it lands.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standardeinstellung. Inhalte wachsen mit der Form aus der Notch und werden beim Erreichen scharf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default. Content grows out of the notch with the shape, blurring into focus as it lands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor predeterminado. El contenido crece desde la muesca con su forma, desenfocándose hasta enfocarse al llegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglage par défaut. Le contenu sort de l’encoche avec sa forme, en se précisant progressivement à l’arrivée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito. Il contenuto cresce dal notch con la sua forma, mettendosi a fuoco gradualmente man mano che arriva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルト。コンテンツがノッチの形から広がり、ぼかしからピントが合うように表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값입니다. 콘텐츠가 모양과 함께 노치에서 커지며 도착하면서 초점이 맞춰집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O padrão. O conteúdo cresce a partir do entalhe com a forma, entrando em foco gradualmente ao chegar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию. Содержимое вырастает из выреза вместе с формой, проявляясь из размытия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认效果。内容随刘海形状一同展开，在到位时由模糊逐渐变清晰。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設效果。內容隨瀏海形狀一同展開，在到位時由模糊逐漸變清晰。"
          }
        }
      }
    },
