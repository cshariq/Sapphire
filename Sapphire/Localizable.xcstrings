    "The launch item could not be stopped and was left in place: %@. %@": {
      "comment": "Settings dynamic interpolated presentation; key and placeholder types verified against module-build-01 compiler output.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Startobjekt konnte nicht gestoppt werden und blieb an seinem Ort: %@. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The launch item could not be stopped and was left in place: %@. %@"
          }
        },
        "es": {
