    "Build your custom Dock here — apps go in Apps, folders, files, links, and spacers on the right side.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie hier Ihr eigenes Dock – Apps kommen unter „Apps“, Ordner, Dateien, Links und Abstandshalter auf die rechte Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build your custom Dock here — apps go in Apps, folders, files, links, and spacers on the right side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea aquí tu Dock personalizado: las apps van en Apps; las carpetas, archivos, enlaces y separadores, en el lado derecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez ici votre Dock personnalisé — les apps vont dans Apps, les dossiers, fichiers, liens et espaceurs sur le côté droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea qui il tuo Dock personalizzato: le app vanno in App, mentre cartelle, file, link e spaziatori vanno sulla destra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでカスタムDockを作成します。Appは“App”に、フォルダ、ファイル、リンク、スペーサは右側に入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 사용자화 Dock을 만드십시오. 앱은 앱에, 폴더, 파일, 링크 및 스페이서는 오른쪽에 넣습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte seu Dock personalizado aqui — apps vão em Apps; pastas, arquivos, links e espaçadores ficam no lado direito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соберите здесь свой Dock — приложения идут в «Приложения», а папки, файлы, ссылки и разделители — справа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此构建你的自定义 Dock——App 放在“App”中，文件夹、文件、链接和间隔符放在右侧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此建立你的自訂 Dock——App 放在「App」中，檔案夾、檔案、連結和間隔符放在右側。"
          }
        }
      }
    },
