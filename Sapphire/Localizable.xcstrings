    "Multi-audio won't work without Screen Recording permission. Sapphire needs it to adjust app volumes, eqs and more.": {
      "comment": "Native local UI wording in MultiAudioView.swift",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-Audio funktioniert nicht ohne die Berechtigung „Bildschirmaufnahme“. Sapphire benötigt sie, um App-Lautstärken, Equalizer und mehr anzupassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-audio won't work without Screen Recording permission. Sapphire needs it to adjust app volumes, eqs and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiaudio no funcionará sin el permiso de Grabación de pantalla. Sapphire lo necesita para ajustar el volumen de las apps, los ecualizadores y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le multi-audio ne fonctionnera pas sans l’autorisation Enregistrement de l’écran. Sapphire en a besoin pour ajuster les volumes des apps, les égaliseurs et plus encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-Audio non funzionerà senza l'autorizzazione Registrazione schermo. Sapphire ne ha bisogno per regolare i volumi delle app, gli equalizzatori e altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録の権限がないと、マルチオーディオは機能しません。Appの音量、EQなどを調整するためにSapphireに必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 기록 권한이 없으면 멀티 오디오가 작동하지 않습니다. Sapphire가 앱 볼륨, EQ 등을 조정하려면 이 권한이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Multi-Audio não funcionará sem a permissão de Gravação de Tela. O Sapphire precisa dela para ajustar volumes de apps, equalizadores e mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мультиаудио не будет работать без разрешения на запись экрана. Оно нужно Sapphire для регулировки громкости приложений, эквалайзера и многого другого."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多路音频需要屏幕录制权限。Sapphire 使用此权限调整应用音量、均衡器等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有「螢幕錄製」權限，多重音訊將無法運作。Sapphire 需要此權限才能調整 App 音量、EQ 等。"
          }
        }
      }
    },
