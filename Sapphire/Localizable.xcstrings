          "stringUnit": {
            "state": "translated",
            "value": "Dê a uma tecla desgastada sua própria janela; 0 nunca filtra essa tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте изношенной клавише собственное окно; 0 — эта клавиша никогда не фильтруется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为磨损的按键单独设置时间窗口；0 表示绝不过滤该按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為磨損的按鍵單獨設定時間範圍；0 表示絕不過濾該按鍵。"
          }
        }
      }
    },
    "Gives that window the whole screen. Double-click again to go back to where you were.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt diesem Fenster den ganzen Bildschirm. Doppelklicken Sie erneut, um dorthin zurückzugehen, wo Sie waren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gives that window the whole screen. Double-click again to go back to where you were."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da a esa ventana toda la pantalla. Vuelve a hacer doble clic para regresar a donde estabas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne tout l’écran à cette fenêtre. Double-cliquez à nouveau pour revenir où vous étiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dà a quella finestra l'intero schermo. Fai di nuovo doppio clic per tornare dove eri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのウインドウを画面全体に広げます。もう一度ダブルクリックすると元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 윈도우가 전체 화면을 채웁니다. 다시 더블 클릭하면 이전 상태로 돌아갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá a essa janela a tela inteira. Clique duas vezes novamente para voltar a onde estava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разворачивает это окно на весь экран. Дважды щёлкните снова, чтобы вернуться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让该窗口占满整个屏幕。再次双击即可返回原来的状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓該視窗佔滿整個螢幕。再次連按兩下即可返回原來的狀態。"
          }
        }
      }
    },
