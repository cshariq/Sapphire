    "Some apps only take shortcuts in front; after muting or toggling video, switch back to what you were using.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Apps nehmen Kurzbefehle nur im Vordergrund an; wechseln Sie nach dem Stummschalten oder Umschalten des Videos zurück zu dem, was Sie verwendet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some apps only take shortcuts in front; after muting or toggling video, switch back to what you were using."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas apps solo reciben atajos cuando están al frente; tras silenciar o activar el vídeo, vuelve a lo que estabas usando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines apps n’acceptent les raccourcis qu’au premier plan ; après avoir coupé le micro ou activé/désactivé la vidéo, revenez à ce que vous utilisiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune app accettano le scorciatoie solo in primo piano; dopo aver silenziato o attivato il video, torna a ciò che stavi usando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のAppは、最前面でのみショートカットを受け付けます。ミュートやビデオの切り替えのあとは、元のAppに戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 앱은 앞에 있을 때만 단축키를 받습니다. 음소거하거나 비디오를 전환한 후에는 사용하던 앱으로 다시 전환하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns apps só aceitam atalhos quando estão na frente; depois de silenciar ou alternar o vídeo, volte ao que você estava usando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые приложения принимают сочетания клавиш только на переднем плане; после отключения звука или переключения видео вернитесь к тому, чем пользовались."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某些应用仅在前台响应快捷键；静音或切换视频后，返回你之前使用的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某些 App 僅在最前方回應快速鍵；靜音或切換視訊後，返回你先前使用的 App。"
          }
        }
      }
    },
