    "Sapphire tucked them out of view last time and wrote down where they were. %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire hat sie beim letzten Mal aus der Ansicht weggeräumt und notiert, wo sie waren. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire tucked them out of view last time and wrote down where they were. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire las ocultó la última vez y anotó dónde estaban. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire les a mises à l’abri la dernière fois et a noté où elles se trouvaient. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire le aveva messe da parte l'ultima volta e ha annotato dove si trovavano. %@"
