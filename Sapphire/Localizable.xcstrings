    "Empty the clipboard this long after you copy something.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leert die Zwischenablage so lange nach dem Kopieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty the clipboard this long after you copy something."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía el portapapeles transcurrido este tiempo desde que copias algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider le presse-papiers après ce délai suivant une copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota gli appunti dopo questo tempo da quando copi qualcosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かをコピーしてからこの時間が経過したら、クリップボードを空にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무언가를 복사한 후 이만큼의 시간이 지나면 클립보드를 비웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esvazia a área de transferência este tempo depois de você copiar algo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищать буфер обмена через это время после копирования."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制内容后等待指定时间，再清空剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝內容後經過此時間即清除剪貼簿。"
          }
        }
      }
    },
    "Empty the clipboard when the Mac (or its display) sleeps.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leert die Zwischenablage, wenn der Mac (oder sein Display) in den Ruhezustand wechselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty the clipboard when the Mac (or its display) sleeps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía el portapapeles cuando el Mac (o su pantalla) entra en reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider le presse-papiers lorsque le Mac (ou son écran) se met en veille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota gli appunti quando il Mac (o il suo display) va in stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac(またはそのディスプレイ)がスリープしたとき、クリップボードを空にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac(또는 디스플레이)이 잠자기 상태가 되면 클립보드를 비웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esvazia a área de transferência quando o Mac (ou o monitor dele) entra em repouso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищать буфер обмена, когда Mac (или его дисплей) засыпает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 或显示器睡眠时清空剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac（或其顯示器）睡眠時清除剪貼簿。"
          }
        }
      }
    },
    "Empty the clipboard when the screen locks.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leert die Zwischenablage, wenn der Bildschirm gesperrt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty the clipboard when the screen locks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía el portapapeles cuando se bloquea la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider le presse-papiers lorsque l’écran se verrouille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota gli appunti quando lo schermo si blocca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面がロックされたとき、クリップボードを空にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 잠기면 클립보드를 비웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esvazia a área de transferência quando a tela é bloqueada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищать буфер обмена при блокировке экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕锁定时清空剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕鎖定時清除剪貼簿。"
          }
        }
      }
    },
    "Empty the system clipboard a set time after copying, or when the Mac sleeps or the screen locks. Saved history items are never touched.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leert die System-Zwischenablage nach einer festgelegten Zeit nach dem Kopieren oder wenn der Mac in den Ruhezustand wechselt oder der Bildschirm gesperrt wird. Gesicherte Verlaufsobjekte bleiben unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty the system clipboard a set time after copying, or when the Mac sleeps or the screen locks. Saved history items are never touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía el portapapeles del sistema un tiempo determinado después de copiar, o cuando el Mac entra en reposo o se bloquea la pantalla. Los elementos guardados del historial nunca se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider le presse-papiers du système après un délai suivant la copie, ou lorsque le Mac se met en veille ou que l’écran se verrouille. Les éléments enregistrés dans l’historique ne sont jamais touchés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota gli appunti di sistema dopo un tempo stabilito dalla copia, o quando il Mac va in stop o lo schermo si blocca. Gli elementi salvati nella cronologia non vengono mai toccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーから一定時間後、またはMacのスリープや画面のロック時に、システムのクリップボードを空にします。保存済みの履歴項目には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사 후 정해진 시간이 지나거나 Mac이 잠자기 상태가 되거나 화면이 잠기면 시스템 클립보드를 비웁니다. 저장된 기록 항목은 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esvazia a área de transferência do sistema um tempo definido após copiar, ou quando o Mac entra em repouso ou a tela é bloqueada. Os itens salvos no histórico nunca são afetados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищать системный буфер обмена через заданное время после копирования, при засыпании Mac или блокировке экрана. Сохранённые элементы истории не затрагиваются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制一段时间后，或在 Mac 睡眠、屏幕锁定时清空系统剪贴板。已保存的历史记录不会受到影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在拷貝後的指定時間，或 Mac 睡眠、螢幕鎖定時清除系統剪貼簿。已儲存的記錄項目永遠不受影響。"
          }
        }
      }
    },
