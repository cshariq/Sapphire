          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокирует Face ID и требует ввода пароля, если подмена явно обнаруживается в течение этого времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
