    "Spotify extras need the Spotify Private API login in the Accounts tab. Apple Music extras work without it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify-Extras erfordern die Anmeldung über die private Spotify-API im Tab „Accounts“. Apple Music-Extras funktionieren ohne sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify extras need the Spotify Private API login in the Accounts tab. Apple Music extras work without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los extras de Spotify necesitan el inicio de sesión de la API privada de Spotify en la pestaña Cuentas. Los extras de Apple Music funcionan sin él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extras Spotify nécessitent la connexion à l’API privée Spotify dans l’onglet Comptes. Les extras Apple Music fonctionnent sans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli extra di Spotify richiedono l'accesso con l'API privata di Spotify nella scheda Account. Gli extra di Apple Music funzionano senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotifyの追加機能には、“アカウント”タブでSpotifyの非公開APIログインが必要です。Apple Musicの追加機能は、ログインなしで利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 추가 기능에는 계정 탭의 Spotify 비공개 API 로그인이 필요합니다. Apple Music 추가 기능은 로그인 없이 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os extras do Spotify exigem o login da API Privada do Spotify na aba Contas. Os extras do Apple Music funcionam sem ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для дополнений Spotify нужен вход через закрытый API Spotify на вкладке «Учётные записи». Дополнения Apple Music работают без него."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 附加功能需要在“账户”标签页中登录 Spotify 私有 API。Apple Music 附加功能无需此登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 附加功能需要在「帳號」標籤頁中登入 Spotify 私有 API。Apple Music 附加功能無須此登入。"
          }
        }
      }
    },
