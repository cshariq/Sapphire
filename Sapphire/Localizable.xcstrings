    "Every 20 minutes, take a 20-second break to look at something 20 feet away.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen Sie alle 20 Minuten eine 20-sekündige Pause und schauen Sie auf etwas in 6 Metern Entfernung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every 20 minutes, take a 20-second break to look at something 20 feet away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 20 minutos, haz una pausa de 20 segundos para mirar algo a 6 metros de distancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 20 minutes, faites une pause de 20 secondes pour regarder quelque chose à 6 mètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni 20 minuti, fai una pausa di 20 secondi guardando qualcosa a 6 metri di distanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "20分ごとに20秒間の休憩を取り、20フィート(約6メートル)先のものを見てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "20분마다 20초 동안 휴식하며 6미터 떨어진 곳을 바라보십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 20 minutos, faça uma pausa de 20 segundos para olhar algo a 6 metros de distância."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждые 20 минут делайте 20-секундный перерыв и смотрите на что-нибудь на расстоянии 6 метров."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每 20 分钟休息 20 秒，注视 20 英尺（约 6 米）外的物体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每 20 分鐘休息 20 秒，看看 20 英尺（約 6 公尺）外的物體。"
          }
        }
      }
    },
    "Every 20 minutes, take a 20-second break to look at something 20 feet away. This helps reduce eye strain and gives eye muscles a break.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen Sie alle 20 Minuten eine 20-sekündige Pause und schauen Sie auf etwas in 6 Metern Entfernung. Das hilft, die Augen zu entlasten, und gibt den Augenmuskeln eine Pause."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every 20 minutes, take a 20-second break to look at something 20 feet away. This helps reduce eye strain and gives eye muscles a break."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 20 minutos, haz una pausa de 20 segundos para mirar algo a 6 metros de distancia. Esto ayuda a reducir la fatiga visual y da un respiro a los músculos de los ojos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 20 minutes, faites une pause de 20 secondes pour regarder quelque chose à 6 mètres. Cela aide à réduire la fatigue visuelle et laisse les muscles des yeux se reposer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni 20 minuti, fai una pausa di 20 secondi guardando qualcosa a 6 metri di distanza. Questo aiuta a ridurre l'affaticamento visivo e dà un po' di riposo ai muscoli oculari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "20分ごとに20秒間の休憩を取り、20フィート(約6メートル)先のものを見てください。眼精疲労を和らげ、目の筋肉を休ませます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "20분마다 20초 동안 휴식하며 6미터 떨어진 곳을 바라보십시오. 눈의 피로를 줄이고 눈 근육을 쉬게 해 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 20 minutos, faça uma pausa de 20 segundos para olhar algo a 6 metros de distância. Isso ajuda a reduzir o cansaço visual e dá um descanso aos músculos dos olhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждые 20 минут делайте 20-секундный перерыв и смотрите на что-нибудь на расстоянии 6 метров. Это снижает нагрузку на глаза и даёт отдых глазным мышцам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每 20 分钟休息 20 秒，注视 20 英尺（约 6 米）外的物体。这有助于缓解眼疲劳，让眼部肌肉休息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每 20 分鐘休息 20 秒，看看 20 英尺（約 6 公尺）外的物體。這有助於減輕眼睛疲勞，讓眼部肌肉休息。"
          }
        }
      }
    },
