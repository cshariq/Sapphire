          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это защищённое место, его можно только просматривать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此位置受保护，只能检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是受保護的位置，只能檢查。"
          }
        }
      }
    },
    "This item syncs to the cloud: removal here also removes from iCloud Drive or your cloud storage and from your other devices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Objekt wird mit der Cloud synchronisiert: Das Entfernen hier entfernt es auch aus iCloud Drive oder Ihrem Cloud-Speicher und von Ihren anderen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item syncs to the cloud: removal here also removes from iCloud Drive or your cloud storage and from your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento se sincroniza con la nube: al eliminarlo aquí, también se elimina de iCloud Drive o de tu almacenamiento en la nube y de tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément est synchronisé dans le cloud : sa suppression ici le supprime aussi d’iCloud Drive ou de votre stockage cloud, ainsi que de vos autres appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento si sincronizza nel cloud: rimuoverlo qui lo rimuove anche da iCloud Drive o dal tuo spazio cloud e dagli altri tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目はクラウドと同期されます。ここで削除すると、iCloud Driveやクラウドストレージ、および他のデバイスからも削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 클라우드와 동기화됩니다. 여기서 제거하면 iCloud Drive 또는 클라우드 저장 공간과 다른 기기에서도 제거됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item é sincronizado com a nuvem: removê-lo aqui também o remove do iCloud Drive ou do seu armazenamento na nuvem e dos seus outros dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот объект синхронизируется с облаком: удаление здесь также удалит его из iCloud Drive или вашего облачного хранилища и с других ваших устройств."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目会同步到云端：在这里移除它，也会将其从 iCloud 云盘或其他云存储以及其他设备上移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此項目會同步至雲端：在這裡移除它，也會將其從 iCloud 雲碟或其他雲端儲存空間以及其他裝置上移除。"
          }
        }
      }
    },
