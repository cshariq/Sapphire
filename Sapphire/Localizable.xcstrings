    "Keys and gestures pass straight through there. Your arrangement is untouched and comes back when you leave it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten und Gesten werden dort direkt durchgereicht. Ihre Anordnung bleibt unberührt und kehrt zurück, wenn Sie sie verlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys and gestures pass straight through there. Your arrangement is untouched and comes back when you leave it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas y los gestos pasan directamente allí. Tu disposición no se toca y vuelve cuando sales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches et les gestes passent directement à travers. Votre agencement n’est pas modifié et revient lorsque vous le quittez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasti e gesti passano direttamente lì. La tua disposizione non viene toccata e torna quando esci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこではキーとジェスチャがそのまま通過します。配置には手を加えず、そこを離れると元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키와 제스처가 그대로 전달됩니다. 배열은 변경되지 않으며 나가면 돌아옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas e gestos passam direto ali. Seu arranjo não é alterado e volta quando você sair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши и жесты там проходят напрямую. Ваша раскладка не затрагивается и возвращается, когда вы выходите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键和手势会直接传递到那里。你的布局不会被改动，离开后会恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵和手勢會直接傳遞到那裡。你的排列不會被更動，離開後會恢復。"
          }
        }
      }
    },
