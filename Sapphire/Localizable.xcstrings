    "Debug: add a notchless 1920×1080 virtual display, shown in a window, to test multi-display and floating island behaviour": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug: Ein notchloses virtuelles 1920×1080-Display in einem Fenster hinzufügen, um Mehrfachdisplay- und Schwebeinsel-Verhalten zu testen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug: add a notchless 1920×1080 virtual display, shown in a window, to test multi-display and floating island behaviour"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuración: añade una pantalla virtual de 1920×1080 sin muesca, mostrada en una ventana, para probar el comportamiento multipantalla y de isla flotante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débogage : ajouter un écran virtuel 1920×1080 sans encoche, affiché dans une fenêtre, pour tester le multi-écran et le comportement de l’îlot flottant"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug: aggiungi un display virtuale 1920×1080 senza notch, mostrato in una finestra, per testare il comportamento multi-display e dell'isola flottante"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバッグ: ノッチのない1920×1080の仮想ディスプレイをウインドウに追加して、マルチディスプレイとフローティングアイランドの動作をテストします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디버그: 다중 디스플레이 및 플로팅 아일랜드 동작을 테스트하기 위해 윈도우에 표시되는 노치 없는 1920×1080 가상 디스플레이를 추가합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuração: adicionar um monitor virtual 1920×1080 sem entalhe, exibido em uma janela, para testar o comportamento de vários monitores e da ilha flutuante"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отладка: добавить виртуальный дисплей 1920×1080 без выреза в окне для проверки поведения нескольких дисплеев и плавающего острова"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调试：添加一个无刘海的 1920×1080 虚拟显示器，以窗口形式显示，用于测试多显示器和悬浮岛行为"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除錯：加入一個沒有瀏海的 1920×1080 虛擬顯示器，以視窗形式顯示，用於測試多顯示器和浮動島行為"
          }
        }
      }
    },
