          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не давать засыпать во время калибровки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校准时防止睡眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "校準時防止睡眠"
          }
        }
      }
    },
    "Prevent sleep during discharge": {
      "localizations": {
        "de": {
          "stringUnit": {
