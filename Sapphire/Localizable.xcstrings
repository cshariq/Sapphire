        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire가 지난번에 이 윈도우들을 치우고 위치를 기록해 두었습니다. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire as guardou fora de vista da última vez e anotou onde estavam. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire убрал их из вида в прошлый раз и записал, где они были. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 上次把它们收起到了视野之外，并记下了它们的位置。%@"
