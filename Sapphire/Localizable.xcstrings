          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto questo tasto e la rotella scorre in orizzontale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーを押しながらホイールを回すと、横方向にスクロールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키를 누른 채 휠을 돌리면 가로로 스크롤됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha esta tecla pressionada e a roda rola na horizontal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте эту клавишу, и колесо будет прокручивать по горизонтали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住此键时，滚轮会横向滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住此鍵時，滾輪會橫向捲動。"
          }
        }
      }
    },
    "Hold your device where you would normally use it when your Mac is unlocked (e.g., next to the trackpad).": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihr Gerät so, wie Sie es normalerweise bei entsperrtem Mac verwenden würden (z. B. neben dem Trackpad)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your device where you would normally use it when your Mac is unlocked (e.g., next to the trackpad)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostén tu dispositivo donde lo usarías normalmente cuando tu Mac está desbloqueado (por ejemplo, junto al trackpad)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez votre appareil là où vous l’utiliseriez normalement lorsque votre Mac est déverrouillé (par ex. à côté du trackpad)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni il dispositivo dove lo useresti normalmente quando il Mac è sbloccato (ad es. accanto al trackpad)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのロックを解除した状態で、通常使う場所(トラックパッドのそばなど)にデバイスを持ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 잠금을 해제했을 때 평소 사용하는 위치(예: 트랙패드 옆)에 기기를 두십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o dispositivo onde você normalmente o usaria quando o Mac estiver desbloqueado (por exemplo, ao lado do trackpad)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите устройство там, где вы обычно им пользуетесь при разблокированном Mac (например, рядом с трекпадом)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将设备放在 Mac 解锁时你通常使用它的位置，例如触控板旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將裝置放在 Mac 解鎖時你平常使用的位置（例如觸控式軌跡板旁邊）。"
          }
        }
      }
    },
