    "Over the wallpaper, where no app is listening, gestures work without holding ⌥.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über dem Hintergrundbild, wo keine App zuhört, funktionieren Gesten ohne Halten von ⌥."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over the wallpaper, where no app is listening, gestures work without holding ⌥."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre el fondo de pantalla, donde ninguna app escucha, los gestos funcionan sin mantener pulsado ⌥."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le fond d’écran, là où aucune app n’écoute, les gestes fonctionnent sans maintenir ⌥."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopra lo sfondo, dove nessuna app è in ascolto, i gesti funzionano senza tenere premuto ⌥."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのAppも反応しない壁紙の上では、⌥を押さなくてもジェスチャが機能します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듣고 있는 앱이 없는 배경화면 위에서는 ⌥를 누르지 않아도 제스처가 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre o papel de parede, onde nenhum app está ouvindo, os gestos funcionam sem manter ⌥ pressionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Над обоями, где ни одно приложение не слушает, жесты работают без удержания ⌥."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在没有 App 监听的墙纸上方，无需按住 ⌥ 即可使用手势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在沒有 App 監聽的桌面圖片上方，無需按住 ⌥ 即可使用手勢。"
          }
        }
      }
    },
