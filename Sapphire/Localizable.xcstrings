    "Sign in in the browser. Apple apps on this Mac need no account login.": {
      "comment": "A description of how to connect to a provider.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich im Browser an. Apple-Apps auf diesem Mac benötigen keine Account-Anmeldung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in in the browser. Apple apps on this Mac need no account login."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en el navegador. Las apps de Apple de este Mac no necesitan iniciar sesión en una cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous dans le navigateur. Les apps Apple de ce Mac n’ont besoin d’aucune connexion de compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi nel browser. Le app Apple su questo Mac non richiedono l'accesso a un account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでサインインしてください。このMacのAppleのAppにはアカウントのログインは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 로그인하십시오. 이 Mac의 Apple 앱은 계정 로그인이 필요하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login no navegador. Os apps da Apple neste Mac não precisam de login de conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в браузере. Приложениям Apple на этом Mac вход в учётную запись не нужен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器中登录。这台 Mac 上的 Apple App 无需账户登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏覽器中登入。這部 Mac 上的 Apple App 無需帳號登入。"
          }
        }
      }
    },
