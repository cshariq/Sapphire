          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività eseguono Blip automaticamente alla scadenza, anche se il pannello del notch è chiuso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジョブは、ノッチパネルが閉じていても、期限になるとBlipを自動的に実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업은 노치 패널이 닫혀 있어도 예정된 시간이 되면 Blip을 자동으로 실행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os trabalhos executam o Blip automaticamente quando vencem — mesmo com o painel do entalhe fechado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
