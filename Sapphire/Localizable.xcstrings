    "The update was not signed by the same Apple developer team.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update wurde nicht vom selben Apple-Entwicklerteam signiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update was not signed by the same Apple developer team."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización no fue firmada por el mismo equipo de desarrollo de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour n’a pas été signée par la même équipe de développeurs Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aggiornamento non è stato firmato dallo stesso team sviluppatore Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートは、同じAppleデベロッパチームによって署名されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트가 동일한 Apple 개발자 팀으로 서명되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização não foi assinada pela mesma equipe de desenvolvedores da Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление не подписано той же командой разработчиков Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此更新并非由同一 Apple 开发者团队签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此更新並非由同一 Apple 開發者團隊簽署。"
          }
        }
      }
    },
    "The update was not staged on the installed app's volume.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update wurde nicht auf dem Volume der installierten App bereitgestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update was not staged on the installed app's volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización no se preparó en el volumen de la app instalada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour n’a pas été préparée sur le volume de l’app installée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aggiornamento non è stato preparato sul volume dell'app installata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが、インストール済みAppのボリューム上にステージングされていませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트가 설치된 앱의 볼륨에 준비되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização não foi preparada no volume do app instalado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление не было подготовлено на томе установленного приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新未暂存在已安装应用所在的宗卷上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新未暫存在已安裝 App 所在的卷宗上。"
          }
        }
      }
    },
    "The update's executable architecture could not be verified.": {
      "comment": "Settings dynamic presentation at literal source; reconcile with final compiler extraction.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Architektur der ausführbaren Datei des Updates konnte nicht verifiziert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update's executable architecture could not be verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido verificar la arquitectura del ejecutable de la actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’architecture de l’exécutable de la mise à jour n’a pas pu être vérifiée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare l'architettura dell'eseguibile dell'aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートの実行ファイルのアーキテクチャを検証できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트의 실행 파일 아키텍처를 확인할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a arquitetura do executável da atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить архитектуру исполняемого файла обновления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
