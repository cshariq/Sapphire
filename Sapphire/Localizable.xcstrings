    "New screenshots taken on this Mac (and, with Photos access, new images in your Photos library) appear on the phone in Pictures/Sapphire.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Bildschirmfotos, die auf diesem Mac aufgenommen werden (und mit Zugriff auf Fotos auch neue Bilder in Ihrer Fotos-Mediathek), erscheinen auf dem Smartphone unter Pictures/Sapphire."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New screenshots taken on this Mac (and, with Photos access, new images in your Photos library) appear on the phone in Pictures/Sapphire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de pantalla nuevas hechas en este Mac (y, con acceso a Fotos, las imágenes nuevas de tu biblioteca de Fotos) aparecen en el teléfono en Pictures/Sapphire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles captures d’écran réalisées sur ce Mac (et, avec l’accès à Photos, les nouvelles images de votre photothèque) apparaissent sur le téléphone dans Pictures/Sapphire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi screenshot acquisiti su questo Mac (e, con l'accesso a Foto, le nuove immagini nella libreria Foto) compaiono sul telefono in Pictures/Sapphire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacで撮影した新しいスクリーンショット(“写真”へのアクセスがあれば、“写真”ライブラリの新しい画像も)は、スマートフォンのPictures/Sapphireに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 새로 촬영한 스크린샷(및 사진 접근이 허용된 경우 사진 보관함의 새 이미지)은 휴대전화의 Pictures/Sapphire에 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As novas capturas de tela feitas neste Mac (e, com acesso às Fotos, as novas imagens da sua biblioteca de Fotos) aparecem no celular em Pictures/Sapphire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые скриншоты, сделанные на этом Mac (и, при доступе к Фото, новые изображения в вашей медиатеке Фото), появляются на телефоне в Pictures/Sapphire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上截取的新屏幕截图（如已授予照片访问权限，还包括照片图库中的新图像）会出现在手机的 Pictures/Sapphire 中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這部 Mac 上擷取的新螢幕截圖（如已授予照片存取權限，還包括照片資料庫中的新影像）會出現在手機的 Pictures/Sapphire 中。"
          }
        }
      }
    },
