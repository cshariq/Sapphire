          }
        }
      }
    },
    "Darken windows you aren't using.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdunkelt Fenster, die Sie nicht verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Darken windows you aren't using."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscurece las ventanas que no estás usando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assombrit les fenêtres que vous n’utilisez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscura le finestre che non stai usando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用していないウインドウを暗くします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하지 않는 윈도우를 어둡게 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escureça as janelas que você não está usando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемняйте окна, которыми вы не пользуетесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调暗你未在使用的窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調暗你未在使用的視窗。"
          }
        }
      }
    },
    "Darken windows you're not using so the active app stands out and visual clutter recedes.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelt Fenster ab, die Sie nicht verwenden, damit die aktive App hervorsticht und visuelle Unruhe zurücktritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Darken windows you're not using so the active app stands out and visual clutter recedes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscurece las ventanas que no usas para que la app activa destaque y se reduzca el desorden visual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assombrissez les fenêtres que vous n’utilisez pas afin que l’app active ressorte et que l’encombrement visuel s’estompe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scurisci le finestre che non stai usando così l'app attiva risalta e il disordine visivo si attenua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用していないウインドウを暗くして、アクティブなAppを際立たせ、視覚的な煩雑さを抑えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하지 않는 윈도우를 어둡게 하여 활성 앱이 돋보이고 시각적 혼란이 줄어들게 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escurece as janelas que você não está usando para destacar o app ativo e reduzir a poluição visual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемняйте неиспользуемые окна, чтобы активное приложение выделялось, а визуальный шум уменьшался."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调暗未使用的窗口，突出当前应用，减少视觉干扰。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調暗你未使用的視窗，讓目前的 App 更突出並減少視覺干擾。"
          }
        }
      }
    },
    "Darkens the wallpaper around your windows when you zoom out, so they stand out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelt das Hintergrundbild um Ihre Fenster ab, wenn Sie herauszoomen, damit sie hervorstechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Darkens the wallpaper around your windows when you zoom out, so they stand out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscurece el fondo de pantalla alrededor de tus ventanas al alejar el zoom, para que destaquen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assombrit le fond d’écran autour de vos fenêtres lorsque vous dézoomez, pour les faire ressortir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scurisce lo sfondo attorno alle finestre quando riduci lo zoom, così risaltano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズームアウトしたとき、ウインドウの周囲の壁紙を暗くして、ウインドウを際立たせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축소하면 윈도우가 돋보이도록 윈도우 주변의 배경화면을 어둡게 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escurece o papel de parede ao redor das janelas quando você reduz o zoom, para que elas se destaquem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемняет обои вокруг окон при уменьшении масштаба, чтобы окна выделялись."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩小时会将窗口周围的墙纸调暗，使窗口更加突出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮小時會將視窗周圍的桌面圖片調暗，使視窗更加突出。"
          }
        }
      }
    },
