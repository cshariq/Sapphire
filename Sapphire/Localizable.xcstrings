    "Unlocked in %@ — or when your session ends, whichever comes first.": {
      "comment": "Native local UI wording in FocusRestrictedAppActivityView.swift",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperrt für %@ – oder bis Ihre Sitzung endet, je nachdem, was zuerst eintritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocked in %@ — or when your session ends, whichever comes first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueado en %@, o cuando termine tu sesión, lo que ocurra primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillé dans %@ — ou à la fin de votre session, selon ce qui arrive en premier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbloccato per %@ — o fino alla fine della sessione, a seconda di cosa viene prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@後にロック解除 — またはセッションが終了したときのいずれか早いほう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 후에 잠금 해제됨. 세션이 끝나면 먼저 해제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueado por %@ — ou até o fim da sessão, o que ocorrer primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировано на %@ — или до конца сеанса, смотря что наступит раньше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 后或专注时段结束时解锁，以较早发生的时间为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將於 %@ 後解鎖，或在你的專注時段結束時解鎖，以先到者為準。"
          }
        }
      }
    },
