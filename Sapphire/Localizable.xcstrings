    "On your phone, open Sapphire Continuity and tap Pair your Mac.": {
      "comment": "A description of the first step in the pairing process.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie auf Ihrem Smartphone Sapphire Continuity und tippen Sie auf „Mac koppeln“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your phone, open Sapphire Continuity and tap Pair your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu teléfono, abre Sapphire Continuity y toca Emparejar tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre téléphone, ouvrez Sapphire Continuity et touchez Associer votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul telefono, apri Sapphire Continuity e tocca Associa il tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンでSapphire Continuityを開き、“Macをペアリング”をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화에서 Sapphire Continuity를 열고 Mac 페어링을 탭하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No celular, abra o Sapphire Continuity e toque em Parear seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На телефоне откройте Sapphire Continuity и нажмите «Связать Mac»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上打开 Sapphire 连续互通，然后点按“配对你的 Mac”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在手機上開啟 Sapphire 接續互通，然後點按「配對你的 Mac」。"
          }
        }
      }
    },
    "On your phone, open Sapphire Continuity → Pair your Mac → Pair with a code, and scan this code.": {
      "comment": "A description of how to pair a Mac with a phone using a QR code.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie auf Ihrem Smartphone Sapphire Continuity → „Mac koppeln“ → „Mit Code koppeln“ und scannen Sie diesen Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your phone, open Sapphire Continuity → Pair your Mac → Pair with a code, and scan this code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu teléfono, abre Sapphire Continuity → Empareja tu Mac → Emparejar con un código, y escanea este código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre téléphone, ouvrez Sapphire Continuity → Associer votre Mac → Associer avec un code, puis scannez ce code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul telefono, apri Sapphire Continuity → Associa il tuo Mac → Associa con un codice e inquadra questo codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンで、Sapphire Continuity → “Macをペアリング” → “コードでペアリング”を開き、このコードをスキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화에서 Sapphire Continuity → Mac 페어링 → 코드로 페어링을 열고 이 코드를 스캔하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No celular, abra o Sapphire Continuity → Parear seu Mac → Parear com um código e leia este código."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На телефоне откройте Sapphire Continuity → «Связать Mac» → «Связать по коду» и отсканируйте этот код."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上打开 Sapphire 连续互通 → 配对你的 Mac → 使用代码配对，然后扫描此代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在手機上開啟 Sapphire 接續互通 → 配對你的 Mac → 使用代碼配對，然後掃描此代碼。"
          }
        }
      }
    },
