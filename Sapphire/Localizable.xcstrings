    "Drop files onto your paired Continuity phone from the File Shelf. Pair a device in Continuity settings first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie Dateien aus der Dateiablage auf Ihrem gekoppelten Continuity-Smartphone ab. Koppeln Sie zuerst ein Gerät in den Continuity-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop files onto your paired Continuity phone from the File Shelf. Pair a device in Continuity settings first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta archivos en tu teléfono de Continuidad emparejado desde la bandeja de archivos. Antes, empareja un dispositivo en los ajustes de Continuidad."
          }
        },
        "fr": {
