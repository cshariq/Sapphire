          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay capturas de personalización almacenadas. Activa el monitor de capturas para recopilarlas (por defecto: cada 2 horas en el preset Moderado)."
          }
        },
        "fr": {
          "stringUnit": {
