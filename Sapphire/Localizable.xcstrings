        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击标题栏以取景"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連按兩下標題列以取景"
          }
        }
      }
    },
    "Double-click an archive (or choose Open With → Sapphire) and Sapphire extracts it for you: smart destinations, password prompts for encrypted archives, and optional cleanup — all using the archive tools that ship with macOS.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklicken Sie auf ein Archiv (oder wählen Sie „Öffnen mit“ → Sapphire), und Sapphire extrahiert es für Sie: intelligente Ziele, Passwortabfragen für verschlüsselte Archive und optionales Aufräumen – alles mit den Archivwerkzeugen, die mit macOS geliefert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click an archive (or choose Open With → Sapphire) and Sapphire extracts it for you: smart destinations, password prompts for encrypted archives, and optional cleanup — all using the archive tools that ship with macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en un archivo comprimido (o elige Abrir con → Sapphire) y Sapphire lo extrae por ti: destinos inteligentes, solicitud de contraseña para archivos cifrados y limpieza opcional, todo con las herramientas de archivos que incluye macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez sur une archive (ou choisissez Ouvrir avec → Sapphire) et Sapphire l’extrait pour vous : destinations intelligentes, demandes de mot de passe pour les archives chiffrées et nettoyage facultatif — le tout avec les outils d’archivage fournis avec macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai doppio clic su un archivio (o scegli Apri con → Sapphire) e Sapphire lo estrae per te: destinazioni intelligenti, richieste di password per gli archivi cifrati e pulizia facoltativa, il tutto con gli strumenti per archivi inclusi in macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブをダブルクリックする(または“このアプリケーションで開く”→“Sapphire”を選択する)と、Sapphireが展開します。スマートな保存先、暗号化されたアーカイブのパスワード入力、オプションのクリーンアップを、すべてmacOSに付属のアーカイブツールで行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관 파일을 더블 클릭하거나(또는 다음으로 열기 → Sapphire 선택) Sapphire가 압축을 풀어 줍니다. 스마트 대상, 암호화된 보관 파일의 암호 프롬프트, 선택적 정리를 제공하며, 모두 macOS에 포함된 보관 파일 도구를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique duas vezes em um arquivo compactado (ou escolha Abrir Com → Sapphire) e o Sapphire o extrai para você: destinos inteligentes, solicitações de senha para arquivos criptografados e limpeza opcional — tudo usando as ferramentas de arquivos compactados que acompanham o macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды щёлкните архив (или выберите «Открыть в программе» → Sapphire), и Sapphire извлечёт его: умные места назначения, запросы пароля для зашифрованных архивов и необязательная очистка — всё с помощью инструментов для архивов, входящих в macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击归档文件（或选择“打开方式 → Sapphire”），Sapphire 会为你解压：智能选择目标位置，为加密归档文件提示输入密码，并可选择清理——全部使用 macOS 自带的归档工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連按兩下封存檔（或選擇「打開方式 → Sapphire」），Sapphire 會為你解壓縮：智慧選擇目的地，為加密封存檔提示輸入密碼，並可選擇清理——全部使用 macOS 內建的封存工具。"
          }
        }
      }
    },
