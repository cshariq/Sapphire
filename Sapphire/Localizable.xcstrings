    "Instead of showing the full focus name, only on/off.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt des vollständigen Fokus-Namens nur An/Aus anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead of showing the full focus name, only on/off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugar de mostrar el nombre completo del foco, solo activado/desactivado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lieu d’afficher le nom complet de la concentration, afficher seulement activé/désactivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invece del nome completo del Focus, mostra solo attivo/disattivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中モードの名前を全部表示する代わりに、オン/オフのみを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 집중 모드 이름 대신 켬/끔만 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em vez de mostrar o nome completo do foco, mostra apenas ativado/desativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо полного названия фокусирования показывать только «вкл.»/«выкл.»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示开启或关闭状态，不显示完整的专注模式名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅顯示開啟或關閉，不顯示完整的專注模式名稱。"
          }
        }
      }
    },
