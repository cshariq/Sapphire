    },
    "Start dates help calculate how long you've held each position. All portfolio data is stored locally.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startdaten helfen bei der Berechnung, wie lange Sie jede Position halten. Alle Portfoliodaten werden lokal gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start dates help calculate how long you've held each position. All portfolio data is stored locally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas de inicio ayudan a calcular cuánto tiempo llevas con cada posición. Todos los datos de la cartera se almacenan localmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates de début aident à calculer depuis combien de temps vous détenez chaque position. Toutes les données du portefeuille sont stockées localement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le date di inizio aiutano a calcolare da quanto tempo detieni ciascuna posizione. Tutti i dati del portafoglio sono memorizzati in locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始日は、各ポジションをどのくらい保有しているかの計算に役立ちます。ポートフォリオのデータはすべてローカルに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 날짜는 각 포지션을 얼마나 오래 보유했는지 계산하는 데 도움이 됩니다. 모든 포트폴리오 데이터는 로컬에 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas de início ajudam a calcular há quanto tempo você mantém cada posição. Todos os dados da carteira são armazenados localmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даты начала помогают рассчитать, как долго вы держите каждую позицию. Все данные портфеля хранятся локально."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始日期有助于计算你持有每个仓位的时长。所有投资组合数据均存储在本地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始日期有助於計算你持有每個部位的時長。所有投資組合資料均儲存在本機。"
          }
        }
      }
    },
