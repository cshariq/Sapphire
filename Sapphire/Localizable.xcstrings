            "value": "유니버설 컨트롤이 휴대전화를 제어하는 방식을 선택하려면 유니버설 컨트롤을 켜십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Universal Control para escolher como ele controla o celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Universal Control, чтобы выбрать, как он управляет телефоном."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“通用控制”，以选择它如何操控手机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「通用控制」，以選擇它如何操控手機。"
          }
        }
      }
    },
    "Turn the dimming off while Mission Control is open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abdunklung ausschalten, solange Mission Control geöffnet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the dimming off while Mission Control is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la atenuación mientras Mission Control está abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez l’assombrissement lorsque Mission Control est ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva l’oscuramento mentre Mission Control è aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mission Controlが開いている間は、暗くする効果をオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
