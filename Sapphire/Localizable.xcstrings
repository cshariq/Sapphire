    "Library and Music.app playback work; catalog playback needs a subscription.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe der Mediathek und der Musik-App funktioniert; für die Katalogwiedergabe ist ein Abo erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library and Music.app playback work; catalog playback needs a subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción de la biblioteca y de la app Música funciona; la del catálogo necesita una suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture de la bibliothèque et de Musique.app fonctionne ; la lecture du catalogue nécessite un abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funzionano la libreria e la riproduzione da Music.app; la riproduzione del catalogo richiede un abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリとMusic.appでの再生は利用できます。カタログの再生にはサブスクリプションが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함과 Music.app 재생은 작동하며 카탈로그 재생에는 구독이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução da biblioteca e do app Música funciona; a reprodução do catálogo requer uma assinatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиатека и воспроизведение в Music.app работают; для воспроизведения из каталога нужна подписка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料库和“音乐”App 均可播放；播放在线曲库内容需要订阅。"
          }
        },
        "zh-Hant": {
