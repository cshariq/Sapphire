    "Show what's in each window while it moves and when it's small. Needs Screen Recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, was in jedem Fenster ist, während es sich bewegt und wenn es klein ist. Erfordert die Bildschirmaufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show what's in each window while it moves and when it's small. Needs Screen Recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra lo que hay en cada ventana mientras se mueve y cuando es pequeña. Requiere Grabación de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le contenu de chaque fenêtre pendant son déplacement et lorsqu’elle est petite. Nécessite l’enregistrement de l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il contenuto di ogni finestra mentre si muove e quando è piccola. Richiede Registrazione schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動中や小さいときに、各ウインドウの内容を表示します。画面収録が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 움직이는 동안과 작을 때 각 윈도우의 내용을 표시합니다. 화면 기록이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o que há em cada janela enquanto ela se move e quando está pequena. Requer Gravação de Tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать содержимое каждого окна, пока оно движется и когда оно маленькое. Нужна запись экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在窗口移动时以及窗口较小时显示其中的内容。需要屏幕录制权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在視窗移動時以及視窗較小時顯示其中的內容。需要螢幕錄製權限。"
          }
        }
      }
    },
    "Show your own image or video behind the clock, sign-in controls, and Sapphire widgets on the lock screen.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr eigenes Bild oder Video hinter der Uhr, den Anmeldesteuerelementen und den Sapphire-Widgets auf dem Sperrbildschirm anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show your own image or video behind the clock, sign-in controls, and Sapphire widgets on the lock screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tu propia imagen o vídeo detrás del reloj, los controles de inicio de sesión y los widgets de Sapphire en la pantalla bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez votre propre image ou vidéo derrière l’horloge, les commandes de connexion et les widgets Sapphire sur l’écran de verrouillage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra una tua immagine o un tuo video dietro l'orologio, i controlli di accesso e i widget di Sapphire nella schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面の時計、サインインのコントロール、Sapphireウィジェットの背後に、独自の画像またはビデオを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면의 시계, 로그인 제어 항목 및 Sapphire 위젯 뒤에 내 이미지나 비디오를 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra sua própria imagem ou vídeo atrás do relógio, dos controles de login e dos widgets do Sapphire na tela bloqueada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать собственное изображение или видео за часами, элементами входа и виджетами Sapphire на экране блокировки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁定屏幕的时钟、登录控件和 Sapphire 小组件后方显示你自己的图像或视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鎖定畫面的時鐘、登入控制項目和 Sapphire 小工具後方顯示你自己的影像或影片。"
          }
        }
      }
    },
    "Show “Hold ⌘Q to quit” or “Press ⌘Q again” on screen while Sapphire waits for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„⌘Q gedrückt halten zum Beenden“ oder „⌘Q erneut drücken“ auf dem Bildschirm anzeigen, während Sapphire auf Sie wartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show “Hold ⌘Q to quit” or “Press ⌘Q again” on screen while Sapphire waits for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra “Mantén ⌘Q para salir” o “Pulsa ⌘Q de nuevo” en pantalla mientras Sapphire espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher « Maintenir ⌘Q pour quitter » ou « Appuyer à nouveau sur ⌘Q » à l’écran pendant que Sapphire attend votre action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra “Tieni premuto ⌘Q per uscire” o “Premi di nuovo ⌘Q” sullo schermo mentre Sapphire ti aspetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireが待機している間、画面上に“⌘Qを長押しして終了”または“もう一度⌘Qを押す”を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire가 기다리는 동안 화면에 “⌘Q를 길게 눌러 종료” 또는 “⌘Q를 다시 누르십시오”를 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra “Segure ⌘Q para encerrar” ou “Pressione ⌘Q novamente” na tela enquanto o Sapphire aguarda você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать на экране «Удерживайте ⌘Q для завершения» или «Нажмите ⌘Q ещё раз», пока Sapphire ждёт вашего действия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 等待你操作时，在屏幕上显示“按住 ⌘Q 退出”或“再次按 ⌘Q”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 等待你操作時，在螢幕上顯示「按住 ⌘Q 結束」或「再次按 ⌘Q」。"
          }
        }
      }
    },
