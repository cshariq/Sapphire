    "Customize notch size and inactive-hiding for each display individually. Changes here override the global settings for the selected display.": {
      "comment": "Settings interface",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie Notch-Größe und Inaktivitäts-Ausblendung für jedes Display einzeln an. Änderungen hier überschreiben die globalen Einstellungen für das ausgewählte Display."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize notch size and inactive-hiding for each display individually. Changes here override the global settings for the selected display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Personaliza el tamaño de la muesca y el ocultamiento por inactividad para cada pantalla por separado. Los cambios aquí sustituyen los ajustes globales de la pantalla seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personnalisez la taille de l’encoche et le masquage en cas d’inactivité pour chaque écran individuellement. Les modifications ici remplacent les réglages globaux pour l’écran sélectionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizza dimensione del notch e nascondimento in inattività per ogni display singolarmente. Le modifiche qui sostituiscono le impostazioni globali per il display selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイごとに、ノッチのサイズと非アクティブ時の非表示をカスタマイズします。ここでの変更は、選択したディスプレイのグローバル設定を上書きします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이마다 노치 크기와 비활성 시 숨기기를 개별적으로 사용자화합니다. 여기서 변경하면 선택한 디스플레이에 대해 전역 설정이 재정의됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalize o tamanho do entalhe e a ocultação por inatividade em cada monitor individualmente. As alterações aqui substituem os ajustes globais do monitor selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настраивайте размер выреза и скрытие при неактивности для каждого дисплея отдельно. Изменения здесь переопределяют общие настройки для выбранного дисплея."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每台显示器分别设置刘海区域大小和闲置隐藏行为。这里的更改会覆盖所选显示器的全局设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為每台顯示器個別自訂瀏海區域大小和閒置隱藏。此處的更改會覆寫所選顯示器的全域設定。"
          }
        }
      }
    },
    "Customize scrolling direction, scroll speed, pointer acceleration, and mouse buttons built into Sapphire.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie Scrollrichtung, Scrollgeschwindigkeit, Zeigerbeschleunigung und Maustasten an, die in Sapphire integriert sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize scrolling direction, scroll speed, pointer acceleration, and mouse buttons built into Sapphire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Personaliza la dirección del desplazamiento, su velocidad, la aceleración del puntero y los botones del ratón integrados en Sapphire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personnalisez le sens de défilement, la vitesse de défilement, l’accélération du pointeur et les boutons de souris intégrés à Sapphire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizza direzione di scorrimento, velocità di scorrimento, accelerazione del puntatore e pulsanti del mouse integrati in Sapphire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireに内蔵されたスクロール方向、スクロール速度、ポインタの加速、マウスボタンをカスタマイズします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire에 내장된 스크롤 방향, 스크롤 속도, 포인터 가속 및 마우스 버튼을 사용자화합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalize a direção de rolagem, a velocidade de rolagem, a aceleração do ponteiro e os botões do mouse integrados ao Sapphire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте направление и скорость прокрутки, ускорение указателя и кнопки мыши, встроенные в Sapphire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义 Sapphire 内置的滚动方向、滚动速度、指针加速度和鼠标按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂 Sapphire 內建的捲動方向、捲動速度、指標加速度和滑鼠按鍵。"
          }
        }
      }
    },
    "Customize the look and feel of your Mac's menu bar.": {
