    "Surface Scan does not read inside folders. These equal-sized tiles are excluded from byte totals.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Oberflächenscan liest nicht in Ordnern. Diese gleich großen Kacheln sind von den Bytesummen ausgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surface Scan does not read inside folders. These equal-sized tiles are excluded from byte totals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis de superficie no lee dentro de las carpetas. Estas fichas del mismo tamaño se excluyen de los totales de bytes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse de surface ne lit pas l’intérieur des dossiers. Ces vignettes de taille égale sont exclues des totaux en octets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Surface Scan non legge all'interno delle cartelle. Queste tessere di uguale dimensione sono escluse dai totali in byte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーフェススキャンはフォルダの内部を読み取りません。これらの同じサイズのタイルは、バイト合計から除外されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표면 스캔은 폴더 내부를 읽지 않습니다. 이 같은 크기의 타일은 바이트 합계에서 제외됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Varredura de Superfície não lê o interior das pastas. Estes blocos de mesmo tamanho são excluídos dos totais de bytes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверхностное сканирование не читает содержимое папок. Эти плитки одинакового размера исключены из итогов в байтах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表层扫描不会读取文件夹内部。这些等大的图块不计入字节总数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表層掃描不會讀取檔案夾內部。這些等大的圖塊不計入位元組總數。"
          }
        }
      }
    },
    "Surface Scan does not read inside these folders, and they do not contribute to the displayed byte total.": {
      "comment": "A description of the unmeasured folders.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Oberflächenscan liest nicht in diesen Ordnern, und sie tragen nicht zur angezeigten Bytesumme bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surface Scan does not read inside these folders, and they do not contribute to the displayed byte total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis de superficie no lee dentro de estas carpetas y no contribuyen al total de bytes mostrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse de surface ne lit pas l’intérieur de ces dossiers, et ils ne contribuent pas au total en octets affiché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Surface Scan non legge all'interno di queste cartelle ed esse non contribuiscono al totale in byte mostrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーフェススキャンはこれらのフォルダの内部を読み取らず、表示されるバイト合計には含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표면 스캔은 이 폴더 내부를 읽지 않으며 표시된 바이트 합계에 반영되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Varredura de Superfície não lê o interior destas pastas, e elas não contribuem para o total de bytes exibido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверхностное сканирование не читает содержимое этих папок, и они не входят в отображаемый итог в байтах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表层扫描不会读取这些文件夹的内部，它们也不计入所显示的字节总数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表層掃描不會讀取這些檔案夾的內部，它們也不計入所顯示的位元組總數。"
          }
        }
      }
    },
    "Surface a live activity while an AI agent, a build, or a terminal command is running.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Live-Aktivität anzeigen, solange ein KI-Agent, ein Build oder ein Terminalbefehl läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surface a live activity while an AI agent, a build, or a terminal command is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una actividad en directo mientras se ejecuta un agente de IA, una compilación o un comando de terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire apparaître une activité en direct lorsqu’un agent IA, un build ou une commande de terminal s’exécute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra una Live Activity mentre è in esecuzione un agente IA, una build o un comando del terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIエージェント、ビルド、ターミナルコマンドの実行中に、ライブアクティビティを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 에이전트, 빌드 또는 터미널 명령이 실행되는 동안 라이브 활동을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe uma atividade ao vivo enquanto um agente de IA, um build ou um comando de terminal está em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать live-активность, пока выполняется ИИ-агент, сборка или команда терминала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 智能体、构建或终端命令运行时，显示实时活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 AI 代理程式、建置或終端機指令執行時顯示即時動態。"
          }
        }
      }
    },
