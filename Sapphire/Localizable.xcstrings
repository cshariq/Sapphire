    "Now, move the device about 3 meters (10 feet) away. The scan will complete automatically.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegen Sie das Gerät nun etwa 3 Meter weit weg. Der Scan wird automatisch abgeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now, move the device about 3 meters (10 feet) away. The scan will complete automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora, aleja el dispositivo unos 3 metros (10 pies). El análisis terminará automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éloignez maintenant l’appareil d’environ 3 mètres. L’analyse se terminera automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora allontana il dispositivo di circa 3 metri. La scansione si completerà automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に、デバイスを約3メートル(10フィート)離してください。スキャンは自動的に完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 기기를 약 3미터(10피트) 떨어진 곳으로 이동하십시오. 스캔은 자동으로 완료됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora, afaste o dispositivo cerca de 3 metros. A varredura será concluída automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь отойдите с устройством примерно на 3 метра. Сканирование завершится автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在将设备移到约 3 米（10 英尺）外，扫描会自动完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在，將裝置移到約 3 公尺（10 英尺）外。掃描將自動完成。"
          }
        }
      }
    },
    "Now, move the device to the distance where you want your Mac to lock automatically.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegen Sie das Gerät nun in die Entfernung, in der Ihr Mac automatisch sperren soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now, move the device to the distance where you want your Mac to lock automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora, mueve el dispositivo a la distancia a la que quieres que tu Mac se bloquee automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éloignez maintenant l’appareil à la distance à laquelle vous voulez que votre Mac se verrouille automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora sposta il dispositivo alla distanza a cui vuoi che il Mac si blocchi automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に、Macを自動的にロックしたい距離までデバイスを移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 Mac이 자동으로 잠기게 할 거리로 기기를 이동하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora, afaste o dispositivo até a distância em que você quer que o Mac bloqueie automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь отойдите с устройством на расстояние, на котором Mac должен блокироваться автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在将设备移到你希望 Mac 自动锁定时的距离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
