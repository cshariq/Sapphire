            "state": "translated",
            "value": "Usa su propio actualizador firmado: Sapphire abrirá la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise son propre programme de mise à jour signé — Sapphire ouvrira l’app."
