    "Default to AirPlay devices when Spotify isn't running and you're signed in to Spotify.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay-Geräte standardmäßig verwenden, wenn Spotify nicht läuft und Sie bei Spotify angemeldet sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default to AirPlay devices when Spotify isn't running and you're signed in to Spotify."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar por defecto los dispositivos AirPlay cuando Spotify no se esté ejecutando y hayas iniciado sesión en Spotify."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser par défaut les appareils AirPlay lorsque Spotify n’est pas ouvert et que vous êtes connecté à Spotify."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa per impostazione predefinita i dispositivi AirPlay quando Spotify non è in esecuzione e hai effettuato l’accesso a Spotify."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotifyが実行されておらず、Spotifyにサインインしている場合は、AirPlayデバイスをデフォルトにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify가 실행 중이 아니고 Spotify에 로그인한 경우 AirPlay 기기를 기본으로 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar dispositivos AirPlay por padrão quando o Spotify não está em execução e você está conectado ao Spotify."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию использовать устройства AirPlay, когда Spotify не запущен и вы вошли в Spotify."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录 Spotify 但 Spotify 未运行时，默认使用 AirPlay 设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已登入 Spotify 但 Spotify 未執行時，預設使用 AirPlay 裝置。"
          }
        }
      }
    },
