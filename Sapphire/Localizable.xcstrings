          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在指定时间自动开始专注时段，可设为每天、每周指定日期、每周、每月或仅一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在指定時間自動開始專注時段，可設為每天、每週特定日子、每週、每月或僅一次。"
          }
        }
      }
    },
    "Automate charging behaviors and perform manual or scheduled calibrations to keep your battery's readings accurate.": {
      "comment": "Settings interface",
      "localizations": {
