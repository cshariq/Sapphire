    "Apps you lock. System-critical apps (Terminal, Xcode, Settings, etc.) can never be locked.": {
      "comment": "A description of the apps that can be locked.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die Sie sperren. Systemkritische Apps (Terminal, Xcode, Einstellungen usw.) können nie gesperrt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps you lock. System-critical apps (Terminal, Xcode, Settings, etc.) can never be locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que bloqueas. Las apps críticas del sistema (Terminal, Xcode, Ajustes, etc.) nunca se pueden bloquear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que vous verrouillez. Les apps essentielles au système (Terminal, Xcode, Réglages, etc.) ne peuvent jamais être verrouillées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App che blocchi. Le app critiche di sistema (Terminale, Xcode, Impostazioni, ecc.) non possono mai essere bloccate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックするApp。システムに不可欠なApp(ターミナル、Xcode、設定など)はロックできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠그는 앱입니다. 시스템에 중요한 앱(터미널, Xcode, 설정 등)은 잠글 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que você bloqueia. Apps essenciais do sistema (Terminal, Xcode, Ajustes etc.) nunca podem ser bloqueados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения, которые вы блокируете. Критически важные системные приложения (Терминал, Xcode, Настройки и т. д.) заблокировать нельзя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你锁定的 App。系统关键 App（终端、Xcode、设置等）永远无法被锁定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你鎖定的 App。系統關鍵 App（終端機、Xcode、設定等）永遠無法被鎖定。"
          }
        }
      }
    },
