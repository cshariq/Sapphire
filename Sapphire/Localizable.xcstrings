    "You can change these any time in Settings.": {
      "comment": "Onboarding, app menus, helper, shared utilities, public build placeholders",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können dies jederzeit in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change these any time in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar esto en cualquier momento en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez modifier ces réglages à tout moment dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi modificarle in qualsiasi momento in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは「設定」でいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정은 언제든지 \"설정\"에서 변경할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode alterar isso a qualquer momento em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете изменить это в любое время в настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后可随时在设置中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隨時在「設定」中更改這些項目。"
          }
        }
      }
    },
    "You finished %@ blocks. Total focus today: %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben %1$@ Blöcke abgeschlossen. Fokus heute insgesamt: %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You finished %1$@ blocks. Total focus today: %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has terminado %1$@ bloques. Foco total de hoy: %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez terminé %1$@ blocs. Concentration totale aujourd’hui : %2$@."
