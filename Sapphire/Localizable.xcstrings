    "New windows join the space you're looking at instead of floating on the desktop.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Fenster treten dem Space bei, den Sie ansehen, statt auf dem Schreibtisch zu schweben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New windows join the space you're looking at instead of floating on the desktop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas nuevas se unen al espacio que estás viendo en lugar de flotar en el escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles fenêtres rejoignent l’espace que vous regardez au lieu de flotter sur le bureau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove finestre si uniscono allo spazio che stai guardando invece di fluttuare sulla scrivania."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいウインドウは、デスクトップに浮かばず、表示中のスペースに加わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 윈도우가 데스크탑에 떠 있는 대신 보고 있는 스페이스에 합류합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As novas janelas entram no espaço que você está vendo em vez de flutuar na mesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые окна присоединяются к пространству, на которое вы смотрите, а не плавают на рабочем столе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新窗口会加入你正在查看的空间，而不是浮动在桌面上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新視窗會加入你正在檢視的空間，而不是浮動在桌面上。"
          }
        }
      }
    },
