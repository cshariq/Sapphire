          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o valor investido em Ajustes para acompanhar o desempenho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте вложенную сумму в «Настройках», чтобы отслеживать доходность."
          }
        },
        "zh-Hans": {
          "stringUnit": {
