    "Drag to set the charge limit — charging pauses at this level to help preserve battery health.": {
      "comment": "Native local UI wording in BatteryDetailView.swift",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen, um das Ladelimit festzulegen – das Laden wird bei diesem Wert pausiert, um den Batteriezustand zu schonen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to set the charge limit — charging pauses at this level to help preserve battery health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para establecer el límite de carga: la carga se pausa en este nivel para ayudar a conservar la salud de la batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour définir la limite de charge — la charge se met en pause à ce niveau pour aider à préserver la santé de la batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per impostare il limite di carica: la ricarica si ferma a questo livello per preservare la salute della batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして充電の上限を設定します。バッテリーの状態を保つため、このレベルで充電が一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 충전 제한을 설정하십시오. 배터리 성능 상태를 보존하기 위해 이 레벨에서 충전이 일시 정지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para definir o limite de carga — o carregamento pausa neste nível para ajudar a preservar a saúde da bateria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы задать лимит заряда — зарядка приостанавливается на этом уровне для сохранения здоровья батареи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动设置充电上限；达到该电量后暂停充电，以保护电池健康。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以設定充電上限：充電會在此電量暫停，有助於維護電池健康度。"
          }
        }
      }
    },
