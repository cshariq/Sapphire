          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale de las apps en ejecución que no estén en este preset tras cambiar (siempre mantiene abiertas la app frontal y Sapphire)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter les apps ouvertes qui ne sont pas dans ce préréglage après le changement (garde toujours l’app au premier plan et Sapphire ouverts)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi le app in esecuzione che non fanno parte di questo preset dopo il cambio (mantiene sempre aperte l'app in primo piano e Sapphire)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替え後に、このプリセットにない実行中のAppを終了します(最前面のAppとSapphireは常に開いたままです)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환 후 이 프리셋에 없는 실행 중인 앱 종료(가장 앞에 있는 앱과 Sapphire는 항상 열려 있음)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra apps em execução que não estão nesta predefinição após a troca (sempre mantém abertos o app da frente e o Sapphire)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершать запущенные приложения, которых нет в этом пресете, после переключения (приложение на переднем плане и Sapphire всегда остаются открытыми)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换后退出不在此预设中的运行中 App（始终保持最前面的 App 和 Sapphire 打开）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
