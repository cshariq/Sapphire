          "stringUnit": {
            "state": "translated",
            "value": "Mit kamerabasierter Face ID entsperren. Wenn aktiviert, startet sie automatisch, sobald eine gesperrte App oder ein Start-Popup erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock with camera-based Face ID. When on, it starts automatically as soon as a locked app or launch popup appears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea con Face ID basado en la cámara. Si está activado, se inicia automáticamente en cuanto aparece una app bloqueada o una ventana emergente de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez avec Face ID par caméra. Lorsque cette option est activée, il démarre automatiquement dès qu’une app verrouillée ou une fenêtre de lancement apparaît."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca con Face ID basato sulla fotocamera. Quando è attivo, parte automaticamente non appena compare un'app bloccata o un popup di avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラベースのFace IDでロックを解除します。オンにすると、ロックされたAppや起動ポップアップが表示された瞬間に自動的に開始されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 기반 Face ID로 잠금을 해제합니다. 켜면 잠긴 앱이나 실행 팝업이 나타나는 즉시 자동으로 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie com o Face ID baseado na câmera. Quando ativado, ele inicia automaticamente assim que um app bloqueado ou um popup de abertura aparece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировка с помощью Face ID на основе камеры. Когда включено, запускается автоматически, как только появляется заблокированное приложение или всплывающее окно запуска."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用基于摄像头的 Face ID 解锁。启用后，锁定应用或启动弹窗一出现就会自动开始认证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用透過相機運作的 Face ID 解鎖。啟用後，鎖定的 App 或啟動彈出式視窗一出現就會自動開始認證。"
          }
        }
      }
    },
    "Unlock your Mac using facial recognition when you wake the screen.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren Sie Ihren Mac per Gesichtserkennung, wenn Sie den Bildschirm aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock your Mac using facial recognition when you wake the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea tu Mac con reconocimiento facial cuando reactivas la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez votre Mac par reconnaissance faciale lorsque vous réactivez l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca il Mac con il riconoscimento facciale quando riattivi lo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のスリープを解除したときに、顔認識でMacのロックを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 깨울 때 얼굴 인식으로 Mac의 잠금을 해제합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o Mac usando reconhecimento facial ao despertar a tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте Mac с помощью распознавания лица при пробуждении экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唤醒屏幕时，通过面容识别解锁 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喚醒螢幕時，透過臉部辨識解鎖你的 Mac。"
          }
        }
      }
    },
    "Unlock your phone to unlock this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre dein Telefon, um diesen Mac zu entsperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock your phone to unlock this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea tu teléfono para desbloquear este Mac."
          }
        },
        "fr": {
