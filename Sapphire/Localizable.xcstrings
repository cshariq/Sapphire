    "%@ and %@ more. Open Settings → Apps to update them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und %@ weitere. Öffnen Sie „Einstellungen“ → „Apps“, um sie zu aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and %@ more. Open Settings → Apps to update them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y %@ más. Abre Ajustes → Apps para actualizarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ et %@ de plus. Ouvrez Réglages → Apps pour les mettre à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ e altri %@. Apri Impostazioni → App per aggiornarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@と他%@件。更新するには“設定”→“App”を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 외 %@개. 업데이트하려면 설정 → 앱을 여십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ e mais %@. Abra Ajustes → Apps para atualizá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ и ещё %@. Откройте «Настройки» → «Приложения», чтобы обновить их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，另有 %@ 个应用。打开“设置”→“应用”进行更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，另有 %@ 個 App。打開「設定」→「App」以進行更新。"
          }
        }
      }
    },
