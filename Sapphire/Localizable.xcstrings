          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a impedire lo stop dopo essere usciti dalla modalità clamshell invece di disattivare caffeinate automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラムシェルモードを終了したあとも、caffeinateを自動的にオフにせず、スリープの防止を続けます。"
