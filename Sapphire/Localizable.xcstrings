    "Put each completed download on the shelf so it's one drag away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden abgeschlossenen Download in die Ablage legen, damit er nur einen Zug entfernt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put each completed download on the shelf so it's one drag away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca cada descarga completada en la bandeja para tenerla a un arrastre de distancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer chaque téléchargement terminé sur l’étagère pour l’avoir à portée de glissement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti ogni download completato sullo shelf così è a un trascinamento di distanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了した各ダウンロードをシェルフに置いて、ドラッグ1回で使えるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 다운로드를 선반에 놓아 한 번만 드래그하면 되도록 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca cada download concluído na prateleira, a um arrasto de distância."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помещать каждую завершённую загрузку на полку, чтобы её можно было перетащить одним движением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将每个下载完成的文件放到文件暂存架，随手即可拖出使用。"
