            "state": "translated",
            "value": "专注时段结束时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專注時段結束時"
          }
        }
      }
    },
    "When a Session Starts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine Sitzung beginnt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a Session Starts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando empieza una sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au début d’une session"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All’inizio di una sessione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの開始時"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 시작될 때"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma sessão começa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда сеанс начинается"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注时段开始时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專注時段開始時"
          }
        }
      }
    },
    "When a song only has line timing, listen to the music app's audio on this Mac to time each word, and share good results. Asks for audio access and downloads Apple's speech model once.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Song nur Zeilenzeiten hat, hören Sie das Audio der Musik-App auf diesem Mac mit, um jedes Wort zeitlich zu bestimmen, und teilen Sie gute Ergebnisse. Fragt nach Audiozugriff und lädt einmalig das Sprachmodell von Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a song only has line timing, listen to the music app's audio on this Mac to time each word, and share good results. Asks for audio access and downloads Apple's speech model once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una canción solo tiene temporización por líneas, escucha el audio de la app de música en este Mac para sincronizar cada palabra y compartir los buenos resultados. Pide acceso al audio y descarga una vez el modelo de voz de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’un morceau n’a que le minutage par ligne, écouter l’audio de l’app de musique sur ce Mac pour minuter chaque mot, et partager les bons résultats. Demande l’accès audio et télécharge une fois le modèle vocal d’Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un brano ha solo la temporizzazione per riga, ascolta sul Mac l'audio dell'app musicale per temporizzare ogni parola e condividere i buoni risultati. Richiede l'accesso audio e scarica una volta il modello vocale di Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲に行のタイミングしかない場合、このMacでミュージックAppのオーディオを聴いて単語ごとのタイミングを計り、良好な結果を共有します。オーディオアクセスを求め、Appleの音声モデルを一度ダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래에 줄 타이밍만 있는 경우 이 Mac에서 음악 앱의 오디오를 들어 각 단어의 타이밍을 맞추고 좋은 결과를 공유합니다. 오디오 접근을 요청하며 Apple 음성 모델을 한 번 다운로드합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma música só tem sincronização por linha, ouve o áudio do app de música neste Mac para sincronizar cada palavra e compartilha os bons resultados. Pede acesso ao áudio e baixa o modelo de fala da Apple uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у песни есть только построчные метки времени, слушайте звук музыкального приложения на этом Mac, чтобы расставить метки по словам, и делитесь хорошими результатами. Запрашивает доступ к аудио и один раз загружает речевую модель Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌曲仅有逐行时间轴时，监听此 Mac 上音乐应用的音频，为每个字词确定时间，并分享质量良好的结果。需要音频访问权限，且首次使用会下载 Apple 的语音模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當歌曲只有逐行時間時，聆聽此 Mac 上音樂 App 的音訊來為每個字詞計時，並分享良好的結果。會要求音訊取用權限，並下載一次 Apple 的語音模型。"
          }
        }
      }
    },
    "When an archive is encrypted, ask for the password. The password is used once and never stored.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Archiv verschlüsselt ist, nach dem Passwort fragen. Das Passwort wird einmal verwendet und nie gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an archive is encrypted, ask for the password. The password is used once and never stored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un archivo comprimido está cifrado, pide la contraseña. La contraseña se usa una vez y nunca se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’une archive est chiffrée, demander le mot de passe. Le mot de passe est utilisé une seule fois et n’est jamais enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un archivio è cifrato, chiedi la password. La password viene usata una sola volta e mai memorizzata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブが暗号化されている場合、パスワードを求めます。パスワードは1回だけ使用され、保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관 파일이 암호화되어 있으면 암호를 요청합니다. 암호는 한 번만 사용되며 저장되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um arquivo compactado é criptografado, pede a senha. A senha é usada uma vez e nunca armazenada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если архив зашифрован, запрашивать пароль. Пароль используется один раз и никогда не сохраняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档文件被加密时，询问密码。密码仅使用一次，绝不会被存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存檔被加密時，詢問密碼。密碼僅使用一次，絕不會被儲存。"
          }
        }
      }
    },
    "When another app is playing, show a Spotify source tab so you can switch medias. Hidden while Spotify itself is the main media source.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine andere App abspielt, einen Spotify-Quellentab anzeigen, damit Sie die Medien wechseln können. Ausgeblendet, solange Spotify selbst die Hauptmedienquelle ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When another app is playing, show a Spotify source tab so you can switch medias. Hidden while Spotify itself is the main media source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando otra app está reproduciendo, muestra una pestaña de origen de Spotify para que puedas cambiar de contenido. Se oculta mientras Spotify es la fuente multimedia principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’une autre app est en lecture, afficher un onglet source Spotify pour changer de média. Masqué tant que Spotify lui-même est la source multimédia principale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un'altra app è in riproduzione, mostra una scheda sorgente Spotify per poter cambiare contenuto multimediale. Nascosta mentre Spotify stesso è la sorgente multimediale principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのAppが再生中の場合、Spotifyのソースタブを表示して、メディアを切り替えられるようにします。Spotify自体がメインのメディアソースの間は非表示です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 재생 중일 때 Spotify 소스 탭을 표시하여 미디어를 전환할 수 있습니다. Spotify 자체가 주 미디어 소스일 때는 숨겨집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando outro app estiver reproduzindo, mostra uma aba de fonte do Spotify para você alternar entre mídias. Oculta enquanto o próprio Spotify é a fonte de mídia principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда играет другое приложение, показывать вкладку источника Spotify, чтобы можно было переключать медиа. Скрыта, пока сам Spotify является основным источником медиа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他应用播放时显示 Spotify 来源标签页，以便切换媒体。Spotify 已是主要媒体来源时不显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當其他 App 正在播放時，顯示 Spotify 來源標籤頁以便切換媒體。當 Spotify 本身為主要媒體來源時則隱藏。"
          }
        }
      }
    },
    "When another app is playing, show a Spotify source tab so you can switch to Spotify. Hidden while Spotify is the main media source.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine andere App wiedergibt, einen Spotify-Quellen-Tab anzeigen, damit Sie zu Spotify wechseln können. Ausgeblendet, solange Spotify die Hauptmedienquelle ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When another app is playing, show a Spotify source tab so you can switch to Spotify. Hidden while Spotify is the main media source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando otra app está reproduciendo, muestra una pestaña de origen de Spotify para poder cambiar a Spotify. Se oculta mientras Spotify es la fuente multimedia principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’une autre app lit du contenu, affiche un onglet source Spotify pour pouvoir passer à Spotify. Masqué lorsque Spotify est la source multimédia principale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un’altra app è in riproduzione, mostra una scheda sorgente Spotify per poter passare a Spotify. Nascosta quando Spotify è la sorgente multimediale principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のAppが再生中のとき、Spotifyに切り替えられるようにSpotifyのソースタブを表示します。Spotifyがメインのメディアソースのときは非表示です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 재생 중일 때 Spotify로 전환할 수 있도록 Spotify 소스 탭을 표시합니다. Spotify가 주 미디어 소스일 때는 숨겨집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando outro app está reproduzindo, mostre uma aba de fonte do Spotify para que você possa mudar para o Spotify. Oculta enquanto o Spotify é a fonte de mídia principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда воспроизводится другое приложение, показывайте вкладку источника Spotify, чтобы можно было переключиться на Spotify. Скрыта, пока Spotify — основной источник мультимедиа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他应用播放时显示 Spotify 来源标签页，以便切换到 Spotify。Spotify 是主要媒体来源时不显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當其他 App 正在播放時，顯示 Spotify 來源標籤頁以便切換到 Spotify。當 Spotify 為主要媒體來源時則隱藏。"
          }
        }
      }
    },
    "When enabled, 100% app volume is capped by current system output volume.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird die App-Lautstärke von 100 % durch die aktuelle Systemausgabelautstärke begrenzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, 100% app volume is capped by current system output volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, el volumen del 100% de la app se limita al volumen de salida actual del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est activée, le volume d’app à 100 % est plafonné par le volume de sortie actuel du système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivato, il volume dell'app al 100% è limitato dal volume di uscita attuale del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、100%のApp音量が現在のシステム出力音量で上限が設定されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 100% 앱 볼륨이 현재 시스템 출력 볼륨으로 제한됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o volume de 100% do app é limitado pelo volume de saída atual do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, громкость приложения 100% ограничивается текущей системной громкостью вывода."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，应用音量的 100% 对应当前系统输出音量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，App 音量 100% 的上限為目前的系統輸出音量。"
          }
        }
      }
    },
    "When enabled, your Mac will stop using AC power and run from its battery until the battery limit is reached.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, verwendet Ihr Mac keinen Netzstrom mehr und läuft mit der Batterie, bis das Batterielimit erreicht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, your Mac will stop using AC power and run from its battery until the battery limit is reached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, tu Mac dejará de usar la corriente alterna y funcionará con su batería hasta alcanzar el límite de batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est activée, votre Mac cessera d’utiliser le secteur et fonctionnera sur sa batterie jusqu’à ce que la limite de batterie soit atteinte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivato, il Mac smette di usare l'alimentazione CA e funziona a batteria finché non si raggiunge il limite della batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、バッテリーの上限に達するまで、MacはAC電源の使用を止めてバッテリーで動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 Mac이 AC 전원 사용을 중지하고 배터리 제한에 도달할 때까지 배터리로 실행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o Mac deixa de usar a energia da tomada e funciona com a bateria até o limite da bateria ser atingido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, Mac перестанет использовать питание от сети и будет работать от батареи, пока не будет достигнут предел заряда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，Mac 将停止使用外接电源，改用电池供电，直到达到设定的电量阈值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，你的 Mac 將停止使用交流電源，改以電池供電，直到達到電池上限。"
          }
        }
      }
    },
    "When more than one live activity is running, the ones after the first appear as small bubbles next to the notch, like the Dynamic Island. Click a bubble to open it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn mehr als eine Live-Aktivität läuft, erscheinen die nach der ersten als kleine Blasen neben der Notch, wie bei der Dynamic Island. Klicken Sie auf eine Blase, um sie zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When more than one live activity is running, the ones after the first appear as small bubbles next to the notch, like the Dynamic Island. Click a bubble to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hay más de una actividad en directo en ejecución, las posteriores a la primera aparecen como pequeñas burbujas junto a la muesca, como en la Dynamic Island. Haz clic en una burbuja para abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque plus d’une activité en direct est en cours, celles qui suivent la première apparaissent sous forme de petites bulles à côté de l’encoche, comme la Dynamic Island. Cliquez sur une bulle pour l’ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è in esecuzione più di una Live Activity, quelle dopo la prima compaiono come piccole bolle accanto al notch, come la Dynamic Island. Fai clic su una bolla per aprirla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のライブアクティビティが実行中のとき、最初のもの以外は、Dynamic Islandのように、ノッチの横に小さなバブルとして表示されます。バブルをクリックすると開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 이상의 라이브 활동이 실행 중이면 첫 번째 이후의 활동이 Dynamic Island처럼 노치 옆에 작은 버블로 나타납니다. 버블을 클릭하면 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando mais de uma atividade ao vivo está em execução, as seguintes à primeira aparecem como pequenas bolhas ao lado do entalhe, como na Dynamic Island. Clique em uma bolha para abri-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда запущено больше одной live-активности, остальные после первой появляются маленькими пузырями рядом с вырезом, как в Dynamic Island. Нажмите на пузырь, чтобы открыть его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个实时活动同时运行时，第一个之后的活动会像灵动岛一样，以小气泡显示在刘海旁。点按气泡即可打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多個即時動態同時執行時，第一個之後的動態會像動態島一樣，以小泡泡顯示在瀏海旁。按一下泡泡即可開啟。"
          }
        }
      }
    },
    "When more than one phone is linked, pick a device each time you mirror or extend. Other features use the preferred (Active) phone, or sync to every linked phone where that makes sense (clipboard, Focus).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn mehr als ein Smartphone verknüpft ist, wählen Sie bei jedem Spiegeln oder Erweitern ein Gerät. Andere Funktionen verwenden das bevorzugte (aktive) Smartphone oder synchronisieren mit jedem verknüpften Smartphone, wo das sinnvoll ist (Zwischenablage, Fokus)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When more than one phone is linked, pick a device each time you mirror or extend. Other features use the preferred (Active) phone, or sync to every linked phone where that makes sense (clipboard, Focus)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hay más de un teléfono vinculado, elige un dispositivo cada vez que dupliques o extiendas la pantalla. Otras funciones usan el teléfono preferido (activo) o se sincronizan con todos los teléfonos vinculados cuando tiene sentido (portapapeles, Foco)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque plusieurs téléphones sont liés, choisissez un appareil à chaque recopie ou extension. Les autres fonctionnalités utilisent le téléphone préféré (actif), ou se synchronisent avec chaque téléphone lié lorsque c’est pertinent (presse-papiers, concentration)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è collegato più di un telefono, scegli un dispositivo ogni volta che fai mirroring o estendi. Le altre funzioni usano il telefono preferito (attivo) o si sincronizzano con ogni telefono collegato dove ha senso (appunti, Focus)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のスマートフォンがリンクされている場合、ミラーリングや拡張のたびにデバイスを選択します。ほかの機能は、優先する(アクティブな)スマートフォンを使用するか、適切な場合はリンクされたすべてのスマートフォンと同期します(クリップボード、集中モード)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 이상의 휴대전화가 연결되어 있으면 미러링하거나 확장할 때마다 기기를 선택합니다. 다른 기능은 선호(활성) 휴대전화를 사용하거나 적절한 경우(클립보드, 집중 모드) 연결된 모든 휴대전화에 동기화합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando mais de um celular está vinculado, escolha um dispositivo a cada vez que espelhar ou estender. Outros recursos usam o celular preferido (Ativo) ou sincronizam com todos os celulares vinculados quando faz sentido (área de transferência, Foco)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда связано больше одного телефона, выбирайте устройство при каждом повторе экрана или расширении. Остальные функции используют предпочтительный (активный) телефон или синхронизируются со всеми связанными телефонами там, где это уместно (буфер обмена, фокусирование)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接多部手机时，每次镜像或扩展都会让你选择设备。其他功能使用首选（当前启用的）手机，或在适用时同步到所有已连接手机（如剪贴板、专注模式）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接多部手機時，每次鏡像或延伸都會讓你選擇裝置。其他功能使用首選（目前啟用的）手機，或在適用時同步到所有已連接手機（如剪貼簿、專注模式）。"
          }
        }
      }
    },
    "When off, a snippet expands as soon as you finish typing its trigger.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deaktiviert, wird ein Textbaustein erweitert, sobald Sie die Eingabe seines Auslösers beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, a snippet expands as soon as you finish typing its trigger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, un fragmento se expande en cuanto terminas de escribir su activador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est désactivée, un extrait se développe dès que vous avez fini de saisir son déclencheur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, uno snippet si espande non appena finisci di digitare il suo trigger."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、トリガの入力を終えた時点でスニペットがすぐに展開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 트리거 입력을 마치자마자 스니펫이 확장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, um snippet é expandido assim que você termina de digitar o gatilho dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, сниппет разворачивается сразу после ввода его триггера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，输入完触发词时文本片段会立即展开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時，輸入完觸發字詞後文字片段會立即展開。"
          }
        }
      }
    },
    "When on (and Music ▸ Live Activity lyrics is on), Continuity / phone tracks can show lyrics in the notch Live Activity.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert (und „Musik“ ▸ Songtexte der Live-Aktivität aktiviert ist), können Continuity-/Smartphone-Titel Songtexte in der Notch-Live-Aktivität anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on (and Music ▸ Live Activity lyrics is on), Continuity / phone tracks can show lyrics in the notch Live Activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado (y la letra de la actividad en directo de Música también), las pistas de Continuidad / del teléfono pueden mostrar letras en la actividad en directo de la muesca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est activée (et que Musique ▸ Paroles de l’activité en direct l’est aussi), les morceaux de continuité / du téléphone peuvent afficher les paroles dans l’activité en direct de l’encoche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivato (e i testi della Live Activity in Musica ▸ Live Activity sono attivi), i brani di Continuity / del telefono possono mostrare i testi nella Live Activity del notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン(かつ“ミュージック”▸“ライブアクティビティ”の歌詞がオン)のとき、Continuity/スマートフォンのトラックの歌詞を、ノッチのライブアクティビティに表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜져 있고(음악 ▸ 라이브 활동 가사가 켜져 있는 경우) 연속성/휴대전화 트랙은 노치 라이브 활동에 가사를 표시할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado (e Música ▸ letras da Atividade ao Vivo estiver ativado), faixas da Continuity / do celular podem mostrar letras na Atividade ao Vivo do entalhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено (и включены тексты в «Музыка» ▸ «Live-активность»), треки Continuity / телефона могут показывать тексты песен в live-активности выреза."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后（且已开启“音乐”▸“实时活动歌词”），Continuity 和手机曲目可在刘海实时活动中显示歌词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後（且已開啟「音樂」▸「即時動態歌詞」），Continuity 與手機曲目可在瀏海即時動態中顯示歌詞。"
          }
        }
      }
    },
    "When re-opening the notch, it will return to the last menu you had open.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim erneuten Öffnen der Notch kehrt sie zum zuletzt geöffneten Menü zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When re-opening the notch, it will return to the last menu you had open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al volver a abrir la muesca, volverá al último menú que tenías abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la réouverture de l’encoche, elle revient au dernier menu que vous aviez ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando riapri il notch, tornerà all'ultimo menu che avevi aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチを開き直すと、最後に開いていたメニューに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치를 다시 열면 마지막으로 열어 둔 메뉴로 돌아갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao reabrir o entalhe, ele volta ao último menu que você tinha aberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При повторном открытии выреза он вернётся к последнему открытому меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开刘海区域时，返回上次打开的菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打開瀏海區域時，會回到你上次打開的選單。"
          }
        }
      }
    },
    "When shown items would run into the app's menus or the notch, temporarily swap the menus out until the items hide again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eingeblendete Objekte mit den Menüs der App oder der Notch kollidieren würden, die Menüs vorübergehend ausblenden, bis die Objekte wieder verschwinden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When shown items would run into the app's menus or the notch, temporarily swap the menus out until the items hide again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando los elementos mostrados chocarían con los menús de la app o con la muesca, sustituye temporalmente los menús hasta que los elementos se vuelvan a ocultar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque les éléments affichés entreraient en conflit avec les menus de l’app ou l’encoche, remplacer temporairement les menus jusqu’à ce que les éléments se masquent à nouveau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando gli elementi mostrati finirebbero contro i menu dell'app o il notch, sostituisci temporaneamente i menu finché gli elementi non vengono nascosti di nuovo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示された項目がAppのメニューやノッチにぶつかる場合、項目が再び非表示になるまで、一時的にメニューを入れ替えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 항목이 앱 메뉴나 노치와 겹치면 항목이 다시 숨겨질 때까지 메뉴를 일시적으로 교체합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando os itens exibidos colidirem com os menus do app ou o entalhe, troca temporariamente os menus até que os itens sejam ocultados novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если показываемые элементы упираются в меню приложения или вырез, временно убирать меню, пока элементы снова не скроются"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示的项目将与应用菜单或刘海重叠时，临时隐藏应用菜单，直到这些项目再次隐藏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示的項目將與 App 選單或瀏海重疊時，暫時隱藏 App 選單，直到這些項目再次隱藏"
          }
        }
      }
    },
    "When the DMG contains an older or equal version of an installed app, keep the installed copy without asking.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das DMG eine ältere oder gleiche Version einer installierten App enthält, die installierte Kopie ohne Nachfrage behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the DMG contains an older or equal version of an installed app, keep the installed copy without asking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el DMG contiene una versión anterior o igual de una app instalada, conserva la copia instalada sin preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque le DMG contient une version plus ancienne ou identique d’une app installée, conserver la copie installée sans demander."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il DMG contiene una versione più vecchia o uguale di un'app installata, mantieni la copia installata senza chiedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DMGにインストール済みのAppと同じかそれより古いバージョンが含まれている場合、確認せずにインストール済みのコピーを維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG에 설치된 앱의 이전 또는 동일한 버전이 있으면 묻지 않고 설치된 사본을 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o DMG contém uma versão mais antiga ou igual de um app instalado, mantém a cópia instalada sem perguntar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если DMG содержит более старую или такую же версию установленного приложения, оставлять установленную копию без запроса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG 中的版本比已安装版本更旧或相同时，无需询问，直接保留已安装的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG 中的版本比已安裝版本更舊或相同時，無須詢問，直接保留已安裝的副本。"
          }
        }
      }
    },
    "When the camera can't see well, the edges of the screen glow white while Face ID looks for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Kamera schlecht sieht, leuchten die Bildschirmränder weiß, während Face ID dich sucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the camera can't see well, the edges of the screen glow white while Face ID looks for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la cámara no ve bien, los bordes de la pantalla brillan en blanco mientras Face ID te busca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la caméra voit mal, les bords de l’écran s’illuminent en blanc pendant que Face ID vous cherche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la fotocamera non vede bene, i bordi dello schermo si illuminano di bianco mentre Face ID ti cerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラがよく見えないとき、Face IDがあなたを探している間、画面の縁が白く光ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 잘 보지 못하면 Face ID가 사용자를 찾는 동안 화면 가장자리가 흰색으로 빛납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a câmera não enxerga bem, as bordas da tela brilham em branco enquanto o Face ID procura você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если камере плохо видно, края экрана светятся белым, пока Face ID ищет вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当摄像头看不清时，屏幕边缘会在 Face ID 识别你时发出白光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當相機看不清楚時，螢幕邊緣會在 Face ID 辨識你時發出白光。"
          }
        }
      }
    },
    "When the music widget appears in the notch: always, only while a song is loaded (playing or paused), or only while playing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann das Musik-Widget in der Notch erscheint: immer, nur solange ein Song geladen ist (abgespielt oder pausiert) oder nur während der Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the music widget appears in the notch: always, only while a song is loaded (playing or paused), or only while playing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo aparece el widget de música en la muesca: siempre, solo mientras hay una canción cargada (en reproducción o en pausa), o solo durante la reproducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le widget musique apparaît dans l’encoche : toujours, uniquement lorsqu’un morceau est chargé (en lecture ou en pause), ou uniquement pendant la lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il widget musica compare nel notch: sempre, solo mentre un brano è caricato (in riproduzione o in pausa) o solo durante la riproduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージックウィジェットをノッチに表示するタイミング: 常に、曲が読み込まれている間(再生中または一時停止中)のみ、または再生中のみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 위젯이 노치에 나타나는 시점입니다. 항상, 노래가 로드된 동안(재생 중 또는 일시 정지)만, 또는 재생 중일 때만 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o widget de música aparece no entalhe: sempre, somente enquanto uma música está carregada (tocando ou pausada) ou somente enquanto toca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда музыкальный виджет появляется в вырезе: всегда, только пока песня загружена (играет или на паузе) или только пока играет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐小组件在刘海中出现的时机：始终显示、仅在已载入歌曲时（播放或暂停）显示，或仅在播放时显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂小工具在瀏海中出現的時機：一律顯示、僅在已載入歌曲時（播放或暫停）顯示，或僅在播放時顯示。"
          }
        }
      }
    },
    "When the notch is collapsed, swipe up over it to hide it completely. Swipe down near the notch area to bring it back.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Notch eingeklappt ist, wischen Sie darüber nach oben, um sie vollständig auszublenden. Wischen Sie in der Nähe des Notch-Bereichs nach unten, um sie zurückzuholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the notch is collapsed, swipe up over it to hide it completely. Swipe down near the notch area to bring it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la muesca está contraída, desliza hacia arriba sobre ella para ocultarla por completo. Desliza hacia abajo cerca de la zona de la muesca para recuperarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque l’encoche est réduite, balayez vers le haut dessus pour la masquer complètement. Balayez vers le bas près de la zone de l’encoche pour la faire revenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il notch è compresso, scorri verso l'alto su di esso per nasconderlo completamente. Scorri verso il basso vicino all'area del notch per riportarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチが折りたたまれているとき、その上で上にスワイプすると完全に非表示になります。ノッチの領域の近くで下にスワイプすると、元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치가 접혀 있을 때 위로 스와이프하면 완전히 숨겨집니다. 노치 영역 근처에서 아래로 스와이프하면 다시 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o entalhe está recolhido, deslize para cima sobre ele para ocultá-lo completamente. Deslize para baixo perto da área do entalhe para trazê-lo de volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вырез свёрнут, смахните вверх над ним, чтобы полностью скрыть его. Смахните вниз рядом с областью выреза, чтобы вернуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海区域收起时，在其上方向上轻扫可完全隐藏；在刘海附近向下轻扫可重新显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海區域收合時，在其上方向上滑動即可完全隱藏；在瀏海區域附近向下滑動即可讓它重新出現。"
          }
        }
      }
    },
    "When the phone is playing and this Mac is not, show it in the regular music Live Activity (album art on the left). Right-side track info, waveform mode, and waveform style are under Music settings ▸ Live Activity.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Smartphone abspielt und dieser Mac nicht, in der regulären Musik-Live-Aktivität anzeigen (Albumcover links). Titelinfo auf der rechten Seite, Wellenformmodus und Wellenformstil befinden sich unter „Musik“-Einstellungen ▸ „Live-Aktivität“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the phone is playing and this Mac is not, show it in the regular music Live Activity (album art on the left). Right-side track info, waveform mode, and waveform style are under Music settings ▸ Live Activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el teléfono está reproduciendo y este Mac no, lo muestra en la actividad en directo de música habitual (carátula a la izquierda). La información de la pista a la derecha, el modo de forma de onda y el estilo de forma de onda están en Ajustes de Música ▸ Actividad en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque le téléphone lit un contenu et que ce Mac ne le fait pas, l’afficher dans l’activité en direct de musique habituelle (pochette à gauche). Les infos du morceau à droite, le mode et le style de la forme d’onde se trouvent dans Réglages Musique ▸ Activité en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il telefono è in riproduzione e questo Mac no, mostralo nella normale Live Activity musicale (copertina a sinistra). Informazioni del brano sul lato destro, modalità e stile della forma d'onda sono in Impostazioni Musica ▸ Live Activity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンが再生中でこのMacが再生中でない場合、通常のミュージックのライブアクティビティ(左側にアルバムアート)に表示します。右側のトラック情報、波形モード、波形スタイルは、“ミュージック”設定▸“ライブアクティビティ”にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화가 재생 중이고 이 Mac이 재생 중이 아니면 일반 음악 라이브 활동(왼쪽에 앨범 아트)에 표시합니다. 오른쪽 트랙 정보, 파형 모드 및 파형 스타일은 음악 설정 ▸ 라이브 활동에 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o celular está reproduzindo e este Mac não, mostra-o na Atividade ao Vivo de música normal (capa do álbum à esquerda). As informações da faixa do lado direito, o modo e o estilo da forma de onda ficam em Ajustes de Música ▸ Atividade ao Vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда воспроизводит телефон, а этот Mac — нет, показывать это в обычной live-активности музыки (обложка альбома слева). Сведения о треке справа, режим и стиль волны находятся в «Настройки музыки» ▸ «Live-активность»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机正在播放而这台 Mac 未播放时，在常规音乐实时活动中显示手机内容，左侧显示专辑封面。右侧曲目信息、波形模式和波形样式位于“音乐设置”▸“实时活动”中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機正在播放而這部 Mac 未播放時，在一般音樂即時動態中顯示手機內容，左側顯示專輯封面。右側曲目資訊、波形模式與波形樣式位於「音樂設定」▸「即時動態」中。"
          }
        }
      }
    },
    "When this Mac or the phone starts playing, it reconnects the shared earbuds and the other device pauses. Seamless Connection is always free.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dieser Mac oder das Smartphone zu spielen beginnt, verbindet es die gemeinsamen Ohrhörer neu, und das andere Gerät pausiert. Nahtlose Verbindung ist immer kostenlos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this Mac or the phone starts playing, it reconnects the shared earbuds and the other device pauses. Seamless Connection is always free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando este Mac o el teléfono empieza a reproducir, reconecta los auriculares compartidos y el otro dispositivo se pausa. La conexión Seamless siempre es gratuita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque ce Mac ou le téléphone commence la lecture, il reconnecte les écouteurs partagés et l’autre appareil se met en pause. Seamless Connection est toujours gratuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando questo Mac o il telefono inizia la riproduzione, riconnette gli auricolari condivisi e l'altro dispositivo va in pausa. Connessione continua è sempre gratuita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacまたはスマートフォンが再生を開始すると、共有しているイヤフォンが再接続され、もう一方のデバイスは一時停止します。シームレス接続は常に無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac 또는 휴대전화에서 재생이 시작되면 공유된 이어버드를 다시 연결하고 다른 기기는 일시 정지됩니다. 끊김 없는 연결은 항상 무료입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando este Mac ou o celular começa a reproduzir, ele reconecta os fones compartilhados e o outro dispositivo pausa. A Conexão Seamless é sempre gratuita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда воспроизведение начинает этот Mac или телефон, общие наушники переподключаются, а другое устройство ставится на паузу. Бесшовное подключение всегда бесплатно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 或手机开始播放时，会重新连接共用的耳塞，另一台设备则暂停。无缝连接始终免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 或手機開始播放時，會重新連接共用的耳塞，另一部裝置則暫停。無縫連線一律免費。"
          }
        }
      }
    },
    "When this profile starts or ends here, do the same on Android.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dieses Profil hier startet oder endet, dasselbe auf Android tun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this profile starts or ends here, do the same on Android."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando este perfil se inicia o termina aquí, hace lo mismo en Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque ce profil démarre ou se termine ici, faire de même sur Android."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando questo profilo inizia o finisce qui, fai lo stesso su Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルをここで開始または終了すると、Androidでも同じ操作を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로파일이 여기서 시작되거나 종료되면 Android에서도 같은 작업을 수행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando este perfil inicia ou termina aqui, faz o mesmo no Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда этот профиль здесь запускается или завершается, делать то же самое на Android."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此开始或结束此配置时，在 Android 上执行相同操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此開始或結束此設定檔時，在 Android 上執行相同操作。"
          }
        }
      }
    },
    "When you copy a large image or screenshot, replace it on the clipboard with a smaller version automatically": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie ein großes Bild oder Bildschirmfoto kopieren, es in der Zwischenablage automatisch durch eine kleinere Version ersetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you copy a large image or screenshot, replace it on the clipboard with a smaller version automatically"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando copias una imagen grande o una captura de pantalla, la sustituye automáticamente en el portapapeles por una versión más pequeña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous copiez une grande image ou une capture d’écran, la remplacer automatiquement dans le presse-papiers par une version plus petite"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando copi un'immagine grande o uno screenshot, sostituiscilo automaticamente negli appunti con una versione più piccola"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな画像やスクリーンショットをコピーしたとき、クリップボード上で自動的に小さいバージョンに置き換えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 이미지나 스크린샷을 복사하면 클립보드에서 더 작은 버전으로 자동 교체합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao copiar uma imagem grande ou captura de tela, substitui-a na área de transferência por uma versão menor automaticamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы копируете большое изображение или снимок экрана, автоматически заменять его в буфере обмена уменьшенной версией"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制大图像或屏幕截图时，自动将剪贴板内容替换为较小版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝大型影像或螢幕截圖時，自動將剪貼簿內容替換為較小版本"
          }
        }
      }
    },
    "When you drag a file out of the shelf, remove it from the shelf automatically.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie eine Datei aus der Ablage herausziehen, sie automatisch aus der Ablage entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you drag a file out of the shelf, remove it from the shelf automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando arrastras un archivo fuera de la bandeja, lo elimina de la bandeja automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous faites glisser un fichier hors de l’étagère, le retirer automatiquement de l’étagère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando trascini un file fuori dallo shelf, rimuovilo automaticamente dallo shelf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをシェルフからドラッグして出すと、シェルフから自動的に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선반에서 파일을 드래그해 내보내면 선반에서 자동으로 제거합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao arrastar um arquivo para fora da prateleira, remove-o da prateleira automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы перетаскиваете файл с полки, автоматически удалять его с полки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件拖出暂存架后，自动将其从暂存架移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將檔案拖出暫存架時，自動將其從暫存架移除。"
          }
        }
      }
    },
    "When you open a disk image yourself, ask whether to install the app inside and eject it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie selbst ein Disk-Image öffnen, fragen, ob die darin enthaltene App installiert und das Image ausgeworfen werden soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you open a disk image yourself, ask whether to install the app inside and eject it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando abres tú mismo una imagen de disco, pregunta si quieres instalar la app que contiene y expulsarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous ouvrez vous-même une image disque, demander s’il faut installer l’app qu’elle contient et l’éjecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando apri tu un'immagine disco, chiedi se installare l'app al suo interno ed espellerla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身でディスクイメージを開くとき、中のAppをインストールして取り出すかどうかを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 이미지를 직접 열면 안에 있는 앱을 설치하고 추출할지 묻습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você mesmo abre uma imagem de disco, pergunta se deseja instalar o app contido e ejetá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы сами открываете образ диска, спрашивать, установить ли приложение из него и извлечь образ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自行打开磁盘映像时，询问是否安装其中的应用并推出映像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你自行開啟磁碟映像檔時，詢問是否安裝其中的 App 並退出映像檔。"
          }
        }
      }
    },
    "Where a window you open goes. Floating keeps it on the Desktop like any Mac window; nothing else moves.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin ein von Ihnen geöffnetes Fenster kommt. „Schweben“ hält es wie bei jedem Mac-Fenster auf dem Schreibtisch; nichts anderes bewegt sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where a window you open goes. Floating keeps it on the Desktop like any Mac window; nothing else moves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde va una ventana que abres. Flotante la mantiene en el escritorio como cualquier ventana de Mac; nada más se mueve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où va une fenêtre que vous ouvrez. Flottante la garde sur le Bureau comme n’importe quelle fenêtre Mac ; rien d’autre ne bouge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove va una finestra che apri. Flottante la tiene sulla Scrivania come qualsiasi finestra del Mac; nient'altro si sposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いたウインドウの配置先。“フローティング”は通常のMacのウインドウと同様にデスクトップに置き、ほかは何も動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여는 윈도우가 놓이는 위치입니다. 띄우기는 다른 Mac 윈도우처럼 데스크탑에 유지하며 다른 것은 이동하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para onde vai uma janela que você abre. Flutuante a mantém na Mesa como qualquer janela do Mac; nada mais se move."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куда попадает открываемое вами окно. «Свободно» оставляет его на Рабочем столе, как любое окно Mac; больше ничего не перемещается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打开的窗口的去向。浮动会像任何 Mac 窗口一样将其保留在桌面上；不会移动其他任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你開啟的視窗的去向。浮動會像任何 Mac 視窗一樣將其保留在桌面上；不會移動其他任何內容。"
          }
        }
      }
    },
    "Where extracted files should go.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin extrahierte Dateien gehen sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where extracted files should go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde deben ir los archivos extraídos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où les fichiers extraits doivent aller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove devono andare i file estratti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
