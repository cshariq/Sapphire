          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте телефон, чтобы разблокировать этот Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁你的手机以解锁这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖你的手機以解鎖這台 Mac。"
          }
        }
      }
    },
    "Unlock, only wake the screen, or do nothing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren, nur den Bildschirm aktivieren oder nichts tun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock, only wake the screen, or do nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquear, solo activar la pantalla o no hacer nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouiller, réveiller seulement l’écran ou ne rien faire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca, riattiva solo lo schermo o non fare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを解除する、画面のスリープ解除のみ行う、または何もしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 해제, 화면만 깨우기 또는 아무것도 하지 않기."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquear, apenas ativar a tela ou não fazer nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировать, только включить экран или ничего не делать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁、仅唤醒屏幕或不执行任何操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖、僅喚醒螢幕或不執行任何動作。"
          }
        }
      }
