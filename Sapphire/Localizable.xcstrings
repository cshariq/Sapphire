    "Mission Control's gesture and key open Fractal's Overview instead: every window on every display, with your Spaces.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geste und die Taste von Mission Control öffnen stattdessen die Übersicht von Fractal: jedes Fenster auf jedem Display, mit Ihren Spaces."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mission Control's gesture and key open Fractal's Overview instead: every window on every display, with your Spaces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gesto y la tecla de Mission Control abren en su lugar el Resumen de Fractal: todas las ventanas de todas las pantallas, con tus Spaces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le geste et la touche de Mission Control ouvrent à la place la Vue d’ensemble de Fractal : toutes les fenêtres de tous les écrans, avec vos Spaces."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gesto e il tasto di Mission Control aprono invece la Panoramica di Fractal: ogni finestra su ogni display, con i tuoi Spaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mission Controlのジェスチャとキーで、代わりにFractalの概要が開きます。すべてのディスプレイのすべてのウインドウが、Spacesとともに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mission Control의 제스처와 키가 대신 Fractal의 개요를 엽니다. 모든 디스플레이의 모든 윈도우와 Spaces가 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gesto e a tecla do Mission Control abrem a Visão Geral do Fractal: todas as janelas em todos os monitores, com seus Spaces."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жест и клавиша Mission Control открывают вместо него Обзор Fractal: все окна на всех дисплеях вместе с вашими Spaces."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调度中心的手势和按键会改为打开 Fractal 的“总览”：所有显示器上的所有窗口，连同你的空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mission Control 的手勢和按鍵會改為開啟 Fractal 的「總覽」：所有顯示器上的所有視窗，連同你的空間。"
          }
        }
      }
    },
