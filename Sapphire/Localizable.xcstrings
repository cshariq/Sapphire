    "Required for Gemini Live screen sharing, per-app audio capture, live window previews, and the hinge-driven desktop animation.": {
      "comment": "Onboarding, app menus, helper, shared utilities, public build placeholders",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erforderlich für die Bildschirmfreigabe von Gemini Live, App-Audioaufnahme, Live-Fenstervorschauen und die scharniergesteuerte Schreibtischanimation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required for Gemini Live screen sharing, per-app audio capture, live window previews, and the hinge-driven desktop animation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para compartir pantalla con Gemini Live, la captura de audio por app, las previsualizaciones de ventanas en directo y la animación del escritorio controlada por la bisagra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Requis pour le partage d’écran Gemini Live, la capture audio par app, les aperçus de fenêtres en direct et l’animation du bureau pilotée par la charnière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiesto per la condivisione dello schermo di Gemini Live, l'acquisizione audio per app, le anteprime live delle finestre e l'animazione della scrivania guidata dalla cerniera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Liveの画面共有、Appごとのオーディオキャプチャ、ライブウインドウプレビュー、ヒンジ連動のデスクトップアニメーションに必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini Live 화면 공유, 앱별 오디오 캡처, 라이브 윈도우 미리보기 및 경첩 연동 데스크탑 애니메이션에 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para o compartilhamento de tela do Gemini Live, a captura de áudio por app, as pré-visualizações ao vivo de janelas e a animação da mesa controlada pela dobradiça."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется для демонстрации экрана в Gemini Live, захвата звука отдельных приложений, живого просмотра окон и анимации рабочего стола по шарниру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于 Gemini Live 屏幕共享、按应用采集音频、实时窗口预览，以及由屏幕转轴驱动的桌面动画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於 Gemini Live 螢幕分享、依 App 擷取音訊、即時視窗預覽，以及由螢幕轉軸驅動的桌面動畫。"
          }
        }
      }
    },
