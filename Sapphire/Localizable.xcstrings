    "Native drives the phone as a real Bluetooth keyboard and mouse — Android's own pointer, hover, right-click and wheel. Sapphire cursor draws an overlay pointer and injects gestures instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native drives the phone as a real Bluetooth keyboard and mouse — Android's own pointer, hover, right-click and wheel. Sapphire cursor draws an overlay pointer and injects gestures instead."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生模式將 Mac 用作藍牙鍵盤與滑鼠來控制手機，使用 Android 本身的游標、停留、按右鍵與滾輪功能。Sapphire 游標模式則繪製覆蓋游標並注入手勢。"
          }
        }
      }
    },
    "Navigation, timers, downloads and calls appear as live activities in the notch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigation, timers, downloads and calls appear as live activities in the notch."
