    "Hold ⌥ and move two fingers to slide the view while zoomed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie ⌥ und bewegen Sie zwei Finger, um die Ansicht beim Zoomen zu verschieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold ⌥ and move two fingers to slide the view while zoomed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado ⌥ y mueve dos dedos para deslizar la vista con el zoom aplicado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌥ et déplacez deux doigts pour faire glisser la vue pendant le zoom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌥ e muovi due dita per far scorrere la vista durante lo zoom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズーム中は、⌥を押しながら2本指で動かすと、ビューをスライドできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확대한 상태에서 ⌥를 누른 채 두 손가락을 움직여 보기를 밉니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⌥ pressionado e mova dois dedos para deslizar a visualização com zoom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌥ и двигайте двумя пальцами, чтобы сдвигать вид при увеличении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 并用两指移动，可在缩放时滑动视图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 並用兩指移動，可在縮放時滑動檢視畫面。"
          }
        }
      }
    },
    "Hold ⌥ and pinch anywhere to zoom out to everything, or in on a window.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie ⌥ und zoomen Sie irgendwo per Pinch, um auf alles herauszuzoomen oder auf ein Fenster hineinzuzoomen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold ⌥ and pinch anywhere to zoom out to everything, or in on a window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado ⌥ y pellizca en cualquier lugar para alejar el zoom hasta ver todo, o acercarlo a una ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌥ et pincez n’importe où pour dézoomer sur tout, ou zoomer sur une fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌥ e pizzica ovunque per ridurre lo zoom su tutto, o ingrandire una finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥を押しながらどこでもピンチすると、すべてにズームアウトするか、ウインドウにズームインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥를 누른 채 아무 곳이나 핀치하면 전체로 축소하거나 윈도우로 확대합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⌥ pressionado e use a pinça em qualquer lugar para reduzir o zoom até ver tudo ou aproximar de uma janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌥ и сводите или разводите пальцы где угодно, чтобы отдалить до всего или приблизить окно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 并在任意位置捏合，可缩小到查看全部内容，或放大到某个窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 並在任何位置縮放手勢，可縮小到檢視全部內容，或放大到某個視窗。"
          }
        }
      }
    },
