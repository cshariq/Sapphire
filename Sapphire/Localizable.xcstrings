    "Mount, install, unmount, and clean up disk images automatically, built into Sapphire.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk-Images automatisch mounten, installieren, auswerfen und aufräumen, direkt in Sapphire integriert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount, install, unmount, and clean up disk images automatically, built into Sapphire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Monta, instala, expulsa y limpia imágenes de disco automáticamente, integrado en Sapphire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montez, installez, démontez et nettoyez automatiquement les images disque, directement dans Sapphire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monta, installa, smonta e ripulisci automaticamente le immagini disco, direttamente in Sapphire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクイメージのマウント、インストール、マウント解除、クリーンアップを自動で行います。Sapphireに内蔵されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 이미지를 자동으로 마운트, 설치, 마운트 해제하고 정리하는 기능이 Sapphire에 내장되어 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte, instale, ejete e limpe imagens de disco automaticamente, integrado ao Sapphire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически монтируйте, устанавливайте, извлекайте и очищайте образы дисков — встроено в Sapphire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动挂载、安装、推出并清理磁盘映像，已内置于 Sapphire。"
