    "Bring the window under the cursor to the front after a pause. Waits while you drag or hold a modifier key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringt das Fenster unter dem Zeiger nach einer Pause in den Vordergrund. Wartet, solange Sie ziehen oder eine Modifikatortaste halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the window under the cursor to the front after a pause. Waits while you drag or hold a modifier key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae al frente la ventana que está bajo el cursor tras una pausa. Espera mientras arrastras o mantienes pulsada una tecla modificadora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre au premier plan la fenêtre sous le curseur après une pause. Attend pendant que vous faites glisser ou maintenez une touche de modification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta in primo piano la finestra sotto il cursore dopo una pausa. Attende mentre trascini o tieni premuto un tasto modificatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止後にカーソル下のウインドウを前面に表示します。ドラッグ中や修飾キーを押している間は待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 멈춘 후 커서 아래의 윈도우를 앞으로 가져옵니다. 드래그하거나 수정자 키를 누르고 있는 동안에는 대기합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz a janela sob o cursor para a frente após uma pausa. Aguarda enquanto você arrasta ou mantém uma tecla modificadora pressionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выводить окно под курсором на передний план после паузы. Ждёт, пока вы перетаскиваете или удерживаете клавишу-модификатор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短暂停顿后，将光标下方的窗口置于前台。拖移或按住修饰键时会等待。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短暫停頓後，將游標下方的視窗移到最前方。拖移或按住變更鍵時會等待。"
          }
        }
      }
    },
    "Bring your desired device as close as possible to your Mac, then press Next.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie das gewünschte Gerät so nah wie möglich an Ihren Mac und drücken Sie dann „Weiter“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your desired device as close as possible to your Mac, then press Next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca el dispositivo que quieras lo máximo posible a tu Mac y pulsa Siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapprochez au maximum l’appareil souhaité de votre Mac, puis appuyez sur Suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvicina il più possibile il dispositivo desiderato al Mac, poi premi Avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的のデバイスをMacにできるだけ近づけてから、“次へ”を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 기기를 Mac에 최대한 가까이 가져간 다음 다음을 누르십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime o dispositivo desejado o máximo possível do Mac e clique em Avançar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднесите нужное устройство как можно ближе к Mac, затем нажмите «Далее»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将目标设备尽可能靠近 Mac，然后点击“下一步”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將目標裝置盡量靠近 Mac，然後按「下一步」。"
          }
        }
      }
    },
    "Bringing every window back into view.": {
