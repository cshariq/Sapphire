    "Browse your library, recommendations and the full catalog, and play without leaving the notch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuchen Sie Ihre Mediathek, Empfehlungen und den gesamten Katalog und spielen Sie ab, ohne die Notch zu verlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse your library, recommendations and the full catalog, and play without leaving the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora tu biblioteca, recomendaciones y todo el catálogo, y reproduce sin salir de la muesca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez votre bibliothèque, les recommandations et tout le catalogue, et lisez sans quitter l’encoche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoglia la libreria, i consigli e l'intero catalogo e riproduci senza uscire dal notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリ、おすすめ、カタログ全体を参照し、ノッチから離れずに再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함, 추천 항목 및 전체 카탈로그를 탐색하고 노치를 벗어나지 않고 재생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore sua biblioteca, recomendações e o catálogo completo, e reproduza sem sair do entalhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте медиатеку, рекомендации и весь каталог и слушайте, не покидая выреза."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览资料库、推荐内容及完整曲库，无需离开刘海区域即可播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽資料庫、推薦內容及完整曲庫，無須離開瀏海區域即可播放。"
          }
        }
      }
    },
