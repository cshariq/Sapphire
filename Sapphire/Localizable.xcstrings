        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "베타 빌드에는 Basic 이상이 필요합니다. 무료 계정은 공개 릴리스만 받습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
