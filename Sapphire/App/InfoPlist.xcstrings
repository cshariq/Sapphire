    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire fügt von Ihrem Smartphone synchronisierte Fotos hinzu, damit sie in der Fotos-App erscheinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire adds photos synced from your phone so they appear in the Photos app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire añade las fotos sincronizadas desde tu teléfono para que aparezcan en la app Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire ajoute les photos synchronisées depuis votre téléphone afin qu’elles apparaissent dans l’app Photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire aggiunge le foto sincronizzate dal telefono in modo che compaiano nell'app Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireは、スマートフォンから同期された写真を“写真”Appに表示されるよう追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire는 휴대전화에서 동기화한 사진을 사진 앱에 나타나도록 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sapphire adiciona as fotos sincronizadas do seu celular para que apareçam no app Fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire добавляет фото, синхронизированные с вашего телефона, чтобы они появлялись в приложении «Фото»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 会添加从你手机同步的照片，使其显示在“照片”App 中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 會加入從你手機同步的照片，使其顯示在「照片」App 中。"
          }
        }
      }
    },
