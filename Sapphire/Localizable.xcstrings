          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了改进 Sapphire，我们会收集完全匿名的汇总使用数据。这有助于了解常用功能、发现问题，并为所有用户改进应用。"
          }
        }
