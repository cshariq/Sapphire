      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Smartphone ausblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide on phone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar en el teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer sur le téléphone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi sul telefono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンでは非表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화에서 숨기기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar no celular"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть на телефоне"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机播放时隐藏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機播放時隱藏"
          }
        }
      }
    },
    "Hide on phone is the default. Turning the waveform off entirely is available when right-side track info is Always.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auf dem Smartphone ausblenden“ ist die Standardeinstellung. Die Wellenform lässt sich ganz ausschalten, wenn die Titelinfo auf der rechten Seite auf „Immer“ steht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide on phone is the default. Turning the waveform off entirely is available when right-side track info is Always."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar en el teléfono es la opción predeterminada. Desactivar por completo la forma de onda está disponible cuando la información de la pista de la derecha está en Siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer sur le téléphone est le réglage par défaut. Désactiver entièrement la forme d’onde est possible lorsque les infos du morceau à droite sont réglées sur Toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi sul telefono è l'impostazione predefinita. Disattivare del tutto la forma d'onda è possibile quando le informazioni del brano sul lato destro sono su Sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンでは非表示がデフォルトです。右側のトラック情報が“常に”のときは、波形を完全にオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화에서 숨기기가 기본값입니다. 오른쪽 트랙 정보가 항상일 때 파형을 완전히 끌 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar no celular é o padrão. Desativar totalmente a forma de onda está disponível quando as informações da faixa do lado direito estão em Sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скрыть на телефоне» — значение по умолчанию. Полностью выключить волну можно, когда сведения о треке справа установлены на «Всегда»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认在手机播放时隐藏波形。当右侧曲目信息设为“始终显示”时，可完全关闭波形。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設在手機播放時隱藏波形。當右側曲目資訊設為「一律顯示」時，可完全關閉波形。"
          }
        }
      }
    },
    "Hide only the activities you pick.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die von Ihnen ausgewählten Aktivitäten ausblenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide only the activities you pick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta solo las actividades que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer uniquement les activités que vous choisissez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi solo le attività che scegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したアクティビティのみを非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 활동만 숨깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta apenas as atividades que você escolher."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать только выбранные вами активности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅隐藏你选择的活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只隱藏你選取的動態。"
          }
        }
      }
    },
    "Hide pinned apps from the Dock — an app's icon appears only while it's running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Apps im Dock ausblenden – das Symbol einer App erscheint nur, solange sie läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide pinned apps from the Dock — an app's icon appears only while it's running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta del Dock las apps fijadas: el icono de una app aparece solo mientras se ejecuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les apps épinglées du Dock — l’icône d’une app n’apparaît que lorsqu’elle est ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi dal Dock le app fissate: l'icona di un'app compare solo mentre è in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めしたAppをDockから非表示にします。Appのアイコンは実行中のみ表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 앱을 Dock에서 숨깁니다. 앱 아이콘은 실행 중일 때만 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta apps fixados do Dock — o ícone de um app aparece somente enquanto ele está em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать закреплённые приложения в Dock — значок приложения появляется, только пока оно запущено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏程序坞中固定的应用，仅在应用运行时显示其图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏 Dock 中固定的 App，僅在 App 執行時顯示其圖示。"
          }
        }
      }
    },
    "Hide short-form feeds without blocking the whole app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzformat-Feeds ausblenden, ohne die gesamte App zu blockieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide short-form feeds without blocking the whole app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los feeds de vídeos cortos sin bloquear toda la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez les flux de vidéos courtes sans bloquer toute l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi i feed di video brevi senza bloccare l’intera app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appすべてをブロックせずに、ショート動画のフィードを非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 전체를 차단하지 않고 짧은 동영상 피드를 숨깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte feeds de vídeos curtos sem bloquear o app inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывайте ленты коротких видео, не блокируя приложение целиком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏短视频内容，而不屏蔽整个应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏短影音內容，而不封鎖整個 App。"
          }
        }
      }
    },
    "Hide the finance activity outside regular US trading hours.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Finanz-Aktivität außerhalb der regulären US-Handelszeiten aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the finance activity outside regular US trading hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta la actividad de finanzas fuera del horario de negociación habitual de EE. UU."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer l’activité Finance en dehors des heures de cotation régulières américaines."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi l'attività Finanza fuori dagli orari regolari di contrattazione USA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の米国取引時間外は、金融アクティビティを非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 미국 거래 시간 외에는 금융 활동을 숨깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta a atividade de finanças fora do horário regular de negociação dos EUA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать активность финансов вне обычных торговых часов США."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在美股常规交易时段之外隐藏财经实时活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在美股正常交易時段以外隱藏財經即時動態。"
          }
        }
      }
    },
    "Hide the lyrics line under the music live activity so it doesn't cover the full-screen app. The song still shows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Songtextzeile unter der Musik-Live-Aktivität aus, damit sie die Vollbild-App nicht verdeckt. Der Song wird weiterhin angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the lyrics line under the music live activity so it doesn't cover the full-screen app. The song still shows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta la línea de letras bajo la actividad en directo de música para que no tape la app a pantalla completa. La canción sigue mostrándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer la ligne de paroles sous l’activité en direct de la musique afin qu’elle ne recouvre pas l’app en plein écran. Le morceau reste affiché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi la riga dei testi sotto la Live Activity musicale così non copre l'app a schermo intero. Il brano viene comunque mostrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンのAppを覆わないよう、ミュージックのライブアクティビティの下の歌詞の行を非表示にします。曲は引き続き表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 앱을 가리지 않도록 음악 라이브 활동 아래의 가사 줄을 숨깁니다. 노래는 계속 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta a linha de letras sob a atividade ao vivo de música para que não cubra o app em tela inteira. A música continua aparecendo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать строку текста песни под live-активностью музыки, чтобы она не закрывала полноэкранное приложение. Песня по-прежнему показывается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏音乐实时活动下方的歌词行，避免遮挡全屏应用。歌曲仍会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏音樂即時動態下方的歌詞列，避免遮住全螢幕 App。歌曲仍會顯示。"
          }
        }
      }
    },
    "Hide the lyrics line while an app is full screen, on every display. Set it per display in Appearance → Displays.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Songtextzeile aus, während eine App im Vollbildmodus ist, auf jedem Display. Stellen Sie dies pro Display unter „Erscheinungsbild“ → „Displays“ ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the lyrics line while an app is full screen, on every display. Set it per display in Appearance → Displays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta la línea de letras mientras una app está a pantalla completa, en todas las pantallas. Ajústalo por pantalla en Apariencia → Pantallas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer la ligne de paroles lorsqu’une app est en plein écran, sur tous les écrans. À régler par écran dans Apparence → Écrans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi la riga dei testi mentre un'app è a schermo intero, su ogni display. Impostalo per display in Aspetto → Display."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appがフルスクリーンのとき、すべてのディスプレイで歌詞の行を非表示にします。ディスプレイごとの設定は“外観”→“ディスプレイ”で行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 디스플레이에서 앱이 전체 화면일 때 가사 줄을 숨깁니다. 외관 → 디스플레이에서 디스플레이별로 설정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta a linha de letras enquanto um app está em tela inteira, em todos os monitores. Defina por monitor em Aparência → Monitores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать строку текста песни, пока приложение в полноэкранном режиме, на каждом дисплее. Настраивается для каждого дисплея в «Оформление» → «Дисплеи»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用全屏时，在所有显示器上隐藏歌词行。可在“外观”→“显示器”中为各显示器单独设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 全螢幕時，在所有顯示器上隱藏歌詞列。可在「外觀」→「顯示器」中為各顯示器個別設定。"
          }
        }
      }
    },
    "Hide the music widget when Spotify is paused and no other system media is playing": {
      "comment": "Settings interface",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Musik-Widget ausblenden, wenn Spotify pausiert ist und keine anderen Systemmedien abgespielt werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the music widget when Spotify is paused and no other system media is playing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta el widget de música cuando Spotify está en pausa y no se reproduce ningún otro contenido del sistema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer le widget musique lorsque Spotify est en pause et qu’aucun autre média système n’est en lecture"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi il widget musica quando Spotify è in pausa e non è in riproduzione altro contenuto multimediale di sistema"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotifyが一時停止中で、ほかにシステムメディアが再生されていないとき、ミュージックウィジェットを非表示にします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify가 일시 정지되고 재생 중인 다른 시스템 미디어가 없으면 음악 위젯을 숨깁니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta o widget de música quando o Spotify está pausado e nenhuma outra mídia do sistema está tocando"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать музыкальный виджет, когда Spotify на паузе и нет другого системного воспроизведения медиа"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 已暂停且没有其他系统媒体播放时，隐藏音乐小组件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 已暫停且沒有其他系統媒體播放時，隱藏音樂小工具"
          }
        }
      }
    },
    "Hide the notch completely while an app is full screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Notch vollständig aus, während eine App im Vollbildmodus ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the notch completely while an app is full screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta la muesca por completo mientras una app está a pantalla completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer complètement l’encoche lorsqu’une app est en plein écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi completamente il notch mentre un'app è a schermo intero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appがフルスクリーンの間、ノッチを完全に非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 전체 화면일 때 노치를 완전히 숨깁니다."
          }
