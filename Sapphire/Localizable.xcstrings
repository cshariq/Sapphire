    "Controls need Accessibility permission; Google Meet also needs permission to control your browser.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Steuerung ist die Berechtigung „Bedienungshilfen“ erforderlich; Google Meet benötigt außerdem die Berechtigung, Ihren Browser zu steuern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls need Accessibility permission; Google Meet also needs permission to control your browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los controles necesitan el permiso de Accesibilidad; Google Meet también necesita permiso para controlar tu navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes nécessitent l’autorisation Accessibilité ; Google Meet nécessite aussi l’autorisation de contrôler votre navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I controlli richiedono l'autorizzazione Accessibilità; Google Meet richiede anche l'autorizzazione a controllare il browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントロールにはアクセシビリティの権限が必要です。Google Meetでは、ブラウザを操作する権限も必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어하려면 손쉬운 사용 권한이 필요합니다. Google Meet는 브라우저를 제어할 권한도 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os controles precisam da permissão de Acessibilidade; o Google Meet também precisa de permissão para controlar seu navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для элементов управления нужно разрешение универсального доступа; Google Meet также требует разрешения на управление браузером."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制功能需要辅助功能权限；Google Meet 还需要控制浏览器的权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制功能需要輔助使用權限；Google Meet 還需要控制瀏覽器的權限。"
          }
        }
      }
    },
