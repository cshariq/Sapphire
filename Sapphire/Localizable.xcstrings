    "Copied images cross over Bluetooth, and over Wi-Fi at full quality when it's available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierte Bilder werden über Bluetooth übertragen und, sofern verfügbar, in voller Qualität über WLAN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied images cross over Bluetooth, and over Wi-Fi at full quality when it's available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes copiadas se transfieren por Bluetooth y, cuando está disponible, por Wi-Fi con calidad completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images copiées transitent par Bluetooth, et par Wi-Fi en pleine qualité lorsqu’il est disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini copiate passano via Bluetooth e, quando disponibile, via Wi-Fi alla massima qualità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーした画像はBluetooth経由で送信され、Wi-Fiが利用できる場合はWi-Fi経由でフル品質で送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 이미지는 Bluetooth를 통해 전송되며, Wi-Fi를 사용할 수 있으면 Wi-Fi를 통해 원본 화질로 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens copiadas passam por Bluetooth e, quando disponível, por Wi-Fi em qualidade total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированные изображения передаются по Bluetooth, а при наличии Wi-Fi — в полном качестве по Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制的图像通过蓝牙传输；Wi-Fi 可用时则以完整质量通过 Wi-Fi 传输。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝的影像透過藍牙傳輸；Wi-Fi 可用時則透過 Wi-Fi 以完整品質傳輸。"
          }
        }
      }
    },
