          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue impidiendo la suspensión tras salir del modo de pantalla cerrada, en lugar de desactivar caffeinate automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
