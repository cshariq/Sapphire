    "Review installed applications, inspect bundle details, and safely move unwanted apps to Trash.": {
      "comment": "SettingsSection.shortDescription",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie installierte Programme, sehen Sie Bundle-Details ein und legen Sie unerwünschte Apps sicher in den Papierkorb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review installed applications, inspect bundle details, and safely move unwanted apps to Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las aplicaciones instaladas, inspecciona los detalles de los paquetes y mueve con seguridad a la Papelera las apps que no quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinez les applications installées, consultez les détails des paquets et placez en toute sécurité les apps indésirables dans la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla le applicazioni installate, esamina i dettagli dei bundle e sposta in sicurezza nel Cestino le app indesiderate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのAppを確認し、バンドルの詳細を調べ、不要なAppを安全にゴミ箱に入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 응용 프로그램을 검토하고, 번들 세부사항을 검사하고, 원하지 않는 앱을 안전하게 휴지통으로 이동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise os aplicativos instalados, inspecione os detalhes dos pacotes e mova com segurança os apps indesejados para a Lixeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте установленные приложения, изучайте сведения о пакетах и безопасно перемещайте ненужные приложения в Корзину."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看已安装的应用及其包信息，并安全地将不需要的应用移到废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視已安裝的應用程式、查看套件詳細資訊，並安全地將不需要的 App 移到垃圾桶。"
          }
        }
      }
    },
