          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubra o papel de parede e os ícones da mesa com preto durante uma sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрывайте обои и значки рабочего стола чёрным на время сеанса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
