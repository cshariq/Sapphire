    "Start a focus session automatically at a set time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Fokus-Sitzung zu einer festgelegten Zeit automatisch starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
