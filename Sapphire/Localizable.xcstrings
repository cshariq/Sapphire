        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留每個項目，不限制項目數量或儲存空間。"
          }
        }
      }
    },
    "Keep installed apps current and review app-linked data before cleanup.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie installierte Apps aktuell und prüfen Sie mit Apps verknüpfte Daten vor dem Bereinigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep installed apps current and review app-linked data before cleanup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén las apps instaladas al día y revisa los datos vinculados a las apps antes de limpiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les apps installées à jour et examinez les données liées aux apps avant le nettoyage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni aggiornate le app installate e controlla i dati collegati alle app prima della pulizia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みAppを最新に保ち、クリーンアップ前にAppに関連するデータを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 앱을 최신 상태로 유지하고 정리하기 전에 앱과 연결된 데이터를 검토합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os apps instalados atualizados e revise os dados vinculados aos apps antes da limpeza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживайте установленные приложения в актуальном состоянии и проверяйте связанные с ними данные перед очисткой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持已安装的应用为最新版本，并在清理前审阅关联数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓已安裝的 App 保持最新，並在清理前檢查與 App 相關的資料。"
          }
        }
      }
    },
    "Keep live wallpapers running whenever the display is awake.": {
      "comment": "Runtime user-facing string",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Hintergrundbilder weiterlaufen lassen, solange das Display aktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep live wallpapers running whenever the display is awake."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén los fondos de pantalla animados en ejecución siempre que la pantalla esté activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder les fonds d’écran animés actifs tant que l’écran est allumé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni in esecuzione gli sfondi animati finché il display è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイがスリープしていない間は、ライブ壁紙を実行し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이가 켜져 있는 동안 라이브 배경화면을 계속 실행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém os papéis de parede dinâmicos em execução sempre que o monitor estiver ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держать живые обои запущенными, пока дисплей не спит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕唤醒时持续播放动态壁纸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示器喚醒時持續播放動態桌布。"
          }
        }
      }
    },
    "Keep noise cancelling on a single bud": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräuschunterdrückung auf einem einzelnen Ohrhörer beibehalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep noise cancelling on a single bud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener la cancelación de ruido en un solo auricular"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder la réduction de bruit sur un seul écouteur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni la cancellazione del rumore su un solo auricolare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "片方のイヤフォンでノイズキャンセリングを維持"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한쪽 버드에서도 노이즈 캔슬링 유지"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter o cancelamento de ruído em um único fone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять шумоподавление в одном наушнике"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用一只耳机时仍保持降噪"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅使用一隻耳機時仍保持降噪"
          }
        }
      }
    },
    "Keep only a few apps on screen. Opening another hides the oldest; they come back when the session ends.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenige Apps auf dem Bildschirm behalten. Beim Öffnen einer weiteren wird die älteste ausgeblendet; sie kommen zurück, wenn die Sitzung endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep only a few apps on screen. Opening another hides the oldest; they come back when the session ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén solo unas pocas apps en pantalla. Al abrir otra se oculta la más antigua; vuelven cuando termina la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne gardez que quelques apps à l’écran. En ouvrir une autre masque la plus ancienne ; elles reviennent à la fin de la session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni sullo schermo solo poche app. Aprendone un’altra viene nascosta la più vecchia; tornano visibili al termine della sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面に表示するAppを少数に絞ります。別のAppを開くと最も古いAppが隠れ、セッションが終了すると元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 몇 개의 앱만 유지합니다. 다른 앱을 열면 가장 오래된 앱이 숨겨지며, 세션이 끝나면 다시 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha só alguns apps na tela. Abrir outro oculta o mais antigo; eles voltam quando a sessão termina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставляйте на экране лишь несколько приложений. При открытии ещё одного самое старое скрывается; они возвращаются в конце сеанса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕上只保留少数应用。打开新应用时会隐藏最早的应用，专注时段结束后会恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕上只保留少數 App。開啟新 App 時會隱藏最早的 App，專注時段結束後會恢復。"
          }
        }
      }
    },
    "Keep only a few apps on screen; switching to another tucks the oldest one away (restored when the session ends).": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenige Apps auf dem Bildschirm behalten; beim Wechsel zu einer anderen wird die älteste weggeräumt (wiederhergestellt, wenn die Sitzung endet)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep only a few apps on screen; switching to another tucks the oldest one away (restored when the session ends)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén solo unas pocas apps en pantalla; al cambiar a otra, la más antigua se guarda (se restaura cuando termina la sesión)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne gardez que quelques apps à l’écran ; passer à une autre met la plus ancienne de côté (restaurée à la fin de la session)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni solo poche app sullo schermo; passando a un'altra, la più vecchia viene messa da parte (ripristinata al termine della sessione)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上に残すAppを数個に限定します。別のAppに切り替えると、最も古いものが片付けられます(セッション終了時に復元されます)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 개의 앱만 화면에 유지합니다. 다른 앱으로 전환하면 가장 오래된 앱이 치워지고 세션이 끝나면 복원됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém apenas alguns apps na tela; alternar para outro guarda o mais antigo (restaurado quando a sessão termina)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держать на экране только несколько приложений; при переключении на другое самое старое убирается (возвращается по окончании сеанса)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕上仅保留少量应用；切换到新应用时隐藏最早使用的应用，专注时段结束后恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕上只保留少數 App；切換到其他 App 時會收起最舊的那個（時段結束時回復）。"
          }
        }
      }
    },
    "Keep score and game clock visible while you work.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielstand und Spieluhr während der Arbeit sichtbar lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep score and game clock visible while you work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén visibles el marcador y el reloj del partido mientras trabajas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le score et le chrono du match visibles pendant que vous travaillez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni visibili punteggio e cronometro della partita mentre lavori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業中も、スコアと試合時間を表示したままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업하는 동안 점수와 경기 시계를 계속 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o placar e o cronômetro do jogo visíveis enquanto você trabalha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держать счёт и игровые часы на виду, пока вы работаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作时持续显示比分和比赛计时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作時持續顯示比分與比賽計時。"
          }
        }
      }
    },
    "Keep showing the current track in lock screen widgets even when playback is paused.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktuellen Titel in Sperrbildschirm-Widgets weiterhin anzeigen, auch wenn die Wiedergabe pausiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep showing the current track in lock screen widgets even when playback is paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue mostrando la pista actual en los widgets de la pantalla bloqueada aunque la reproducción esté en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer à afficher le morceau en cours dans les widgets de l’écran de verrouillage même lorsque la lecture est en pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a mostrare il brano corrente nei widget della schermata di blocco anche quando la riproduzione è in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生が一時停止中でも、ロック画面のウィジェットに現在のトラックを表示し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생이 일시 정지되어도 잠금 화면 위젯에 현재 트랙을 계속 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua mostrando a faixa atual nos widgets da tela bloqueada mesmo com a reprodução pausada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжать показывать текущий трек в виджетах экрана блокировки, даже когда воспроизведение на паузе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使播放已暂停，也在锁定屏幕小组件中继续显示当前曲目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使播放已暫停，也在鎖定畫面小工具中繼續顯示目前曲目。"
          }
        }
      }
    },
    "Keep still while the buds play tones": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stillhalten, während die Ohrhörer Töne abspielen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep still while the buds play tones"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quédate quieto mientras los auriculares reproducen tonos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne bougez pas pendant que les écouteurs émettent des sons"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta fermo mentre gli auricolari riproducono i toni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イヤフォンがトーンを再生している間は、じっとしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버드에서 톤이 재생되는 동안 가만히 계십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique parado enquanto os fones tocam tons"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не двигайтесь, пока наушники воспроизводят тоны"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耳机播放提示音时请保持静止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "耳機播放提示音時請保持靜止"
          }
        }
      }
    },
    "Keep the Sapphire notch bar visible at the top of the lock screen.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sapphire-Notch-Leiste oben auf dem Sperrbildschirm sichtbar lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the Sapphire notch bar visible at the top of the lock screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén visible la barra de la muesca de Sapphire en la parte superior de la pantalla bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder la barre d’encoche Sapphire visible en haut de l’écran de verrouillage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni la barra del notch di Sapphire visibile in cima alla schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面の上部に、Sapphireのノッチバーを表示したままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면 상단에 Sapphire 노치 막대를 계속 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a barra do entalhe do Sapphire visível no topo da tela bloqueada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держать панель выреза Sapphire видимой вверху экрана блокировки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁定屏幕顶部保持显示 Sapphire 刘海栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鎖定畫面頂部持續顯示 Sapphire 瀏海列。"
          }
        }
      }
    },
    "Keep the face recognition and liveness models loaded between unlocks so Face ID recognizes you from the first camera frame.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesichtserkennungs- und Lebendigkeitsmodelle zwischen Entsperrungen geladen lassen, damit Face ID Sie ab dem ersten Kamerabild erkennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the face recognition and liveness models loaded between unlocks so Face ID recognizes you from the first camera frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén cargados los modelos de reconocimiento facial y de prueba de vida entre desbloqueos para que Face ID te reconozca desde el primer fotograma de la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder les modèles de reconnaissance faciale et de détection du vivant chargés entre les déverrouillages pour que Face ID vous reconnaisse dès la première image de la caméra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni caricati i modelli di riconoscimento facciale e liveness tra uno sblocco e l'altro, così Face ID ti riconosce dal primo fotogramma della fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔認識とライブネスのモデルをロック解除の合間も読み込んだままにして、最初のカメラフレームからFace IDがあなたを認識できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 해제 사이에도 얼굴 인식 및 라이브니스 모델을 로드된 상태로 유지하여 첫 카메라 프레임부터 Face ID가 사용자를 인식하게 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém os modelos de reconhecimento facial e prova de vida carregados entre desbloqueios para que o Face ID o reconheça desde o primeiro quadro da câmera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держать модели распознавания лица и живости загруженными между разблокировками, чтобы Face ID узнавал вас с первого кадра камеры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在两次解锁之间保持人脸识别和活体检测模型已加载，让Face ID 从摄像头的第一帧就能识别你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在兩次解鎖之間保持臉部辨識與活體偵測模型已載入，讓 Face ID 從相機的第一個畫格就能辨識你。"
          }
        }
      }
    },
    "Keep the music live activity showing while playback is paused instead of hiding it after 30 seconds.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Musik-Live-Aktivität bei pausierter Wiedergabe weiter anzeigen, statt sie nach 30 Sekunden auszublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the music live activity showing while playback is paused instead of hiding it after 30 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener visible la actividad en directo de música mientras la reproducción está en pausa en lugar de ocultarla tras 30 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder l’activité en direct de la musique affichée pendant la pause au lieu de la masquer après 30 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni visibile la Live Activity della musica durante la pausa invece di nasconderla dopo 30 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生を一時停止しても、30 秒後に隠さずに音楽のライブアクティビティを表示し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생이 일시 정지되어도 30초 후에 숨기지 않고 음악 라이브 활동을 계속 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter a Atividade ao Vivo da música visível enquanto a reprodução está pausada, em vez de ocultá-la após 30 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать Live-активность музыки во время паузы, а не скрывать её через 30 секунд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放暂停时继续显示音乐实时活动，而不是在 30 秒后隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放暫停時繼續顯示音樂即時動態，而不是在 30 秒後隱藏。"
          }
        }
      }
    },
    "Keep the music widget visible with the last track even when playback is paused or stopped": {
      "comment": "Settings interface",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Musik-Widget mit dem letzten Titel sichtbar lassen, auch wenn die Wiedergabe pausiert oder gestoppt ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the music widget visible with the last track even when playback is paused or stopped"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén visible el widget de música con la última pista aunque la reproducción esté en pausa o detenida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder le widget musique visible avec le dernier morceau même lorsque la lecture est en pause ou arrêtée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni visibile il widget musica con l'ultimo brano anche quando la riproduzione è in pausa o interrotta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生が一時停止または停止中でも、最後のトラックでミュージックウィジェットを表示したままにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생이 일시 정지되거나 중지되어도 마지막 트랙과 함께 음악 위젯을 계속 표시합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o widget de música visível com a última faixa mesmo com a reprodução pausada ou parada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставлять музыкальный виджет видимым с последним треком, даже когда воспроизведение приостановлено или остановлено"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使播放已暂停或停止，也继续显示音乐小组件及上一首曲目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使播放已暫停或停止，也繼續顯示音樂小工具及最後播放的曲目"
          }
        }
      }
    },
    "Keep the readings you care about in the menu bar itself, and get notified when your Mac is under stress — all computed locally.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie die für Sie wichtigen Werte direkt in der Menüleiste im Blick und lassen Sie sich benachrichtigen, wenn Ihr Mac stark belastet ist – alles wird lokal berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the readings you care about in the menu bar itself, and get notified when your Mac is under stress — all computed locally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén en la propia barra de menús las lecturas que te interesan y recibe una notificación cuando tu Mac esté bajo estrés; todo se calcula localmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les mesures qui vous importent dans la barre des menus et soyez averti lorsque votre Mac est sous tension — tout est calculé en local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni nella barra dei menu le letture che ti interessano e ricevi una notifica quando il Mac è sotto sforzo: tutto calcolato in locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気になる計測値をメニューバーに表示し、Macに負荷がかかっているときに通知します。すべてローカルで計算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요한 측정값을 메뉴 막대에 유지하고 Mac에 부하가 걸리면 알림을 받습니다. 모두 로컬에서 계산됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha as leituras que importam na própria barra de menus e seja avisado quando o Mac estiver sob estresse — tudo calculado localmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите нужные показания прямо в строке меню и получайте уведомления, когда Mac перегружен — всё вычисляется локально."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你关心的读数保留在菜单栏中，并在 Mac 负载过高时收到通知——全部在本地计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將你關心的讀數保留在選單列中，並在 Mac 負載過高時收到通知——全部在本機運算。"
          }
        }
      }
    },
    "Keep the system Focus / Do Not Disturb notification state in sync between this Mac and the phone. This is separate from Sapphire Focus Sessions and is free.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Benachrichtigungszustand des System-Fokus / „Nicht stören“ zwischen diesem Mac und dem Smartphone synchron halten. Dies ist unabhängig von Sapphire-Fokus-Sitzungen und kostenlos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the system Focus / Do Not Disturb notification state in sync between this Mac and the phone. This is separate from Sapphire Focus Sessions and is free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén sincronizado el estado de notificaciones del Foco / No molestar del sistema entre este Mac y el teléfono. Es independiente de las sesiones de foco de Sapphire y es gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez l’état de notification de concentration / Ne pas déranger du système synchronisé entre ce Mac et le téléphone. Cela est distinct des sessions de concentration Sapphire et est gratuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni sincronizzato tra questo Mac e il telefono lo stato di notifica di sistema Focus / Non disturbare. È separato dalle sessioni Focus di Sapphire ed è gratuito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの集中モード/おやすみモードの通知状態を、このMacとスマートフォンの間で同期します。これはSapphireの集中セッションとは別で、無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac과 휴대전화 간에 시스템 집중 모드/방해 금지 모드 알림 상태를 동기화합니다. Sapphire 집중 세션과는 별개이며 무료입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o estado de notificação do Foco / Não Perturbe do sistema sincronizado entre este Mac e o celular. É separado das Sessões de Foco do Sapphire e é gratuito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизировать состояние системного «Фокусирования» / «Не беспокоить» между этим Mac и телефоном. Это отдельно от сеансов фокусирования Sapphire и бесплатно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让系统的专注模式／勿扰模式通知状态在这台 Mac 和手机之间保持同步。这与 Sapphire 专注时段无关，且免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓系統的專注模式／勿擾模式通知狀態在這部 Mac 和手機之間保持同步。這與 Sapphire 專注時段無關，且免費。"
          }
        }
      }
    },
