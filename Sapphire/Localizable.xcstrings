    "Temperature unit. Off (the default) shows Fahrenheit (°F); on shows Celsius (°C).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperatureinheit. Aus (Standard) zeigt Fahrenheit (°F); an zeigt Celsius (°C)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature unit. Off (the default) shows Fahrenheit (°F); on shows Celsius (°C)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
