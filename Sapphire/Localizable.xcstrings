    "Can I hide the notch when nothing is playing?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann ich die Notch ausblenden, wenn nichts abgespielt wird?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I hide the notch when nothing is playing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Puedo ocultar la muesca cuando no se está reproduciendo nada?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis-je masquer l’encoche quand rien n’est en lecture ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso nascondere il notch quando non è in riproduzione nulla?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も再生していないときにノッチを非表示にできますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 중인 항목이 없을 때 노치를 숨길 수 있습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso ocultar o entalhe quando nada está tocando?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно ли скрыть вырез, когда ничего не воспроизводится?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有播放内容时可以隐藏刘海吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有播放內容時可以隱藏瀏海嗎？"
          }
        }
      }
    },
    "Can't be changed while a session is running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann nicht geändert werden, solange eine Sitzung läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't be changed while a session is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede cambiar mientras hay una sesión en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible à modifier pendant qu’une session est en cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non può essere modificato mentre è in corso una sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの実行中は変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 실행되는 동안에는 변경할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
