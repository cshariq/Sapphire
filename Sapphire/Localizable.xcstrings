    "Enable Accessibility in System Settings to allow auto-unlock.": {
      "comment": "Runtime user-facing string",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie die Bedienungshilfen in den Systemeinstellungen, um die automatische Entsperrung zu erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Accessibility in System Settings to allow auto-unlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Accesibilidad en Ajustes del Sistema para permitir el desbloqueo automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’accessibilité dans Réglages Système pour autoriser le déverrouillage automatique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Accessibilità in Impostazioni di Sistema per consentire lo sblocco automatico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動ロック解除を許可するには、“システム設定”でアクセシビリティを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 잠금 해제를 허용하려면 시스템 설정에서 손쉬운 사용을 활성화하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a Acessibilidade em Ajustes do Sistema para permitir o desbloqueio automático."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите универсальный доступ в Системных настройках, чтобы разрешить автоматическую разблокировку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中开启辅助功能权限，以允许自动解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中啟用「輔助使用」以允許自動解鎖。"
          }
        }
      }
    },
