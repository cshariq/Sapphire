    "Show CPU, memory and live network rates directly in the menu bar. Network rates update every second.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, Arbeitsspeicher und Live-Netzwerkraten direkt in der Menüleiste anzeigen. Netzwerkraten werden jede Sekunde aktualisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show CPU, memory and live network rates directly in the menu bar. Network rates update every second."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la CPU, la memoria y las velocidades de red en directo en la propia barra de menús. Las velocidades de red se actualizan cada segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le processeur, la mémoire et les débits réseau en direct directement dans la barre des menus. Les débits réseau se mettent à jour chaque seconde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra CPU, memoria e velocità di rete in tempo reale direttamente nella barra dei menu. Le velocità di rete si aggiornano ogni secondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU、メモリ、ライブのネットワーク速度をメニューバーに直接表示します。ネットワーク速度は1秒ごとに更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, 메모리 및 실시간 네트워크 속도를 메뉴 막대에 직접 표시합니다. 네트워크 속도는 1초마다 업데이트됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra CPU, memória e taxas de rede ao vivo diretamente na barra de menus. As taxas de rede são atualizadas a cada segundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать загрузку ЦП, памяти и скорость сети в реальном времени прямо в строке меню. Скорость сети обновляется каждую секунду."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在菜单栏中显示 CPU、内存和实时网络速率。网络速率每秒更新一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列中直接顯示 CPU、記憶體和即時網路速率。網路速率每秒更新一次。"
          }
        }
      }
    },
