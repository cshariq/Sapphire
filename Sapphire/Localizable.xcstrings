    "Download in the background. Installation always waits for you.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Hintergrund laden. Die Installation wartet immer auf Sie."
          }
