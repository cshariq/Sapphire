    "Keeps your Mac awake to ensure it reaches the charge limit, useful for 'top-up' schedules before you need to leave.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält Ihren Mac wach, damit er das Ladelimit erreicht – nützlich für Auffüllpläne, bevor Sie losmüssen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps your Mac awake to ensure it reaches the charge limit, useful for 'top-up' schedules before you need to leave."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene tu Mac activo para asegurar que llegue al límite de carga; útil para programaciones de \"recarga\" antes de que tengas que salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient votre Mac éveillé pour garantir qu’il atteigne la limite de charge, utile pour les planifications de « complément de charge » avant de partir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene il Mac attivo per assicurarsi che raggiunga il limite di carica, utile per le pianificazioni di “ricarica rapida” prima di uscire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電の上限に確実に到達するように、Macをスリープさせません。出かける前の“継ぎ足し充電”のスケジュールに便利です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전 제한에 도달하도록 Mac을 깨어 있게 유지합니다. 자리를 뜨기 전에 '보충 충전' 일정을 사용할 때 유용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o Mac ativo para garantir que ele alcance o limite de carga, útil para agendamentos de 'complemento' antes de você precisar sair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не даёт Mac заснуть, чтобы он достиг лимита заряда; полезно для «подзарядки» по расписанию перед уходом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Mac 保持唤醒，确保达到充电上限，适合出门前定时补充电量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 Mac 保持喚醒以確保達到充電上限，適合在出門前定時補充電量。"
          }
        }
      }
    },
    "Kept as the system input, even when headphones with their own microphone connect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt als Systemeingang erhalten, auch wenn Kopfhörer mit eigenem Mikrofon verbunden werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept as the system input, even when headphones with their own microphone connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mantiene como entrada del sistema, incluso cuando se conectan auriculares con su propio micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservé comme entrée système, même lorsque des écouteurs dotés de leur propre micro se connectent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenuto come ingresso di sistema, anche quando si collegano cuffie con un proprio microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自のマイクを備えたヘッドフォンが接続されても、システムの入力として維持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 마이크가 있는 헤드폰을 연결해도 시스템 입력으로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantido como entrada do sistema, mesmo quando fones com microfone próprio são conectados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаётся системным входом, даже когда подключаются наушники со своим микрофоном."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使连接带麦克风的耳机，也始终将此设备用作系统输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使連接帶有麥克風的耳機，也始終將此裝置用作系統輸入。"
          }
        }
      }
    },
