    "How far each brightness key press moves. Smaller steps give finer control.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit sich die Helligkeit pro Tastendruck ändert. Kleinere Schritte ermöglichen eine feinere Steuerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far each brightness key press moves. Smaller steps give finer control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto se mueve cada pulsación de la tecla de brillo. Los pasos más pequeños dan un control más preciso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance parcourue à chaque pression d’une touche de luminosité. Des pas plus petits offrent un contrôle plus fin."
          }
        },
        "it": {
          "stringUnit": {
