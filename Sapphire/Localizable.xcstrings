    "Enable and reorder the buttons that appear in the music player. The first two enabled buttons will appear in the main control bar.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren und ordnen Sie die Tasten, die im Musikplayer erscheinen. Die ersten beiden aktivierten Tasten erscheinen in der Hauptsteuerleiste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable and reorder the buttons that appear in the music player. The first two enabled buttons will appear in the main control bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa y reordena los botones que aparecen en el reproductor de música. Los dos primeros botones activados aparecerán en la barra de control principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez et réorganisez les boutons qui apparaissent dans le lecteur de musique. Les deux premiers boutons activés apparaîtront dans la barre de commande principale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva e riordina i pulsanti che compaiono nel lettore musicale. I primi due pulsanti attivati compariranno nella barra dei controlli principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージックプレーヤーに表示されるボタンを有効にして並べ替えます。有効にした最初の2つのボタンが、メインのコントロールバーに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 플레이어에 나타나는 버튼을 활성화하고 순서를 변경합니다. 활성화된 처음 두 버튼이 주 제어 막대에 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative e reordene os botões que aparecem no player de música. Os dois primeiros botões ativados aparecem na barra de controle principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включайте и переупорядочивайте кнопки музыкального проигрывателя. Первые две включённые кнопки появятся на главной панели управления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用并排列音乐播放器中的按钮。前两个已启用按钮会显示在主控制栏中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用並重新排序音樂播放器中顯示的按鈕。前兩個已啟用的按鈕會顯示在主要控制列中。"
          }
        }
      }
    },
