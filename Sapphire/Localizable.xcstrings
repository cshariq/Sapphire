    "Manually stop charging while plugged in. Turn off to resume normal charging rules (limit, sailing mode, etc.).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laden manuell stoppen, während das Gerät angeschlossen ist. Deaktivieren Sie dies, um die normalen Laderegeln (Limit, Sailing-Modus usw.) fortzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manually stop charging while plugged in. Turn off to resume normal charging rules (limit, sailing mode, etc.)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén manualmente la carga mientras está conectado. Desactívalo para reanudar las reglas de carga normales (límite, modo Navegación, etc.)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter manuellement la charge lorsque l’appareil est branché. Désactivez pour reprendre les règles de charge normales (limite, mode Sailing, etc.)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi manualmente la ricarica mentre è collegato all'alimentazione. Disattiva per riprendere le normali regole di ricarica (limite, modalità Sailing, ecc.)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源に接続している間、手動で充電を停止します。オフにすると、通常の充電ルール(上限、セーリングモードなど)が再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원에 연결된 상태에서 충전을 수동으로 중지합니다. 끄면 일반 충전 규칙(제한, 항해 모드 등)이 재개됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompa manualmente o carregamento enquanto conectado. Desative para retomar as regras normais de carregamento (limite, modo sailing etc.)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вручную остановить зарядку при подключённом питании. Выключите, чтобы вернуться к обычным правилам зарядки (лимит, режим Sailing и т. д.)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接通电源时手动停止充电。关闭后恢复正常充电规则（上限、巡航模式等）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接上電源時手動停止充電。關閉後恢復正常充電規則（上限、航行模式等）。"
          }
        }
      }
    },
