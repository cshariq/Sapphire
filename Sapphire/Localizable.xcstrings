    "Fractal Windows is part of Sapphire Ultra. Your windows aren't touched while it's locked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fractal Windows ist Teil von Sapphire Ultra. Ihre Fenster werden nicht angetastet, solange es gesperrt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fractal Windows is part of Sapphire Ultra. Your windows aren't touched while it's locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fractal Windows forma parte de Sapphire Ultra. Tus ventanas no se tocan mientras está bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fractal Windows fait partie de Sapphire Ultra. Vos fenêtres ne sont pas touchées tant qu’il est verrouillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fractal Windows fa parte di Sapphire Ultra. Le tue finestre non vengono toccate mentre è bloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fractal WindowsはSapphire Ultraの一部です。ロックされている間、ウインドウには触れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프랙탈 윈도우는 Sapphire Ultra에 포함됩니다. 잠겨 있는 동안 윈도우는 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Fractal Windows faz parte do Sapphire Ultra. Suas janelas não são alteradas enquanto ele está bloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Fractal Windows входит в Sapphire Ultra. Ваши окна не затрагиваются, пока функция заблокирована."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fractal Windows 属于 Sapphire Ultra。锁定期间不会触碰你的窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Fractal Windows 屬於 Sapphire Ultra。鎖定期間不會觸碰你的視窗。"
          }
        }
      }
    },
