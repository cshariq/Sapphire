    "Starting or ending a Focus Profile on one device starts or ends it on the other.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Starten oder Beenden eines Fokus-Profils auf einem Gerät startet oder beendet es auf dem anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting or ending a Focus Profile on one device starts or ends it on the other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar o terminar un perfil de foco en un dispositivo lo inicia o termina en el otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer ou terminer un profil de concentration sur un appareil le démarre ou le termine sur l’autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avviare o terminare un profilo Focus su un dispositivo lo avvia o lo termina sull'altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一方のデバイスで集中プロファイルを開始または終了すると、もう一方でも開始または終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 기기에서 집중 프로파일을 시작하거나 종료하면 다른 기기에서도 시작되거나 종료됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar ou encerrar um Perfil de Foco em um dispositivo o inicia ou encerra no outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начало или завершение профиля фокусирования на одном устройстве начинает или завершает его на другом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一台设备上开始或结束专注配置，会在另一台设备上同步开始或结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在一部裝置上開始或結束專注設定檔，會在另一部裝置上同步開始或結束。"
          }
        }
      }
    },
    "Starting or ending this profile here does the same on your Android phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie dieses Profil hier starten oder beenden, geschieht dasselbe auf Ihrem Android-Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting or ending this profile here does the same on your Android phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al iniciar o terminar este perfil aquí, ocurre lo mismo en tu teléfono Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer ou arrêter ce profil ici fait de même sur votre téléphone Android."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avviare o terminare questo profilo qui fa lo stesso sul tuo telefono Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでこのプロファイルを開始または終了すると、Androidスマートフォンでも同じ操作が行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 이 프로필을 시작하거나 종료하면 Android 휴대전화에서도 동일하게 실행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar ou encerrar este perfil aqui faz o mesmo no seu celular Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запуск или завершение этого профиля здесь делает то же самое на вашем телефоне Android."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里开始或结束此配置方案时，Android 手机上也会同步执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這裡開始或結束此設定組時，Android 手機上也會同步執行。"
          }
        }
      }
    },
