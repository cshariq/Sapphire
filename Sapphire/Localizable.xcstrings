    "Update this app from its own row. Batch updates skip it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie diese App in ihrer eigenen Zeile. Sammelaktualisierungen überspringen sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update this app from its own row. Batch updates skip it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza esta app desde su propia fila. Las actualizaciones por lotes la omiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour cette app depuis sa propre ligne. Les mises à jour groupées l’ignorent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna questa app dalla sua riga. Gli aggiornamenti in blocco la saltano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このAppは専用の行から更新してください。一括アップデートでは対象外になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 해당 행에서 직접 업데이트하십시오. 일괄 업데이트에서는 제외됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize este app na própria linha dele. As atualizações em lote o ignoram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновляйте это приложение из его собственной строки. Пакетные обновления его пропускают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在对应行单独更新此应用，批量更新会跳过它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在對應列單獨更新此 App，批次更新會略過它。"
          }
        }
      }
    },
