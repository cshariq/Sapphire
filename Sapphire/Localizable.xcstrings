        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome, Edge, Brave, Arc 또는 Safari의 Meet 탭이 마이크를 사용하는 동안입니다. 브라우저를 제어할 권한이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
