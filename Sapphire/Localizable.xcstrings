      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduziert Mikro-Ladezyklen, wenn das Limit erreicht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduces micro-charging cycles when the limit is reached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce los ciclos de microcarga cuando se alcanza el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit les cycles de micro-charge lorsque la limite est atteinte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduce i micro-cicli di carica quando viene raggiunto il limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限に達したときの微小な充電サイクルを減らします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한에 도달하면 미세 충전 주기를 줄입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz os ciclos de microcarga quando o limite é atingido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уменьшает микроциклы зарядки при достижении лимита."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到充电上限后，减少微量充电循环。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達到上限時減少微量充電循環。"
          }
        }
      }
    },
    "Reference page listing every keyboard shortcut in Sapphire — global hotkeys, snap zones, and in-app shortcuts.": {
      "comment": "SettingsSection.shortDescription",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenzseite mit allen Tastenkurzbefehlen in Sapphire – globale Hotkeys, Einrastzonen und Tastenkurzbefehle in der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference page listing every keyboard shortcut in Sapphire — global hotkeys, snap zones, and in-app shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Página de referencia con todos los atajos de teclado de Sapphire: atajos globales, zonas de ajuste y atajos dentro de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Page de référence listant tous les raccourcis clavier de Sapphire — raccourcis globaux, zones d’ancrage et raccourcis dans l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagina di riferimento con tutte le scorciatoie da tastiera di Sapphire: scorciatoie globali, zone di aggancio e scorciatoie nell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireのすべてのキーボードショートカット(グローバルホットキー、スナップゾーン、Appのショートカット)を一覧にした参照ページ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전역 단축키, 스냅 영역 및 앱 내 단축키 등 Sapphire의 모든 키보드 단축키를 나열한 참조 페이지입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Página de referência que lista todos os atalhos de teclado do Sapphire — atalhos globais, zonas de encaixe e atalhos dentro do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Справочная страница со всеми сочетаниями клавиш Sapphire — глобальные горячие клавиши, зоны привязки и сочетания в приложении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Sapphire 的所有键盘快捷键，包括全局热键、窗口分区和应用内快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列出 Sapphire 所有鍵盤快速鍵的參考頁面，包括全域快速鍵、貼齊區域和 App 內快速鍵。"
          }
        }
      }
    },
