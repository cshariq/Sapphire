        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricollega per concedere gli ambiti aggiornati (Drive, scrittura su Calendario, pubblicazione su X, …)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
