    "Layer frosted liquid glass on top of the base glass for a denser, more opaque look.": {
      "comment": "Settings interface",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt Milchglas im Liquid-Glass-Stil über das Basisglas für einen dichteren, undurchsichtigeren Look."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layer frosted liquid glass on top of the base glass for a denser, more opaque look."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Superpone cristal líquido esmerilado sobre el cristal base para un aspecto más denso y opaco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Superposer du verre liquide dépoli au verre de base pour un rendu plus dense et plus opaque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovrapponi vetro liquido smerigliato al vetro di base per un aspetto più denso e opaco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より密度の高い、不透明な見た目にするため、ベースのガラスの上にすりガラスのリキッドグラスを重ねます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 짙고 불투명한 모양을 위해 기본 유리 위에 반투명 리퀴드 글래스를 겹칩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrepõe vidro líquido fosco ao vidro base para um visual mais denso e opaco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наложить матовое «жидкое стекло» поверх базового стекла для более плотного и непрозрачного вида."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在基础玻璃上叠加磨砂液态玻璃，使外观更加厚实、不透明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在基礎玻璃上疊加磨砂液態玻璃，讓外觀更厚實、更不透明。"
          }
        }
      }
    },
    "Layer frosted liquid glass on top of the base glass, like on the lock screen.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt wie auf dem Sperrbildschirm mattierte Liquid-Glass-Optik über das Basisglas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
