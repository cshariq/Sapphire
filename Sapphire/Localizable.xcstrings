    "On Android, grant Do Not Disturb access so the phone can apply changes received from this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erteilen Sie unter Android den Zugriff auf „Nicht stören“, damit das Smartphone von diesem Mac empfangene Änderungen anwenden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Android, grant Do Not Disturb access so the phone can apply changes received from this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Android, concede acceso a No molestar para que el teléfono pueda aplicar los cambios recibidos desde este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur Android, accordez l’accès à Ne pas déranger pour que le téléphone puisse appliquer les modifications reçues de ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su Android, concedi l'accesso a Non disturbare così il telefono può applicare le modifiche ricevute da questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Androidで、このMacから受け取った変更をスマートフォンに適用できるよう、おやすみモードへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android에서 휴대전화가 이 Mac에서 받은 변경 사항을 적용할 수 있도록 방해 금지 모드 접근을 허용하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Android, conceda acesso ao Não Perturbe para que o celular possa aplicar as alterações recebidas deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Android предоставьте доступ к «Не беспокоить», чтобы телефон мог применять изменения, полученные с этого Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Android 上，请授予“勿扰模式”访问权限，以便手机应用从这台 Mac 收到的更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Android 上，請授予「勿擾模式」存取權限，以便手機套用從這部 Mac 收到的更改。"
          }
        }
      }
    },
