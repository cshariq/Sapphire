    "Navigation, timers, downloads and calls appear as live activities in the notch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigation, Timer, Downloads und Anrufe erscheinen als Live-Aktivitäten in der Notch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigation, timers, downloads and calls appear as live activities in the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La navegación, los temporizadores, las descargas y las llamadas aparecen como actividades en directo en la muesca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La navigation, les minuteurs, les téléchargements et les appels apparaissent sous forme d’activités en direct dans l’encoche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigazione, timer, download e chiamate compaiono come Live Activity nel notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナビゲーション、タイマー、ダウンロード、通話が、ノッチにライブアクティビティとして表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내비게이션, 타이머, 다운로드 및 통화가 노치에 라이브 활동으로 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegação, cronômetros, downloads e chamadas aparecem como atividades ao vivo no entalhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Навигация, таймеры, загрузки и звонки появляются как live-активности в вырезе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导航、计时器、下载和通话会以实时活动显示在刘海区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導航、計時器、下載與通話會以即時動態顯示在瀏海區域。"
          }
        }
      }
    },
