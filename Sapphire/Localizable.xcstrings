    "Stay awake as long as one of the apps below is open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach bleiben, solange eine der unten genannten Apps geöffnet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay awake as long as one of the apps below is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el Mac activo mientras una de las apps de abajo esté abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester éveillé tant qu’une des apps ci-dessous est ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni attivo finché una delle app qui sotto è aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下のAppのいずれかが開いている間、スリープさせません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 앱 중 하나라도 열려 있는 동안 깨어 있도록 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém ativo enquanto um dos apps abaixo estiver aberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не засыпать, пока открыто одно из приложений ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要下方任一应用处于打开状态，就保持唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要下方任一 App 處於開啟狀態，就保持喚醒。"
          }
        }
      }
    },
    "Stay awake whenever the Mac is plugged in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach bleiben, wann immer der Mac am Strom angeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay awake whenever the Mac is plugged in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el Mac activo siempre que esté conectado a la corriente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester éveillé tant que le Mac est branché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni attivo ogni volta che il Mac è collegato all'alimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macが電源に接続されている間は、常にスリープさせません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 전원에 연결되어 있을 때마다 깨어 있도록 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
