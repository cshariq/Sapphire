    "Files land in Downloads and on the File Shelf. A Continuity Live Activity shows in the notch while they transfer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien landen in „Downloads“ und in der Dateiablage. Während der Übertragung wird in der Notch eine Continuity-Live-Aktivität angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files land in Downloads and on the File Shelf. A Continuity Live Activity shows in the notch while they transfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos aparecen en Descargas y en la bandeja de archivos. Una actividad en directo de Continuidad se muestra en la muesca mientras se transfieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers arrivent dans Téléchargements et sur l’étagère de fichiers. Une activité en direct de continuité s’affiche dans l’encoche pendant leur transfert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vengono salvati in Download e nel File Shelf. Durante il trasferimento nel notch compare una Live Activity di Continuity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは“ダウンロード”フォルダとファイルシェルフに保存されます。転送中は、ノッチにContinuityのライブアクティビティが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 다운로드와 파일 선반에 저장됩니다. 전송되는 동안 노치에 연속성 라이브 활동이 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos vão para Downloads e para a Prateleira de Arquivos. Uma Atividade ao Vivo da Continuity aparece no entalhe enquanto são transferidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы попадают в «Загрузки» и на Полку файлов. Во время передачи в вырезе показывается live-активность Continuity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件会保存到“下载”和文件暂存架。传输期间，刘海中会显示连续互通实时活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會儲存到「下載項目」和檔案暫存架。傳輸期間，瀏海中會顯示接續互通即時動態。"
          }
        }
      }
    },
    "Files use measured bytes; direct folders are shown separately": {
      "comment": "A description of the storage map.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
