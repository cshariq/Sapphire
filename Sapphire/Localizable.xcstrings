        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래의 마지막 10초 동안 지금 재생 중인 제목 아래에 대기열의 다음 트랙을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a próxima faixa da fila sob o título da que está tocando durante os últimos 10 segundos da música."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать следующий трек из очереди под названием текущего в последние 10 секунд песни."
