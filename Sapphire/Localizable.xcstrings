    "This method works for both Free and Premium users. Use at your own risk.": {
      "comment": "Onboarding, app menus, helper, shared utilities, public build placeholders",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Methode funktioniert sowohl für kostenlose als auch für Premium-Benutzer. Verwendung auf eigenes Risiko."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This method works for both Free and Premium users. Use at your own risk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este método funciona para usuarios Free y Premium. Úsalo bajo tu propia responsabilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette méthode fonctionne pour les utilisateurs Gratuit et Premium. À utiliser à vos propres risques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo metodo funziona sia per gli utenti gratuiti sia per quelli Premium. Usalo a tuo rischio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この方法は、無料ユーザとPremiumユーザの両方で機能します。ご自身の責任でご使用ください。"
          }
        },
        "ko": {
          "stringUnit": {
