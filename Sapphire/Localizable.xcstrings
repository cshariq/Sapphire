    "Desktop motion, input, and window enhancements that stay out of your way.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbesserungen für Schreibtischbewegung, Eingabe und Fenster, die Ihnen nicht im Weg sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop motion, input, and window enhancements that stay out of your way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejoras de movimiento, entrada y ventanas del escritorio que no estorban."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliorations discrètes du bureau : mouvements, saisie et fenêtres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miglioramenti di movimento, input e finestre della scrivania che non ti intralciano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "邪魔にならない、デスクトップのモーション、入力、ウインドウの機能強化。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해되지 않는 데스크탑 모션, 입력 및 윈도우 향상 기능입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhorias de movimento, entrada e janelas da mesa que não atrapalham."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Улучшения рабочего стола, ввода и окон, которые не мешают работе."
