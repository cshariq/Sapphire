          "stringUnit": {
            "state": "translated",
            "value": "이 디스플레이의 외관을 기본값으로 지정하고 모든 디스플레이의 자체 외관을 지웁니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tornar a aparência deste monitor o padrão e limpar a aparência própria de cada monitor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать оформление этого дисплея основным и сбросить собственное оформление всех дисплеев"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此显示器的外观设为默认值，并清除所有显示器各自的外观设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此顯示器的外觀設為預設值，並清除所有顯示器各自的外觀設定"
          }
        }
      }
    },
    "Make your phone's camera and microphone selectable in other apps, the way any built-in device is.": {
      "comment": "A description of the system devices section.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen Sie Kamera und Mikrofon Ihres Smartphones in anderen Apps auswählbar, wie jedes integrierte Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make your phone's camera and microphone selectable in other apps, the way any built-in device is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que la cámara y el micrófono de tu teléfono se puedan seleccionar en otras apps, como cualquier dispositivo integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendez la caméra et le micro de votre téléphone sélectionnables dans d’autres apps, comme n’importe quel appareil intégré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendi selezionabili la fotocamera e il microfono del telefono nelle altre app, come qualsiasi dispositivo integrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのAppで、内蔵デバイスと同じようにスマートフォンのカメラとマイクを選択できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱에서 내장 기기처럼 휴대전화의 카메라와 마이크를 선택할 수 있게 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Torne a câmera e o microfone do celular selecionáveis em outros apps, como qualquer dispositivo integrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте камеру и микрофон телефона доступными для выбора в других приложениях, как у любого встроенного устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你手机的相机和麦克风可在其他 App 中选用，就像任何内置设备一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓你手機的相機和麥克風可在其他 App 中選用，就像任何內建裝置一樣。"
          }
        }
      }
    },
