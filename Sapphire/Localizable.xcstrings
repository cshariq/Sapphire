    "Add a caffeinate toggle to the expanded notch header.": {
      "comment": "Settings interface",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt dem erweiterten Notch-Kopfbereich einen Caffeinate-Schalter hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a caffeinate toggle to the expanded notch header."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un interruptor de caffeinate al encabezado de la muesca expandida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un bouton caffeinate à l’en-tête de l’encoche étendue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un interruttore caffeinate all'intestazione del notch espanso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開したノッチのヘッダにcaffeinateのトグルを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장된 노치 헤더에 caffeinate 토글을 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um botão do caffeinate ao cabeçalho do entalhe expandido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить переключатель caffeinate в заголовок развёрнутого выреза."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在展开的刘海区域顶部添加保持唤醒开关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在展開的瀏海區域頂部加入保持喚醒開關。"
          }
        }
      }
    },
    "Add a caffeinate toggle to the expanded notch header. Turning this off also stops caffeinate from turning on by itself for tasks, apps, power or displays.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt dem erweiterten Notch-Kopfbereich einen Caffeinate-Schalter hinzu. Wenn Sie dies deaktivieren, wird Caffeinate auch nicht mehr automatisch für Aufgaben, Apps, Strom oder Displays aktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a caffeinate toggle to the expanded notch header. Turning this off also stops caffeinate from turning on by itself for tasks, apps, power or displays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un interruptor de caffeinate al encabezado de la muesca expandida. Si lo desactivas, caffeinate tampoco se activará por sí solo para tareas, apps, energía o pantallas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un bouton caffeinate à l’en-tête de l’encoche étendue. Si vous le désactivez, caffeinate ne s’active plus non plus automatiquement pour les tâches, les apps, l’alimentation ou les écrans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un interruttore caffeinate all'intestazione del notch espanso. Disattivandolo, caffeinate non si attiverà più da solo per attività, app, alimentazione o display."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開したノッチのヘッダにcaffeinateのトグルを追加します。オフにすると、タスク、App、電源、ディスプレイに応じてcaffeinateが自動的にオンになることもなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장된 노치 헤더에 caffeinate 토글을 추가합니다. 이 옵션을 끄면 작업, 앱, 전원 또는 디스플레이에 따라 caffeinate가 자동으로 켜지는 것도 중지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um botão do caffeinate ao cabeçalho do entalhe expandido. Desativar isto também impede que o caffeinate seja ativado sozinho para tarefas, apps, energia ou monitores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить переключатель caffeinate в заголовок развёрнутого выреза. Если выключить, caffeinate также не будет включаться сам для задач, приложений, питания или дисплеев."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在展开的刘海区域顶部添加保持唤醒开关。关闭后，也会停止根据任务、应用、电源或显示器自动启用保持唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在展開的瀏海區域頂端加入保持喚醒開關。關閉後，也會停止依據工作、App、電源或顯示器自動啟用保持喚醒。"
          }
        }
      }
    },
