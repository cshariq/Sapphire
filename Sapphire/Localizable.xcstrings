    "Style the panel — or strip it back to just the answer and the controls you use.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestalten Sie das Fenster – oder reduzieren Sie es auf die Antwort und die Steuerelemente, die Sie verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Style the panel — or strip it back to just the answer and the controls you use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da estilo al panel o déjalo reducido a la respuesta y los controles que usas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stylisez le panneau — ou réduisez-le à la réponse et aux commandes que vous utilisez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizza il pannello oppure riducilo alla sola risposta e ai controlli che usi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルのスタイルを整えます。または、回答と使用するコントロールだけに絞り込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널의 스타일을 지정하거나 답변과 사용하는 제어 항목만 남기십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina o estilo do painel — ou reduza-o a apenas a resposta e os controles que você usa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
