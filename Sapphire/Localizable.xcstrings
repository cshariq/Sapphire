    "Enable, disable, and reorder all available Live Activities.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle verfügbaren Live-Aktivitäten aktivieren, deaktivieren und anordnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable, disable, and reorder all available Live Activities."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa, desactiva y reordena todas las actividades en directo disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez, désactivez et réorganisez toutes les activités en direct disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva, disattiva e riordina tutte le Live Activity disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能なすべてのライブアクティビティを有効/無効にして、並べ替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 모든 라이브 활동을 활성화, 비활성화하고 순서를 변경합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative, desative e reordene todas as Atividades ao Vivo disponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включайте, отключайте и переупорядочивайте все доступные live-активности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用、停用或重新排列所有可用的实时活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用、停用並重新排序所有可用的即時動態。"
          }
        }
      }
    },
    "Enable, disable, and reorder the icons that appear when you expand the notch.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Symbole, die beim Erweitern der Notch erscheinen, aktivieren, deaktivieren und anordnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable, disable, and reorder the icons that appear when you expand the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa, desactiva y reordena los iconos que aparecen al expandir la muesca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez, désactivez et réorganisez les icônes qui apparaissent lorsque vous étendez l’encoche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva, disattiva e riordina le icone che compaiono quando espandi il notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチを展開したときに表示されるアイコンを有効/無効にして、並べ替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치를 확장할 때 나타나는 아이콘을 활성화, 비활성화하고 순서를 변경합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative, desative e reordene os ícones que aparecem ao expandir o entalhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включайте, отключайте и переупорядочивайте значки, которые появляются при раскрытии выреза."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用、停用或重新排列展开刘海区域时显示的图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用、停用並重新排序展開瀏海區域時顯示的圖像。"
          }
        }
      }
    },
    "Enable, disable, and reorder the widgets that appear in the notch. Space is limited by your display width.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Widgets, die in der Notch erscheinen, aktivieren, deaktivieren und anordnen. Der Platz ist durch die Breite Ihres Displays begrenzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable, disable, and reorder the widgets that appear in the notch. Space is limited by your display width."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa, desactiva y reordena los widgets que aparecen en la muesca. El espacio está limitado por el ancho de tu pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez, désactivez et réorganisez les widgets qui apparaissent dans l’encoche. L’espace est limité par la largeur de votre écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva, disattiva e riordina i widget che compaiono nel notch. Lo spazio è limitato dalla larghezza del display."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチに表示されるウィジェットを有効/無効にして、並べ替えます。使えるスペースはディスプレイの幅によって制限されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에 나타나는 위젯을 활성화, 비활성화하고 순서를 변경합니다. 공간은 디스플레이 너비에 따라 제한됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative, desative e reordene os widgets que aparecem no entalhe. O espaço é limitado pela largura do seu monitor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включайте, отключайте и переупорядочивайте виджеты, которые появляются в вырезе. Место ограничено шириной дисплея."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用、停用或重新排列刘海区域中的小组件。可用空间受显示器宽度限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用、停用並重新排序瀏海區域中顯示的小工具。可用空間受顯示器寬度限制。"
          }
        }
      }
    },
