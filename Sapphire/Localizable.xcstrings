          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tus propios servidores del Model Context Protocol. Blip puede listar y llamar a sus herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez vos propres serveurs Model Context Protocol. Blip peut lister et appeler leurs outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i tuoi server Model Context Protocol. Blip può elencarne e chiamarne gli strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自のModel Context Protocolサーバを追加します。BlipがそのツールをリストアップしたりCallしたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
