    "Estimates how much light your face needs, and adjusts the brightness and the ring's size while Face ID looks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzt, wie viel Licht dein Gesicht braucht, und passt Helligkeit und Ringgröße an, während Face ID sucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates how much light your face needs, and adjusts the brightness and the ring's size while Face ID looks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula cuánta luz necesita tu cara y ajusta el brillo y el tamaño del anillo mientras Face ID busca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estime la lumière nécessaire à votre visage et ajuste la luminosité et la taille de l’anneau pendant que Face ID cherche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stima quanta luce serve al tuo viso e regola luminosità e dimensione dell’anello mentre Face ID cerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔に必要な光の量を推定し、Face IDが探している間、明るさとリングの大きさを調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼굴에 필요한 빛의 양을 추정하여 Face ID가 찾는 동안 밝기와 링 크기를 조정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estima quanta luz seu rosto precisa e ajusta o brilho e o tamanho do anel enquanto o Face ID procura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценивает, сколько света нужно лицу, и подстраивает яркость и размер кольца, пока Face ID ищет вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "估算你的面部需要多少光线，并在 Face ID 识别时调整亮度和光环大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "估算你的臉部需要多少光線，並在 Face ID 辨識時調整亮度和光環大小。"
          }
        }
      }
    },
