          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía eventos de uso anónimos a Google para ayudar a mejorar Sapphire. Desactívalo para no participar en la recopilación de analíticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
