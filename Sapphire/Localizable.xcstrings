          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigir que o telefone esteja desbloqueado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требовать разблокированный телефон"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要求手机已解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求手機已解鎖"
          }
        }
      }
    },
    "Require a hold, a double press, or an extra modifier for ⌘Q and ⌘W. Enabled for every app by default.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ⌘Q und ⌘W ein Halten, ein Doppeldrücken oder einen zusätzlichen Modifikator verlangen. Standardmäßig für jede App aktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Require a hold, a double press, or an extra modifier for ⌘Q and ⌘W. Enabled for every app by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere mantener pulsado, una doble pulsación o un modificador adicional para ⌘Q y ⌘W. Activado para todas las apps por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exiger un maintien, un double appui ou un modificateur supplémentaire pour ⌘Q et ⌘W. Activé par défaut pour toutes les apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedi una pressione prolungata, una doppia pressione o un modificatore extra per ⌘Q e ⌘W. Attivato per ogni app per impostazione predefinita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Qと⌘Wに、長押し、ダブルプレス、または追加の修飾キーを必須にします。デフォルトですべてのAppで有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Q 및 ⌘W에 길게 누르기, 두 번 누르기 또는 추가 수정자를 요구합니다. 모든 앱에 기본적으로 활성화되어 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige manter pressionado, pressionar duas vezes ou um modificador extra para ⌘Q e ⌘W. Ativado para todos os apps por padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требовать удержание, двойное нажатие или дополнительный модификатор для ⌘Q и ⌘W. По умолчанию включено для всех приложений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要求长按、连按两次或添加修饰键才能执行 ⌘Q 和 ⌘W。默认对所有应用开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Q 和 ⌘W 需要按住、按兩下或額外的變更鍵才能執行。預設對所有 App 啟用。"
          }
        }
      }
    },
