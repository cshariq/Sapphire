    "%@ saves what you're looking at as view 1 (up to 9), and %@ jumps back to it. Every macOS Space on every display keeps its own arrangement; %@ hides or shows the Desktop in just this Space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sichert, was Sie gerade ansehen, als Ansicht 1 (bis zu 9), und %@ springt dorthin zurück. Jeder macOS-Space auf jedem Display behält seine eigene Anordnung; %@ blendet den Schreibtisch nur in diesem Space aus oder ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ saves what you're looking at as view 1 (up to 9), and %@ jumps back to it. Every macOS Space on every display keeps its own arrangement; %@ hides or shows the Desktop in just this Space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ guarda lo que estás viendo como la vista 1 (hasta 9) y %@ vuelve a ella. Cada Space de macOS de cada pantalla conserva su propia disposición; %@ oculta o muestra el escritorio solo en este Space."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enregistre ce que vous regardez comme vue 1 (jusqu’à 9), et %@ y revient. Chaque Space macOS de chaque écran conserve son propre agencement ; %@ masque ou affiche le Bureau dans ce seul Space."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ salva ciò che stai guardando come vista 1 (fino a 9) e %@ torna a essa. Ogni Space di macOS su ogni display mantiene la propria disposizione; %@ nasconde o mostra la Scrivania solo in questo Space."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@で現在の表示をビュー1(最大9個)として保存し、%2$@でそこに戻ります。各ディスプレイの各macOS Spaceは、それぞれ独自の配置を保持します。%3$@は、このSpaceのデスクトップのみを非表示または表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 보고 있는 화면을 보기 1로 저장하고(최대 9개), %@은(는) 그 보기로 돌아갑니다. 각 디스플레이의 모든 macOS Space는 자체 배열을 유지하며, %@은(는) 이 Space에서만 데스크탑을 숨기거나 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ salva o que você está vendo como visualização 1 (até 9), e %@ volta a ela. Cada Space do macOS em cada monitor mantém seu próprio arranjo; %@ oculta ou mostra a Mesa somente neste Space."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ сохраняет то, что вы сейчас видите, как вид 1 (до 9), а %@ возвращает к нему. Каждый Space macOS на каждом дисплее хранит собственную раскладку; %@ скрывает или показывает Рабочий стол только в этом Space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会将你当前查看的内容存储为视图 1（最多 9 个），%@ 则跳回该视图。每个显示器上的每个 macOS 空间都保留各自的布局；%@ 仅在当前空间中隐藏或显示桌面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會將你目前檢視的內容儲存為檢視方式 1（最多 9 個），%@ 則跳回該檢視方式。每個顯示器上的每個 macOS 空間都保留各自的排列；%@ 僅在目前空間中隱藏或顯示桌面。"
          }
        }
      }
    },
