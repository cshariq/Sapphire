    "When Sapphire opens a DMG, mount it, install contained apps, unmount, and clean up automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sapphire ein DMG öffnet, es mounten, enthaltene Apps installieren, auswerfen und automatisch aufräumen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Sapphire opens a DMG, mount it, install contained apps, unmount, and clean up automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando Sapphire abre un DMG, lo monta, instala las apps que contiene, lo expulsa y limpia automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque Sapphire ouvre un DMG, le monter, installer les apps qu’il contient, le démonter et nettoyer automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando Sapphire apre un DMG, lo monta, installa le app contenute, lo smonta e ripulisce automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SapphireでDMGを開くと、マウントして、含まれるAppをインストールし、マウント解除して、自動的にクリーンアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire에서 DMG를 열면 마운트하고, 포함된 앱을 설치하고, 마운트 해제하고, 자동으로 정리합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o Sapphire abre um DMG, monta, instala os apps contidos, ejeta e limpa automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда Sapphire открывает DMG, он автоматически монтирует его, устанавливает приложения из него, извлекает образ и очищает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 打开 DMG 时，会自动挂载、安装其中的应用、卸载并清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 開啟 DMG 時，會自動掛載、安裝其中的 App、卸載並清理。"
          }
        }
      }
    },
    "When Sapphire opens an archive, extract it automatically. Disable to hand archives back to macOS Archive Utility.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sapphire ein Archiv öffnet, es automatisch extrahieren. Deaktivieren, um Archive an das Archivierungsprogramm von macOS zurückzugeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Sapphire opens an archive, extract it automatically. Disable to hand archives back to macOS Archive Utility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando Sapphire abre un archivo comprimido, lo extrae automáticamente. Desactívalo para devolver los archivos a la Utilidad de archivo de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque Sapphire ouvre une archive, l’extraire automatiquement. Désactivez pour rendre les archives à l’Utilitaire d’archive de macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando Sapphire apre un archivio, lo estrae automaticamente. Disattiva per restituire gli archivi all'Utility Archivi di macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphireでアーカイブを開くと、自動的に展開します。アーカイブをmacOSのアーカイブユーティリティに戻すには、無効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire에서 보관 파일을 열면 자동으로 압축을 풉니다. 끄면 보관 파일을 macOS 보관 유틸리티로 되돌립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o Sapphire abre um arquivo compactado, extrai-o automaticamente. Desative para devolver os arquivos compactados ao Utilitário de Compactação do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда Sapphire открывает архив, он извлекает его автоматически. Выключите, чтобы возвращать архивы «Утилите архивирования» macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 打开归档时自动解压。停用后，归档会交回 macOS 归档实用工具处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 開啟封存檔時自動解壓縮。停用後，封存檔會交回 macOS 封存工具程式處理。"
          }
        }
      }
    },
    "When Spotify desktop on this Mac plays an ad, relaunch it in the background, then resume via Spotify Connect.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Spotify-Desktop-App auf diesem Mac Werbung abspielt, sie im Hintergrund neu starten und dann über Spotify Connect fortsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Spotify desktop on this Mac plays an ad, relaunch it in the background, then resume via Spotify Connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la app de escritorio de Spotify de este Mac reproduce un anuncio, la reinicia en segundo plano y reanuda mediante Spotify Connect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque Spotify sur le bureau de ce Mac diffuse une publicité, le relancer en arrière-plan, puis reprendre via Spotify Connect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando Spotify per desktop su questo Mac riproduce una pubblicità, lo riavvia in background e poi riprende tramite Spotify Connect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのSpotifyデスクトップアプリで広告が再生されたとき、バックグラウンドで再起動してから、Spotify Connectで再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 Spotify 데스크탑에서 광고가 재생되면 백그라운드에서 다시 실행한 다음 Spotify Connect로 재개합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o Spotify para computador neste Mac reproduz um anúncio, reabre-o em segundo plano e depois retoma pelo Spotify Connect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда Spotify для компьютера на этом Mac воспроизводит рекламу, перезапускать его в фоне и возобновлять через Spotify Connect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当此 Mac 上的 Spotify 桌面应用播放广告时，在后台重新启动它，再通过 Spotify Connect 恢复播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當這台 Mac 上的 Spotify 桌面版播放廣告時，在背景重新啟動它，然後透過 Spotify Connect 繼續播放。"
          }
        }
      }
    },
