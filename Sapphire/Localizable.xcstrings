        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login aqui para ativar recursos oficiais, como a troca de dispositivos para usuários Premium. Este é o método de login padrão e recomendado."
          }
        },
        "ru": {
          "stringUnit": {
