    "Downloads, Desktop, Documents and each browser's own download folder are found automatically. Add any other folder apps save into.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Downloads“, „Schreibtisch“, „Dokumente“ und der Download-Ordner jedes Browsers werden automatisch gefunden. Fügen Sie jeden anderen Ordner hinzu, in dem Apps sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, Desktop, Documents and each browser's own download folder are found automatically. Add any other folder apps save into."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargas, Escritorio, Documentos y la carpeta de descargas de cada navegador se encuentran automáticamente. Añade cualquier otra carpeta donde guarden las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargements, Bureau, Documents et le dossier de téléchargement propre à chaque navigateur sont détectés automatiquement. Ajoutez tout autre dossier dans lequel les apps enregistrent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download, Scrivania, Documenti e la cartella di download di ciascun browser vengono trovati automaticamente. Aggiungi qualsiasi altra cartella in cui le app salvano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード、デスクトップ、書類、および各ブラウザのダウンロードフォルダは自動的に検出されます。Appが保存するその他のフォルダを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드, 데스크탑, 문서 및 각 브라우저의 자체 다운로드 폴더는 자동으로 찾습니다. 앱이 저장하는 다른 폴더를 추가하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, Mesa, Documentos e a pasta de downloads de cada navegador são encontrados automaticamente. Adicione qualquer outra pasta em que os apps salvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Загрузки», «Рабочий стол», «Документы» и папка загрузок каждого браузера находятся автоматически. Добавьте любую другую папку, в которую сохраняют приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会自动查找“下载”“桌面”“文稿”和各浏览器的下载文件夹。可添加 App 保存文件的其他文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會自動尋找「下載項目」、「桌面」、「文件」和各瀏覽器的下載檔案夾。可加入 App 儲存檔案的其他檔案夾。"
          }
        }
      }
    },
    "Drag Activation Collapse Delay": {
      "comment": "Settings interface",
