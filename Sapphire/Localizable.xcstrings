    "Link an account anytime in Settings to sync your subscription across devices.": {
      "comment": "Onboarding, app menus, helper, shared utilities, public build placeholders",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verknüpfen Sie jederzeit in den Einstellungen einen Account, um Ihr Abo geräteübergreifend zu synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link an account anytime in Settings to sync your subscription across devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincula una cuenta en cualquier momento en Ajustes para sincronizar tu suscripción entre dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez un compte à tout moment dans les Réglages pour synchroniser votre abonnement sur tous vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega un account in qualsiasi momento in Impostazioni per sincronizzare l'abbonamento tra i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でいつでもアカウントをリンクして、デバイス間でサブスクリプションを同期できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 언제든지 계정을 연결하여 기기 간에 구독을 동기화하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincule uma conta a qualquer momento nos Ajustes para sincronizar sua assinatura entre dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привяжите учётную запись в любой момент в «Настройках», чтобы синхронизировать подписку между устройствами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你随时可以在设置中关联账户，在设备之间同步订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你隨時可以在「設定」中連結帳號，在裝置之間同步訂閱。"
          }
        }
      }
    },
