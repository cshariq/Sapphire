    "Snap the focused window to a zone of a layout. Assign or change them in Snap Zones settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das fokussierte Fenster in eine Zone eines Layouts einrasten. Weisen Sie sie in den Einstellungen für Einrastzonen zu oder ändern Sie sie dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snap the focused window to a zone of a layout. Assign or change them in Snap Zones settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la ventana enfocada a una zona de una disposición. Asígnalas o cámbialas en los ajustes de Zonas de ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancrez la fenêtre active dans une zone d’une disposition. Attribuez-les ou modifiez-les dans les réglages des zones d’ancrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggancia la finestra in primo piano a una zona di un layout. Assegnale o modificale nelle impostazioni Zone di aggancio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスしているウインドウを、レイアウトのゾーンにスナップします。スナップゾーン設定で割り当てまたは変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 윈도우를 레이아웃의 영역에 스냅합니다. 스냅 영역 설정에서 지정하거나 변경하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaixa a janela em foco em uma zona de um layout. Atribua ou altere nos ajustes de Zonas de Encaixe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привяжите окно в фокусе к зоне раскладки. Назначайте или меняйте их в настройках зон привязки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将焦点窗口贴靠到布局的某个分区。请在“贴靠分区”设置中分配或更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將焦點視窗貼齊到版面配置的某個分區。請在「貼齊分區」設定中指定或更改。"
          }
        }
      }
    },
