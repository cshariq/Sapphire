    "Uses less energy but may be slightly slower to react.": {
      "comment": "Settings interface",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbraucht weniger Energie, reagiert aber möglicherweise etwas langsamer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses less energy but may be slightly slower to react."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa menos energía, pero puede tardar un poco más en reaccionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consomme moins d’énergie mais peut réagir un peu plus lentement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa meno energia ma può reagire con un po' di ritardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エネルギー消費が少なくなりますが、反応がわずかに遅くなる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에너지를 덜 사용하지만 반응이 약간 느릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa menos energia, mas pode reagir um pouco mais devagar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расходует меньше энергии, но может реагировать чуть медленнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耗电更少，但响应速度可能略慢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "耗電較少，但反應可能稍慢。"
          }
        }
      }
    },
    "Uses the app's own Paste and Match Style when it has one. Must include ⌘ or ⌃. Plain ⌘V is never changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet das eigene „Einsetzen und Stil anpassen“ der App, sofern vorhanden. Muss ⌘ oder ⌃ enthalten. Ein einfaches ⌘V wird nie geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the app's own Paste and Match Style when it has one. Must include ⌘ or ⌃. Plain ⌘V is never changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la función Pegar y ajustar estilo de la propia app cuando la tiene. Debe incluir ⌘ o ⌃. El ⌘V simple nunca se modifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la commande Coller et adapter le style propre à l’app lorsqu’elle en a une. Doit inclure ⌘ ou ⌃. ⌘V seul n’est jamais modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il comando Incolla e adatta lo stile dell'app, se ne ha uno. Deve includere ⌘ o ⌃. Il semplice ⌘V non viene mai modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appに独自の“ペーストしてスタイルを合わせる”がある場合はそれを使用します。⌘または⌃を含める必要があります。⌘Vのみの場合は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 자체 스타일에 맞춰 붙여넣기가 있으면 이를 사용합니다. ⌘ 또는 ⌃를 포함해야 합니다. 일반 ⌘V는 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o próprio Colar e Corresponder ao Estilo do app quando ele tiver um. Deve incluir ⌘ ou ⌃. O ⌘V simples nunca é alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует собственное «Вставить и согласовать стиль» приложения, если оно есть. Должно включать ⌘ или ⌃. Обычное ⌘V никогда не меняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先使用应用自身的“粘贴并匹配样式”功能。必须包含 ⌘ 或 ⌃。不会更改普通的 ⌘V。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "優先使用 App 本身的「貼上並符合樣式」功能。必須包含 ⌘ 或 ⌃。不會更改一般的 ⌘V。"
          }
        }
