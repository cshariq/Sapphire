    "Allow Input Monitoring for Sapphire to confirm Face ID with Return or Space.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie Sapphire die Eingabeüberwachung, um Face ID mit der Eingabetaste oder der Leertaste zu bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Input Monitoring for Sapphire to confirm Face ID with Return or Space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite la Supervisión de entrada para Sapphire para confirmar Face ID con Retorno o Espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez la surveillance de l’entrée pour Sapphire afin de confirmer Face ID avec Retour ou Espace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Sapphire il Monitoraggio input per confermare Face ID con Invio o Spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ReturnまたはSpaceでFace IDを確認するには、Sapphireに入力監視を許可してください。"
