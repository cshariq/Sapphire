        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用使用自己的签名更新程序，Sapphire 将打开该应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用其專屬的已簽署更新程式，Sapphire 將會打開該 App。"
          }
        }
      }
    },
