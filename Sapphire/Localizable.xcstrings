        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使播放已暂停，也在锁定屏幕小组件中继续显示当前曲目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使播放已暫停，也在鎖定畫面小工具中繼續顯示目前曲目。"
          }
        }
      }
    },
