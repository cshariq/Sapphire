<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.shariq.sapphire</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sapphire</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sapphire uses the microphone for Gemini Live voice conversations.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Blip uses your location for local weather, nearby places, and location-aware tasks.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Needed for gemini live activity</string>
	<key>NSCameraUsageDescription</key>
	<string>Sapphire uses the camera for the Mirror widget so you can see yourself in the notch.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Blip can learn from your calendar patterns to better understand your schedule and preferences.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Blip needs access to analyze Notes and Spotify activity to learn your preferences.</string>
	<key>NSSystemExtensionPointIdentifier</key>
	<string>com.apple.developer.driverkit.transport.audio</string>
	<key>SapphireSubscriptionAPIKey</key>
	<string>$(SAPPHIRE_SUBSCRIPTION_API_KEY)</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Sapphire Settings Backup</string>
			<key>UTTypeIdentifier</key>
			<string>com.shariq.sapphire.settings-backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>sapphirebackup</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Sapphire Launchpad Item</string>
			<key>UTTypeIdentifier</key>
			<string>com.shariq.sapphire.launchpaditem</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>sapphirelaunchpaditem</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
