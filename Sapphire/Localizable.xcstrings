    "Skip — moving windows show as app-colour cards": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringen – bewegte Fenster werden als Karten in der App-Farbe angezeigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip — moving windows show as app-colour cards"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitir: las ventanas en movimiento se muestran como tarjetas del color de la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
