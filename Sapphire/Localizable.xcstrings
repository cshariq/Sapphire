    "Automate charging behaviors and perform manual or scheduled calibrations to keep your battery's readings accurate.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisieren Sie Ladeverhalten und führen Sie manuelle oder geplante Kalibrierungen durch, damit die Anzeigen Ihrer Batterie genau bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automate charging behaviors and perform manual or scheduled calibrations to keep your battery's readings accurate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiza los comportamientos de carga y realiza calibraciones manuales o programadas para que las lecturas de tu batería sean precisas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisez les comportements de charge et effectuez des étalonnages manuels ou planifiés pour que les mesures de votre batterie restent précises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatizza i comportamenti di ricarica ed esegui calibrazioni manuali o pianificate per mantenere accurate le letture della batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電の動作を自動化し、手動またはスケジュールでキャリブレーションを実行して、バッテリーの表示を正確に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전 동작을 자동화하고 수동 또는 예약된 보정을 수행하여 배터리 측정값을 정확하게 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatize comportamentos de carregamento e faça calibrações manuais ou agendadas para manter as leituras da bateria precisas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматизируйте режимы зарядки и выполняйте ручную или плановую калибровку, чтобы показания батареи были точными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动执行充电操作，并通过手动或定时校准保持电池读数准确。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動執行充電行為，並透過手動或排程校正讓電池讀數保持準確。"
          }
        }
      }
    },
