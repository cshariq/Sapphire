            "state": "translated",
            "value": "Sapphire отказался удалять небезопасный путь: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapphire 拒绝移除不安全的路径：%@"
          }
