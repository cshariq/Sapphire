          }
        }
      }
    },
    "Automatically matches the orientation reported by the camera. If an external camera feed appears rotated, choose a fixed angle to display it upright.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entspricht automatisch der von der Kamera gemeldeten Ausrichtung. Wenn ein externes Kamerabild gedreht erscheint, wählen Sie einen festen Winkel, um es aufrecht anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically matches the orientation reported by the camera. If an external camera feed appears rotated, choose a fixed angle to display it upright."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coincide automáticamente con la orientación indicada por la cámara. Si la imagen de una cámara externa aparece girada, elige un ángulo fijo para verla derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Correspond automatiquement à l’orientation signalée par la caméra. Si le flux d’une caméra externe apparaît pivoté, choisissez un angle fixe pour l’afficher à l’endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrisponde automaticamente all'orientamento rilevato dalla fotocamera. Se l'immagine di una fotocamera esterna appare ruotata, scegli un angolo fisso per vederla dritta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが報告する向きに自動的に合わせます。外部カメラの映像が回転して表示される場合は、固定の角度を選んで正立させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라에서 보고하는 방향에 자동으로 맞춥니다. 외부 카메라 화면이 회전되어 보이면 고정 각도를 선택하여 바로 세워서 표시하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corresponde automaticamente à orientação informada pela câmera. Se a imagem de uma câmera externa aparecer girada, escolha um ângulo fixo para exibi-la na vertical."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически подстраивается под ориентацию, сообщаемую камерой. Если изображение внешней камеры повёрнуто, выберите фиксированный угол, чтобы оно отображалось прямо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动匹配摄像头报告的方向。如果外接摄像头画面发生旋转，可选择固定角度，使画面保持正向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動配合相機回報的方向。若外接相機畫面看起來是旋轉的，請選擇固定角度使其正向顯示。"
          }
        }
      }
    },
    "Automatically pause now playing media and resume when the lid opens back up.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die aktuelle Medienwiedergabe automatisch an und setzt sie fort, wenn der Deckel wieder geöffnet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically pause now playing media and resume when the lid opens back up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa automáticamente el contenido en reproducción y lo reanuda cuando se vuelve a abrir la tapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre automatiquement en pause la lecture en cours et la reprendre à la réouverture du capot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti automaticamente in pausa i contenuti in riproduzione e riprendi quando il coperchio si riapre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中のメディアを自動的に一時停止し、蓋を開いたら再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 중인 미디어를 자동으로 일시 정지하고 덮개를 다시 열면 재개합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa automaticamente a mídia em reprodução e retoma quando a tampa é aberta novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически ставить воспроизведение на паузу и возобновлять его при открытии крышки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动暂停正在播放的媒体，并在屏幕重新打开时恢复播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動暫停正在播放的媒體，並在重新打開螢幕時繼續播放。"
          }
        }
      }
    },
    "Automatically pauses charging if the battery temperature gets too high to prevent heat-related damage and extend its lifespan.": {
      "comment": "Settings interface",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält das Laden automatisch an, wenn die Batterietemperatur zu hoch wird, um hitzebedingte Schäden zu vermeiden und die Lebensdauer zu verlängern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically pauses charging if the battery temperature gets too high to prevent heat-related damage and extend its lifespan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa la carga automáticamente si la temperatura de la batería es demasiado alta, para evitar daños por calor y prolongar su vida útil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met automatiquement la charge en pause si la température de la batterie devient trop élevée, afin d’éviter les dommages liés à la chaleur et de prolonger sa durée de vie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette automaticamente in pausa la ricarica se la temperatura della batteria diventa troppo alta, per prevenire danni da calore e prolungarne la durata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー温度が高くなりすぎると充電を自動的に一時停止し、熱による損傷を防いで寿命を延ばします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 온도가 너무 높아지면 충전을 자동으로 일시 정지하여 열로 인한 손상을 방지하고 수명을 연장합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa o carregamento automaticamente se a temperatura da bateria ficar alta demais, para evitar danos causados por calor e prolongar sua vida útil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически приостанавливает зарядку, если температура батареи слишком высока, чтобы предотвратить повреждения от перегрева и продлить срок службы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池温度过高时自动暂停充电，以防止高温损伤并延长使用寿命。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電池溫度過高時自動暫停充電，以防止高溫損害並延長電池壽命。"
          }
        }
      }
    },
