    "Off uses imperial units (mph, inches); on uses metric (km/h, mm).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus verwendet imperiale Einheiten (mph, Zoll); an verwendet metrische (km/h, mm)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off uses imperial units (mph, inches); on uses metric (km/h, mm)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado usa unidades imperiales (mph, pulgadas); activado usa unidades métricas (km/h, mm)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : unités impériales (mph, pouces) ; activé : unités métriques (km/h, mm)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato usa le unità imperiali (mph, pollici); attivato usa quelle metriche (km/h, mm)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするとヤード・ポンド法(mph、インチ)、オンにするとメートル法(km/h、mm)を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 야드파운드법 단위(mph, 인치), 켜면 미터법 단위(km/h, mm)를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado usa unidades imperiais (mph, polegadas); ativado usa métricas (km/h, mm)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкл. — имперские единицы (миль/ч, дюймы); вкл. — метрические (км/ч, мм)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时使用英制单位（mph、英寸）；开启时使用公制（km/h、mm）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時使用英制單位（mph、英吋）；開啟時使用公制（km/h、mm）。"
          }
        }
      }
    },
