    "Choose a widget mirrored from your paired Android phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a widget mirrored from your paired Android phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个从已配对 Android 手机镜像的小组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個從已配對 Android 手機鏡像的小工具。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein von Ihrem gekoppelten Android-Smartphone gespiegeltes Widget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un widget duplicado desde tu teléfono Android emparejado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un widget recopié depuis votre téléphone Android associé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un widget rispecchiato dal telefono Android associato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのAndroidスマートフォンからミラーリングされたウィジェットを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 Android 휴대전화에서 미러링된 위젯을 선택하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um widget espelhado do seu celular Android pareado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите виджет, продублированный с вашего парного телефона Android."
          }
        }
      }
    },
    "Edit this widget to choose one from your phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit this widget to choose one from your phone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑此小组件，从手机中选择一个"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯此小工具，從手機選擇一個"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeiten Sie dieses Widget, um eines von Ihrem Smartphone auszuwählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita este widget para elegir uno de tu teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez ce widget pour en choisir un depuis votre téléphone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica questo widget per sceglierne uno dal telefono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウィジェットを編集して、スマートフォンから1つ選択してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위젯을 편집하여 휴대전화의 위젯 중 하나를 선택하십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite este widget para escolher um do seu celular"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените этот виджет, чтобы выбрать один с телефона"
          }
        }
      }
    },
    "Live widget from your Android phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
